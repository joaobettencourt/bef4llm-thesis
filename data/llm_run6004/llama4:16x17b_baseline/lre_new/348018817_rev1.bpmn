<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="ExpenseReportProcess" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Receive Expense Report">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="IntermediateCatchEvent_1"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_2</incoming>
      <timerEventDefinition>
        <timeDuration>P28D</timeDuration>
      </timerEventDefinition>
      <outgoing>SequenceFlow_3</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_1" targetRef="Task_2"/>

    <task id="Task_2" name="Send Resubmit Email to Employee">
      <incoming>SequenceFlow_3</incoming>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_4</outgoing>
      <outgoing>SequenceFlow_5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task_3" name="Check if Employee has Account">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4">
      <conditionExpression xsi:type="tFormalExpression">${hasAccount == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task_4" name="Create Employee Account">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_5"/>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="Task_5"/>

    <task id="Task_5" name="Review Expense Report">
      <incoming>SequenceFlow_6</incoming>
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
      <conditionExpression xsi:type="tFormalExpression">${amount <= 200}</conditionExpression>
    </sequenceFlow>

    <task id="Task_6" name="Reimburse Employee through Direct Deposit">
      <incoming>SequenceFlow_9</incoming>
    </task>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_7">
      <conditionExpression xsi:type="tFormalExpression">${amount > 200}</conditionExpression>
    </sequenceFlow>

    <task id="Task_7" name="Request Supervisor Approval">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_7" targetRef="IntermediateCatchEvent_2"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_2">
      <incoming>SequenceFlow_11</incoming>
      <timerEventDefinition>
        <timeDuration>P7D</timeDuration>
      </timerEventDefinition>
      <outgoing>SequenceFlow_12</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateCatchEvent_2" targetRef="ExclusiveGateway_3"/>

    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
      <outgoing>SequenceFlow_15</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_13" sourceRef="ExclusiveGateway_3" targetRef="Task_8">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'approved'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_8" name="Reimburse Employee through Direct Deposit">
      <incoming>SequenceFlow_13</incoming>
    </task>

    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_16</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_14" sourceRef="ExclusiveGateway_3" targetRef="Task_9">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_9" name="Notify Employee of Rejection through Email">
      <incoming>SequenceFlow_14</incoming>
    </task>

    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="Task_10">
      <conditionExpression xsi:type="tFormalExpression">${approvalStatus == 'in progress'}</conditionExpression>
    </sequenceFlow>

    <task id="Task_10" name="Send Follow-up Email to Employee">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_10" targetRef="EndEvent_2"/>
  </process>
</definitions>