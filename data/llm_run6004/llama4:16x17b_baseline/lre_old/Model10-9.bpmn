<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="MPO Change Request Process" targetNamespace="http://example.com/bpmn">

   <process id="mpoChangeRequestProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskReviewChangeRequest"/>

     <userTask id="taskReviewChangeRequest" name="Review Change Request">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskReviewChangeRequest" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="taskReviewChangeRequest" targetRef="endEvent4">
       <conditionExpression xsi:type="tFormalExpression">${changeRequest.approved == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow4" name="Approve Change Request" sourceRef="exclusiveGateway1" targetRef="taskPerformMeasuringPointChange">
       <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow5" name="Reject Change Request" sourceRef="exclusiveGateway1" targetRef="endEvent3"/>

     <userTask id="taskPerformMeasuringPointChange" name="Perform Measuring Point Change">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <serviceTask id="taskReportImplementation" name="Report Implementation to SP/PU/GO">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="taskPerformMeasuringPointChange" targetRef="taskReportImplementation"/>

     <endEvent id="endEvent3">
       <incoming>sequenceFlow5</incoming>
     </endEvent>

     <endEvent id="endEvent4">
       <incoming>sequenceFlow3</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="taskReportImplementation" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${implementationSuccessful == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="endEvent2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow8</incoming>
     </endEvent>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow9</incoming>
     </endEvent>
   </process>
 </definitions>