<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Register Measurement at GO">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Examine Application">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${applicationValid  == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${applicationValid  == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_5" name="Confirm Application" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

     <sequenceFlow id="SequenceFlow_6" name="Reject Application" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>

     <task id="Task_3" name="Assign MSPN">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Inform MSPO">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="Task_5"/>

     <task id="Task_5" name="Inform MPO">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="Task_6"/>

     <task id="Task_6" name="Inform SP">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="EndEvent_2"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_6</incoming>
     </endEvent>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
 </definitions>