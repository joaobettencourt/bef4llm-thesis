<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Diagram" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_2" name="MPOO sends bill for temporary continuation of metering point operations" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_3" name="MSPO sends bill for temporary continuation of measurement" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_4" name="MSPO sends bill for additional readings" sourceRef="ExclusiveGateway_1" targetRef="Task_1"/>

     <sequenceFlow id="SequenceFlow_5" name="MPOO or MSPO sends bill for equipment acquisition" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_1" name="GO examines bill">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_3</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_1" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="Confirm invoice with payment advice" sourceRef="ExclusiveGateway_2" targetRef="Task_3"/>

     <sequenceFlow id="SequenceFlow_8" name="Reject invoice" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>

     <task id="Task_2" name="MPON or GO examines bill">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_2" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" name="Confirm invoice with payment advice" sourceRef="ExclusiveGateway_3" targetRef="Task_5"/>

     <sequenceFlow id="SequenceFlow_11" name="Reject invoice" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>

     <task id="Task_3" name="GO or MPON confirms invoice with payment advice to MPOO or MSPO">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_3" targetRef="EndEvent_1"/>

     <task id="Task_4" name="GO or MPON rejects invoice of MPOO or MSPO">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <task id="Task_5" name="GO or MPON confirms invoice with payment advice to MPOO or MSPO">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <task id="Task_6" name="GO or MPON rejects invoice of MPOO or MSPO">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_14</incoming>
       <incoming>SequenceFlow_15</incoming>
     </endEvent>

   </process>
 </definitions>