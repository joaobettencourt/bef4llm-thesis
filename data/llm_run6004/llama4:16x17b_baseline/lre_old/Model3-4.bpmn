<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="claim_handling_process" isExecutable="true">
     <startEvent id="start_event">
       <outgoing>send_questionnaire</outgoing>
     </startEvent>

     <sequenceFlow id="send_questionnaire_flow" sourceRef="start_event" targetRef="send_questionnaire_task"/>

     <task id="send_questionnaire_task" name="Send Questionnaire">
       <incoming>send_questionnaire_flow</incoming>
       <outgoing>wait_for_response</outgoing>
     </task>

     <sequenceFlow id="wait_for_response_flow" sourceRef="send_questionnaire_task" targetRef="intermediate_catch_event"/>

     <intermediateCatchEvent id="intermediate_catch_event">
       <incoming>wait_for_response_flow</incoming>
       <outgoing>check_response</outgoing>
       <timerEventDefinition>
         <timeDuration>P5D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="check_response_flow" sourceRef="intermediate_catch_event" targetRef="exclusive_gateway"/>

     <task id="send_reminder_task" name="Send Reminder">
       <incoming>send_reminder_flow</incoming>
       <outgoing>wait_for_response_again</outgoing>
     </task>

     <sequenceFlow id="send_reminder_flow" sourceRef="exclusive_gateway_send_reminder" targetRef="send_reminder_task"/>

     <intermediateCatchEvent id="intermediate_catch_event_2">
       <incoming>wait_for_response_again_flow</incoming>
       <outgoing>check_response_again</outgoing>
       <timerEventDefinition>
         <timeDuration>P5D</timeDuration>
       </timerEventDefinition>
     </intermediateCatchEvent>

     <sequenceFlow id="wait_for_response_again_flow" sourceRef="send_reminder_task" targetRef="intermediate_catch_event_2"/>

     <sequenceFlow id="check_response_again_flow" sourceRef="intermediate_catch_event_2" targetRef="exclusive_gateway"/>

     <exclusiveGateway id="exclusive_gateway">
       <incoming>check_response_flow</incoming>
       <outgoing>exclusive_gateway_send_reminder</outgoing>
       <outgoing>exclusive_gateway_end</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="exclusive_gateway_send_reminder" sourceRef="exclusive_gateway" targetRef="send_reminder_task">
       <conditionExpression xsi:type="tFormalExpression">${responseReceived == false}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="exclusive_gateway_end" sourceRef="exclusive_gateway" targetRef="end_event">
       <conditionExpression xsi:type="tFormalExpression">${responseReceived == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="end_event">
       <incoming>exclusive_gateway_end</incoming>
     </endEvent>
   </process>
 </definitions>