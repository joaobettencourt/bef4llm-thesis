                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="Organization" processRef="Pool_0"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclusive_Databased_Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartNoneEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent name="" id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
    <bpmn:task name="Check if insurant could be possibly subrogated against" id="Task_0">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_8" sourceRef="Task_0" targetRef="Task_1"/>
    <bpmn:task name="Get information about that" id="Task_1">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_9" sourceRef="Task_1" targetRef="Exclusive_Databased_Gateway_0"/>
    <bpmn:exclusiveGateway name="" id="Exclusive_Databased_Gateway_0">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Exclusive_Databased_Gateway_0" targetRef="Task_2"/>
    <bpmn:task name="Send request for payment to the insurant and make reminder" id="Task_2">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_2" targetRef="Exclusive_Databased_Gateway_1"/>
    <bpmn:exclusiveGateway name="" id="Exclusive_Databased_Gateway_1">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent name="" id="EndNoneEvent_0">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Exclusive_Databased_Gateway_1" targetRef="EndNoneEvent_0"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Exclusive_Databased_Gateway_1" targetRef="Task_3"/>
    <bpmn:task name="Check if insurant disagrees with the recourse" id="Task_3">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_3" targetRef="Exclusive_Databased_Gateway_2"/>
    <bpmn:exclusiveGateway name="" id="Exclusive_Databased_Gateway_2">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent name="" id="EndNoneEvent_1">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_15" sourceRef="Exclusive_Databased_Gateway_2" targetRef="EndNoneEvent_1"/>
  </bpmn:process>
</bpmn:definitions>