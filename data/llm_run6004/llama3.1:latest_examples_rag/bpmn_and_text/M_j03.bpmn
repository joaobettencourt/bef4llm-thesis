<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             targetNamespace="http://bpmn.io/schema/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <collaboration id="Collaboration_1" name="Contract">
    <participant id="Participant_1" processRef="Process_1"/>
  </collaboration>
  <process id="Process_1" isExecutable="false" name="Contract">
    <startEvent id="StartEvent_1" name="Find web shops with parts">
      <outgoing>SequenceFlow_ID_1</outgoing>
    </startEvent>
    <serviceTask id="ServiceTask_1" name="Query all web shops">
      <incoming>SequenceFlow_ID_1</incoming>
      <outgoing>SequenceFlow_ID_2</outgoing>
    </serviceTask>
    <exclusiveGateway id="ExclusiveGateway_1" name="Select cheapest parts">
      <incoming>SequenceFlow_ID_2</incoming>
      <outgoing>SequenceFlow_ID_3</outgoing>
      <outgoing>SequenceFlow_ID_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_3" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_2"/>
    <serviceTask id="ServiceTask_2" name="Order parts from selected web shops">
      <incoming>SequenceFlow_ID_3</incoming>
      <outgoing>SequenceFlow_ID_5</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_4" sourceRef="ExclusiveGateway_1" targetRef="ServiceTask_3"/>
    <serviceTask id="ServiceTask_3" name="Order parts from other web shops">
      <incoming>SequenceFlow_ID_4</incoming>
      <outgoing>SequenceFlow_ID_6</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_5" sourceRef="ServiceTask_2" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Parts arrive">
      <incoming>SequenceFlow_ID_5</incoming>
      <outgoing>SequenceFlow_ID_7</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_ID_6" sourceRef="ServiceTask_3" targetRef="IntermediateCatchEvent_1"/>
    <sequenceFlow id="SequenceFlow_ID_7" sourceRef="IntermediateCatchEvent_1" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2" name="Assemble parts">
      <incoming>SequenceFlow_ID_7</incoming>
      <outgoing>SequenceFlow_ID_8</outgoing>
      <outgoing>SequenceFlow_ID_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_8" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_4"/>
    <serviceTask id="ServiceTask_4" name="Assemble parts">
      <incoming>SequenceFlow_ID_8</incoming>
      <outgoing>SequenceFlow_ID_10</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_9" sourceRef="ExclusiveGateway_2" targetRef="ServiceTask_5"/>
    <serviceTask id="ServiceTask_5" name="Reorder parts if necessary">
      <incoming>SequenceFlow_ID_9</incoming>
      <outgoing>SequenceFlow_ID_11</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_10" sourceRef="ServiceTask_4" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1" name="Contract completed">
      <incoming>SequenceFlow_ID_10</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_11" sourceRef="ServiceTask_5" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3" name="Check stock levels">
      <incoming>SequenceFlow_ID_11</incoming>
      <outgoing>SequenceFlow_ID_12</outgoing>
      <outgoing>SequenceFlow_ID_13</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_12" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_6"/>
    <serviceTask id="ServiceTask_6" name="Reorder parts if stock level falls below 5">
      <incoming>SequenceFlow_ID_12</incoming>
      <outgoing>SequenceFlow_ID_14</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_13" sourceRef="ExclusiveGateway_3" targetRef="ServiceTask_7"/>
    <serviceTask id="ServiceTask_7" name="Reorder parts if stock level falls below 3">
      <incoming>SequenceFlow_ID_13</incoming>
      <outgoing>SequenceFlow_ID_15</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_14" sourceRef="ServiceTask_6" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2" name="Contract completed">
      <incoming>SequenceFlow_ID_14</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_15" sourceRef="ServiceTask_7" targetRef="ExclusiveGateway_4"/>
    <exclusiveGateway id="ExclusiveGateway_4" name="Check stock levels again">
      <incoming>SequenceFlow_ID_15</incoming>
      <outgoing>SequenceFlow_ID_16</outgoing>
      <outgoing>SequenceFlow_ID_17</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_ID_16" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_8"/>
    <serviceTask id="ServiceTask_8" name="Reorder parts if stock level falls below 1">
      <incoming>SequenceFlow_ID_16</incoming>
      <outgoing>SequenceFlow_ID_18</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_17" sourceRef="ExclusiveGateway_4" targetRef="ServiceTask_9"/>
    <serviceTask id="ServiceTask_9" name="Send email to friends">
      <incoming>SequenceFlow_ID_17</incoming>
      <outgoing>SequenceFlow_ID_19</outgoing>
    </serviceTask>
    <sequenceFlow id="SequenceFlow_ID_18" sourceRef="ServiceTask_8" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_3" name="Contract completed">
      <incoming>SequenceFlow_ID_18</incoming>
    </endEvent>
    <sequenceFlow id="SequenceFlow_ID_19" sourceRef="ServiceTask_9" targetRef="EndEvent_4"/>
    <endEvent id="EndEvent_4" name="Contract completed">
      <incoming>SequenceFlow_ID_19</incoming>
    </endEvent>
  </process>
</definitions>