<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   targetNamespace="http://bpmn.io/schema/bpmn" id="Definitions_1" name="DIY Repair of a Broken Smartphone Screen">
  <bpmn:process id="Process_1" isExecutable="false" name="DIY Repair of a Broken Smartphone Screen">
    <bpmn:startEvent id="StartEvent_1" name="Enter model and what's broken">
      <bpmn:outgoing>SequenceFlow_0j9o4y</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_0v6x5a" name="Get list of materials, tools and ordering choices">
      <bpmn:incoming>SequenceFlow_0j9o4y</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1k8z3e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0j9o4y" sourceRef="StartEvent_1" targetRef="ServiceTask_0v6x5a"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0p2e5vq">
      <bpmn:incoming>SequenceFlow_1k8z3e</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_1dlbln9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_1k8z3e" sourceRef="ServiceTask_0v6x5a" targetRef="ExclusiveGateway_0p2e5vq"/>
    <bpmn:serviceTask id="ServiceTask_12j0pib" name="Get instructions on how to fix phone">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0kz5g1t</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="ServiceTask_12j0pib"/>
    <bpmn:task id="Task_0jsoxba" name="Fix phone">
      <bpmn:incoming>SequenceFlow_0kz5g1t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0mp5byl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_0kz5g1t" sourceRef="ServiceTask_12j0pib" targetRef="Task_0jsoxba"/>
    <bpmn:inclusiveGateway id="InclusiveGateway_1dgb4sg">
      <bpmn:incoming>SequenceFlow_0mp5byl</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_0buzwss</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_0mp5byl" sourceRef="Task_0jsoxba" targetRef="InclusiveGateway_1dgb4sg"/>
    <bpmn:endEvent id="EndEvent_1fx9yp3" name="Send review and/or video of fixing phone">
      <bpmn:incoming>SequenceFlow_0buzwss</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0buzwss" sourceRef="InclusiveGateway_1dgb4sg" targetRef="EndEvent_1fx9yp3"/>
  </bpmn:process>
</bpmn:definitions>