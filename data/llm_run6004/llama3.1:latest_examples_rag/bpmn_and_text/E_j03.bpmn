    <bpmn:sequenceFlow id="SequenceFlow_1dlbln9" name="" sourceRef="ExclusiveGateway_0p2e5vq" targetRef="EndEvent_1"/>
  </bpmn:process>
  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_2" name="Employee Reports Work Accident">
      <bpmn:outgoing>SequenceFlow_14a0oky</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_1ocseyo" name="Report Work Accident to Employer">
      <bpmn:incoming>SequenceFlow_14a0oky</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_023hzxi</bpmn:outgoing>
