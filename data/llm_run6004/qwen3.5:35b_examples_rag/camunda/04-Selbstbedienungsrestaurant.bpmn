<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantService">
    <bpmn:participant id="Participant_RestaurantProcess" name="Restaurant Service Process" processRef="Process_Restaurant"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Restaurant" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Gast">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_WaitingTurn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PagerTriggered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickupMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Staff" name="Angestellter">
        <bpmn:flowNodeRef>Gateway_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CookNotified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TriggerGuestPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimeoutTimer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CallGuestTimeout</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Cook" name="Koch">
        <bpmn:flowNodeRef>StartEvent_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformCook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MealReady</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_1" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_GuestEnters</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_SelectOrder" name="Gericht auswählen aus Angebot">
      <bpmn:incoming>SequenceFlow_GuestEnters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitingTurn</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Mahlzeit verzehrt">
      <bpmn:incoming>SequenceFlow_MealConsumed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Staff Lane -->
    <bpmn:startEvent id="StartEvent_TimeoutTimer" name="5 Minuten Timer">
      <bpmn:timerDuration xsi:type="tTimeDate">PT5M</bpmn:timerDuration>
      <bpmn:outgoing>SequenceFlow_CallGuestTimeout</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Cook Lane -->
    <bpmn:startEvent id="StartEvent_2" name="Koch wird informiert">
      <bpmn:outgoing>SequenceFlow_CookReceivesOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for waiting turn -->
    <bpmn:exclusiveGateway id="Gateway_WaitingTurn" name="An der Reihe?">
      <bpmn:incoming>SequenceFlow_WaitingTurn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PlacesOrder</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway for order received -->
    <bpmn:inclusiveGateway id="Gateway_OrderReceived" name="Bestellung erhalten?">
      <bpmn:incoming>SequenceFlow_GuestPlacesOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProcessPayment</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Gateway for cook notified -->
    <bpmn:exclusiveGateway id="Gateway_CookNotified" name="Koch informiert?">
      <bpmn:incoming>SequenceFlow_StaffInformsCook</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TriggerPager</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Gateway for meal ready -->
    <bpmn:inclusiveGateway id="Gateway_MealReady" name="Essen fertig?">
      <bpmn:incoming>SequenceFlow_CookNotifiesStaff</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StaffTriggerPager</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Tasks -->
    <bpmn:task id="Task_ProcessOrder" name="Bestellung eingeben &amp; Geld kassieren">
      <bpmn:incoming>SequenceFlow_PlacesOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SetPager</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SetPager" name="Pieper einstellen &amp; übergeben">
      <bpmn:incoming>SequenceFlow_ProcessPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StaffInformsCook</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_InformCook" name="Koch über Mahlzeit informieren">
      <bpmn:incoming>SequenceFlow_CookReceivesOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareMealStart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CallGuestTimeout" name="Gast nach 5 Minuten rufen">
      <bpmn:incoming>SequenceFlow_CallGuestTimeout</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuestRespondsOrRetry</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_GuestEnters" sourceRef="StartEvent_1" targetRef="Task_SelectOrder">
      <bpmn:name>Gast betritt Restaurant</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_WaitingTurn" sourceRef="Task_SelectOrder" targetRef="Gateway_WaitingTurn">
      <bpmn:name>Gast wartet auf Bedienung</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PlacesOrder" name="" sourceRef="Gateway_WaitingTurn" targetRef="Task_ProcessOrder">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[ready]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GuestPlacesOrder" name="" sourceRef="Gateway_OrderReceived" targetRef="Task_ProcessOrder">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[orderPlaced]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ProcessPayment" name="" sourceRef="Task_ProcessOrder" targetRef="Task_SetPager">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[paid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CookReceivesOrder" name="" sourceRef="StartEvent_2" targetRef="Task_InformCook">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[orderReceived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SetPager" name="" sourceRef="Task_ProcessOrder" targetRef="Task_SetPager">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[guestPaid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_StaffInformsCook" name="" sourceRef="Task_SetPager" targetRef="Gateway_CookNotified">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[pagerGiven]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareMealStart" name="" sourceRef="Task_InformCook" targetRef="Gateway_MealReady">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[cookNotified]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CookNotifiesStaff" name="" sourceRef="Gateway_MealReady" targetRef="Task_TriggerGuestPager">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[mealPrepared]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CallGuestTimeout" name="" sourceRef="StartEvent_TimeoutTimer" targetRef="Task_CallGuestTimeout">
      <bpmn:name>5 Minuten vergangen</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>