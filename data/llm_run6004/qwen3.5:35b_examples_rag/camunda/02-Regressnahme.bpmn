<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_0geryc1">
    <bpmn:participant id="Participant_0ygkg4f" name="Regressbearbeitung Versicherung" processRef="Process_2" />
  </bpmn:collaboration>

  <bpmn:process id="Process_2" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Meldung Regress möglich">
      <bpmn:outgoing>SequenceFlow_0iu9po7</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_2j8pib" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_0iu9po7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1a65vxa</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_3z8fqc" name="Regress möglich?">
      <bpmn:incoming>SequenceFlow_1a65vxa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4k2lqpo</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9d8jzxw</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Yes path - send payment demand -->
    <bpmn:task id="Task_3z7mnb" name="Zahlungsaufforderung senden">
      <bpmn:incoming>SequenceFlow_4k2lqpo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5p9xvco</bpmn:outgoing>
    </bpmn:task>

    <!-- Set for follow-up -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_Wiedervorlage" name="Wiedervorlage">
      <bpmn:incoming>SequenceFlow_5p9xvco</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6q3rtnp</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Decision after follow-up -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_FollowUp" name="Geld eingegangen?">
      <bpmn:incoming>SequenceFlow_6q3rtnp</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeldEingang</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Widerspruch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FristAbgelaufen</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Money received path -->
    <bpmn:task id="Task_GeldBuchung" name="Geldeingang verbuchen">
      <bpmn:incoming>SequenceFlow_GeldEingang</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Close1</bpmn:outgoing>
    </bpmn:task>

    <!-- Objection path -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Widerspruch" name="Widerspruch gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_Widerspruch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Close2</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Inkasso</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Deadline expired path -->
    <bpmn:task id="Task_Inkasso" name="An Inkassodienstleister abgeben">
      <bpmn:incoming>SequenceFlow_FristAbgelaufen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Close3</bpmn:outgoing>
    </bpmn:task>

    <!-- End events -->
    <bpmn:endEvent id="EndEvent_1" name="Vorgang geschlossen">
      <bpmn:incoming>SequenceFlow_Close1</bpmn:incoming />
      <bpmn:incoming>SequenceFlow_Close2</bpmn:incoming />
      <bpmn:incoming>SequenceFlow_Close3</bpmn:incoming />
    </bpmn:endEvent>

    <!-- Sequence flows -->
    <bpmn:sequenceFlow id="SequenceFlow_0iu9po7" sourceRef="StartEvent_1" targetRef="Task_2j8pib" />
    
    <!-- Regression check decision -->
    <bpmn:sequenceFlow id="SequenceFlow_1a65vxa" sourceRef="Task_2j8pib" targetRef="ExclusiveGateway_3z8fqc" />

    <bpmn:sequenceFlow id="SequenceFlow_4k2lqpo" name="Ja, möglich" sourceRef="ExclusiveGateway_3z8fqc" targetRef="Task_3z7mnb">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[regressPossible]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_9d8jzxw" name="Nein, nicht möglich" sourceRef="ExclusiveGateway_3z8fqc" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[!regressPossible]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Payment demand and follow-up -->
    <bpmn:sequenceFlow id="SequenceFlow_5p9xvco" sourceRef="Task_3z7mnb" targetRef="IntermediateEvent_Wiedervorlage" />

    <!-- After follow-up period, check status -->
    <bpmn:sequenceFlow id="SequenceFlow_6q3rtnp" sourceRef="IntermediateEvent_Wiedervorlage" targetRef="ExclusiveGateway_FollowUp" />

    <!-- Money received path -->
    <bpmn:sequenceFlow id="SequenceFlow_GeldEingang" name="Geld eingegangen" sourceRef="ExclusiveGateway_FollowUp" targetRef="Task_GeldBuchung">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[moneyReceived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Objection path -->
    <bpmn:sequenceFlow id="SequenceFlow_Widerspruch" name="Widerspruch erhalten" sourceRef="ExclusiveGateway_FollowUp" targetRef="ExclusiveGateway_Widerspruch">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[objectionReceived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Deadline expired path -->
    <bpmn:sequenceFlow id="SequenceFlow_FristAbgelaufen" name="Frist abgelaufen, kein Widerspruch" sourceRef="ExclusiveGateway_FollowUp" targetRef="Task_Inkasso">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[deadlineExpired]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Close after money booking -->
    <bpmn:sequenceFlow id="SequenceFlow_Close1" sourceRef="Task_GeldBuchung" targetRef="EndEvent_1" />

    <!-- Objection justified path - close process -->
    <bpmn:sequenceFlow id="SequenceFlow_Close2" name="Gerechtfertigt" sourceRef="ExclusiveGateway_Widerspruch" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[objectionJustified]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Objection not justified - hand to collection -->
    <bpmn:sequenceFlow id="SequenceFlow_Inkasso" name="Nicht gerechtfertigt" sourceRef="ExclusiveGateway_Widerspruch" targetRef="Task_Inkasso">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[!objectionJustified]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Close after collection handover -->
    <bpmn:sequenceFlow id="SequenceFlow_Close3" sourceRef="Task_Inkasso" targetRef="EndEvent_1" />

  </bpmn:process>
</bpmn:definitions>