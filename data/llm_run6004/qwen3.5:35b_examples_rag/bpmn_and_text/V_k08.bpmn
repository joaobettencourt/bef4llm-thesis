<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1s9j4wq">
    <bpmn:participant id="Participant_OrderProcessing" name="Order Processing Process" processRef="Process_CustomerShopping"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CustomerShopping" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Login" name="Customer Logs In">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Login Verification Task (System) -->
    <bpmn:serviceTask id="ServiceTask_CheckCredentials" name="Check Credentials &amp; Confirm Login">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Decision Point for Login Success -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_LoginSuccess" name="Login Successful?">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Failed Login -->
    <bpmn:endEvent id="EndEvent_LoginFailed" name="Shopping Experience Stops">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Product Selection Loop Start Gateway (Converging) -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckAllProducts" name="All Products Selected?">
      <bpmn:incoming>SequenceFlow_05</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Product Selection Task (User) -->
    <bpmn:userTask id="UserTask_SelectProduct" name="Select Products">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Add to Cart Task (User) -->
    <bpmn:userTask id="UserTask_AddToCart" name="Add Product to Shopping Cart">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Save Product Task (System) -->
    <bpmn:serviceTask id="ServiceTask_SaveProduct" name="Save Selected Products">
      <bpmn:incoming>SequenceFlow_08</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Order Finished Task (System) -->
    <bpmn:serviceTask id="ServiceTask_OrderFinished" name="Order Finished by System">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Parallel Gateway for Payment and Shipment Preparation -->
    <bpmn:parallelGateway id="ParallelGateway_PaymentShipment" name="">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Payment Data Entry Task (User) -->
    <bpmn:userTask id="UserTask_EnterPaymentData" name="Enter Payment Data">
      <bpmn:incoming>SequenceFlow_09</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Bank Confirmation Task (System) -->
    <bpmn:serviceTask id="ServiceTask_BankConfirmation" name="Wait for Bank Payment Confirmation">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Shipping Address Entry Task (User) -->
    <bpmn:userTask id="UserTask_EnterShippingAddress" name="Enter Shipping Address">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Billing Address Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BillingAddress" name="Billing Different from Shipping?">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Billing Address Entry Task (User) -->
    <bpmn:userTask id="UserTask_EnterBillingAddress" name="Enter Independent Billing Address">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for Payment and Shipping Convergence -->
    <bpmn:parallelGateway id="ParallelGateway_Converge" name="">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Order Completion Task (System) -->
    <bpmn:serviceTask id="ServiceTask_FinalOrderCompletion" name="Finalize Order">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_19</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="StartEvent_Login" targetRef="ServiceTask_CheckCredentials"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_02" name="Login Initiated" sourceRef="ServiceTask_CheckCredentials" targetRef="ExclusiveGateway_LoginSuccess"/>

    <bpmn:sequenceFlow id="SequenceFlow_03" name="Yes - Login Successful" sourceRef="ExclusiveGateway_LoginSuccess" targetRef="UserTask_SelectProduct">
      <bpmn:name>Login Confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_04" name="No - Login Failed" sourceRef="ExclusiveGateway_LoginSuccess" targetRef="EndEvent_LoginFailed">
      <bpmn:name>Login Rejected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Product Selection Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_05" sourceRef="ServiceTask_SaveProduct" targetRef="ExclusiveGateway_CheckAllProducts"/>

    <bpmn:sequenceFlow id="SequenceFlow_06" name="Yes - All Products Selected" sourceRef="ExclusiveGateway_CheckAllProducts" targetRef="ServiceTask_OrderFinished">
      <bpmn:name>Order Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back for More Products -->
    <bpmn:sequenceFlow id="SequenceFlow_07" name="No - Continue Selecting" sourceRef="ExclusiveGateway_CheckAllProducts" targetRef="UserTask_SelectProduct">
      <bpmn:name>Select Another Product</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_08" name="" sourceRef="UserTask_AddToCart" targetRef="ServiceTask_SaveProduct"/>

    <!-- Parallel Payment and Shipment Preparation -->
    <bpmn:sequenceFlow id="SequenceFlow_12" name="Order Ready for Processing" sourceRef="ServiceTask_OrderFinished" targetRef="ParallelGateway_PaymentShipment">
      <bpmn:name>Order Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Payment Path -->
    <bpmn:sequenceFlow id="SequenceFlow_09" name="Prepare Payment" sourceRef="ParallelGateway_PaymentShipment" targetRef="UserTask_EnterPaymentData">
      <bpmn:name>Start Payment</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_10" name="" sourceRef="UserTask_EnterPaymentData" targetRef="ServiceTask_BankConfirmation"/>

    <!-- Shipping Address Path -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="Prepare Shipment" sourceRef="ParallelGateway_PaymentShipment" targetRef="UserTask_EnterShippingAddress">
      <bpmn:name>Start Shipment</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Billing Address Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="" sourceRef="ServiceTask_BankConfirmation" targetRef="ParallelGateway_Converge"/>

    <bpmn:sequenceFlow id="SequenceFlow_15" name="Shipping Entered" sourceRef="UserTask_EnterShippingAddress" targetRef="ExclusiveGateway_BillingAddress">
      <bpmn:name>Enter Shipping Address</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Billing Different from Shipping -->
    <bpmn:sequenceFlow id="SequenceFlow_16" name="Yes - Enter Separate Billing" sourceRef="ExclusiveGateway_BillingAddress" targetRef="UserTask_EnterBillingAddress">
      <bpmn:name>Billing Address Required</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Convergence after billing address -->
    <bpmn:sequenceFlow id="SequenceFlow_17" name="" sourceRef="UserTask_EnterBillingAddress" targetRef="ParallelGateway_Converge"/>

    <!-- Final Order Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_18" name="Payment &amp; Address Complete" sourceRef="ParallelGateway_Converge" targetRef="ServiceTask_FinalOrderCompletion">
      <bpmn:name>Ready to Finish</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_19" name="Finalize Order" sourceRef="ServiceTask_FinalOrderCompletion" targetRef="EndEvent_OrderCompleted">
      <bpmn:name>Process Complete</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

</bpmn:definitions>