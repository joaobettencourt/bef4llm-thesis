<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LuxuryAirplane">
    <bpmn:participant id="Participant_ManufacturingPlant" name="Luxury Airplane Manufacturing Plant" processRef="Process_AirplaneProduction"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_AirplaneProduction" isExecutable="false">
    <!-- Lane Set for Organizing Teams -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_SalesOrdering" name="Sales &amp; Order Management">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequirements</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_ManufacturingTeams" name="Manufacturing Teams">
        <bpmn:flowNodeRef>ParallelGateway_PartsSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BaseModelPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VodkaBarProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WhiskeyBarProd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CustomInteriorPrep</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_AssemblyTesting" name="Assembly &amp; Test Flight">
        <bpmn:flowNodeRef>ParallelGateway_PartsJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssembleInterior</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConductTestFlight</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_DeliveryCustomer" name="Delivery &amp; Customer Relations">
        <bpmn:flowNodeRef>Task_CreateProtocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ConfirmationCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderCompleted</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received with Specs">
      <bpmn:outgoing>SequenceFlow_AnalyzeSpecs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Analyze Requirements -->
    <bpmn:task id="Task_AnalyzeRequirements" name="Analyze Customer Specifications">
      <bpmn:incoming>SequenceFlow_AnalyzeSpecs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitManufacturing</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Manufacturing Parts -->
    <bpmn:parallelGateway id="ParallelGateway_PartsSplit" name="Start Production">
      <bpmn:incoming>SequenceFlow_SplitManufacturing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BaseModelProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_VodkaBarProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WhiskeyBarProd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CustomInteriorProd</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Manufacturing Tasks -->
    <bpmn:task id="Task_BaseModelPrep" name="Prepare Base Model Components">
      <bpmn:incoming>SequenceFlow_BaseModelProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BaseToJoin</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="Task_VodkaBarProd" name="Manufacture Vodka Bar (Russian Team)">
      <bpmn:incoming>SequenceFlow_VodkaBarProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BarToJoin</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_WhiskeyBarProd" name="Manufacture Whiskey Bar (Irish Team)">
      <bpmn:incoming>SequenceFlow_WhiskeyBarProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BarToJoin2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_CustomInteriorPrep" name="Prepare Custom Interior (Seats, Color, Water)">
      <bpmn:incoming>SequenceFlow_CustomInteriorProd</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InteriorToJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Joining Parts -->
    <bpmn:parallelGateway id="ParallelGateway_PartsJoin" name="All Parts Ready">
      <bpmn:incoming>SequenceFlow_BaseToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BarToJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_BarToJoin2</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_InteriorToJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartAssembly</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Assembly Task -->
    <bpmn:task id="Task_AssembleInterior" name="Assemble Interior &amp; Finalize Plane">
      <bpmn:incoming>SequenceFlow_StartAssembly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartTestFlight</bpmn:outgoing>
    </bpmn:task>

    <!-- Test Flight Task -->
    <bpmn:userTask id="Task_ConductTestFlight" name="Conduct Test Flight">
      <bpmn:incoming>SequenceFlow_StartTestFlight</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CreateProtocol</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Protocol Task -->
    <bpmn:task id="Task_CreateProtocol" name="Create Test Protocol">
      <bpmn:incoming>SequenceFlow_CreateProtocol</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DistributeProtocols</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery Task -->
    <bpmn:userTask id="Task_DeliverPlane" name="Deliver Plane to Customer">
      <bpmn:incoming>SequenceFlow_DistributeProtocols</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckConfirmation</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Confirmation Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmationCheck" name="Customer Confirmed?">
      <bpmn:incoming>SequenceFlow_CheckConfirmation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderCompleted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_OrderCompleted" name="Order Completed &amp; Confirmed">
      <bpmn:incoming>SequenceFlow_OrderCompleted</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with name attributes instead of child elements -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalyzeSpecs" sourceRef="StartEvent_OrderReceived" targetRef="Task_AnalyzeRequirements" name="Receive Specs"/>

    <!-- Manufacturing Split -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitManufacturing" sourceRef="Task_AnalyzeRequirements" targetRef="ParallelGateway_PartsSplit" name="Analyzed"/>

    <!-- Manufacturing Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_BaseModelProd" sourceRef="ParallelGateway_PartsSplit" targetRef="Task_BaseModelPrep" name="Base Model"/>
    <bpmn:sequenceFlow id="SequenceFlow_VodkaBarProd" sourceRef="ParallelGateway_PartsSplit" targetRef="Task_VodkaBarProd" name="Vodka Bar Order"/>
    <bpmn:sequenceFlow id="SequenceFlow_WhiskeyBarProd" sourceRef="ParallelGateway_PartsSplit" targetRef="Task_WhiskeyBarProd" name="Whiskey Bar Order"/>
    <bpmn:sequenceFlow id="SequenceFlow_CustomInteriorProd" sourceRef="ParallelGateway_PartsSplit" targetRef="Task_CustomInteriorPrep" name="Custom Interior"/>

    <!-- Manufacturing Join Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_BaseToJoin" sourceRef="Task_BaseModelPrep" targetRef="ParallelGateway_PartsJoin" name="Ready"/>
    <bpmn:sequenceFlow id="SequenceFlow_BarToJoin" sourceRef="Task_VodkaBarProd" targetRef="ParallelGateway_PartsJoin" name="Ready"/>
    <bpmn:sequenceFlow id="SequenceFlow_BarToJoin2" sourceRef="Task_WhiskeyBarProd" targetRef="ParallelGateway_PartsJoin" name="Ready"/>
    <bpmn:sequenceFlow id="SequenceFlow_InteriorToJoin" sourceRef="Task_CustomInteriorPrep" targetRef="ParallelGateway_PartsJoin" name="Ready"/>

    <!-- Assembly & Test -->
    <bpmn:sequenceFlow id="SequenceFlow_StartAssembly" sourceRef="ParallelGateway_PartsJoin" targetRef="Task_AssembleInterior" name="All Parts Ready"/>
    <bpmn:sequenceFlow id="SequenceFlow_StartTestFlight" sourceRef="Task_AssembleInterior" targetRef="Task_ConductTestFlight" name="Fly Test"/>

    <!-- Protocol & Delivery -->
    <bpmn:sequenceFlow id="SequenceFlow_CreateProtocol" sourceRef="Task_ConductTestFlight" targetRef="Task_CreateProtocol" name="Create Report"/>
    <bpmn:sequenceFlow id="SequenceFlow_DistributeProtocols" sourceRef="Task_CreateProtocol" targetRef="Task_DeliverPlane" name="Distribute to Customer &amp; Archive"/>

    <!-- Confirmation -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckConfirmation" sourceRef="Task_DeliverPlane" targetRef="Gateway_ConfirmationCheck" name="Awaiting Sign-off"/>

    <!-- Completion -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderCompleted" sourceRef="Gateway_ConfirmationCheck" targetRef="EndEvent_OrderCompleted" name="Confirmed Yes"/>

  </bpmn:process>

</bpmn:definitions>