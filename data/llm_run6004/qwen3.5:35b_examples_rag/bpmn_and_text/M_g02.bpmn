<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LegoMachine">
    <bpmn:participant id="Participant_MachineBuilding" name="Lego Machine Building Process" processRef="Process_Building"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Building" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_DesignMachine" name="Design Basic Machine">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Order Lego Sets Task -->
    <bpmn:userTask id="Task_OrderSets" name="Order Lego Brick Sets">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Children Sort Parts -->
    <bpmn:userTask id="Task_SortParts" name="Children Sort Parts into Containers">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Subcomponent Building Loop Start -->
    <bpmn:startEvent id="Start_SubComponentLoop" name="Subcomponent">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Build Subcomponent Task -->
    <bpmn:userTask id="Task_BuildSubcomponent" name="Build Subcomponent from Sorted Parts">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Container Status -->
    <bpmn:exclusiveGateway id="Gateway_CheckParts" name="More Parts Available?">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_30a</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_30b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reorder Parts Task -->
    <bpmn:userTask id="Task_ReorderParts" name="Reorder Individual Parts">
      <bpmn:incoming>SequenceFlow_30a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_40</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Subcomponent -->
    <bpmn:userTask id="Task_TestSubcomponent" name="Test Subcomponent">
      <bpmn:incoming>SequenceFlow_30b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50a</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_60</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Test Result Gateway -->
    <bpmn:exclusiveGateway id="Gateway_TestResult" name="Test Successful?">
      <bpmn:incoming>SequenceFlow_40</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_50a</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Redesign Task -->
    <bpmn:userTask id="Task_Redesign" name="Redesign Subcomponent">
      <bpmn:incoming>SequenceFlow_60</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_70</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Assemble All Components -->
    <bpmn:userTask id="Task_Assemble" name="Assemble Subcomponents">
      <bpmn:incoming>SequenceFlow_80a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_90</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="End_Completed" name="Machine Completed">
      <bpmn:incoming>SequenceFlow_90</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows - Initial Process -->
    <bpmn:sequenceFlow id="SequenceFlow_01" sourceRef="Start_DesignMachine" targetRef="Task_OrderSets"/>

    <bpmn:sequenceFlow id="SequenceFlow_02" sourceRef="Task_OrderSets" targetRef="Task_SortParts"/>

    <!-- Sequence Flows - Subcomponent Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="Start_SubComponentLoop" targetRef="Task_BuildSubcomponent"/>

    <!-- Build to Check Parts -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Task_BuildSubcomponent" targetRef="Gateway_CheckParts"/>

    <!-- Reorder Flow (No Parts) -->
    <bpmn:sequenceFlow id="SequenceFlow_30a" sourceRef="Gateway_CheckParts" targetRef="Task_ReorderParts">
      <bpmn:name>No More Parts</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Test Flow (Has Parts) -->
    <bpmn:sequenceFlow id="SequenceFlow_30b" sourceRef="Gateway_CheckParts" targetRef="Task_TestSubcomponent">
      <bpmn:name>Continue Building</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reorder to Test -->
    <bpmn:sequenceFlow id="SequenceFlow_40" sourceRef="Task_ReorderParts" targetRef="Gateway_TestResult">
      <bpmn:name>Parts Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Successful Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_50a" sourceRef="Task_TestSubcomponent" targetRef="Gateway_TestResult">
      <bpmn:name>All Components Tested</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Failed Test Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_60" sourceRef="Task_TestSubcomponent" targetRef="Gateway_TestResult">
      <bpmn:name>Test Failed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Redesign to Test -->
    <bpmn:sequenceFlow id="SequenceFlow_70" sourceRef="Task_Redesign" targetRef="Gateway_TestResult">
      <bpmn:name>Redesigned</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Assembly to End -->
    <bpmn:sequenceFlow id="SequenceFlow_80a" sourceRef="Task_Assemble" targetRef="End_Completed">
      <bpmn:name>All Assembled</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="Data_DesignDocument" name="Machine Design Document"/>
  <bpmn:dataObject id="Data_OrderList" name="Lego Brick Order List"/>
  <bpmn:dataObject id="Data_SortedParts" name="Sorted Parts Containers"/>

</bpmn:definitions>