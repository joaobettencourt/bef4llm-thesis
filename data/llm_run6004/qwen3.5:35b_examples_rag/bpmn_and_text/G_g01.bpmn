<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LANParty_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LANParty">
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_LANParty_01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_LANParty_01" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_PlanLAN" name="Plan LAN Party">
      <bpmn:outgoing>SequenceFlow_SendInvites</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Invitations -->
    <bpmn:task id="Task_SendInvites" name="Send invitations to friends">
      <bpmn:incoming>SequenceFlow_SendInvites</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectGames</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Collect Game Preferences -->
    <bpmn:userTask id="UserTask_CollectGames" name="Collect game preferences">
      <bpmn:incoming>SequenceFlow_CollectGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitParallel</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="">
      <bpmn:incoming>SequenceFlow_SplitParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointDate</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckGames</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Date Scheduling Loop -->
    <bpmn:userTask id="UserTask_AppointDate" name="Appoint a date">
      <bpmn:incoming>SequenceFlow_AppointDate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAttendees</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 1: Check Attendee Availability -->
    <bpmn:exclusiveGateway id="Gateway_8PlusAgree" name="8+ agree on date?">
      <bpmn:incoming>SequenceFlow_CheckAttendees</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppointDateLoop</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_DateConfirmed</bpmn:outgoing>   <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow for Loop (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_AppointDateLoop" sourceRef="Gateway_8PlusAgree" targetRef="UserTask_AppointDate">
      <bpmn:name>not enough agree</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Yes -->
    <bpmn:sequenceFlow id="SequenceFlow_DateConfirmed" sourceRef="Gateway_8PlusAgree" targetRef="Gateway_JoinParallel">
      <bpmn:name>date confirmed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Game Availability Check Path -->
    <bpmn:userTask id="UserTask_CheckGames" name="Check game availability">
      <bpmn:incoming>SequenceFlow_CheckGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GamesMissingDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 2: Games Missing? -->
    <bpmn:exclusiveGateway id="Gateway_MissingGames" name="Some games missing?">
      <bpmn:incoming>SequenceFlow_GamesMissingDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DownloadGames</bpmn:outgoing> <!-- Yes -->
      <bpmn:outgoing>SequenceFlow_GamesReady</bpmn:outgoing>   <!-- No -->
    </bpmn:exclusiveGateway>

    <!-- Task 3: Download Missing Games -->
    <bpmn:userTask id="UserTask_DownloadGames" name="Download missing games">
      <bpmn:incoming>SequenceFlow_DownloadGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GamesReadyJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow for Download -->
    <bpmn:sequenceFlow id="SequenceFlow_DownloadGames" sourceRef="Gateway_MissingGames" targetRef="UserTask_DownloadGames">
      <bpmn:name>games missing</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Games Ready (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_GamesReady" sourceRef="Gateway_MissingGames" targetRef="Gateway_JoinParallel">
      <bpmn:name>all games available</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Download to Join -->
    <bpmn:sequenceFlow id="SequenceFlow_GamesReadyJoin" sourceRef="UserTask_DownloadGames" targetRef="Gateway_JoinParallel">
      <bpmn:name>downloaded</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway Join -->
    <bpmn:parallelGateway id="Gateway_JoinParallel" name="">
      <bpmn:incoming>SequenceFlow_DateConfirmed</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_GamesReadyJoin</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CalculateBeer</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4: Calculate Beer Requirements -->
    <bpmn:userTask id="UserTask_CalcBeer" name="Calculate beer requirements">
      <bpmn:incoming>SequenceFlow_CalculateBeer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckEnoughBeer</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway 3: Enough Beer? -->
    <bpmn:exclusiveGateway id="Gateway_EnoughBeer" name="Have enough beer?">
      <bpmn:incoming>SequenceFlow_CheckEnoughBeer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyMissing</bpmn:outgoing> <!-- No -->
      <bpmn:outgoing>SequenceFlow_ReadyForParty</bpmn:outgoing> <!-- Yes -->
    </bpmn:exclusiveGateway>

    <!-- Task 5: Buy Missing Beer -->
    <bpmn:userTask id="UserTask_BuyBeer" name="Buy missing beer">
      <bpmn:incoming>SequenceFlow_BuyMissing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadyForPartyJoin</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Sequence Flow for Buying Beer -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyMissing" sourceRef="Gateway_EnoughBeer" targetRef="UserTask_BuyBeer">
      <bpmn:name>not enough</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Ready (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyForParty" sourceRef="Gateway_EnoughBeer" targetRef="EndEvent_Party">
      <bpmn:name>enough beer</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Buying Beer to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ReadyForPartyJoin" sourceRef="UserTask_BuyBeer" targetRef="EndEvent_Party">
      <bpmn:name>bought</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flows for Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_SendInvites" sourceRef="StartEvent_PlanLAN" targetRef="Task_SendInvites">
      <bpmn:name>start</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Collect Games -->
    <bpmn:sequenceFlow id="SequenceFlow_CollectGames" sourceRef="Task_SendInvites" targetRef="UserTask_CollectGames">
      <bpmn:name>invitations sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow for Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitParallel" sourceRef="UserTask_CollectGames" targetRef="Gateway_ParallelSplit">
      <bpmn:name>preferences collected</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Date Path -->
    <bpmn:sequenceFlow id="SequenceFlow_AppointDate" sourceRef="Gateway_ParallelSplit" targetRef="UserTask_AppointDate">
      <bpmn:name>scheduling</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Games Path -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckGames" sourceRef="Gateway_ParallelSplit" targetRef="UserTask_CheckGames">
      <bpmn:name>game check</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Attendees -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckAttendees" sourceRef="UserTask_AppointDate" targetRef="Gateway_8PlusAgree">
      <bpmn:name>date proposed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Games Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_GamesMissingDecision" sourceRef="UserTask_CheckGames" targetRef="Gateway_MissingGames">
      <bpmn:name>check status</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Beer Check -->
    <bpmn:sequenceFlow id="SequenceFlow_CalculateBeer" sourceRef="Gateway_JoinParallel" targetRef="UserTask_CalcBeer">
      <bpmn:name>all ready</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check Enough Beer -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckEnoughBeer" sourceRef="UserTask_CalcBeer" targetRef="Gateway_EnoughBeer">
      <bpmn:name>calculation done</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>