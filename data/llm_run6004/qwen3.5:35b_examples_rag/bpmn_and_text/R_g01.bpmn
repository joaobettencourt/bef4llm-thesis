<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_diy_repair">
    <bpmn:participant id="Participant_smartphone_repair" name="DIY Smartphone Screen Repair Process" processRef="Process_1s9j4wq"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1s9j4wq" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_smartphone_repair" name="DIY Repair Requested">
      <bpmn:outgoing>SequenceFlow_start_to_tool</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Enter Model and Issue -->
    <bpmn:userTask id="Task_enter_model_issue" name="Enter Smartphone Model &amp; Broken Part">
      <bpmn:incoming>SequenceFlow_start_to_tool</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_tool_analysis</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Tool Analysis -->
    <bpmn:serviceTask id="ServiceTool_materials_list" name="Generate Materials &amp; Tools List">
      <bpmn:incoming>SequenceFlow_tool_analysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_check_inventory</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Check Inventory -->
    <bpmn:exclusiveGateway id="ExclusiveInventory" name="Items Already Owned?">
      <bpmn:incoming>SequenceFlow_check_inventory</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_borrow_items</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_buy_all</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Borrow from Friends -->
    <bpmn:userTask id="Task_contact_friends" name="Contact Friends for Items">
      <bpmn:incoming>SequenceFlow_borrow_items</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_friend_response</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Buy Remaining -->
    <bpmn:userTask id="Task_buy_remaining" name="Purchase Missing Items">
      <bpmn:incoming>SequenceFlow_buy_all</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_purchase_complete</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Converge After Acquisition -->
    <bpmn:exclusiveGateway id="ExclusiveAcquisitionComplete" name="All Items Acquired?">
      <bpmn:incoming>SequenceFlow_friend_response</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_purchase_complete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_proceed_repair</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Receive Instructions -->
    <bpmn:userTask id="Task_receive_instructions" name="Receive Repair Instructions">
      <bpmn:incoming>SequenceFlow_proceed_repair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_start_fixing</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Perform Fix -->
    <bpmn:userTask id="Task_perform_fix" name="Perform Screen Repair">
      <bpmn:incoming>SequenceFlow_start_fixing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_check_success</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Check Success -->
    <bpmn:exclusiveGateway id="ExclusiveRepairSuccess" name="Repair Successful?">
      <bpmn:incoming>SequenceFlow_check_success</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_send_review</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_expert_repair</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Send Review -->
    <bpmn:userTask id="Task_send_review" name="Send Review/Video">
      <bpmn:incoming>SequenceFlow_send_review</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_success_end</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Expert Repair -->
    <bpmn:userTask id="Task_expert_repair" name="Send to Professional">
      <bpmn:incoming>SequenceFlow_expert_repair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_professional_end</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_success" name="Repair Complete">
      <bpmn:incoming>SequenceFlow_success_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_professional" name="Professional Repair Initiated">
      <bpmn:incoming>SequenceFlow_professional_end</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_start_to_tool" sourceRef="StartEvent_smartphone_repair" targetRef="Task_enter_model_issue">
      <bpmn:name>Request Initiated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_tool_analysis" sourceRef="Task_enter_model_issue" targetRef="ServiceTool_materials_list">
      <bpmn:name>Analyze Issue</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_check_inventory" sourceRef="ServiceTool_materials_list" targetRef="ExclusiveInventory">
      <bpmn:name>List Generated</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_borrow_items" name="Some Items Available" sourceRef="ExclusiveInventory" targetRef="Task_contact_friends"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_buy_all" name="No Items Owned" sourceRef="ExclusiveInventory" targetRef="Task_buy_remaining"/>

    <bpmn:sequenceFlow id="SequenceFlow_friend_response" sourceRef="Task_contact_friends" targetRef="ExclusiveAcquisitionComplete">
      <bpmn:name>Items Borrowed</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_purchase_complete" sourceRef="Task_buy_remaining" targetRef="ExclusiveAcquisitionComplete"/>

    <bpmn:sequenceFlow id="SequenceFlow_proceed_repair" name="All Items Ready" sourceRef="ExclusiveAcquisitionComplete" targetRef="Task_receive_instructions">
      <bpmn:name>Items Acquired</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_start_fixing" name="Instructions Received" sourceRef="Task_receive_instructions" targetRef="Task_perform_fix"/>

    <bpmn:sequenceFlow id="SequenceFlow_check_success" sourceRef="Task_perform_fix" targetRef="ExclusiveRepairSuccess">
      <bpmn:name>Fix Attempted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_send_review" name="Successful Repair" sourceRef="ExclusiveRepairSuccess" targetRef="Task_send_review"/>

    <bpmn:sequenceFlow id="SequenceFlow_expert_repair" name="Failed Repair" sourceRef="ExclusiveRepairSuccess" targetRef="Task_expert_repair"/>

    <bpmn:sequenceFlow id="SequenceFlow_success_end" sourceRef="Task_send_review" targetRef="EndEvent_success">
      <bpmn:name>Review Submitted</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_professional_end" name="Professional Service Requested" sourceRef="Task_expert_repair" targetRef="EndEvent_professional"/>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_RepairList" name="Materials &amp; Tools List">
    <bpmn:name>Data Object</bpmn:name>
  </bpmn:dataObject>

  <bpmn:dataObject id="DataObject_Instructions" name="Repair Instructions"/>

  <!-- Associations -->
  <bpmn:association associationDirection="OneWay" id="Association_tool_data">
    <bpmn:startEventRef>StartEvent_smartphone_repair</bpmn:startEventRef>
    <bpmn:dataInputSet>DataObject_RepairList</bpmn:dataInputSet>
  </bpmn:association>

  <!-- Messages -->
  <bpmn:message id="Message_ReviewSubmission" name="Repair Review Submission"/>
  
  <bpmn:message id="Message_ProfessionalRequest" name="Professional Repair Request"/>

</bpmn:definitions>