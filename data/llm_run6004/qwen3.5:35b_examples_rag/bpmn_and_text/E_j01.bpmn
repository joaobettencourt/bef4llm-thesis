<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1s9j4wq">
    <bpmn:participant id="Participant_0h3c6f2" name="Job Application Process" processRef="Process_1x5t9h4" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1x5t9h4" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0k7f2m8" name="Job Application Submitted">
      <bpmn:outgoing>SequenceFlow_3g6j9p1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Regular Reporting Task -->
    <bpmn:userTask id="Task_4h8w5k2" name="Report Job Applications">
      <bpmn:incoming>SequenceFlow_3g6j9p1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7m2f6t9</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Job Offers Received -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_1p5k8j3" name="Job Offer Received">
      <bpmn:incoming>SequenceFlow_7m2f6t9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2q4h7w6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Company Confirmation & Rating -->
    <bpmn:userTask id="Task_5j9k3m1" name="Company Confirms Receipt">
      <bpmn:incoming>SequenceFlow_2q4h7w6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8t6f4p2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Interview Negotiation Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_3k7h9w5" name="Interview Needed?">
      <bpmn:incoming>SequenceFlow_8t6f4p2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1m5g8j4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_9r3k7h6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Interview Task -->
    <bpmn:userTask id="Task_2m8f5j1" name="Conduct Job Interview">
      <bpmn:incoming>SequenceFlow_9r3k7h6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4p6t9k3</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Probation Phase -->
    <bpmn:userTask id="Task_7w5h2m8" name="Probation Period">
      <bpmn:incoming>SequenceFlow_4p6t9k3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6j3f8k1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Mutual Rating After Probation -->
    <bpmn:userTask id="Task_9p4m7h2" name="Mutual Ratings">
      <bpmn:incoming>SequenceFlow_6j3f8k1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5t8w3j6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Rating Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_4h9k2m7" name="Rating C or Less?">
      <bpmn:incoming>SequenceFlow_5t8w3j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1f6p9k4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7m2h5w8</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Permanent Job End -->
    <bpmn:endEvent id="EndEvent_0k6j9p3" name="Job Becomes Permanent">
      <bpmn:incoming>SequenceFlow_7m2h5w8</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Continue Receiving Offers -->
    <bpmn:userTask id="Task_6k3f9j1" name="Continue Job Search">
      <bpmn:incoming>SequenceFlow_1f6p9k4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8h5t2m7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event for No Longer Reporting -->
    <bpmn:endEvent id="EndEvent_3p9k6j4" name="No More Reports Required">
      <bpmn:incoming>SequenceFlow_8h5t2m7</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Review Visibility Timer -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_6k9p3j1" name="Review Visible After 1 Year">
      <bpmn:incoming>SequenceFlow_5t8w3j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2h7f4m9</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3g6j9p1" sourceRef="StartEvent_0k7f2m8" targetRef="Task_4h8w5k2">
      <bpmn:name>Begin Process</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Reporting to Offers -->
    <bpmn:sequenceFlow id="SequenceFlow_7m2f6t9" sourceRef="Task_4h8w5k2" targetRef="IntermediateEvent_1p5k8j3">
      <bpmn:name>Regularly Report</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Offers to Confirmation -->
    <bpmn:sequenceFlow id="SequenceFlow_2q4h7w6" sourceRef="IntermediateEvent_1p5k8j3" targetRef="Task_5j9k3m1">
      <bpmn:name>New Offer Received</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Confirmation to Interview Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_8t6f4p2" sourceRef="Task_5j9k3m1" targetRef="ExclusiveGateway_3k7h9w5">
      <bpmn:name>Company Rates Application</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Interview Needed Path -->
    <bpmn:sequenceFlow id="SequenceFlow_9r3k7h6" sourceRef="ExclusiveGateway_3k7h9w5" targetRef="Task_2m8f5j1">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No Interview Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1m5g8j4" sourceRef="ExclusiveGateway_3k7h9w5" targetRef="Task_2m8f5j1">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Interview to Probation -->
    <bpmn:sequenceFlow id="SequenceFlow_4p6t9k3" sourceRef="Task_2m8f5j1" targetRef="Task_7w5h2m8">
      <bpmn:name>Hired for Work</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Probation to Ratings -->
    <bpmn:sequenceFlow id="SequenceFlow_6j3f8k1" sourceRef="Task_7w5h2m8" targetRef="Task_9p4m7h2">
      <bpmn:name>Probation Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Ratings to Review Visibility -->
    <bpmn:sequenceFlow id="SequenceFlow_5t8w3j6" sourceRef="Task_9p4m7h2" targetRef="IntermediateEvent_6k9p3j1">
      <bpmn:name>Submit Reviews</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Review Visible to Rating Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_2h7f4m9" sourceRef="IntermediateEvent_6k9p3j1" targetRef="ExclusiveGateway_4h9k2m7">
      <bpmn:name>After 1 Year</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Rating C or Less Path -->
    <bpmn:sequenceFlow id="SequenceFlow_1f6p9k4" sourceRef="ExclusiveGateway_4h9k2m7" targetRef="Task_6k3f9j1">
      <bpmn:name>Rating ≤ C</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Good Rating Path -->
    <bpmn:sequenceFlow id="SequenceFlow_7m2h5w8" sourceRef="ExclusiveGateway_4h9k2m7" targetRef="EndEvent_0k6j9p3">
      <bpmn:name>Rating > C</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Continue Search to End -->
    <bpmn:sequenceFlow id="SequenceFlow_8h5t2m7" sourceRef="Task_6k3f9j1" targetRef="EndEvent_3p9k6j4">
      <bpmn:name>No More Reports</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_JobApplication" name="Job Application Details" />
  <bpmn:dataObject id="DataObject_CompanyRating" name="Company Rating Score" />
  
  <!-- Associations for Documentation -->
  <bpmn:association associationDirection="OneWay">
    <bpmn:startEventRef>StartEvent_0k7f2m8</bpmn:startEventRef>
    <bpmn:dataInputSet>DataObject_JobApplication</bpmn:dataInputSet>
  </bpmn:association>

  <!-- Error Event Definitions -->
  <bpmn:error id="Error_RatingInvalid" name="Rating Invalid Format">
    <bpmn:messageRef>ErrorMsg_01</bpmn:messageRef>
  </bpmn:error>

  <!-- Message Definition -->
  <bpmn:message id="ErrorMsg_01" name="Invalid Rating Error"/>

</bpmn:definitions>