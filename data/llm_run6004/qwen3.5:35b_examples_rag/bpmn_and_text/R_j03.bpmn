<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FridgeRepair_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FridgeRepair">
    <bpmn:participant id="Participant_ServiceCenter" name="Fridge Repair Process" processRef="Process_RepairService"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_RepairService" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Customer_1" name="Customer">
        <bpmn:flowNodeRef>StartEvent_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmRepair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RateService</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceProvider_1" name="Service Provider">
        <bpmn:flowNodeRef>Task_SelectFacility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ScheduleVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMissingParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_RescheduleVisit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_WaitForParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RepairFridge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Report" name="Fridge Issue Reported">
      <bpmn:outgoing>SequenceFlow_StartToSelect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Service Provider Tasks & Gateway -->
    <bpmn:userTask id="UserTask_ScheduleVisit_1" name="Schedule Visit Appointment">
      <bpmn:incoming>SequenceFlow_SelectToSchedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ScheduleToCheckParts</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_OrderMissingParts_1" name="Order Missing Parts">
      <bpmn:incoming>SequenceFlow_CheckNoParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderToReschedule</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="UserTask_RescheduleVisit_1" name="Reschedule Visit">
      <bpmn:incoming>SequenceFlow_OrderToReschedule</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RescheduleToWait</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:task id="Task_SelectFacility_1" name="Analyze &amp; Select Facility">
      <bpmn:incoming>SequenceFlow_StartToSelect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectToSchedule</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for Loop -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_WaitForParts_1" name="Wait for Parts">
      <bpmn:incoming>SequenceFlow_RescheduleToWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitBackToVisit</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_CheckParts_1" name="Parts Available?">
      <bpmn:incoming>SequenceFlow_ScheduleToCheckParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckYesRepair</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CheckNoParts_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Repair Task -->
    <bpmn:userTask id="Task_RepairFridge_1" name="Repair Fridge">
      <bpmn:incoming>SequenceFlow_CheckYesRepair</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RepairToConfirm</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Customer Tasks -->
    <bpmn:userTask id="UserTask_ConfirmRepair_1" name="Confirm Repair OK">
      <bpmn:incoming>SequenceFlow_RepairToConfirm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmToRate</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="UserTask_RateService_1" name="Rate Service Facility">
      <bpmn:incoming>SequenceFlow_ConfirmToRate</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RateToEnd</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed_1" name="Service Completed">
      <bpmn:incoming>SequenceFlow_RateToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSelect_1" sourceRef="StartEvent_Report" targetRef="Task_SelectFacility_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_SelectToSchedule_1" name="Select Facility Done" sourceRef="Task_SelectFacility_1" targetRef="UserTask_ScheduleVisit_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_ScheduleToCheckParts_1" name="Scheduled Visit" sourceRef="UserTask_ScheduleVisit_1" targetRef="Gateway_CheckParts_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckYesRepair_1" name="Yes" sourceRef="Gateway_CheckParts_1" targetRef="Task_RepairFridge_1"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckNoParts_1" name="No Parts Needed" sourceRef="Gateway_CheckParts_1" targetRef="Task_OrderMissingParts_1">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RepairToConfirm_1" name="" sourceRef="Task_RepairFridge_1" targetRef="UserTask_ConfirmRepair_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_OrderToReschedule_1" name="Order Parts" sourceRef="Task_OrderMissingParts_1" targetRef="UserTask_RescheduleVisit_1">
      <bpmn:name>Order Parts</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmToRate_1" name="" sourceRef="UserTask_ConfirmRepair_1" targetRef="UserTask_RateService_1"/>

    <bpmn:sequenceFlow id="SequenceFlow_RescheduleToWait_1" name="Rescheduled" sourceRef="UserTask_RescheduleVisit_1" targetRef="IntermediateEvent_WaitForParts_1">
      <bpmn:name>Rescheduled</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RateToEnd_1" name="" sourceRef="UserTask_RateService_1" targetRef="EndEvent_Completed_1"/>

    <!-- Loop Back Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitBackToVisit_1" name="Parts Arrived" sourceRef="IntermediateEvent_WaitForParts_1" targetRef="Gateway_CheckParts_1">
      <bpmn:name>Wait for Parts</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>