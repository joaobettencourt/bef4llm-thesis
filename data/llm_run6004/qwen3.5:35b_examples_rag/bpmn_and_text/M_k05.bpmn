<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_HouseBuilder">
    <bpmn:participant id="Participant_Builder" name="House Builder Process" processRef="Process_BuildingTreehouse"/>
    <bpmn:messageFlow id="MessageFlow_Requirements" sourceRef="Task_SendRequirements" targetRef="ReceiveDraftFromArchitect">
      <bpmn:name>Send Requirements</bpmn:name>
    </bpmn:messageFlow>
  </bpmn:collaboration>

  <bpmn:process id="Process_BuildingTreehouse" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_CollectRequirements" name="Collect Requirements">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Send requirements to architect -->
    <bpmn:userTask id="Task_SendRequirements" name="Send Requirements to Architect">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Receive Task: Get draft from architect -->
    <bpmn:receiveTask id="ReceiveDraftFromArchitect" name="Receive Draft Plan">
      <bpmn:incoming>MessageFlow_Requirements</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:receiveTask>

    <!-- Exclusive Gateway for refinement loop -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Refine" name="Refinement Needed?">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Refine requirements -->
    <bpmn:userTask id="Task_RefineRequirements" name="Refine Requirements">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create materials list -->
    <bpmn:userTask id="Task_CreateMaterialsList" name="Create Materials List">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for ordering materials -->
    <bpmn:parallelGateway id="ParallelGateway_OrderMaterials" name="">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Order materials category 1 -->
    <bpmn:userTask id="Task_OrderMaterials1" name="Order Materials Category A">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Order materials category 2 -->
    <bpmn:userTask id="Task_OrderMaterials2" name="Order Materials Category B">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for building activities -->
    <bpmn:parallelGateway id="ParallelGateway_Building" name="">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Send messages to friends -->
    <bpmn:userTask id="Task_SendMessagesToFriends" name="Send Messages to Friends">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Build house -->
    <bpmn:userTask id="Task_BuildHouse" name="Build Tree House">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Parallel Gateway for party preparation -->
    <bpmn:parallelGateway id="ParallelGateway_Party" name="">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Send invitations -->
    <bpmn:userTask id="Task_SendInvitations" name="Send Party Invitations">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Task: Create guest list -->
    <bpmn:userTask id="Task_CreateGuestList" name="Create Guest List">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Exclusive Gateway for party preparation -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PartyPrep" name="">
      <bpmn:incoming>SequenceFlow_19</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PartyPrepared" name="Party Prepared">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_CollectRequirements" targetRef="Task_SendRequirements"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Send to Architect" sourceRef="ReceiveDraftFromArchitect" targetRef="ExclusiveGateway_Refine">
      <bpmn:name>Plan Ready?</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3" name="" sourceRef="Task_SendRequirements" targetRef="ReceiveDraftFromArchitect"/>

    <bpmn:sequenceFlow id="SequenceFlow_4" name="Continue Refining?" sourceRef="ExclusiveGateway_Refine" targetRef="Task_SendRequirements">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_5" name="Yes, Finalize Plan" sourceRef="ExclusiveGateway_Refine" targetRef="Task_CreateMaterialsList">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_6" name="" sourceRef="Task_SendRequirements" targetRef="ParallelGateway_OrderMaterials"/>

    <bpmn:sequenceFlow id="SequenceFlow_7" name="" sourceRef="Task_CreateMaterialsList" targetRef="ParallelGateway_Building">
      <bpmn:name>Create List</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="ParallelGateway_OrderMaterials" targetRef="Task_OrderMaterials1"/>

    <bpmn:sequenceFlow id="SequenceFlow_9" name="" sourceRef="ParallelGateway_OrderMaterials" targetRef="Task_OrderMaterials2"/>

    <!-- Convergence of material orders -->
    <bpmn:parallelGateway id="ParallelGateway_MaterialsComplete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Convergence of building activities -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_BuildingComplete" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from materials to building -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_MaterialsComplete" targetRef="ExclusiveGateway_BuildingComplete"/>

    <!-- Parallel Gateway for party preparation after house built -->
    <bpmn:parallelGateway id="ParallelGateway_PartyPrepStart">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flow from building to party prep -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_BuildingComplete" targetRef="ParallelGateway_PartyPrepStart">
      <bpmn:name>House Built</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Sequence Flow from party prep to invitations -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_GuestList" gatewayDirection="Converging">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flow from invitations to guest list -->
    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="ParallelGateway_PartyPrepStart" targetRef="ExclusiveGateway_GuestList"/>

    <!-- Exclusive Gateway for party complete -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PartyComplete">
      <bpmn:incoming>SequenceFlow_18</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObject id="DataObject_Requirements" name="Project Requirements"/>
  <bpmn:dataObject id="DataObject_MaterialsList" name="Materials List"/>
  <bpmn:dataObject id="DataObject_GuestList" name="Guest Attendance List"/>

</bpmn:definitions>