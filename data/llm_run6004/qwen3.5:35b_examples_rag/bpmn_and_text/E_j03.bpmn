<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1a8v7kx" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkAccident">
    <bpmn:participant id="Participant_Employee" name="Employee/Student/Self-Employed" processRef="Process_ReportWorkAccident"/>
    <bpmn:participant id="Participant_Employer" name="Employer/Educational Institution" processRef="Process_ReportWorkAccident2"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ReportWorkAccident" isExecutable="false">
    <bpmn:startEvent id="Start_EmployeeReport" name="Employee Reports Accident">
      <bpmn:outgoing>SequenceFlow_1a2b3c4d</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_ReportAccidentDetails" name="Report Work Accident Details">
      <bpmn:incoming>SequenceFlow_1a2b3c4d</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5e6f7g8h</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_AccidentType" name="Accident Type?">
      <bpmn:incoming>SequenceFlow_5e6f7g8h</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9i0j1k2l</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_3m4n5o6p</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Employee to Employer Reporting -->
    <bpmn:userTask id="Task_EmployeeToEmployer" name="Inform Employer Immediately">
      <bpmn:incoming>SequenceFlow_9i0j1k2l</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7q8r9s0t</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Near Miss Reporting -->
    <bpmn:userTask id="Task_ReportNearMiss" name="Report Incident/Near-Miss">
      <bpmn:incoming>SequenceFlow_3m4n5o6p</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_u1v2w3x4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Self-Employed Reporting -->
    <bpmn:userTask id="Task_SelfEmployedReport" name="Self-Employed Report to Insurance">
      <bpmn:incoming>SequenceFlow_5y6z7a8b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_c9d0e1f2</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Student Reporting -->
    <bpmn:userTask id="Task_StudentReport" name="Student Report to Directorate">
      <bpmn:incoming>SequenceFlow_g3h4i5j6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_k7l8m9n0</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Private Insurance Reporting -->
    <bpmn:userTask id="Task_PrivateInsuranceReport" name="Written Report to Provider">
      <bpmn:incoming>SequenceFlow_o1p2q3r4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_s5t6u7v8</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Fatalities Special Handling -->
    <bpmn:userTask id="Task_FatalityReport" name="Fatality Report (3 Days)">
      <bpmn:incoming>SequenceFlow_w9x0y1z2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_a3b4c5d6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="End_EmployeeReportComplete" name="Accident Reported">
      <bpmn:incoming>SequenceFlow_e7f8g9h0</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_NearMissRecorded" name="Near-Miss Recorded">
      <bpmn:incoming>SequenceFlow_i1j2k3l4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Converging Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Converge1" name="">
      <bpmn:incoming>SequenceFlow_7q8r9s0t</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_e7f8g9h0</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1a2b3c4d" sourceRef="Start_EmployeeReport" targetRef="Task_ReportAccidentDetails">
      <bpmn:name>Begin Reporting</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_5e6f7g8h" sourceRef="Task_ReportAccidentDetails" targetRef="Gateway_AccidentType">
      <bpmn:name>Determine Type</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_9i0j1k2l" sourceRef="Gateway_AccidentType" targetRef="Task_EmployeeToEmployer">
      <bpmn:name>Work Accident</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_3m4n5o6p" sourceRef="Gateway_AccidentType" targetRef="Task_ReportNearMiss">
      <bpmn:name>Near-Miss/Risk</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Second Process for Educational Institutions -->
  <bpmn:process id="Process_ReportWorkAccident2" isExecutable="false">
    <bpmn:startEvent id="Start_SchoolReport" name="School Accident Occurred">
      <bpmn:outgoing>SequenceFlow_a1b2c3d4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="Task_DocumentAccident" name="Document School/Student Accident">
      <bpmn:incoming>SequenceFlow_a1b2c3d4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_e5f6g7h8</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_SchoolType" name="Student Type?">
      <bpmn:incoming>SequenceFlow_e5f6g7h8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_i9j0k1l2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- School/University Reporting -->
    <bpmn:userTask id="Task_SchoolToInsurance" name="Report to Insurance Provider (5 Days)">
      <bpmn:incoming>SequenceFlow_i9j0k1l2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_m3n4o5p6</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Directorate Reporting -->
    <bpmn:userTask id="Task_DirectorateReport" name="Report to Competent Directorate">
      <bpmn:incoming>SequenceFlow_q7r8s9t0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_u1v2w3x4</bpmn:outgoing>
    </bpmn:userTask>

    <!-- End Events -->
    <bpmn:endEvent id="End_SchoolReportComplete" name="School Report Complete">
      <bpmn:incoming>SequenceFlow_m3n4o5p6</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_DirectorateReported" name="Directorate Notified">
      <bpmn:incoming>SequenceFlow_u1v2w3x4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_a1b2c3d4" sourceRef="Start_SchoolReport" targetRef="Task_DocumentAccident">
      <bpmn:name>Begin Documentation</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_e5f6g7h8" sourceRef="Task_DocumentAccident" targetRef="Gateway_SchoolType">
      <bpmn:name>Determine Reporting Path</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Message Flows -->
  <bpmn:message id="Message_AccidentReport" name="Accident Report"/>
  <bpmn:message id="Message_NearMissReport" name="Near-Miss Incident Report"/>

</bpmn:definitions>