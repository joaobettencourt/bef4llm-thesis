<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="ERICS Reimbursement Process" processRef="Process_0c5t3y2l8k6j4h9f">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_ReimbursementDept">
          <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_CreateContact</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_ChooseBeneficiary</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_DetermineDuration</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_CheckVerband</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_SetThreshold</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_CustomerService">
          <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_PrintCreditNote</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>EndEvent_ProcessComplete</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_Finance">
          <bpmn:flowNodeRef>Task_CalculateReimbursement</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_ParallelMerge</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Reimbursement request received" id="StartEvent_RequestReceived">
      <bpmn:outgoing>SequenceFlow_01</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Create reimbursement contact -->
    <bpmn:task name="Create reimbursement contact" id="Task_CreateContact">
      <bpmn:incoming>SequenceFlow_01</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_02</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Choose beneficiary -->
    <bpmn:task name="Choose beneficiary" id="Task_ChooseBeneficiary">
      <bpmn:incoming>SequenceFlow_02</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_03</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Determine refund period/contract duration -->
    <bpmn:task name="Determine refund period / contract duration" id="Task_DetermineDuration">
      <bpmn:incoming>SequenceFlow_03</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_04</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway: Check Verband membership -->
    <bpmn:exclusiveGateway name="Customer part of Verband?" id="Gateway_CheckVerband">
      <bpmn:incoming>SequenceFlow_04</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_05a</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_05b</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4a: Select customer group association (Verband) -->
    <bpmn:task name="Select customer group association" id="Task_SelectGroupAssociation">
      <bpmn:incoming>SequenceFlow_05a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_06</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Select customers manually (Normal subsidiaries) -->
    <bpmn:task name="Select customers manually" id="Task_SelectCustomersManual">
      <bpmn:incoming>SequenceFlow_05b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_07</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Set threshold -->
    <bpmn:task name="Set threshold" id="Task_SetThreshold">
      <bpmn:incoming>SequenceFlow_06</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_08</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Split for credit note and payment -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>SequenceFlow_07</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_09a</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_09b</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 6a: Print and send credit note (after refund period ends) -->
    <bpmn:task name="Print and send credit note" id="Task_PrintCreditNote">
      <bpmn:incoming>SequenceFlow_09a</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12a</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6b: Calculate and pay reimbursement -->
    <bpmn:task name="Calculate and pay reimbursement" id="Task_CalculateReimbursement">
      <bpmn:incoming>SequenceFlow_09b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12b</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway: Merge parallel flows -->
    <bpmn:parallelGateway id="Gateway_ParallelMerge">
      <bpmn:incoming>SequenceFlow_12a</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_12b</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent name="Process complete" id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow sourceRef="StartEvent_RequestReceived" targetRef="Task_CreateContact" id="SequenceFlow_01"/>
    <bpmn:sequenceFlow sourceRef="Task_CreateContact" targetRef="Task_ChooseBeneficiary" id="SequenceFlow_02"/>
    <bpmn:sequenceFlow sourceRef="Task_ChooseBeneficiary" targetRef="Task_DetermineDuration" id="SequenceFlow_03"/>
    <bpmn:sequenceFlow sourceRef="Task_DetermineDuration" targetRef="Gateway_CheckVerband" id="SequenceFlow_04"/>
    
    <!-- Gateway Check Verbands -->
    <bpmn:sequenceFlow name="Yes - Verband member" sourceRef="Gateway_CheckVerband" targetRef="Task_SelectGroupAssociation" id="SequenceFlow_05a"/>
    <bpmn:sequenceFlow name="No - Normal subsidiary" sourceRef="Gateway_CheckVerband" targetRef="Task_SelectCustomersManual" id="SequenceFlow_05b"/>

    <!-- Merge after selection -->
    <bpmn:sequenceFlow sourceRef="Task_SelectGroupAssociation" targetRef="Task_SetThreshold" id="SequenceFlow_06"/>
    
    <!-- Set threshold and split parallel flows -->
    <bpmn:sequenceFlow name="" sourceRef="Task_SetThreshold" targetRef="Gateway_ParallelSplit" id="SequenceFlow_07"/>

    <!-- Parallel paths after refund period ends -->
    <bpmn:sequenceFlow sourceRef="Gateway_ParallelSplit" targetRef="Task_PrintCreditNote" id="SequenceFlow_09a"/>
    <bpmn:sequenceFlow sourceRef="Gateway_ParallelSplit" targetRef="Task_CalculateReimbursement" id="SequenceFlow_09b"/>

    <!-- Merge parallel flows -->
    <bpmn:sequenceFlow sourceRef="Task_PrintCreditNote" targetRef="Gateway_ParallelMerge" id="SequenceFlow_12a"/>
    <bpmn:sequenceFlow sourceRef="Task_CalculateReimbursement" targetRef="Gateway_ParallelMerge" id="SequenceFlow_12b"/>

    <!-- Final flow to end event -->
    <bpmn:sequenceFlow sourceRef="Gateway_ParallelMerge" targetRef="EndEvent_ProcessComplete" id="SequenceFlow_13"/>

  </bpmn:process>
</bpmn:definitions>