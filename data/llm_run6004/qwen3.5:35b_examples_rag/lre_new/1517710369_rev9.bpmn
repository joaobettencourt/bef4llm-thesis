<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_AddCreditCard_1" targetNamespace="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:process id="Process_AddCreditCard_1" isExecutable="false">

    <!-- Start Event -->
    <bpmn:startEvent name="Choose Credit Card Payment" id="StartEvent_ChoosePayment">
      <bpmn:outgoing>SequenceFlow_EnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- User Task: Enter Details -->
    <bpmn:userTask name="Enter Credit Card &amp; Billing Details" id="UserTask_EnterDetails">
      <bpmn:incoming>SequenceFlow_ModifyBack</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAddress</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Check Address -->
    <bpmn:serviceTask name="Check Billing Address" id="ServiceTask_CheckAddress">
      <bpmn:incoming>SequenceFlow_EnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddressValidDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Address Valid? -->
    <bpmn:exclusiveGateway name="Address Valid?" id="ExclusiveGateway_AddressCheck">
      <bpmn:incoming>SequenceFlow_AddressValidDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModifyPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContinuePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- User Task: Modify Details (Loop Back) -->
    <bpmn:userTask name="Modify Credit Card Details" id="UserTask_ModifyDetails">
      <bpmn:incoming>SequenceFlow_ModifyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ModifyBack</bpmn:outgoing>
    </bpmn:userTask>

    <!-- User Task: Click Continue Button -->
    <bpmn:userTask name="Click Continue Button" id="UserTask_ClickContinue">
      <bpmn:incoming>SequenceFlow_ContinuePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerifyCard</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Service Task: Verify with Authority -->
    <bpmn:serviceTask name="Verify Credit Card" id="ServiceTask_VerifyAuthority">
      <bpmn:incoming>SequenceFlow_VerifyCard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResultCheckDecision</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Gateway: Verification Result -->
    <bpmn:exclusiveGateway name="Verification Valid?" id="ExclusiveGateway_VerificationResult">
      <bpmn:incoming>SequenceFlow_ResultCheckDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AddCardPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CancelAdditionPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Added Successfully -->
    <bpmn:endEvent name="Credit Card Added" id="EndEvent_Added">
      <bpmn:incoming>SequenceFlow_AddCardPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Cancelled -->
    <bpmn:endEvent name="Addition Cancelled" id="EndEvent_Cancelled">
      <bpmn:incoming>SequenceFlow_CancelAdditionPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EnterDetails" sourceRef="StartEvent_ChoosePayment" targetRef="UserTask_EnterDetails">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CheckAddress" sourceRef="UserTask_EnterDetails" targetRef="ServiceTask_CheckAddress">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AddressValidDecision" sourceRef="ServiceTask_CheckAddress" targetRef="ExclusiveGateway_AddressCheck">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Loop Back Path (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_ModifyPath" sourceRef="ExclusiveGateway_AddressCheck" targetRef="UserTask_ModifyDetails">
      <bpmn:name>Incorrect - Modify</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Continue Path (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinuePath" sourceRef="ExclusiveGateway_AddressCheck" targetRef="UserTask_ClickContinue">
      <bpmn:name>Correct - Proceed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Back to Entry -->
    <bpmn:sequenceFlow id="SequenceFlow_ModifyBack" sourceRef="UserTask_ModifyDetails" targetRef="UserTask_EnterDetails">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- To Verification -->
    <bpmn:sequenceFlow id="SequenceFlow_VerifyCard" sourceRef="UserTask_ClickContinue" targetRef="ServiceTask_VerifyAuthority">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Result Check Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ResultCheckDecision" sourceRef="ServiceTask_VerifyAuthority" targetRef="ExclusiveGateway_VerificationResult">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Added Path (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_AddCardPath" sourceRef="ExclusiveGateway_VerificationResult" targetRef="EndEvent_Added">
      <bpmn:name>Validated - Add Card</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Cancelled Path (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_CancelAdditionPath" sourceRef="ExclusiveGateway_VerificationResult" targetRef="EndEvent_Cancelled">
      <bpmn:name>Invalid - Cancel</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>