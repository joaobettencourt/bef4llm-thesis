<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_BankAccountVerification">
    <bpmn:participant name="PayPal Client Verification Process" processRef="Process_BankVerify" />
  </bpmn:collaboration>

  <bpmn:process id="Process_BankVerify" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane name="PayPal Client">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterBankDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_SubmitToSystem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TimerNotification_3to5Days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDepositAmounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateThrowEvent_VerifyClick</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane name="PayPal System">
        <bpmn:flowNodeRef>Task_MakeRandomDeposits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_DepositInfoSent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_CheckValuesMatch</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane name="Bank Account">
        <bpmn:flowNodeRef>IntermediateThrowEvent_DepositsMade</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Add Bank Account">
      <bpmn:outgoing>SequenceFlow_StartToEnterDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Client Task: Enter Bank Details -->
    <bpmn:task id="Task_EnterBankDetails" name="Enter Bank Details&#10;(First Name, Bank Name,&#10;Account Type, BSB,&#10;Account Number)">
      <bpmn:incoming>SequenceFlow_StartToEnterDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EnterToSubmit</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Task: Submit to System -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_SubmitToSystem" name="Click Continue">
      <bpmn:incoming>SequenceFlow_EnterToSubmit</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- System Task: Make Random Deposits -->
    <bpmn:task id="Task_MakeRandomDeposits" name="Make Two&#10;Random Deposits">
      <bpmn:incoming>SequenceFlow_DepositsToSystem</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_SendDepositInfo</bpmn:outgoing>
    </bpmn:task>

    <!-- System Task: Send Deposit Info -->
    <bpmn:intermediateThrowEvent id="IntermediateCatchEvent_DepositInfoSent" name="Send Message&#10;with Deposit Info">
      <bpmn:messageEventDefinition />
      <bpmn:outgoing>SequenceFlow_SendToClient</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Client Timer Event: Notification after 3-5 days -->
    <bpmn:intermediateCatchEvent id="TimerNotification_3to5Days" name="Wait for&#10;3-5 Working Days">
      <bpmn:incoming>SequenceFlow_SendToClient</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyToEnterAmounts</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Client Task: Enter Deposit Amounts -->
    <bpmn:task id="Task_EnterDepositAmounts" name="Log into PayPal&#10;and enter deposit amounts">
      <bpmn:incoming>SequenceFlow_NotifyToEnterAmounts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToVerifyClick</bpmn:outgoing>
    </bpmn:task>

    <!-- Client Task: Click Verify -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_VerifyClick" name="Click Verify">
      <bpmn:incoming>SequenceFlow_ToVerifyClick</bpmn:incoming>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>

    <!-- System Gateway: Check Values Match -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_CheckValuesMatch" name="Do values&#10;match?">
      <bpmn:incoming>SequenceFlow_ReceiveVerification</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_IfMatch_ConfirmAccount</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_IfNoMatch_RemoveAccount</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Account Confirmed -->
    <bpmn:endEvent id="EndEvent_AccountConfirmed" name="Bank account&#10;confirmed">
      <bpmn:incoming>SequenceFlow_IfMatch_ConfirmAccount</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event: Account Removed -->
    <bpmn:endEvent id="EndEvent_AccountRemoved" name="Bank account&#10;removed">
      <bpmn:incoming>SequenceFlow_IfNoMatch_RemoveAccount</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToEnterDetails" sourceRef="StartEvent_1" targetRef="Task_EnterBankDetails" />
    <bpmn:sequenceFlow id="SequenceFlow_EnterToSubmit" sourceRef="Task_EnterBankDetails" targetRef="IntermediateThrowEvent_SubmitToSystem" />

    <!-- Message Flow to System -->
    <bpmn:messageFlow id="MessageFlow_ToPayPalSystem">
      <bpmn:sourceRef>IntermediateThrowEvent_SubmitToSystem</bpmn:sourceRef>
      <bpmn:targetRef>Task_MakeRandomDeposits</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Sequence Flow from Client to System -->
    <bpmn:sequenceFlow id="SequenceFlow_DepositsToSystem" sourceRef="IntermediateThrowEvent_SubmitToSystem" targetRef="Task_MakeRandomDeposits" />

    <!-- Message Flow for Deposit Info Sent (Client side) -->
    <bpmn:messageFlow id="MessageFlow_SendDepositInfo">
      <bpmn:sourceRef>Task_MakeRandomDeposits</bpmn:sourceRef>
      <bpmn:targetRef>IntermediateCatchEvent_DepositInfoSent</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Sequence Flow to Client Notification -->
    <bpmn:sequenceFlow id="SequenceFlow_SendToClient" sourceRef="Task_MakeRandomDeposits" targetRef="TimerNotification_3to5Days" />

    <!-- Timer Event Processing -->
    <bpmn:sequenceFlow id="SequenceFlow_NotifyToEnterAmounts" name="After 3-5 days&#10;notify client">
      <bpmn:sourceRef>TimerNotification_3to5Days</bpmn:sourceRef>
      <bpmn:targetRef>Task_EnterDepositAmounts</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <!-- Client Verify Click -->
    <bpmn:sequenceFlow id="SequenceFlow_ToVerifyClick" sourceRef="Task_EnterDepositAmounts" targetRef="IntermediateThrowEvent_VerifyClick" />

    <!-- Message Flow to System for Verification Check -->
    <bpmn:messageFlow id="MessageFlow_SendToSystemForCheck">
      <bpmn:sourceRef>IntermediateThrowEvent_VerifyClick</bpmn:sourceRef>
      <bpmn:targetRef>ExclusiveGateway_CheckValuesMatch</bpmn:targetRef>
    </bpmn:messageFlow>

    <!-- Sequence Flow from Client to System for Check -->
    <bpmn:sequenceFlow id="SequenceFlow_ReceiveVerification" sourceRef="IntermediateThrowEvent_VerifyClick" targetRef="ExclusiveGateway_CheckValuesMatch" />

    <!-- Gateway Outgoing Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_IfMatch_ConfirmAccount" name="Yes - Values Match">
      <bpmn:sourceRef>ExclusiveGateway_CheckValuesMatch</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_AccountConfirmed</bpmn:targetRef>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_IfNoMatch_RemoveAccount" name="No - Values Do Not Match">
      <bpmn:sourceRef>ExclusiveGateway_CheckValuesMatch</bpmn:sourceRef>
      <bpmn:targetRef>EndEvent_AccountRemoved</bpmn:targetRef>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>