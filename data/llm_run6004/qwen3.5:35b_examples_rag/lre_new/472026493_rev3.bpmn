<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_2h7k9m3p5q8r6t4w" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0x9y8z7w6v5u4t3s">
    <bpmn:participant name="Hardware Purchase Process" processRef="Process_0a1b2c3d4e5f6g7h"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_0a1b2c3d4e5f6g7h" isExecutable="false">
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_001">
      <bpmn:lane id="Lane_ITDept">
        <bpmn:flowNodeRef>StartEvent_HardwareRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditCompleteRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPriceInquiry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_SupplierOfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MgmtDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareOrderSendSupplier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateEvent_OrderAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResourcesAndAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HardwareReceivedIT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_HardwareRequest" name="Hardware Request Received">
      <bpmn:outgoing>SequenceFlow_RequestReceived</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- IT Department Tasks and Gateway 1 -->
    <bpmn:task id="Task_AnalyzeRequest" name="Analyze Request">
      <bpmn:incoming>SequenceFlow_RequestReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToITGateway</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_ApprovalIT" name="Request Approved?">
      <bpmn:incoming>SequenceFlow_ToITGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeniedByIT</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovedByIT</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Denied Path -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_EndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_EmailDenial" name="Email Employee Denial">
      <bpmn:incoming>SequenceFlow_DeniedByIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDenied</bpmn:outgoing>
    </bpmn:task>

    <!-- Approved Path -->
    <bpmn:task id="Task_EditCompleteRequest" name="Edit and Complete Request">
      <bpmn:incoming>SequenceFlow_ApprovedByIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInquiry</bpmn:outgoing>
    </bpmn:task>

    <!-- Supplier Communication -->
    <bpmn:task id="Task_SendPriceInquiry" name="Send Price Inquiry Email">
      <bpmn:incoming>SequenceFlow_SendInquiry</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitForOffer</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Event for Supplier Offer -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_SupplierOfferReceived" name="Receive Supplier Offer">
      <bpmn:incoming>SequenceFlow_WaitForOffer</bpmn:incoming>
      <bpmn:outgoing>SequenceForm_FillManagementForm</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Management Review -->
    <bpmn:task id="Task_FillMgmtForm" name="Fill Form and Submit to Management">
      <bpmn:incoming>SequenceFlow_FillManagementForm</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MgmtAnalysis</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Management Decision -->
    <bpmn:endEvent id="EndEvent_DeniedByMgmt" name="Process Ended - Denial">
      <bpmn:incoming>SequenceFlow_EndDeniedByMgmt</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="Gateway_MgmtDecision" name="Management Approval?">
      <bpmn:incoming>SequenceFlow_MgmtAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReworkRequired</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DeniedByMgmt</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApprovedByMgmt</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rework Path -->
    <bpmn:task id="Task_ForwardToFinanceIT" name="Forward Offer to Finance &amp; IT">
      <bpmn:incoming>SequenceFlow_ApprovedByMgmt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitForParallel</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="">
      <bpmn:incoming>SequenceFlow_SplitForParallel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinanceResources</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ITOrderPrep</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Finance Path -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_FindResources" name="Find Financial Resources">
      <bpmn:incoming>SequenceFlow_FinanceResources</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResourcesFoundEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Path -->
    <bpmn:intermediateCatchEvent id="IntermediateEvent_ResourcesFound" name="Resources Found">
      <bpmn:incoming>SequenceFlow_ResourcesFoundEvent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeFinanceIT</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Merge Point -->
    <bpmn:parallelGateway id="Gateway_ResourcesAndAcceptance" name="">
      <bpmn:incoming>SequenceFlow_MergeFinanceIT</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HardwareReceived</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Tasks -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_HardwareReceivedIT" name="Hardware Received by IT">
      <bpmn:incoming>SequenceFlow_HardwareReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToInvoiceProcessing</bpmn:outgoing>
    </bpmn:task>

    <!-- Invoice Processing -->
    <bpmn:endEvent id="EndEvent_ProcessCompleted" name="Process Completed">
      <bpmn:incoming>SequenceFlow_FinalEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ProcessInvoice" name="Process Invoice">
      <bpmn:incoming>SequenceFlow_ToInvoiceProcessing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEndEvent</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_RequestReceived" sourceRef="StartEvent_HardwareRequest" targetRef="Task_AnalyzeRequest"/>
  <bpmn:sequenceFlow id="SequenceFlow_ToITGateway" sourceRef="Task_AnalyzeRequest" targetRef="Gateway_ApprovalIT"/>
  <bpmn:sequenceFlow id="SequenceFlow_DeniedByIT" name="Denied" sourceRef="Gateway_ApprovalIT" targetRef="Task_EmailDenial"/>
  <bpmn:sequenceFlow id="SequenceFlow_EndDenied" sourceRef="Task_EmailDenial" targetRef="EndEvent_ProcessCompleted"/>
  <bpmn:sequenceFlow id="SequenceFlow_ApprovedByIT" name="Approved" sourceRef="Gateway_ApprovalIT" targetRef="Task_EditCompleteRequest"/>
  <bpmn:sequenceFlow id="SequenceForm_FillManagementForm" sourceRef="IntermediateEvent_SupplierOfferReceived" targetRef="Task_FillMgmtForm"/>
  <bpmn:sequenceFlow id="SequenceFlow_MgmtAnalysis" sourceRef="Task_FillMgmtForm" targetRef="Gateway_MgmtDecision"/>
  <bpmn:sequenceFlow id="SequenceFlow_DeniedByMgmt" name="Denied by Management" sourceRef="Gateway_MgmtDecision" targetRef="EndEvent_ProcessCompleted"/>
  <bpmn:sequenceFlow id="SequenceFlow_ApprovedByMgmt" name="Approved by Management" sourceRef="Gateway_MgmtDecision" targetRef="Task_ForwardToFinanceIT"/>
  <bpmn:sequenceFlow id="SequenceFlow_SplitForParallel" sourceRef="Task_ForwardToFinanceIT" targetRef="Gateway_ParallelSplit"/>
  <bpmn:sequenceFlow id="SequenceFlow_FinanceResources" name="" sourceRef="Gateway_ParallelSplit" targetRef="Task_FindResources"/>
  <bpmn:sequenceFlow id="SequenceFlow_ITOrderPrep" name="" sourceRef="Gateway_ParallelSplit" targetRef="IntermediateEvent_ResourcesFound"/>
  <bpmn:sequenceFlow id="SequenceForm_FillManagementForm" sourceRef="IntermediateEvent_SupplierOfferReceived" targetRef="Task_FillMgmtForm"/>
  <bpmn:sequenceFlow id="SequenceFlow_SendInquiry" name="" sourceRef="Task_EditCompleteRequest" targetRef="Task_SendPriceInquiry"/>
  <bpmn:sequenceFlow id="SequenceFlow_WaitForOffer" sourceRef="Task_SendPriceInquiry" targetRef="IntermediateEvent_SupplierOfferReceived"/>
  <bpmn:sequenceFlow id="SequenceFlow_ResourcesFoundEvent" name="" sourceRef="Task_FindResources" targetRef="IntermediateEvent_ResourcesFound"/>
  <bpmn:sequenceFlow id="SequenceFlow_MergeFinanceIT" name="" sourceRef="IntermediateEvent_ResourcesFound" targetRef="Gateway_ResourcesAndAcceptance"/>
  <bpmn:sequenceFlow id="SequenceFlow_HardwareReceived" name="" sourceRef="Gateway_ResourcesAndAcceptance" targetRef="Task_HardwareReceivedIT"/>
  <bpmn:sequenceFlow id="SequenceFlow_ToInvoiceProcessing" sourceRef="Task_HardwareReceivedIT" targetRef="Task_ProcessInvoice"/>
  <bpmn:sequenceFlow id="SequenceFlow_FinalEndEvent" name="" sourceRef="Task_ProcessInvoice" targetRef="EndEvent_ProcessCompleted"/>

</bpmn:definitions>