<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_WebDesignProcess">
    <bpmn:participant name="Website Development Process" processRef="Process_WebDesignMain">
      <bpmn:laneSet>
        <bpmn:lane id="Lane_WebDesignTeam">
          <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Gateway_SuccessfulMeeting</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_CreateStoryboard</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Inclusive_Gateway_StoryAgreement</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ParallelGateway_DevContentStart</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_DevelopWebsite</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Inclusive_Gateway_ReviewNeeded</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Task_FinalContentVersion</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>ParallelGateway_BuildStart</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="Lane_MarketingTeam">
          <bpmn:flowNodeRef>Task_ReviewContentDraft</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
    </bpmn:participant>
  </bpmn:collaboration>

  <bpmn:process id="Process_WebDesignMain" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent name="Informational Meeting Started" id="StartEvent_Meeting">
      <bpmn:outgoing>SequenceFlow_StartToMeetingCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Decision: Is meeting successful? -->
    <bpmn:exclusiveGateway name="Is Meeting Successful?" id="Gateway_SuccessfulMeeting">
      <bpmn:incoming>SequenceFlow_StartToMeetingCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeetingFailed_End</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MeetingSuccess_Storyboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for failed meeting -->
    <bpmn:endEvent name="Process Ended" id="EndEvent_ProcessEnded">
      <bpmn:incoming>SequenceFlow_MeetingFailed_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create Storyboard -->
    <bpmn:task name="Create Storyboard" id="Task_CreateStoryboard">
      <bpmn:incoming>SequenceFlow_MeetingSuccess_Storyboard</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StoryboardToAgreementCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Story Agreement -->
    <bpmn:inclusiveGateway name="Story Agreed?" id="Inclusive_Gateway_StoryAgreement">
      <bpmn:incoming>SequenceFlow_StoryboardToAgreementCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AgreementYes_ParallelStart</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Parallel Gateway for simultaneous work -->
    <bpmn:parallelGateway name="Parallel Start" id="ParallelGateway_DevContentStart">
      <bpmn:incoming>SequenceFlow_AgreementYes_ParallelStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevelopmentPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ContentDraftPath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Design and Development of Website -->
    <bpmn:task name="Design &amp; Develop Website" id="Task_DevelopWebsite">
      <bpmn:incoming>SequenceFlow_DevelopmentPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DevToBuildJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Initial Draft of Content -->
    <bpmn:task name="Prepare Initial Content Draft" id="Task_InitialContentDraft">
      <bpmn:incoming>SequenceFlow_ContentDraftPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DraftToReviewCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Review Decision -->
    <bpmn:inclusiveGateway name="Is Content Review Needed?" id="Inclusive_Gateway_ReviewNeeded">
      <bpmn:incoming>SequenceFlow_DraftToReviewCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewYes_Marketing</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviewNo_FinalContent</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Marketing Team Reviews Content -->
    <bpmn:task name="Marketing Review of Draft" id="Task_ReviewContentDraft">
      <bpmn:incoming>SequenceFlow_ReviewYes_Marketing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewDone_ToFinalVersion</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Create Final Version of Content -->
    <bpmn:task name="Create Final Content Version" id="Task_FinalContentVersion">
      <bpmn:incoming>SequenceFlow_ReviewDone_ToFinalVersion</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ReviewNo_FinalContent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContentToBuildJoin</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Build Start -->
    <bpmn:parallelGateway name="Parallel Join" id="ParallelGateway_BuildStart">
      <bpmn:incoming>SequenceFlow_DevToBuildJoin</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ContentToBuildJoin</bpmn:incoming>
    </bpmn:parallelGateway>

    <!-- Task: Build Website and Review -->
    <bpmn:task name="Build &amp; Review Website" id="Task_BuildWebsiteReview">
      <bpmn:incoming>SequenceFlow_BuiltToApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuiltToApprovalCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Approval Decision -->
    <bpmn:exclusiveGateway name="Is Site Approved?" id="Exclusive_Gateway_Approved">
      <bpmn:incoming>SequenceFlow_BuiltToApprovalCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Yes_ProcessComplete</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_No_RebuildLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for successful completion -->
    <bpmn:endEvent name="Process Completed" id="EndEvent_ProcessComplete">
      <bpmn:incoming>SequenceFlow_Yes_ProcessComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow sourceRef="StartEvent_Meeting" targetRef="Gateway_SuccessfulMeeting" id="SequenceFlow_StartToMeetingCheck"/>
    
    <bpmn:sequenceFlow name="No - Meeting Failed" sourceRef="Gateway_SuccessfulMeeting" targetRef="EndEvent_ProcessEnded" id="SequenceFlow_MeetingFailed_End"/>
    
    <bpmn:sequenceFlow name="Yes - Continue Process" sourceRef="Gateway_SuccessfulMeeting" targetRef="Task_CreateStoryboard" id="SequenceFlow_MeetingSuccess_Storyboard"/>
    
    <bpmn:sequenceFlow sourceRef="Task_CreateStoryboard" targetRef="Inclusive_Gateway_StoryAgreement" id="SequenceFlow_StoryboardToAgreementCheck"/>
    
    <bpmn:sequenceFlow name="Yes - Agreement Reached" sourceRef="Inclusive_Gateway_StoryAgreement" targetRef="ParallelGateway_DevContentStart" id="SequenceFlow_AgreementYes_ParallelStart"/>
    
    <bpmn:sequenceFlow sourceRef="ParallelGateway_DevContentStart" targetRef="Task_DevelopWebsite" id="SequenceFlow_DevelopmentPath"/>
    
    <bpmn:sequenceFlow sourceRef="ParallelGateway_DevContentStart" targetRef="Task_InitialContentDraft" id="SequenceFlow_ContentDraftPath"/>
    
    <bpmn:sequenceFlow sourceRef="Task_DevelopWebsite" targetRef="ParallelGateway_BuildStart" id="SequenceFlow_DevToBuildJoin"/>
    
    <bpmn:sequenceFlow sourceRef="Task_InitialContentDraft" targetRef="Inclusive_Gateway_ReviewNeeded" id="SequenceFlow_DraftToReviewCheck"/>
    
    <bpmn:sequenceFlow name="Yes - Review Needed" sourceRef="Inclusive_Gateway_ReviewNeeded" targetRef="Task_ReviewContentDraft" id="SequenceFlow_ReviewYes_Marketing"/>
    
    <bpmn:sequenceFlow name="No - Skip Review" sourceRef="Inclusive_Gateway_ReviewNeeded" targetRef="Task_FinalContentVersion" id="SequenceFlow_ReviewNo_FinalContent"/>
    
    <bpmn:sequenceFlow sourceRef="Task_ReviewContentDraft" targetRef="Task_FinalContentVersion" id="SequenceFlow_ReviewDone_ToFinalVersion"/>
    
    <bpmn:sequenceFlow sourceRef="ParallelGateway_BuildStart" targetRef="Task_BuildWebsiteReview" id="SequenceFlow_BuiltToApprovalCheck"/>
    
    <bpmn:sequenceFlow name="Yes - Approved" sourceRef="Exclusive_Gateway_Approved" targetRef="EndEvent_ProcessComplete" id="SequenceFlow_Yes_ProcessComplete"/>
    
    <bpmn:sequenceFlow name="No - Rebuild Required" sourceRef="Exclusive_Gateway_Approved" targetRef="Task_BuildWebsiteReview" id="SequenceFlow_No_RebuildLoop"/>

  </bpmn:process>
</bpmn:definitions>