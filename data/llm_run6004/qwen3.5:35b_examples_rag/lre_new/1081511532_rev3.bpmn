<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_0a9j6w5v4h3k2l7x" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:collaboration id="Collab_0v7x8w9z6q1p0r4m">
    <bpmn:participant name="Client Acquisition Process" processRef="Process_0c5t3y2l8k6j4h9f" />
  </bpmn:collaboration>

  <bpmn:process id="Process_0c5t3y2l8k6j4h9f" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Management" name="Management">
        <bpmn:flowNodeRef>StartEvent_NewClientsNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDetailedOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ClientAcceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ContractSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AnalyzeFailureReasons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OfferRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
        <bpmn:flowNodeRef>Task_AnalysisPresentation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RespondToManagement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_NewClientsNeeded" name="New Clients Needed Indication">
      <bpmn:outgoing>SequenceFlow_StartToAnalysis</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Marketing Tasks -->
    <bpmn:task id="Task_AnalysisPresentation" name="Market Analysis &amp; Presentation Prep">
      <bpmn:incoming>SequenceFlow_StartToAnalysis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToSendOffers</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendOffers" name="Send Offers to Potential Clients">
      <bpmn:incoming>SequenceFlow_AnalysisToSendOffers</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendsToInformMgmt</bpmn:outgoing>
    </bpmn:task>

    <!-- Handover Task -->
    <bpmn:task id="Task_RespondToManagement" name="Inform Management of Responses">
      <bpmn:incoming>SequenceFlow_SendsToInformMgmt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformToNegotiation</bpmn:outgoing>
    </bpmn:task>

    <!-- Management Tasks & Gateway -->
    <bpmn:exclusiveGateway id="Gateway_ClientAcceptance" name="Client Accepts Offer?">
      <bpmn:incoming>SequenceFlow_NegotiateToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AcceptedPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Negotiation Start -->
    <bpmn:task id="Task_SendDetailedOffer" name="Send Detailed Offer (Negotiations)">
      <bpmn:incoming>SequenceFlow_InformToNegotiation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NegotiateToGateway</bpmn:outgoing>
    </bpmn:task>

    <!-- Path A: Accepted -->
    <bpmn:sequenceFlow id="SequenceFlow_AcceptedPath" sourceRef="Gateway_ClientAcceptance" targetRef="Task_PrepareContract">
      <bpmn:text>Yes</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_PrepareContract" name="Prepare Contract">
      <bpmn:incoming>SequenceFlow_AcceptedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContractToSign</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SignContract" name="Sign Contract">
      <bpmn:incoming>SequenceFlow_ContractToSign</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SignedToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Rejected -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectedPath" sourceRef="Gateway_ClientAcceptance" targetRef="Task_AnalyzeFailureReasons">
      <bpmn:text>No</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_AnalyzeFailureReasons" name="Analyze Failure Reasons">
      <bpmn:incoming>SequenceFlow_RejectedPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AnalysisToEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_ContractSigned" name="Contract Signed">
      <bpmn:incoming>SequenceFlow_SignedToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_OfferRejected" name="Offer Rejected &amp; Analyzed">
      <bpmn:incoming>SequenceFlow_AnalysisToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToAnalysis" sourceRef="StartEvent_NewClientsNeeded" targetRef="Task_AnalysisPresentation">
      <bpmn:text>New Clients Needed</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToSendOffers" sourceRef="Task_AnalysisPresentation" targetRef="Task_SendOffers">
      <bpmn:text>Analysis Complete</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_SendsToInformMgmt" sourceRef="Task_SendOffers" targetRef="Task_RespondToManagement">
      <bpmn:text>Offers Sent</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_InformToNegotiation" name="Responses Received" sourceRef="Task_RespondToManagement" targetRef="Task_SendDetailedOffer">
      <bpmn:text>Informs Management</bpmn:text>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NegotiateToGateway" name="Negotiation Started" sourceRef="Task_SendDetailedOffer" targetRef="Gateway_ClientAcceptance">
      <bpmn:text>Negotiated</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Path A to End -->
    <bpmn:sequenceFlow id="SequenceFlow_ContractToSign" sourceRef="Task_PrepareContract" targetRef="Task_SignContract">
      <bpmn:text>Prepare</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Path A to End -->
    <bpmn:sequenceFlow id="SequenceFlow_SignedToEnd" sourceRef="Task_SignContract" targetRef="EndEvent_ContractSigned">
      <bpmn:text>Signed</bpmn:text>
    </bpmn:sequenceFlow>

    <!-- Path B to End -->
    <bpmn:sequenceFlow id="SequenceFlow_AnalysisToEnd" sourceRef="Task_AnalyzeFailureReasons" targetRef="EndEvent_OfferRejected">
      <bpmn:text>Analyzed</bpmn:text>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>