<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_3k8m9xq" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_7p2w6tj">
    <bpmn:messageFlow id="MessageFlow_4h9r3nk"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_8v5k1mz" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_2x7q9w3" name="Change Request Triggered">
      <bpmn:outgoing>SequenceFlow_6m4k8p1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task - Review Change Request -->
    <bpmn:task id="Task_5w3j7q2" name="Review Change Request">
      <bpmn:incoming>SequenceFlow_6m4k8p1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9h2v5t8</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Reject or Confirm -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1k6p4m7" name="Confirm Request?">
      <bpmn:incoming>SequenceFlow_9h2v5t8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3r8w6j5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7q1m4k9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Reject Change -->
    <bpmn:endEvent id="EndEvent_0p5t8w3" name="Change Rejected">
      <bpmn:incoming>SequenceFlow_7q1m4k9</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Perform Measuring Point Change -->
    <bpmn:task id="Task_2h8v6j3" name="Perform Measuring Point Change">
      <bpmn:incoming>SequenceFlow_3r8w6j5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4k9m1p7</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway - Success or Failure -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_6j3w8q2" name="Change Successful?">
      <bpmn:incoming>SequenceFlow_4k9m1p7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5t2h9v4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_8w6j3q1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task - Report Implementation -->
    <bpmn:endEvent id="EndEvent_4m7k2p9" name="Implementation Reported">
      <bpmn:incoming>SequenceFlow_5t2h9v4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task - Notify Failure -->
    <bpmn:endEvent id="EndEvent_1q8w6j3" name="Failure Notified">
      <bpmn:incoming>SequenceFlow_8w6j3q1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_6m4k8p1" sourceRef="StartEvent_2x7q9w3" targetRef="Task_5w3j7q2"/>
    
    <!-- Review to Decision Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_9h2v5t8" sourceRef="Task_5w3j7q2" targetRef="ExclusiveGateway_1k6p4m7"/>

    <!-- Confirm Path (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_3r8w6j5" name="Confirm" sourceRef="ExclusiveGateway_1k6p4m7" targetRef="Task_2h8v6j3"/>

    <!-- Reject Path (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_7q1m4k9" name="Reject" sourceRef="ExclusiveGateway_1k6p4m7" targetRef="EndEvent_0p5t8w3"/>

    <!-- Change to Success/Failure Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_4k9m1p7" sourceRef="Task_2h8v6j3" targetRef="ExclusiveGateway_6j3w8q2"/>

    <!-- Successful Implementation Path (Yes) -->
    <bpmn:sequenceFlow id="SequenceFlow_5t2h9v4" name="Success" sourceRef="ExclusiveGateway_6j3w8q2" targetRef="EndEvent_4m7k2p9"/>

    <!-- Failure Notification Path (No) -->
    <bpmn:sequenceFlow id="SequenceFlow_8w6j3q1" name="Failure" sourceRef="ExclusiveGateway_6j3w8q2" targetRef="EndEvent_1q8w6j3"/>

  </bpmn:process>

</bpmn:definitions>