<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_MSPO"/>
    <bpmn:messageFlow id="MessageFlow_MPO"/>
    <bpmn:messageFlow id="MessageFlow_SP"/>
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Pool_MSPN"/>
    <bpmn:participant id="Participant_GO" name="GO" processRef="Pool_GO"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Pool_MSPO"/>
    <bpmn:participant id="Participant_MPO" name="MPO" processRef="Pool_MPO"/>
    <bpmn:participant id="Participant_SP" name="SP" processRef="Pool_SP"/>
  </bpmn:collaboration>

  <!-- MSPN Process -->
  <bpmn:process id="Pool_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_0">
      <bpmn:name>MSPN Registration</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MSPN_Register" name="Register measurement at GO">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneEvent_MSPN">
      <bpmn:name>MSPN Registration Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartNoneEvent_0" targetRef="Task_MSPN_Register"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MSPN_Register" targetRef="EndNoneEvent_MSPN"/>

  </bpmn:process>

  <!-- GO Process -->
  <bpmn:process id="Pool_GO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_0">
      <bpmn:name>MSPN Application Received</bpmn:name>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GO_Examine" name="Examine MSPN application">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Application Approved?">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection Path -->
    <bpmn:endEvent id="EndNoneEvent_Reject">
      <bpmn:name>Application Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Confirmation Path -->
    <bpmn:task id="Task_GO_Assign" name="Assign MSPN">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform MSPO -->
    <bpmn:intermediateThrowEvent id="IntermediateMessageEvent_MSPO">
      <bpmn:name>Inform MSPO about assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Inform MPO -->
    <bpmn:task id="Task_GO_InformMPO" name="Inform MPO about assignment">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- Inform SP -->
    <bpmn:intermediateThrowEvent id="IntermediateMessageEvent_SP">
      <bpmn:name>Inform SP about assignment</bpmn:name>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- End Event -->
    <bpmn:endEvent id="EndNoneEvent_Complete">
      <bpmn:name>MSPN Assignment Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="StartMessageEvent_0" targetRef="Task_GO_Examine"/>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="" sourceRef="Task_GO_Examine" targetRef="ExclusiveGateway_Decision"/>

    <!-- Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Yes - Confirm" sourceRef="ExclusiveGateway_Decision" targetRef="Task_GO_Assign"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" name="No - Reject" sourceRef="ExclusiveGateway_Decision" targetRef="EndNoneEvent_Reject"/>

    <!-- Confirmation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_7" sourceRef="Task_GO_Assign" targetRef="IntermediateMessageEvent_MSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="IntermediateMessageEvent_MSPO" targetRef="Task_GO_InformMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_9" name="" sourceRef="Task_GO_InformMPO" targetRef="IntermediateMessageEvent_SP"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" name="" sourceRef="IntermediateMessageEvent_SP" targetRef="EndNoneEvent_Complete"/>

  </bpmn:process>

</bpmn:definitions>