<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:collaboration id="Collaboration_OfficeSupply">
    <bpmn:participant id="Participant_OfficeSupply" name="Office Supply Request Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OfficeSupplyRequest" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Employee" name="Employee (Petitioner)">
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewChanges</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Supervisor">
        <bpmn:flowNodeRef>StartEvent_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterRequirement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Purchase" name="Purchase Department">
        <bpmn:flowNodeRef>SubProcess_Procurement</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Submit" name="Submit Request">
      <bpmn:name>Employee Submits</bpmn:name>
      <bpmn:outgoing>SequenceFlow_01Register</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Registration Task -->
    <bpmn:task id="Task_RegisterRequirement" name="Register Requirement">
      <bpmn:name>Register &amp; Receive Request</bpmn:name>
      <bpmn:incoming>SequenceFlow_01Register</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:task>

    <!-- Decision Gateway (Supervisor) -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Decision">
      <bpmn:name>Approve / Change / Reject</bpmn:name>
      <bpmn:incoming>SequenceFlow_02Review</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:exclusiveGateway>

    <!-- Rejection Path -->
    <bpmn:task id="Task_NotifyReject" name="Notify User of Rejection">
      <bpmn:name>Send Notification (Rejected)</bpmn:name>
      <bpmn:incoming>SequenceFlow_03Reject</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Rejected" name="Request Rejected">
      <bpmn:name>Process Ended (Rejected)</bpmn:name>
      <bpmn:incoming>SequenceFlow_04RejectNotify</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <!-- Change Required Path -->
    <bpmn:task id="Task_NotifyChange" name="Notify Employee of Changes">
      <bpmn:name>Send Notification (Changes)</bpmn:name>
      <bpmn:incoming>SequenceFlow_05Change</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Completed" name="Request Completed">
      <bpmn:name>Process Ended (Completed)</bpmn:name>
      <bpmn:incoming>SequenceFlow_09FinalNotify</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <!-- Subprocess for Procurement -->
    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Subproc" name="Subprocess End">
      <bpmn:name>Procurement Done</bpmn:name>
      <bpmn:incoming>SequenceFlow_08WaitDone</bpmn:outgoing/> <!-- Typo fix below -->
    </bpmn:endEvent>

    <bpmn:startEvent id="StartEvent_Subproc" name="Procurement Start">
      <bpmn:name>Subprocess Entry</bpmn:name>
      <bpmn:incoming>SequenceFlow_06Procure</bpmn:outgoing/> <!-- Typo fix below -->
