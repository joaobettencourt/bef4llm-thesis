<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_IPO_001">
  <bpmn:collaboration id="Collab_IPO_001">
    <bpmn:participant id="Participant_IPO_Process" name="IPO Underwriting Process"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_IPO_Main" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Decision_Public">
      <bpmn:name>Decision to Go Public</bpmn:name>
      <bpmn:outgoing>Sequence_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_Select_Underwriters" name="Select Underwriters">
      <bpmn:incoming>Sequence_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>Sequence_FairnessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 - Fairness Check -->
    <bpmn:exclusiveGateway id="Gateway_FactsFairly" name="Facts Presented Fairly?">
      <bpmn:incoming>Sequence_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_ProceedIPO</bpmn:outgoing>
      <bpmn:outgoing>Sequence_RejectIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 (Rejection) -->
    <bpmn:endEvent id="End_Rejected">
      <bpmn:name>Process Stopped / Underwriter Declines</bpmn:name>
      <bpmn:incoming>Sequence_RejectIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 2 (Parallel Split) -->
    <bpmn:parallelGateway id="Gateway_ParallelStart" name="SEC & Compliance Process">
      <bpmn:incoming>Sequence_ProceedIPO</bpmn:incoming>
      <bpmn:outgoing>Sequence_PrepareReg</bpmn:outgoing>
      <bpmn:outgoing>Sequence_BlueSkyCheck</bpmn:outgoing>
      <bpmn:outgoing>Sequence_RoadShow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 2 (SEC) -->
    <bpmn:task id="Task_PrepareReg" name="Prepare Registration Statement">
      <bpmn:incoming>Sequence_PrepareReg</bpmn:incoming>
      <bpmn:outgoing>Sequence_SubmitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event (Submit) -->
    <bpmn:intermediateThrowEvent id="Event_SubmitSEC" name="Submit to SEC">
      <bpmn:incoming>Sequence_SubmitSEC</bpmn:incoming>
      <bpmn:outgoing>Sequence_WaitClearance</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <!-- Intermediate Catch Event (Wait) -->
    <bpmn:intermediateCatchEvent id="Event_ReceiveSEC" name="Receive SEC Clearance">
      <bpmn:incoming>Sequence_WaitClearance</bpmn:incoming>
      <bpmn:outgoing>Sequence_FixPriceFlow</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 (Laws) -->
    <bpmn:task id="Task_BlueSkyCheck" name="Check Blue-Sky Laws Compliance">
      <bpmn:incoming>Sequence_BlueSkyCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_LawDoneFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4 (Roadshow) -->
    <bpmn:task id="Task_RoadShow" name="Arrange Road Show">
      <bpmn:incoming>Sequence_RoadShow</bpmn:incoming>
      <bpmn:outgoing>Sequence_RoadDoneFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3 (Parallel Join) -->
    <bpmn:parallelGateway id="Gateway_MergeAll" name="Wait for All Checks">
      <bpmn:incoming>Sequence_FixPriceFlow</bpmn:incoming>
      <bpmn:incoming>Sequence_LawDoneFlow</bpmn:incoming>
      <bpmn:incoming>Sequence_RoadDoneFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5 (Price) -->
    <bpmn:task id="Task_FixIssuePrice" name="Fix Issue Price">
      <bpmn:incoming>Sequence_MergeAllOut</bpmn:incoming>
      <bpmn:outgoing>Sequence_FinalCheckFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 4 (Final Check) -->
    <bpmn:exclusiveGateway id="Gateway_NoReasonNotTo" name="Found Reason Not To Proceed?">
      <bpmn:incoming>Sequence_FinalCheckFlow</bpmn:incoming>
      <bpmn:outgoing>Sequence_OfferPublicYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 (Withdrawal) -->
    <bpmn:endEvent id="End_Withdraw">
      <bpmn:name>IPO Withdrawn / Stopped</bpmn:name>
      <bpmn:incoming>Sequence_FinalCheckNo</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 6 (Offer) -->
    <bpmn:task id="Task_OfferPublic" name="Enter Firm Commitment & Offer Stock">
      <bpmn:incoming>Sequence_OfferPublicYes</bpmn:incoming>
      <bpmn:outgoing>Sequence_CompletedIPO</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 (Success) -->
    <bpmn:endEvent id="End_Success">
      <bpmn:name>IPO Completed Successfully</bpmn:name>
      <bpmn:incoming>Sequence_CompletedIPO</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Sequence_SelectUnderwriters" sourceRef="Start_Decision_Public" targetRef="Task_Select_Underwriters"/>
    
    <bpmn:exclusiveGateway id="Gateway_FairnessCheckNo">
      <bpmn:incoming>Sequence_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>Sequence_RejectIPO</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Corrected Gateway 1 -->
    <bpmn:sequenceFlow id="Sequence_FairnessCheck" sourceRef="Task_Select_Underwriters" targetRef="Gateway_FactsFairly"/>
    
    <bpmn:sequenceFlow id="Sequence_ProceedIPO" name="Yes - Proceed with IPO" sourceRef="Gateway_FactsFairly" targetRef="Gateway_ParallelStart"/>
    
    <bpmn:sequenceFlow id="Sequence_RejectIPO" name="No - Reject Issue" sourceRef="Gateway_FactsFairly" targetRef="End_Rejected"/>

    <!-- Parallel Path Flows -->
    <bpmn:sequenceFlow id="Sequence_PrepareReg" sourceRef="Gateway_ParallelStart" targetRef="Task_PrepareReg"/>
    
    <bpmn:sequenceFlow id="Sequence_SubmitSEC" name="" sourceRef="Task_PrepareReg" targetRef="Event_SubmitSEC"/>
    
    <bpmn:sequenceFlow id="Sequence_WaitClearance" name="" sourceRef="Event_SubmitSEC" targetRef="Gateway_ParallelStart"/>

    <!-- Blue Sky Laws Path -->
    <bpmn:sequenceFlow id="Sequence_BlueSkyCheck" sourceRef="Gateway_ParallelStart" targetRef="Task_BlueSkyCheck"/>
    
    <bpmn:sequenceFlow id="Sequence_LawDoneFlow" name="" sourceRef="Task_BlueSkyCheck" targetRef="Gateway_MergeAll"/>

    <!-- Road Show Path -->
    <bpmn:sequenceFlow id="Sequence_RoadShow" sourceRef="Gateway_ParallelStart" targetRef="Task_RoadShow"/>
    
    <bpmn:sequenceFlow id="Sequence_RoadDoneFlow" name="" sourceRef="Task_RoadShow" targetRef="Gateway_MergeAll"/>

    <!-- Merge and Price Fix -->
    <bpmn:parallelGateway id="Gateway_PriceFixStart">
      <bpmn:incoming>Sequence_WaitClearance</bpmn:incoming>
      <bpmn:outgoing>Sequence_FixPriceFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="Sequence_MergeAllOut" sourceRef="Gateway_MergeAll" targetRef="Task_FixIssuePrice"/>
    
    <bpmn:sequenceFlow id="Sequence_FinalCheckFlow" name="" sourceRef="Task_FixIssuePrice" targetRef="Gateway_NoReasonNotTo"/>

    <!-- Final Check -->
    <bpmn:exclusiveGateway id="Gateway_Withdrawal">
      <bpmn:incoming>Sequence_FinalCheckNo</bpmn:outgoing/>
      <bpmn:outgoing>Sequence_OfferPublicYes</bpmn:outgoing/>
    </bpmn:exclusiveGateway>

    <!-- Final Check Flow -->
    <bpmn:sequenceFlow id="Sequence_FinalCheckNo" name="Reason Found - Stop IPO" sourceRef="Gateway_NoReasonNotTo" targetRef="End_Withdraw"/>
    
    <bpmn:sequenceFlow id="Sequence_OfferPublicYes" name="No Reason to Stop" sourceRef="Gateway_NoReasonNotTo" targetRef="Task_OfferPublic"/>

    <!-- Completion -->
    <bpmn:sequenceFlow id="Sequence_CompletedIPO" name="" sourceRef="Task_OfferPublic" targetRef="End_Success"/>

  </bpmn:process>
</bpmn:definitions>