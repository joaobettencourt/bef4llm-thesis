<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Computer Repair Service" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Customer brings defective computer">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- CRS checks defect and calculates cost -->
    <bpmn:task id="Task_CheckDefect" name="Check Defect &amp; Calculate Repair Cost">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CostDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway - Is cost acceptable? -->
    <bpmn:exclusiveGateway id="Gateway_CostAcceptable" name="Cost Acceptable?">
      <bpmn:incoming>SequenceFlow_CostDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_No</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- No path - Customer takes computer home -->
    <bpmn:endEvent id="EndEvent_TakeHome" name="Computer taken home unrepaired">
      <bpmn:incoming>SequenceFlow_No</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Yes path - Continue with repair -->
    <bpmn:startEvent id="StartEvent_Repair" name="Repair Process Start">
      <bpmn:outgoing>SequenceFlow_Yes</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Gateway for two activities in arbitrary order -->
    <bpmn:parallelGateway id="Parallel_Gateway_Start">
      <bpmn:incoming>SequenceFlow_Yes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HardwarePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SoftwarePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Hardware Repair Path -->
    <bpmn:task id="Task_RepairHardware" name="Check &amp; Repair Hardware">
      <bpmn:incoming>SequenceFlow_HardwarePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestAfterHardware</bpmn:outgoing>
    </bpmn:task>

    <!-- Software Configuration Path -->
    <bpmn:task id="Task_ConfigSoftware" name="Check &amp; Configure Software">
      <bpmn:incoming>SequenceFlow_SoftwarePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TestAfterSoftware</bpmn:outgoing>
    </bpmn:task>

    <!-- Test After Hardware -->
    <bpmn:exclusiveGateway id="Gateway_HardwareTest" name="Hardware Functional?">
      <bpmn:incoming>SequenceFlow_TestAfterHardware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_HardwareOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_HardwareError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Test After Software -->
    <bpmn:exclusiveGateway id="Gateway_SoftwareTest" name="Software Functional?">
      <bpmn:incoming>SequenceFlow_TestAfterSoftware</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SoftwareOK</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SoftwareError</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Error handling - Additional repair activity -->
    <bpmn:task id="Task_AdditionalRepair" name="Execute Additional Repair Activity">
      <bpmn:incoming>SequenceFlow_HardwareError</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RetryHardware</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Gateway for test results -->
    <bpmn:parallelGateway id="Parallel_Gateway_Merge">
      <bpmn:incoming>SequenceFlow_HardwareOK</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_SoftwareOK</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Finished</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="Repair Completed Successfully">
      <bpmn:incoming>SequenceFlow_Finished</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_CheckDefect"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CostDecision" name="" sourceRef="Task_CheckDefect" targetRef="Gateway_CostAcceptable"/>
    
    <!-- Cost Decision Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_No" name="No - Not Acceptable" sourceRef="Gateway_CostAcceptable" targetRef="EndEvent_TakeHome"/>
    <bpmn:sequenceFlow id="SequenceFlow_Yes" name="Yes - Continue Repair" sourceRef="Gateway_CostAcceptable" targetRef="Parallel_Gateway_Start"/>

    <!-- Parallel Paths for repair activities -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwarePath" sourceRef="Parallel_Gateway_Start" targetRef="Task_RepairHardware"/>
    <bpmn:sequenceFlow id="SequenceFlow_SoftwarePath" sourceRef="Parallel_Gateway_Start" targetRef="Task_ConfigSoftware"/>

    <!-- Test paths -->
    <bpmn:sequenceFlow id="SequenceFlow_TestAfterHardware" name="" sourceRef="Task_RepairHardware" targetRef="Gateway_HardwareTest"/>
    <bpmn:sequenceFlow id="SequenceFlow_TestAfterSoftware" name="" sourceRef="Task_ConfigSoftware" targetRef="Gateway_SoftwareTest"/>

    <!-- Test Results - OK paths -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwareOK" name="Yes, Functional" sourceRef="Gateway_HardwareTest" targetRef="Parallel_Gateway_Merge"/>
    <bpmn:sequenceFlow id="SequenceFlow_SoftwareOK" name="Yes, Functional" sourceRef="Gateway_SoftwareTest" targetRef="Parallel_Gateway_Merge"/>

    <!-- Test Results - Error paths (loop back for additional repair) -->
    <bpmn:sequenceFlow id="SequenceFlow_HardwareError" name="No, Error Detected" sourceRef="Gateway_HardwareTest" targetRef="Task_AdditionalRepair"/>
    <bpmn:sequenceFlow id="SequenceFlow_SoftwareError" name="No, Error Detected" sourceRef="Gateway_SoftwareTest" targetRef="Task_AdditionalRepair"/>

    <!-- Loop back from additional repair to appropriate test -->
    <bpmn:sequenceFlow id="SequenceFlow_RetryHardware" name="" sourceRef="Task_AdditionalRepair" targetRef="Parallel_Gateway_Start"/>

    <!-- Final completion path -->
    <bpmn:sequenceFlow id="SequenceFlow_Finished" sourceRef="Parallel_Gateway_Merge" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>