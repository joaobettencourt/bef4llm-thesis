<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_Dismissal" sourceRef="IntermediateThrowEvent_MSPN" targetRef="StartCatchEvent_MSPO"/>
    <bpmn:participant id="Participant_MSPN" name="MSPN" processRef="Process_MSPN"/>
    <bpmn:participant id="Participant_MSPO" name="MSPO" processRef="Process_MSPO"/>
  </bpmn:collaboration>

  <bpmn:message id="Message_Dismissal">Dismissal</bpmn:message>

  <bpmn:process id="Process_MSPN" isExecutable="false">
    <bpmn:startEvent id="StartNone_MSPN">
      <bpmn:name>Dismissal Initiated</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Send_Dismissal" name="Send Dismissal">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNone_MSPN">
      <bpmn:name>Dismissal Sent</bpmn:name>
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_MSPN">
      <bpmn:messageRef="Message_Dismissal"/>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartNone_MSPN" targetRef="Task_Send_Dismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_Send_Dismissal" targetRef="IntermediateThrowEvent_MSPN"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateThrowEvent_MSPN" targetRef="EndNone_MSPN"/>

  </bpmn:process>

  <bpmn:message id="Message_Confirmation">Confirmation Response</bpmn:message>

  <bpmn:process id="Process_MSPO" isExecutable="false">
    <bpmn:startEvent id="StartCatchEvent_MSPO">
      <bpmn:name>Receive Dismissal</bpmn:name>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Review_Dismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndReject_MSPO">
      <bpmn:name>Dismissal Rejected</bpmn:name>
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndConfirm_MSPO">
      <bpmn:name>Dismissal Confirmed</bpmn:name>
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Decision">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Reject_Dismissal" name="Reject Dismissal">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Confirm_Dismissal" name="Confirm Dismissal">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startEvent id="StartNone_MSPO">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndConfirm_MSPO_Final">
      <bpmn:name>Dismissal Processed</bpmn:name>
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Message flow for confirmation response -->
    <bpmn:message id="Message_Confirmation">Confirmation Response</bpmn:message>

  </bpmn:process>

  <bpmn:collaboration id="Collaboration_2">
    <bpmn:messageFlow id="MessageFlow_Response" sourceRef="Task_Confirm_Dismissal" targetRef="IntermediateCatchEvent_MSPN"/>
  </bpmn:collaboration>

</bpmn:definitions>