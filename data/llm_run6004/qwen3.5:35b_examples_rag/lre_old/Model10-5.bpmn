<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Task_MPON_RequestBid" targetRef="StartEvent_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="IntermediateThrowEvent_TenderSent" targetRef="CatchEvent_MPONReceiveTender"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_MPON_PlaceOrder" targetRef="StartEvent_MPOO_OrderReceived"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="IntermediateThrowEvent_ConfirmationSent" targetRef="CatchEvent_MPONReceiveConfirmation"/>
  </bpmn:collaboration>

  <!-- MPON Participant -->
  <bpmn:process id="Process_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_MPON">
      <bpmn:name>Device Takeover Request</bpmn:name>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_MPON_RequestBid" name="Request Device Takeover Bid">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_MPONReceiveTender">
      <bpmn:name>Tender Received</bpmn:name>
      <bpmn:messageRef="Message_Tender"/>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_MPON_PlaceOrder" name="Place Order at MPOO">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="CatchEvent_MPONReceiveConfirmation">
      <bpmn:name>Order Confirmation Received</bpmn:name>
      <bpmn:messageRef="Message_Confirmation"/>
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="EndNoneEvent_MPON">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPON_1" sourceRef="StartNoneEvent_MPON" targetRef="Task_MPON_RequestBid"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_2" name="" sourceRef="Task_MPON_RequestBid" targetRef="CatchEvent_MPONReceiveTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_3" name="" sourceRef="CatchEvent_MPONReceiveTender" targetRef="Task_MPON_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_4" name="" sourceRef="Task_MPON_PlaceOrder" targetRef="CatchEvent_MPONReceiveConfirmation"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_5" name="" sourceRef="CatchEvent_MPONReceiveConfirmation" targetRef="EndNoneEvent_MPON"/>

  </bpmn:process>

  <!-- MPOO Participant -->
  <bpmn:process id="Process_MPOO" isExecutable="false">
    <bpmn:startMessageEvent id="StartEvent_MPOO">
      <bpmn:name>Tender Request Received</bpmn:name>
      <bpmn:messageRef="Message_RequestBid"/>
      <bpmn:outgoing>SequenceFlow_MPOO_1</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <bpmn:task id="Task_MPOO_SendTender" name="Send Tender for Equipment Takeover">
      <bpmn:incoming>SequenceFlow_MPOO_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:startMessageEvent id="StartEvent_MPOO_OrderReceived">
      <bpmn:name>Order Received</bpmn:name>
      <bpmn:messageRef="Message_PlaceOrder"/>
      <bpmn:outgoing>SequenceFlow_MPOO_3</bpmn:outgoing>
    </bpmn:startMessageEvent>

    <bpmn:task id="Task_MPOO_ConfirmOrder" name="Confirm Order and Send Master Data">
      <bpmn:incoming>SequenceFlow_MPOO_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPOO_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndNoneEvent_MPOO">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_MPOO_5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Intermediate Throw Events for Message Flows -->
    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_TenderSent">
      <bpmn:name>Tender Sent</bpmn:name>
      <bpmn:messageRef="Message_Tender"/>
      <bpmn:incoming>SequenceFlow_MPOO_2</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <bpmn:intermediateThrowEvent id="IntermediateThrowEvent_ConfirmationSent">
      <bpmn:name>Confirmation Sent</bpmn:name>
      <bpmn:messageRef="Message_Confirmation"/>
      <bpmn:incoming>SequenceFlow_MPOO_4</bpmn:incoming>
    </bpmn:intermediateThrowEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_1" sourceRef="StartEvent_MPOO" targetRef="Task_MPOO_SendTender"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_2" name="" sourceRef="Task_MPOO_SendTender" targetRef="IntermediateThrowEvent_TenderSent"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_3" sourceRef="StartEvent_MPOO_OrderReceived" targetRef="Task_MPOO_ConfirmOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_4" name="" sourceRef="Task_MPOO_ConfirmOrder" targetRef="IntermediateThrowEvent_ConfirmationSent"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPOO_5" name="" sourceRef="IntermediateThrowEvent_ConfirmationSent" targetRef="EndNoneEvent_MPOO"/>

  </bpmn:process>

</bpmn:definitions>