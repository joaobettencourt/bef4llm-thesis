<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_3k8m9xq" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_7j2w6p4">
    <bpmn:messageFlow id="MessageFlow_1r8v5tq"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_9m3k7xq" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1p8w5tq" name="Client Service Back Office (Small Claims Registry Operations)">
        <bpmn:flowNodeRef>StartEvent_0k7m3xq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_2r9v6w4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1t8p5wq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_0v6r4tq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3m7k9xq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1k9m7xq</bpmn:flowNodeRef>
      </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_0k7m3xq" name="Warrant Possession Request Received">
      <bpmn:outgoing>SequenceFlow_1w8p5tq</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Retrieve SCTT File -->
    <bpmn:task id="Task_2r9v6w4" name="Retrieve SCTT file">
      <bpmn:incoming>SequenceFlow_1w8p5tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3m7k9xq</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for decision point -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1t8p5wq" name="SCTT File Available?">
      <bpmn:incoming>SequenceFlow_3m7k9xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4v6r2mq</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Forward to Queensland Police -->
    <bpmn:task id="Task_3m7k9xq" name="Forward SCT Warrant Possession">
      <bpmn:incoming>SequenceFlow_4v6r2mq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5w8p1tq</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for Police Report -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_0v6r4tq" name="Awaiting Police Report">
      <bpmn:incoming>SequenceFlow_5w8p1tq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7k9m2xq</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3: Receive Report and Retrieve SCT File -->
    <bpmn:task id="Task_5w8p2mq" name="Receive report, retrieve SCT file">
      <bpmn:incoming>SequenceFlow_7k9m2xq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6r4t1pq</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Attach New SCT Document and Store -->
    <bpmn:task id="Task_7k9m2xq" name="Attach new SCT document, store expanded physical file">
      <bpmn:incoming>SequenceFlow_6r4t1pq</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8p5w3mq</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1k9m7xq" name="Process Complete">
      <bpmn:incoming>SequenceFlow_8p5w3mq</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1w8p5tq" sourceRef="StartEvent_0k7m3xq" targetRef="Task_2r9v6w4"/>
    <bpmn:sequenceFlow id="SequenceFlow_3m7k9xq" name="" sourceRef="Task_2r9v6w4" targetRef="ExclusiveGateway_1t8p5wq"/>
    <bpmn:sequenceFlow id="SequenceFlow_4v6r2mq" name="Yes" sourceRef="ExclusiveGateway_1t8p5wq" targetRef="Task_3m7k9xq"/>
    <bpmn:sequenceFlow id="SequenceFlow_5w8p1tq" sourceRef="Task_3m7k9xq" targetRef="IntermediateCatchEvent_0v6r4tq"/>
    <bpmn:sequenceFlow id="SequenceFlow_7k9m2xq" name="" sourceRef="IntermediateCatchEvent_0v6r4tq" targetRef="Task_5w8p2mq"/>
    <bpmn:sequenceFlow id="SequenceFlow_6r4t1pq" sourceRef="Task_5w8p2mq" targetRef="Task_7k9m2xq"/>
    <bpmn:sequenceFlow id="SequenceFlow_8p5w3mq" name="" sourceRef="Task_7k9m2xq" targetRef="EndEvent_1k9m7xq"/>

  </bpmn:process>

</bpmn:definitions>