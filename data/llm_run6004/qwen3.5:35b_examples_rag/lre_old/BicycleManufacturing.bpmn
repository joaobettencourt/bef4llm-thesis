<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1"/>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sales" name="Sales Department">
        <bpmn:flowNodeRef>StartEvent_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectAcceptOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_AcceptReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShipBicycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ProcessFinished</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Storehouse" name="Storehouse">
        <bpmn:flowNodeRef>InclusiveGateway_CheckParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProcessPartList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_PartAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReservePart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BackOrderPart</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Engineering" name="Engineering Department">
        <bpmn:flowNodeRef>InclusiveGateway_MergeAssemblyReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssemblyPreparation</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_OrderReceived" name="Order Received">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Reject or Accept Order -->
    <bpmn:task id="Task_RejectAcceptOrder" name="Reject/Accept Order">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Accept/Reject Decision -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_AcceptReject" name="Accept Order?">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejected Order -->
    <bpmn:endEvent id="EndEvent_OrderRejected" name="Order Rejected">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Split to Storehouse and Engineering after Acceptance -->
    <bpmn:parallelGateway id="ParallelGateway_Accepted" name="Inform Departments">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Storehouse Path - Process Part List -->
    <bpmn:task id="Task_ProcessPartList" name="Process Part List">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_7</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway for Each Item Check -->
    <bpmn:inclusiveGateway id="InclusiveGateway_CheckParts" name="Check Parts">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_8</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Exclusive Gateway for Part Availability -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_PartAvailable" name="Part Available?">
      <bpmn:incoming>SequenceFlow_8</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Reserve Part -->
    <bpmn:task id="Task_ReservePart" name="Reserve Part">
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Back Order Part -->
    <bpmn:task id="Task_BackOrderPart" name="Back-Order Part">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_9</bpmn:outgoing>
    </bpmn:task>

    <!-- Engineering Path - Assembly Preparation -->
    <bpmn:task id="Task_AssemblyPreparation" name="Prepare for Assembling">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <!-- Inclusive Gateway to Merge Storehouse and Engineering -->
    <bpmn:inclusiveGateway id="InclusiveGateway_MergeAssemblyReady" name="All Parts Ready?">
      <bpmn:incoming>SequenceFlow_9</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Assemble Bicycle -->
    <bpmn:task id="Task_AssembleBicycle" name="Assemble Bicycle">
      <bpmn:incoming>SequenceFlow_14</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Ship to Customer -->
    <bpmn:task id="Task_ShipBicycle" name="Ship Bicycle">
      <bpmn:incoming>SequenceFlow_15</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_16</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Process Finished -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Process Finished">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_OrderReceived" targetRef="Task_RejectAcceptOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" name="" sourceRef="Task_RejectAcceptOrder" targetRef="ExclusiveGateway_AcceptReject"/>

    <!-- Reject Path -->
    <bpmn:sequenceFlow id="SequenceFlow_3" name="No" sourceRef="ExclusiveGateway_AcceptReject" targetRef="EndEvent_OrderRejected"/>

    <!-- Accept Path - Parallel Split -->
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Yes" sourceRef="ExclusiveGateway_AcceptReject" targetRef="ParallelGateway_Accepted"/>

    <!-- Storehouse Branch from Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_5" name="" sourceRef="ParallelGateway_Accepted" targetRef="Task_ProcessPartList"/>

    <!-- Engineering Branch from Parallel Gateway -->
    <bpmn:sequenceFlow id="SequenceFlow_6" name="" sourceRef="ParallelGateway_Accepted" targetRef="Task_AssemblyPreparation"/>

    <!-- Part Availability Check Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_7" name="" sourceRef="Task_ProcessPartList" targetRef="InclusiveGateway_CheckParts"/>

    <!-- Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_10" name="Yes" sourceRef="ExclusiveGateway_PartAvailable" targetRef="Task_ReservePart"/>

    <!-- Not Available Path -->
    <bpmn:sequenceFlow id="SequenceFlow_11" name="No" sourceRef="ExclusiveGateway_PartAvailable" targetRef="Task_BackOrderPart"/>

    <!-- Merge to Next Item or Continue -->
    <bpmn:sequenceFlow id="SequenceFlow_8" name="" sourceRef="InclusiveGateway_CheckParts" targetRef="ExclusiveGateway_PartAvailable"/>

    <!-- Loop Back for Next Item -->
    <bpmn:sequenceFlow id="SequenceFlow_9" name="Next Item?" sourceRef="Task_ReservePart" targetRef="InclusiveGateway_MergeAssemblyReady"/>

    <!-- Assembly Preparation Complete Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_13" name="" sourceRef="Task_AssemblyPreparation" targetRef="InclusiveGateway_MergeAssemblyReady"/>

    <!-- All Parts Ready - Start Assembly -->
    <bpmn:sequenceFlow id="SequenceFlow_14" name="All Items Processed" sourceRef="InclusiveGateway_MergeAssemblyReady" targetRef="Task_AssembleBicycle"/>

    <!-- Ship to Customer Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_15" name="" sourceRef="Task_AssembleBicycle" targetRef="Task_ShipBicycle"/>

    <!-- Process Finished Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_16" name="" sourceRef="Task_ShipBicycle" targetRef="EndEvent_ProcessFinished"/>

  </bpmn:process>
</bpmn:definitions>