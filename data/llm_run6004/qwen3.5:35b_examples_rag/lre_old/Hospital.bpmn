<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1m9e7qz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1a3f8y6"/>

  <bpmn:process id="Process_Examination" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_OutpatientPhysician" name="Outpatient Physician">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExaminePatient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HealthyDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FillForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlaceOrderRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformRisks</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientDelegate" name="Outpatient Delegate">
        <bpmn:flowNodeRef>Gateway_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArrangeAppointment</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Patient" name="Patient">
        <bpmn:flowNodeRef>Gateway_ConsentDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SignConsent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardNurse" name="Ward Nurse">
        <bpmn:flowNodeRef>Gateway_AppointmentPrep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareExaminationSampling</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_WardPhysician" name="Ward Physician">
        <bpmn:flowNodeRef>Gateway_SamplePath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeSampleSendLab</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysician" name="Lab Physician">
        <bpmn:flowNodeRef>Gateway_SampleValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateSampleState</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabAssistant" name="Lab Assistant">
        <bpmn:flowNodeRef>Gateway_AnalysisPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformAnalysis</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_LabPhysicianResults" name="Lab Physician">
        <bpmn:flowNodeRef>Gateway_ValidationPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateAnalysisResults</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_OutpatientPhysicianFinal" name="Outpatient Physician">
        <bpmn:flowNodeRef>Gateway_DiagnosisPath</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MakeDiagnosisTherapy</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Patient Examination">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Examine Patient -->
    <bpmn:task id="Task_ExaminePatient" name="Examine and Determine Health Status">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideHealthy</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Healthy Decision -->
    <bpmn:exclusiveGateway id="Gateway_HealthyDecision" name="Patient healthy?">
      <bpmn:incoming>SequenceFlow_DecideHealthy</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FillFormPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NeedExamPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Healthy -->
    <bpmn:task id="Task_FillForm" name="Fill Examination Form">
      <bpmn:incoming>SequenceFlow_FillFormPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LeavePatient</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_PatientLeaves" name="Patient Can Leave">
      <bpmn:name>Patient Leaves</bpmn:name>
      <bpmn:incoming>SequenceFlow_LeavePatient</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Needs Examination -->
    <bpmn:task id="Task_PlaceOrderRequest" name="Place Order and Fill Request Form">
      <bpmn:incoming>SequenceFlow_NeedExamPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InformRisks</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Inform Risks -->
    <bpmn:task id="Task_InformRisks" name="Inform Patient of Potential Risks">
      <bpmn:incoming>SequenceFlow_InformRisks</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConsentCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Consent Decision -->
    <bpmn:exclusiveGateway id="Gateway_ConsentDecision" name="Patient agrees?">
      <bpmn:incoming>SequenceFlow_ConsentCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ArrangeApptPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Arrange Appointment -->
    <bpmn:task id="Task_ArrangeAppointment" name="Arrange Appointment with Ward">
      <bpmn:incoming>SequenceFlow_ArrangeApptPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WardPrepPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Sample Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_SamplePath" name="Sample Preparation">
      <bpmn:incoming>SequenceFlow_WardPrepPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Prepare Examination and Sampling -->
    <bpmn:task id="Task_PrepareExaminationSampling" name="Prepare Examination and Sampling">
      <bpmn:incoming>SequenceFlow_PrepareTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TakeSamplePath</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Take Sample -->
    <bpmn:task id="Task_TakeSampleSendLab" name="Take Sample and Send to Lab">
      <bpmn:incoming>SequenceFlow_TakeSamplePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SampleValidationCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Sample Validation -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_SampleValidation" name="Sample usable?">
      <bpmn:incoming>SequenceFlow_SampleValidationCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContaminatedPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_SampleContaminated" name="New Sample Required">
      <bpmn:name>New Sample Required</bpmn:name>
      <bpmn:incoming>SequenceFlow_ContaminatedPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway: Analysis Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_AnalysisPath" name="Analysis">
      <bpmn:incoming>SequenceFlow_SampleValidationCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PerformAnalysisTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Perform Analysis -->
    <bpmn:task id="Task_PerformAnalysis" name="Perform Analysis">
      <bpmn:incoming>SequenceFlow_PerformAnalysisTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ValidationCheckPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Validation Path -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_ValidationPath" name="Results Valid?">
      <bpmn:incoming>SequenceFlow_ValidationCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DiagnosisTaskPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Validate Analysis Results -->
    <bpmn:task id="Task_ValidateAnalysisResults" name="Validate Analysis Results">
      <bpmn:incoming>SequenceFlow_PerformAnalysisTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DiagnosisPath</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Diagnosis Path -->
    <bpmn:inclusiveGateway id="InclusiveGateway_DiagnosisPath" name="Diagnosis">
      <bpmn:incoming>SequenceFlow_ValidationCheckPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MakeDiagnosisTask</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <!-- Task: Make Diagnosis and Prescribe Therapy -->
    <bpmn:task id="Task_MakeDiagnosisTherapy" name="Make Diagnosis and Prescribe Therapy">
      <bpmn:incoming>SequenceFlow_MakeDiagnosisTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalEndPath</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_ProcessComplete" name="Diagnosis and Therapy Prescribed">
      <bpmn:name>Process Complete</bpmn:name>
      <bpmn:incoming>SequenceFlow_FinalEndPath</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExaminePatient"/>
    <bpmn:sequenceFlow id="SequenceFlow_DecideHealthy" name="" sourceRef="Task_ExaminePatient" targetRef="Gateway_HealthyDecision"/>

    <!-- Healthy Path -->
    <bpmn:sequenceFlow id="SequenceFlow_FillFormPath" name="Yes - Patient healthy" sourceRef="Gateway_HealthyDecision" targetRef="Task_FillForm"/>
    <bpmn:sequenceFlow id="SequenceFlow_LeavePatient" sourceRef="Task_FillForm" targetRef="EndEvent_PatientLeaves"/>

    <!-- Additional Examination Path -->
    <bpmn:sequenceFlow id="SequenceFlow_NeedExamPath" name="No - Needs examination" sourceRef="Gateway_HealthyDecision" targetRef="Task_PlaceOrderRequest"/>
    <bpmn:sequenceFlow id="SequenceFlow_InformRisks" sourceRef="Task_PlaceOrderRequest" targetRef="Task_InformRisks"/>

    <!-- Consent Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ConsentCheck" name="" sourceRef="Task_InformRisks" targetRef="Gateway_ConsentDecision"/>
    <bpmn:sequenceFlow id="SequenceFlow_ArrangeApptPath" name="Yes - Patient agrees" sourceRef="Gateway_ConsentDecision" targetRef="Task_ArrangeAppointment"/>

    <!-- Sample Path -->
    <bpmn:sequenceFlow id="SequenceFlow_WardPrepPath" sourceRef="Task_ArrangeAppointment" targetRef="InclusiveGateway_SamplePath"/>
    <bpmn:sequenceFlow id="SequenceFlow_PrepareTask" name="" sourceRef="InclusiveGateway_SamplePath" targetRef="Task_PrepareExaminationSampling"/>

    <!-- Sample Validation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeSamplePath" sourceRef="Task_PrepareExaminationSampling" targetRef="Task_TakeSampleSendLab"/>
    <bpmn:sequenceFlow id="SequenceFlow_SampleValidationCheck" name="" sourceRef="Task_TakeSampleSendLab" targetRef="ExclusiveGateway_SampleValidation"/>

    <!-- Contaminated Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ContaminatedPath" name="No - Contaminated" sourceRef="ExclusiveGateway_SampleValidation" targetRef="EndEvent_SampleContaminated"/>

    <!-- Analysis Path (Merge from Validation) -->
    <bpmn:sequenceFlow id="SequenceFlow_PerformAnalysisTask" name="" sourceRef="InclusiveGateway_AnalysisPath" targetRef="Task_PerformAnalysis"/>

    <!-- Validation Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidationCheckPath" name="Yes - Results valid" sourceRef="ExclusiveGateway_SampleValidation" targetRef="InclusiveGateway_DiagnosisPath"/>
    <bpmn:sequenceFlow id="SequenceFlow_MakeDiagnosisTask" name="" sourceRef="InclusiveGateway_AnalysisPath" targetRef="Task_PerformAnalysis"/>

    <!-- Diagnosis Path -->
    <bpmn:sequenceFlow id="SequenceFlow_ValidationCheckPath2" name="" sourceRef="ExclusiveGateway_SampleValidation" targetRef="InclusiveGateway_DiagnosisPath"/>
    <bpmn:sequenceFlow id="SequenceFlow_MakeDiagnosisTask2" name="" sourceRef="InclusiveGateway_AnalysisPath" targetRef="Task_PerformAnalysis"/>

  </bpmn:process>
</bpmn:definitions>