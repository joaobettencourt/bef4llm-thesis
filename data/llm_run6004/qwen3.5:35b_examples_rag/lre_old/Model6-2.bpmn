<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1m9e7qz" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_OrderRequest"/>
  <bpmn:message id="Message_Invoice"/>

  <bpmn:collaboration id="Collaboration_AggregatorSupplier">
    <bpmn:participant id="Participant_AssemblerAG" name="Assembler AG" processRef="Process_Assembler"/>
    <bpmn:participant id="Participant_Supplier" name="Supplier Company" processRef="Process_Supplier"/>

    <!-- Message Flow from Assembler to Supplier -->
    <bpmn:messageFlow id="MessageFlow_OrderRequest" sourceRef="Task_PlaceOrder" targetRef="StartEvent_ReceiveOrder">
      <bpmn:name>Place Order</bpmn:name>
    </bpmn:messageFlow>

    <!-- Message Flow from Supplier to Assembler -->
    <bpmn:messageFlow id="MessageFlow_InvoiceRequest" sourceRef="Task_SendInvoice" targetRef="StartEvent_ReceiveInvoice">
      <bpmn:name>Send Invoice</bpmn:name>
    </bpmn:messageFlow>

  </bpmn:collaboration>

  <!-- Process for Assembler AG -->
  <bpmn:process id="Process_Assembler" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:name>Monthly Order Trigger</bpmn:name>
      <bpmn:timerEventDefinition bpmn:type="TimeCycle"/>
      <bpmn:outgoing>SequenceFlow_OrderTrigger</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_PlaceOrder" name="Place Order with Supplier">
      <bpmn:incoming>SequenceFlow_OrderTrigger</bpmn:incoming>
      <bpmn:outgoing/>
    </bpmn:task>

    <!-- Message Start Event for Invoice -->
    <bpmn:startEvent id="StartEvent_ReceiveInvoice" name="Receive Invoice">
      <bpmn:messageRef>Message_Invoice</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_ProcessInvoice</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_Assembler">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_ProcessInvoice</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_OrderTrigger" sourceRef="StartEvent_1" targetRef="Task_PlaceOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_ProcessInvoice" sourceRef="StartEvent_ReceiveInvoice" targetRef="EndEvent_Assembler"/>

  </bpmn:process>

  <!-- Process for Supplier Company -->
  <bpmn:process id="Process_Supplier" isExecutable="false">
    <!-- Message Start Event for Order -->
    <bpmn:startEvent id="StartEvent_ReceiveOrder" name="Receive Order">
      <bpmn:messageRef>Message_OrderRequest</bpmn:messageRef>
      <bpmn:outgoing>SequenceFlow_ProcessOrderTrigger</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ProcessOrder" name="Process Order">
      <bpmn:incoming>SequenceFlow_ProcessOrderTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendInvoiceTrigger</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Supplier">
      <bpmn:name>Process Completed</bpmn:name>
      <bpmn:incoming>SequenceFlow_SendInvoiceTrigger</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ProcessOrderTrigger" sourceRef="StartEvent_ReceiveOrder" targetRef="Task_ProcessOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendInvoiceTrigger" sourceRef="Task_ProcessOrder" targetRef="EndEvent_Supplier"/>

  </bpmn:process>

</bpmn:definitions>