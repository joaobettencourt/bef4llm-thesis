<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1m9e7qz">
    <bpmn:messageFlow id="MessageFlow_DismissalSent" sourceRef="Task_MPON_SendDismissal" targetRef="StartEvent_MPOO"/>
  </bpmn:collaboration>

  <!-- MPON Participant -->
  <bpmn:process id="Pool_MPON" isExecutable="false">
    <bpmn:startEvent id="StartNoneEvent_MPON">
      <bpmn:name>Dismissal Initiated</bpmn:name>
      <bpmn:outgoing>SequenceFlow_0g6h8y4</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndNoneEvent_MPON">
      <bpmn:name>Dismissal Processed</bpmn:name>
      <bpmn:incoming>SequenceFlow_5h7x9qj</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task for sending dismissal -->
    <bpmn:task id="Task_MPON_SendDismissal" name="Send Dismissal">
      <bpmn:name>Send Dismissal</bpmn:name>
      <bpmn:incoming>SequenceFlow_0g6h8y4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MPON_SendDismissal</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_0g6h8y4" sourceRef="StartNoneEvent_MPON" targetRef="Task_MPON_SendDismissal"/>
    <bpmn:sequenceFlow id="SequenceFlow_MPON_SendDismissal" name="" sourceRef="Task_MPON_SendDismissal" targetRef="EndNoneEvent_MPON"/>

  </bpmn:process>

  <!-- MPOO Participant -->
  <bpmn:process id="Pool_MPOO" isExecutable="false">
    <bpmn:startEvent id="StartMessageEvent_MPOO">
      <bpmn:name>Dismissal Received</bpmn:name>
      <bpmn:outgoing>SequenceFlow_3x9k4mz</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task for reviewing dismissal -->
    <bpmn:task id="Task_MPOO_Review" name="Review Dismissal">
      <bpmn:name>Review Dismissal</bpmn:name>
      <bpmn:incoming>SequenceFlow_3x9k4mz</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExclusiveGateway_MPOO</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_1p7j0vx" name="Confirm or Oppose?">
      <bpmn:name>Confirm or Oppose?</bpmn:name>
      <bpmn:incoming>SequenceFlow_ExclusiveGateway_MPOO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Confirm_Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Oppose_Path</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Confirm Path -->
    <bpmn:endEvent id="EndConfirm_MPOO">
      <bpmn:name>Dismissal Confirmed</bpmn:name>
      <bpmn:incoming>SequenceFlow_Confirm_Path</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Oppose Path -->
    <bpmn:endEvent id="EndOppose_MPOO">
      <bpmn:name>Dismissal Opposed</bpmn:name>
      <bpmn:incoming>SequenceFlow_Oppose_Path</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_3x9k4mz" sourceRef="StartMessageEvent_MPOO" targetRef="Task_MPOO_Review"/>
    <bpmn:sequenceFlow id="SequenceFlow_ExclusiveGateway_MPOO" name="" sourceRef="Task_MPOO_Review" targetRef="ExclusiveGateway_1p7j0vx"/>

    <!-- Confirm Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Confirm_Path" name="Confirm Dismissal" sourceRef="ExclusiveGateway_1p7j0vx" targetRef="EndConfirm_MPOO"/>

    <!-- Oppose Path -->
    <bpmn:sequenceFlow id="SequenceFlow_Oppose_Path" name="Oppose Dismissal" sourceRef="ExclusiveGateway_1p7j0vx" targetRef="EndOppose_MPOO"/>
  </bpmn:process>

</bpmn:definitions>