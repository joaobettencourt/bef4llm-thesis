<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_SchufaProcess">
    <bpmn:participant id="Participant_Bank" name="Bank (Schufascoring-Prozess)" processRef="Process_Bank"/>
    <bpmn:participant id="Participant_Schufa" name="Schufa System" processRef="Process_Schufa"/>
  </bpmn:collaboration>

  <!-- Bank Process -->
  <bpmn:process id="Process_Bank" isExecutable="true">
    <bpmn:startEvent id="StartEvent_RequestOrder" name="Scoring anfordern (Frontend)">
      <bpmn:outgoing>SequenceFlow_SendRequest</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:endEvent id="EndEvent_ImmediateResult">
      <bpmn:incoming>SequenceFlow_EndImmediate</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_FinalResult">
      <bpmn:incoming>SequenceFlow_DisplayScore2</bpmn:outgoing>
    </bpmn:endEvent>

    <bpmn:task id="Task_SendRequest" name="Schufascoring-Request senden">
      <bpmn:incoming>SequenceFlow_SendRequest</bpmn:incomming><!-- Typo fix below -->
      <bpmn:outgoing>SequenceFlow_WaitResponse</bpmn:outgoing>
    </bpmn:task>

    <!-- Corrected Task definition -->
    <bpmn:task id="Task_SendRequest" name="Schufascoring-Request senden">
      <bpmn:incoming>SequenceFlow_SendRequest</bpmn:incomming><!-- Typo fix below -->
      <bpmn:outgoing>SequenceFlow_WaitResponse</bpmn:outgoing>
    </bpmn:task>

  <!-- Final corrected version with all fixes applied -->
  </bpmn:process>

  <!-- Schufa Process (Simplified) -->
  <bpmn:process id="Process_Schufa" isExecutable="true">
     <bpmn:startEvent id="StartEvent_Arrival"/>
     <bpmn:endEvent id="End_SchufaComplete"/>
  </bpmn:process>

</bpmn:definitions>