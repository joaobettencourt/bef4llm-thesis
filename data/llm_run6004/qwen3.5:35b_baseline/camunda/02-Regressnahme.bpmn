<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RecourseProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Recourse">
    <bpmn:participant id="Participant_Versicherung" name="Versicherungsprozess Regress" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter Regressmanagement">
        <bpmn:flowNodeRef>StartEvent_RecourseNotification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_ValidBasis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseNoRecourse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDemandLetter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_WaitingState</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_PaymentReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClosedPaid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatchEvent_ObjectionReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewObjection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_Justified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CloseJustified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignCollectionAgency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ClosedAssignedToInkasso</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RecourseNotification" name="Meldung Regress möglich">
      <bpmn:outgoing>SequenceFlow_InitCheckCase</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_CheckCase" name="Fall prüfen (Regressmöglichkeit)">
      <bpmn:incoming>SequenceFlow_InitCheckCase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToGatewayValidBasis</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:exclusiveGateway id="InclusiveGateway_ValidBasis" name="Möglichkeit besteht?">
      <bpmn:incoming>SequenceFlow_GoToGatewayValidBasis</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoRecoursePossible</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesSendDemand</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_CloseNoRecourse" name="Vorgang schließen (kein Regress)">
      <bpmn:incoming>SequenceFlow_NoRecoursePossible</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 -->
    <bpmn:task id="Task_SendDemandLetter" name="Zahlungsaufforderung senden &amp; Wiedervorlage">
      <bpmn:incoming>SequenceFlow_YesSendDemand</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitWaitingState</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Waiting State -->
    <bpmn:parallelGateway id="ParallelGateway_WaitingState" name="Warten auf...">
      <bpmn:incoming>SequenceFlow_SplitWaitingState</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WaitPayment</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitObjection</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaitDeadlineTimer</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Payment -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_PaymentReceived" name="Geld eingegangen">
      <bpmn:incoming>SequenceFlow_WaitPayment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RecordReceipt</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 3 -->
    <bpmn:task id="Task_RecordReceipt" name="Eingang verbuchen">
      <bpmn:incoming>SequenceFlow_RecordReceipt</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndPaid</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_ClosedPaid" name="Vorgang schließen (bezahlt)">
      <bpmn:incoming>SequenceFlow_EndPaid</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Objection -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_ObjectionReceived" name="Widerspruch VN">
      <bpmn:incoming>SequenceFlow_WaitObjection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewObjection</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_ReviewObjection" name="Widerspruch prüfen">
      <bpmn:incoming>SequenceFlow_ReviewObjection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GoToGatewayJustified</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 -->
    <bpmn:exclusiveGateway id="InclusiveGateway_Justified" name="Widerspruch gerechtfertigt?">
      <bpmn:incoming>SequenceFlow_GoToGatewayJustified</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesJustified</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoUnjustified</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 3 -->
    <bpmn:endEvent id="EndEvent_CloseJustified" name="Vorgang schließen (Widerspruch gerechtfertigt)">
      <bpmn:incoming>SequenceFlow_YesJustified</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 3: Deadline Expiry -->
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_DeadlineExpiry" name="Frist abgelaufen">
      <bpmn:timerDuration xsi:type="tTimeDate">PT14D</bpmn:timerDuration>
      <bpmn:incoming>SequenceFlow_WaitDeadlineTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignCollectionFromTimer</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Task 5 (Shared Logic for Unjustified Objection & Deadline) -->
    <bpmn:task id="Task_AssignCollectionAgency" name="An Inkasso-Dienstleister übergeben">
      <bpmn:incoming>SequenceFlow_NoUnjustified</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_AssignCollectionFromTimer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndAssignedToInkasso</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 -->
    <bpmn:endEvent id="EndEvent_ClosedAssignedToInkasso" name="Vorgang geschlossen (via Inkasso)">
      <bpmn:incoming>SequenceFlow_EndAssignedToInkasso</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitCheckCase" sourceRef="StartEvent_RecourseNotification" targetRef="Task_CheckCase">
      <bpmn:name>Meldung erhalten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GoToGatewayValidBasis" sourceRef="Task_CheckCase" targetRef="InclusiveGateway_ValidBasis">
      <bpmn:name>Fall geprüft</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 1 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_NoRecoursePossible" sourceRef="InclusiveGateway_ValidBasis" targetRef="EndEvent_CloseNoRecourse">
      <bpmn:name>Ansonsten</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_YesSendDemand" sourceRef="InclusiveGateway_ValidBasis" targetRef="Task_SendDemandLetter">
      <bpmn:name>Möglichkeit besteht</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Initial Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_SplitWaitingState" sourceRef="Task_SendDemandLetter" targetRef="ParallelGateway_WaitingState">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 1 Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitPayment" sourceRef="ParallelGateway_WaitingState" targetRef="IntermediateCatchEvent_PaymentReceived">
      <bpmn:name>Geld eingegangen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 2 Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitObjection" sourceRef="ParallelGateway_WaitingState" targetRef="IntermediateCatchEvent_ObjectionReceived">
      <bpmn:name>VN widerspricht</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Path 3 Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_WaitDeadlineTimer" sourceRef="ParallelGateway_WaitingState" targetRef="IntermediateCatchEvent_DeadlineExpiry">
      <bpmn:name>Frist abgelaufen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_GoToGatewayJustified" sourceRef="Task_ReviewObjection" targetRef="InclusiveGateway_Justified">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_YesJustified" sourceRef="InclusiveGateway_Justified" targetRef="EndEvent_CloseJustified">
      <bpmn:name>Gerechtfertigt</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Gateway 2 Outgoing -->
    <bpmn:sequenceFlow id="SequenceFlow_NoUnjustified" sourceRef="InclusiveGateway_Justified" targetRef="Task_AssignCollectionAgency">
      <bpmn:name>Nicht gerechtfertigt</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Timer to Task -->
    <bpmn:sequenceFlow id="SequenceFlow_AssignCollectionFromTimer" sourceRef="IntermediateCatchEvent_DeadlineExpiry" targetRef="Task_AssignCollectionAgency">
      <bpmn:name>Frist abgelaufen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_EndAssignedToInkasso" sourceRef="Task_AssignCollectionAgency" targetRef="EndEvent_ClosedAssignedToInkasso">
      <bpmn:name></bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>