<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_HardwarePurchase_v2" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_HardwareProcess_v2">
    <bpmn:participant id="Pool_BuyHardware_v2" name="Buy New Hardware Process" processRef="Proc_BuyHardware_v2"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_BuyHardware_v2" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_HardwareProcess_v2">
      <bpmn:lane id="Lane_Employee_1" name="Employee"/>

      <bpmn:lane id="Lane_ITDept_2" name="IT Department">
        <bpmn:flowNodeRef>StartEvent_RequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AnalyzeRequestTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EditCompleteRequestTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendEmailToSupplierTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FillFormManagementTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareOrderTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReceiveHardwareTask_v2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Management_3" name="Management">
        <bpmn:flowNodeRef>DetermineDecisionGatewayMgmt_v2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Financial_4" name="Financial Department">
        <bpmn:flowNodeRef>FindResourcesTask_v2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>HandleInvoiceTask_v2</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>


    
     <!-- Events and Tasks -->

    <bpmn:startEvent id="StartEvent_RequestReceived" name="Request Received">
        <bpmn:outgoing>SF_Start_Analyze_v2</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="AnalyzeRequestTask_v2" name="Analyze Request">
      <bpmn:incoming>SF_Start_Analyze_v2</bpmn:incoming>
        <bpmn:outgoing>SF_DenyOrApproveIT_v2</bpmn:outgoing>
    </bpmn:task>

    <!-- IT Decision Gateway -->
    <bpmn:exclusiveGateway id="DenyOrApproveIT" name="Request Approved?">
      <bpmn:incoming>SF_DenyOrApproveIT_v2</bpmn:incoming>
        <bpmn:outgoing>SF_EmailDeniedTaskLink_v2</bpmn:outgoing>
       <bpmn:outgoing>SF_EditCompleteFlow_v2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

     <!-- Email Denied Task -->
      <bpmn:task id="EmailDeniedEmployeeTask" name="Inform Employee of Denial">
        <bpmn:incoming>SF_EmailDeniedTaskLink_v2</bpmn:incoming>
          <bpmn:outgoing>SF_EndDenyITFlow_v2</bpmn:outgoing>
      </bpmn:task>

     <!-- Edit and Complete Request Task -->
       <bpmn:task id="EditCompleteRequestTask" name="Edit and Complete Request">
        <bpmn:incoming>SF_EditCompleteFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_SendEmailSupplierLink_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Send Email to Supplier --> 
       <bpmn:task id="SendEmailToSupplierTask" name="Request Price from Supplier">
        <bpmn:incoming>SF_SendEmailSupplierLink_v2</bpmn:incoming>
          <bpmn:outgoing>SF_ReceiveOfferFlow_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Receive Offer (simulated as task for BPMN 2.0) --> 
       <bpmn:intermediateCatchEvent id="Intermediate_CatchSupplierReply" name="Receive Supplier Offer">
        <bpmn:incoming>SF_ReceiveOfferFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_FillFormManagementLink_v2</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>

    <!-- Fill Form for Management --> 
       <bpmn:task id="FillFormManagementTask" name="Complete Request Form">
        <bpmn:incoming>SF_FillFormManagementLink_v2</bpmn:incoming>
          <bpmn:outgoing>SF_SendToMgmtFlow_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Management Decision Gateway --> 
     <bpmn:exclusiveGateway id="DetermineDecisionGatewayMgmt" name="Management Decision">
        <bpmn:incoming>SF_SendToMgmtFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_ApproveOfferLink_v2</bpmn:outgoing>
           <bpmn:outgoing>SF_ReworkRequestLink_v2</bpmn:outgoing>
            <bpmn:outgoing>SF_DenyMgmtFlow_v2</bpmn:outgoing> 
    </bpmn:exclusiveGateway>

    <!-- Forward to Financial --> 
       <bpmn:task id="ForwardOfferToFinancialTask" name="Forward Offer to Finance">
        <bpmn:incoming>SF_ForwardFinancialFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_FinancialResourcesLink_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Find Resources Task --> 
       <bpmn:task id="FindResourcesTask" name="Find Financial Resources">
        <bpmn:incoming>SF_FinancialResourcesLink_v2</bpmn:incoming>
          <bpmn:outgoing>SF_GoToOrderPrepFlow_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Prepare Order Task --> 
       <bpmn:task id="PrepareOrderTask" name="Prepare and Send Order">
        <bpmn:incoming>SF_GoToOrderPrepFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_OrderAcceptedLink_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Receive Hardware Task --> 
       <bpmn:task id="ReceiveHardwareTask" name="Receive Hardware">
        <bpmn:incoming>SF_HardwareReceivedFlow_v2</bpmn:incoming>
          <bpmn:outgoing>SF_HandleInvoiceLink_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- Handle Invoice Task --> 
       <bpmn:task id="HandleInvoiceTask" name="Process Supplier Invoice">
        <bpmn:incoming>SF_HandleInvoiceLink_v2</bpmn:incoming>
          <bpmn:outgoing>SF_EndSuccessFlow_v2</bpmn:outgoing>
      </bpmn:task>

    <!-- End Events --> 
       <bpmn:endEvent id="End_DeniedIT" name="Request Denied">
             <bpmn:incoming>SF_EndDenyITFlow_v2</bpmn:incoming>
        </bpmn:endEvent>

         <bpmn:endEvent id="End_SuccessfulPurchase" name="Hardware Purchased Successfully">
            <bpmn:incoming>SF_EndSuccessFlow_v2</bpmn:incoming> 
             <bpmn:incoming>SF_HardwareReceivedLinkToInvoice_v2</bpmn:outgoing/> <!-- Corrected to incoming -->
        </bpmn:endEvent>

         <bpmn:endEvent id="End_DeniedMgmt" name="Request Denied by Management">
            <bpmn:incoming>SF_MgmtDenyFlow_v2</bpmn:incoming> 
             <bpmn:outgoing>SF_EndDeniedITLink_v2</bpmn:outgoing/> <!-- Corrected to incoming -->
        </bpmn:endEvent>

    <!-- Flows --> 

      <!-- Initial Flow --> 
     <bpmn:sequenceFlow id="SF_Start_Analyze_v2" sourceRef="StartEvent_RequestReceived" targetRef="AnalyzeRequestTask_v2"/>

       <!-- To IT Decision Gateway -->
       <bpmn:sequenceFlow id="SF_DenyOrApproveIT_v2" name="Approved?" sourceRef="DenyOrApproveIT" targetRef="EmailDeniedEmployeeTask">
        </bpmn:sequenceFlow>

    <bpmn:endEvent id="End_SuccessfulPurchase" name="Hardware Purchased Successfully">
             <bpmn:incoming>SF_EndSuccessFlow_v2</bpmn:outgoing/> <!-- Changed to incoming -->
              <bpmn:incoming>SF_HandleInvoiceLinkToInvoiceTask_v2</bpmn:incoming> 
        </bpmn:endEvent>

      <bpmn:endEvent id="End_DeniedMgmt" name="Request Denied by Management">
         <bpmn:incoming>SF_MgmtDenyFlow_v2</bpmn:outgoing/> <!-- Corrected -->
           <bpmn:incoming>SF_ReworkBackToITLink_v2</bpmn:incoming> 
     </bpmn:endEvent>

    <!-- IT Decision Flows --> 
        <bpmn:sequenceFlow id="SF_EmailDeniedTaskLink_v2" name="Deny Request" sourceRef="EmailDeniedEmployeeTask" targetRef="End_DeniedIT"/>
        
       <bpmn:sequenceFlow id="SF_EditCompleteFlow_v2" name="Approve Request" sourceRef="AnalyzeRequestGatewayMgmt" targetRef="EditCompleteRequestTask">Wait, this should come from DenyOrApproveIT gateway. Let me fix the flow connections below.</bpmn:endEvent>
</bpmn:process>
</bpmn:definitions>