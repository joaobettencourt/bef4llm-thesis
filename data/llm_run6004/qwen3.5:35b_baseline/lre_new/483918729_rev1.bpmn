<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProvisionProcess_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Provision_Process">
    <bpmn:participant id="Pool_ProvisionTeam" name="Provision Team Process" processRef="Proc_ProvisionMain"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ProvisionMain" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_RequestReceived" name="Receive Customer Request">
      <bpmn:outgoing>SF_Start_IdentifyParts</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Identify Parts -->
    <bpmn:task id="Task_1IdentifyParts" name="Identify Necessary Parts">
      <bpmn:incoming>SF_Start_IdentifyParts</bpmn:incoming>
        <bpmn:outgoing>SF_QuestionsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Any Questions? -->
    <bpmn:exclusiveGateway id="GW_1Questions" name="Any Questions?">
      <bpmn:incoming>SF_QuestionsCheck</bpmn:incoming>
        <bpmn:outgoing>SF_NoQuestions_CheckAvailability</bpmn:outgoing>
       <bpmn:outgoing>SF_YesQuestions_AskCustomer</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Ask Customer for More Information -->
    <bpmn:task id="Task_2AskCustomer" name="Ask Customer for More Information">
      <bpmn:incoming>SF_YesQuestions_AskCustomer</bpmn:incoming>
        <bpmn:outgoing>SF_BackToCheckAvailability</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: All Parts Available? -->
    <bpmn:exclusiveGateway id="GW_2PartsAvailable" name="All Parts Available?">
      <bpmn:incoming>SF_NoQuestions_CheckAvailability</bpmn:outgoing>
        <bpmn:incomings>SF_BackToCheckAvailability</bpmn:incomings>
       <bpmn:outgoing>SF_Available_SupplyCustomer</bpmn:outgoing>
       <bpmn:outgoing>SF_NotAvailable_RecordPetition</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 3: Check Parts Availability -->
    <bpmn:task id="Task_3CheckAvailability" name="Check Parts Availability">
      <bpmn:incoming>SF_BackToCheckAvailability</bpmn:incoming>
        <bpmn:outgoing>SF_Gateway_PartsAvailable</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Record Petition & Order from Daisuki -->
    <bpmn:task id="Task_4OrderDaisuki" name="Record Petition &amp; Order from Daisuki">
      <bpmn:incoming>SF_NotAvailable_RecordPetition</bpmn:incoming>
        <bpmn:outgoing>SF_Gateway_ItemsCollected</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Items Collected? -->
    <bpmn:exclusiveGateway id="GW_3ItemsCollected" name="Items Collected?">
      <bpmn:incoming>SF_Gateway_ItemsCollected</bpmn:outgoing>
        <bpmn:incomings>SF_OrderFromDaisuki_PetitionRecorded</bpmn:incomings>
       <bpmn:outgoing>SF_FinalPaymentReceived_EndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PaymentReceived" name="Final Payment Received">
      <bpmn:incoming>SF_FinalPaymentReceived_EndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SF_Start_IdentifyParts" sourceRef="StartEvent_RequestReceived" targetRef="Task_1IdentifyParts"/>
    
    <bpmn:sequenceFlow id="SF_QuestionsCheck" name="Any Questions?" sourceRef="GW_1Questions" targetRef="Task_2AskCustomer">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_NoQuestions_CheckAvailability" name="No questions?" sourceRef="GW_1Questions" targetRef="Task_3CheckAvailability">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[no]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_BackToCheckAvailability" sourceRef="Task_2AskCustomer" targetRef="GW_1Questions"/>
    
    <bpmn:sequenceFlow id="SF_Gateway_PartsAvailable" name="All Parts Available?" sourceRef="Task_3CheckAvailability" targetRef="GW_2PartsAvailable">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_Available_SupplyCustomer" name="Supply to Customer" sourceRef="GW_2PartsAvailable" targetRef="EndEvent_PaymentReceived">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_NotAvailable_RecordPetition" name="Not available?" sourceRef="GW_2PartsAvailable" targetRef="Task_4OrderDaisuki">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[no]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SF_OrderFromDaisuki_PetitionRecorded" name="Order from Daisuki?" sourceRef="Task_4OrderDaisuki" targetRef="GW_3ItemsCollected">
      <bpmn:conditionExpression xsi:type="tFormalExpression"><![CDATA[yes]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>