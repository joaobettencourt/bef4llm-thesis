<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_WebDesignProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_WebDesign">
    <bpmn:participant id="Pool_WebDesignTeam" name="Web Design Project Process" processRef="Proc_ManageProject"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_ManageProject" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_ProjectTeams">
      <bpmn:lane id="Lane_WebDesignTeam" name="Web Design Team">
        <bpmn:flowNodeRef>StartEvent_Meeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoMeeting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SuccessCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unsuccessful</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateStoryboard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Agreement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_SplitDevContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DesignDevelopment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ReviewNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ContentFinalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pg_JoinBuild</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildAndReviewWebsite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Successful</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_MarketingTeam" name="Marketing Team">
         <bpmn:flowNodeRef>Task_ContentDraft</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>Task_MarketingReview</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Meeting" name="Project Kickoff">
        <bpmn:outgoing>SF_StartToMeeting</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Informational Meeting -->
    <bpmn:task id="Task_InfoMeeting" name="Informational Meeting">
      <bpmn:incoming>SF_StartToMeeting</bpmn:incoming>
        <bpmn:outgoing>SF_MeetingResultCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Is meeting successful? -->
    <bpmn:exclusiveGateway id="Gw_SuccessCheck" name="Meeting Successful?">
      <bpmn:incoming>SF_MeetingResultCheck</bpmn:incoming>
        <bpmn:outgoing>SF_EndUnsuccessfulFlow</bpmn:outgoing>
       <bpmn:outgoing>SF_GoToStoryboard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Unsuccessful" name="Process Ended">
        <bpmn:incoming>SF_EndUnsuccessfulFlow</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Create Storyboard -->
    <bpmn:task id="Task_CreateStoryboard" name="Create Storyboard">
      <bpmn:incoming>SF_GoToStoryboard</bpmn:incoming>
        <bpmn:outgoing>SF_CheckAgreementFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Agreement on storyboard -->
    <bpmn:exclusiveGateway id="Gw_Agreement" name="Storyboard Agreed?">
      <bpmn:incoming>SF_CheckAgreementFlow</bpmn:incoming>
        <bpmn:outgoing>SF_SplitDevContentFlow</bpmn:outgoing> <!-- Yes -->
       <bpmn:outgoing>SF_ReworkStoryboardFlow</bpmn:outgoing> <!-- No (Loop back) -->
    </bpmn:exclusiveGateway>

     <!-- Loop Back for Rework -->
      <bpmn:sequenceFlow id="SF_ReworkStoryboardFlow" sourceRef="Gw_Agreement" targetRef="Task_CreateStoryboard">
        <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Split for Dev and Content -->
    <bpmn:parallelGateway id="Pg_SplitDevContent" name="Start Work Streams">
      <bpmn:incoming>SF_SplitDevContentFlow</bpmn:incoming>
        <bpmn:outgoing>SF_DevStreamFlow</bpmn:outgoing>
       <bpmn:outgoing>SF_ContentDraftStreamFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 1: Design and Development -->
    <bpmn:task id="Task_DesignDevelopment" name="Design &amp; Develop Website">
      <bpmn:incoming>SF_DevStreamFlow</bpmn:incoming>
        <bpmn:outgoing>SF_ToBuildJoinFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Initial Content Draft -->
    <bpmn:task id="Task_ContentDraft" name="Prepare Initial Content">
      <bpmn:incoming>SF_ContentDraftStreamFlow</bpmn:incoming>
        <bpmn:outgoing>SF_CheckReviewNeededFlow</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Review Needed? -->
    <bpmn:exclusiveGateway id="Gw_ReviewNeeded" name="Marketing Review Needed?">
      <bpmn:incoming>SF_CheckReviewNeededFlow</bpmn:incoming>
        <bpmn:outgoing>SF_MarketingReviewPathFlow</bpmn:outgoing> <!-- Yes -->
       <bpmn:outgoing>SF_SkipToFinalizeContentFlow</bpmn:outgoing> <!-- No -->
    </bpmn:exclusiveGateway>

     <!-- Task 3: Marketing Review (Lane: Marketing) -->
      <bpmn:task id="Task_MarketingReview" name="Conduct Content Review">
        <bpmn:incoming>SF_MarketingReviewPathFlow</bpmn:incoming>
          <bpmn:outgoing>SF_ToContentFinalizeFlow</bpmn:outgoing>
      </bpmn:task>

    <!-- Task 4: Final Content Version -->
     <bpmn:task id="Task_ContentFinalize" name="Create Final Content">
        <bpmn:incoming>SF_SkipToFinalizeContentFlow</bpmn:incoming>
          <bpmn:incoming>SF_ToContentFinalizeFlow</bpmn:incoming>
            <bpmn:outgoing>SF_ContentReadyForBuildFlow</bpmn:outgoing>
    </bpmn:task>

     <!-- Parallel Join -->
      <bpmn:parallelGateway id="Pg_JoinBuild" name="Wait for Completion">
        <bpmn:incoming>SF_ToBuildJoinFlow</bpmn:incoming>
          <bpmn:incoming>SF_ContentReadyForBuildFlow</bpmn:incoming>
            <bpmn:outgoing>SF_StartBuildReviewFlow</bpmn:outgoing>
    </bpmn:parallelGateway>

     <!-- Task 5: Build and Review -->
      <bpmn:task id="Task_BuildAndReviewWebsite" name="Build &amp; Review Website">
        <bpmn:incoming>SF_StartBuildReviewFlow</bpmn:incoming>
          <bpmn:outgoing>SF_CheckApprovalFlow</bpmn:outgoing>
    </bpmn:task>

     <!-- Gateway 4: Approved? -->
      <bpmn:exclusiveGateway id="Gw_Approved" name="Site Approved?">
        <bpmn:incoming>SF_CheckApprovalFlow</bpmn:incoming>
          <bpmn:outgoing>SF_EndSuccessFlow</bpmn:outgoing> <!-- Yes -->
           <bpmn:outgoing>SF_LoopBackBuildFlow</bpmn:outgoing> <!-- No -->
    </bpmn:exclusiveGateway>

     <!-- Loop Back to Build Step -->
      <bpmn:sequenceFlow id="SF_LoopBackBuildFlow" sourceRef="Gw_Approved" targetRef="Task_BuildAndReviewWebsite">
        <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- End Event 2 -->
      <bpmn:endEvent id="End_Successful" name="Process Completed">
          <bpmn:incoming>SF_EndSuccessFlow</bpmn:incoming>
    </bpmn:endEvent>


    <!-- Sequence Flows Definitions -->
    
    <bpmn:sequenceFlow id="SF_StartToMeeting" sourceRef="StartEvent_Meeting" targetRef="Task_InfoMeeting"/>

    <bpmn:sequenceFlow id="SF_MeetingResultCheck" name="Success?" sourceRef="Task_InfoMeeting" targetRef="Gw_SuccessCheck">
        <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SF_EndUnsuccessfulFlow" name="No" sourceRef="Gw_SuccessCheck" targetRef="End_Unsuccessful"/>

      <bpmn:sequenceFlow id="SF_GoToStoryboard" sourceRef="Gw_SuccessCheck" targetRef="Task_CreateStoryboard">
        <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SF_CheckAgreementFlow" name="Agreed?" sourceRef="Task_CreateStoryboard" targetRef="Gw_Agreement"/>

      <bpmn:sequenceFlow id="SF_SplitDevContentFlow" sourceRef="Gw_Agreement" targetRef="Pg_SplitDevContent">
        <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SF_DevStreamFlow" name="Design &amp; Dev Stream" sourceRef="Pg_SplitDevContent" targetRef="Task_DesignDevelopment"/>

      <bpmn:sequenceFlow id="SF_ContentDraftStreamFlow" name="Content Draft Stream" sourceRef="Pg_SplitDevContent" targetRef="Task_ContentDraft"/>

       <bpmn:sequenceFlow id="SF_CheckReviewNeededFlow" name="Need Review?" sourceRef="Task_ContentDraft" targetRef="Gw_ReviewNeeded"/>

        <bpmn:sequenceFlow id="SF_MarketingReviewPathFlow" name="Yes - Marketing Team" sourceRef="Gw_ReviewNeeded" targetRef="Task_MarketingReview">
            <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SF_SkipToFinalizeContentFlow" name="No - Skip Review" sourceRef="Gw_ReviewNeeded" targetRef="Task_ContentFinalize">
        <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

     <bpmn:sequenceFlow id="SF_ToContentFinalizeFlow" name="After Marketing Review" sourceRef="Task_MarketingReview" targetRef="Task_ContentFinalize"/>

      <bpmn:sequenceFlow id="SF_ContentReadyForBuildFlow" name="Content Ready" sourceRef="Task_ContentFinalize" targetRef="Pg_JoinBuild"/>
      
       <bpmn:sequenceFlow id="SF_ToBuildJoinFlow" name="Dev Complete" sourceRef="Task_DesignDevelopment" targetRef="Pg_JoinBuild"/>

        <bpmn:sequenceFlow id="SF_StartBuildReviewFlow" sourceRef="Pg_JoinBuild" targetRef="Task_BuildAndReviewWebsite"/>
        
         <bpmn:sequenceFlow id="SF_CheckApprovalFlow" name="Approved?" sourceRef="Task_BuildAndReviewWebsite" targetRef="Gw_Approved"/>

          <bpmn:sequenceFlow id="SF_EndSuccessFlow" name="Yes - Approved" sourceRef="Gw_Approved" targetRef="End_Successful">
            <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>


  </bpmn:process>

</bpmn:definitions>