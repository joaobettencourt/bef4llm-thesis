<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_MaternityLeave" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_ParentPortal" name="Maternity Leave Management System" processRef="Process_MaternalSupport"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_MaternalSupport" isExecutable="false">
    
    <!-- Lane Set -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Parents" name="Parent Actions">
        <bpmn:flowNodeRef>Task_SelectModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideExtension</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System Actions">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifySplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifySS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NotifyJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GatherInfoCompanies</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Plan Maternity Leave">
      <bpmn:outgoing>SequenceFlow_FetchInfo</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Fetch Information -->
    <bpmn:task id="Task_FetchInfo" name="Fetch potential models (duration, split)">
      <bpmn:incoming>SequenceFlow_FetchInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SelectModel</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: Parent Select -->
    <bpmn:task id="Task_SelectModel" name="Parent selects model">
      <bpmn:incoming>SequenceFlow_SelectModel</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectInfo</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Collect Info -->
    <bpmn:task id="Task_CollectInfo" name="Collect relevant information">
      <bpmn:incoming>SequenceFlow_CollectInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifySplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Parallel Split for Notifications -->
    <bpmn:parallelGateway id="Gateway_NotifySplit" name="Notify in time">
      <bpmn:incoming>SequenceFlow_NotifySplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifSS</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotifCompany</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 4a: Notify Social Security -->
    <bpmn:task id="Task_NotifySS" name="Notify Social Security">
      <bpmn:incoming>SequenceFlow_NotifSS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyJoin1</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4b: Notify Company -->
    <bpmn:task id="Task_NotifyCompany" name="Notify Employer">
      <bpmn:incoming>SequenceFlow_NotifCompany</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotifyJoin2</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Join Notifications -->
    <bpmn:parallelGateway id="Gateway_NotifyJoin">
      <bpmn:incoming>SequenceFlow_NotifyJoin1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_NotifyJoin2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatherInfo</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Gather Info from Companies -->
    <bpmn:task id="Task_GatherInfoCompanies" name="Gather information from companies">
      <bpmn:incoming>SequenceFlow_GatherInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecideExtension</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Decide Extension -->
    <bpmn:task id="Task_DecideExtension" name="Decide about extension">
      <bpmn:incoming>SequenceFlow_DecideExtension</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ExtendDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Decision Point -->
    <bpmn:exclusiveGateway id="Gateway_ExtensionChoice">
      <bpmn:incoming>SequenceFlow_ExtendDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesExtend</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Completed" name="Leave Process Ended">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Data Objects & Associations -->
    <bpmn:dataObjectReference id="Data_ModelInfo" name="Leave Models Info"/>
    <bpmn:association sourceRef="Task_FetchInfo" targetRef="Data_ModelInfo"/>
    
    <bpmn:endEvent id="EndEvent_Extended" name="Extension Processed">
      <bpmn:incoming>SequenceFlow_YesExtend</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_FetchInfo" sourceRef="StartEvent_1" targetRef="Task_FetchInfo"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_SelectModel" name="Selection Made" sourceRef="Task_FetchInfo" targetRef="Task_SelectModel"/>

  <bpmn:sequenceFlow id="SequenceFlow_CollectInfo" sourceRef="Task_SelectModel" targetRef="Task_CollectInfo"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_NotifySplit" name="Notifications Required" sourceRef="Task_CollectInfo" targetRef="Gateway_NotifySplit"/>

  <bpmn:sequenceFlow id="SequenceFlow_NotifSS" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifySS"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_NotifCompany" name="Notify Employer" sourceRef="Gateway_NotifySplit" targetRef="Task_NotifyCompany"/>

  <bpmn:sequenceFlow id="SequenceFlow_NotifyJoin1" sourceRef="Task_NotifySS" targetRef="Gateway_NotifyJoin"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_GatherInfo" name="During Leave Period" sourceRef="Gateway_NotifyJoin" targetRef="Task_GatherInfoCompanies"/>

  <bpmn:sequenceFlow id="SequenceFlow_DecideExtension" name="End of period reached" sourceRef="Task_GatherInfoCompanies" targetRef="Task_DecideExtension"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_ExtendDecision" sourceRef="Task_DecideExtension" targetRef="Gateway_ExtensionChoice"/>

  <bpmn:sequenceFlow id="SequenceFlow_EndProcess" name="No Extension" sourceRef="Gateway_ExtensionChoice" targetRef="EndEvent_Completed">
    <bpmn:name>Do not extend</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_YesExtend" name="Extend Period" sourceRef="Gateway_ExtensionChoice" targetRef="EndEvent_Extended">
    <bpmn:name>Proceed with extension</bpmn:name>
  </bpmn:sequenceFlow>

</bpmn:definitions>