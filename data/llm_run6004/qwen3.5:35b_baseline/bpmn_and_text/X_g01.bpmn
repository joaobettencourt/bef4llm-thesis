<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_NewApplication">
    <bpmn:participant id="Participant_CourseRegistration" name="USI Course Registration System" processRef="Process_CourseRegistration"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_CourseRegistration" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_1" name="New Application for USI Course Registration">
      <bpmn:outgoing>SequenceFlow_StartToCourseSelect</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Select a course -->
    <bpmn:task id="Task_SelectCourse" name="Check Available Courses and Slots">
      <bpmn:incoming>SequenceFlow_StartToCourseSelect</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CourseSelectionResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if slots are free -->
    <bpmn:exclusiveGateway id="Gateway_SlotsAvailable">
      <bpmn:incoming>SequenceFlow_CourseSelectionResult</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SlotsFreePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoSlotsPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Show courses and dates -->
    <bpmn:task id="Task_ShowCourses" name="Display Courses and Dates">
      <bpmn:incoming>SequenceFlow_SlotsFreePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CourseSelected</bpmn:outgoing>
    </bpmn:task>

    <!-- Select one course -->
    <bpmn:task id="Task_SelectOneCourse" name="Select One Course">
      <bpmn:incoming>SequenceFlow_CourseSelected</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountCheckRequest</bpmn:outgoing>
    </bpmn:task>

    <!-- Check if already have account -->
    <bpmn:exclusiveGateway id="Gateway_HasAccount">
      <bpmn:incoming>SequenceFlow_AccountCheckRequest</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesHasAccountPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoNoAccountPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Already has account - log in -->
    <bpmn:task id="Task_LoginExisting" name="Log into Existing Account">
      <bpmn:incoming>SequenceFlow_YesHasAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountReadyForRegistration</bpmn:outgoing>
    </bpmn:task>

    <!-- No account - check university eligibility -->
    <bpmn:exclusiveGateway id="Gateway_UniversityEligible">
      <bpmn:incoming>SequenceFlow_NoNoAccountPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibleUniversityPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotEligibleUniversityPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Eligible university - register account -->
    <bpmn:task id="Task_RegisterAccount" name="Register Your Account">
      <bpmn:incoming>SequenceFlow_EligibleUniversityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AccountRegistrationComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Not eligible - request activation -->
    <bpmn:task id="Task_RequestActivation" name="Request Account Activation">
      <bpmn:incoming>SequenceFlow_NotEligibleUniversityPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ActivationRequested</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for response -->
    <bpmn:intermediateCatchEvent id="Intermediate_Event_WaitResponse" name="Wait for Activation Response">
      <bpmn:incoming>SequenceFlow_ActivationRequested</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResponseReceived</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Account ready - merge paths -->
    <bpmn:parallelGateway id="Gateway_AccountReadyMerge">
      <bpmn:incoming>SequenceFlow_AccountRegistrationComplete</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ResponseReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoginAfterAccountCreation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Log into account (after creation) -->
    <bpmn:task id="Task_LoginNew" name="Log into New Account">
      <bpmn:incoming>SequenceFlow_AccountReadyForRegistration</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_LoggedInToAccount</bpmn:outgoing>
    </bpmn:task>

    <!-- Twitter tweet -->
    <bpmn:exclusiveGateway id="Gateway_TwitterTweet">
      <bpmn:incoming>SequenceFlow_LoginAfterAccountCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConnectTwitterPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Connect to Twitter -->
    <bpmn:task id="Task_TweetFriends" name="Tweet Friends About Joining">
      <bpmn:incoming>SequenceFlow_ConnectTwitterPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TwitterComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Complete registration and payment -->
    <bpmn:exclusiveGateway id="Gateway_RegistrationMerge">
      <bpmn:incoming>SequenceFlow_LoginAfterAccountCreation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompleteRegistrationPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Complete registration with payment -->
    <bpmn:task id="Task_CompleteRegistration" name="Complete Course Registration and Payment">
      <bpmn:incoming>SequenceFlow_TwitterComplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RegistrationSubmitted</bpmn:outgoing>
    </bpmn:task>

    <!-- Receive course ticket -->
    <bpmn:endEvent id="End_Event_CourseTicket" name="Receive Course Ticket">
      <bpmn:incoming>SequenceFlow_TicketReceived</bpmn:incoming>
    </bpmn:endEvent>

    <!-- No slots available path -->
    <bpmn:endEvent id="End_Event_NoSlots" name="No Slots Available"/>
    
    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToCourseSelect" sourceRef="Start_Event_1" targetRef="Task_SelectCourse">
      <bpmn:name>Start</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CourseSelectionResult" sourceRef="Task_SelectCourse" targetRef="Gateway_SlotsAvailable"/>

    <!-- Slots available path -->
    <bpmn:sequenceFlow id="SequenceFlow_SlotsFreePath" name="Slots Available">
      <bpmn:name>Yes - Slots Free</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No slots path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoSlotsPath" sourceRef="Gateway_SlotsAvailable" targetRef="End_Event_NoSlots">
      <bpmn:name>No - No Slots</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Course selection flow -->
    <bpmn:sequenceFlow id="SequenceFlow_CourseSelected" sourceRef="Task_ShowCourses" targetRef="Task_SelectOneCourse"/>
    
    <!-- Account check gateway flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountCheckRequest" sourceRef="Task_SelectOneCourse" targetRef="Gateway_HasAccount"/>

    <!-- Has account path -->
    <bpmn:sequenceFlow id="SequenceFlow_YesHasAccountPath" name="Already has Account">
      <bpmn:name>Yes - Already Registered</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- No account path -->
    <bpmn:sequenceFlow id="SequenceFlow_NoNoAccountPath" sourceRef="Gateway_HasAccount" targetRef="Gateway_UniversityEligible">
      <bpmn:name>No - Need Account</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- University eligibility flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EligibleUniversityPath" name="Eligible University">
      <bpmn:name>Yes - Eligible</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_NotEligibleUniversityPath" sourceRef="Gateway_UniversityEligible" targetRef="Task_RequestActivation">
      <bpmn:name>No - Not Eligible</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Account creation flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountRegistrationComplete" sourceRef="Task_RegisterAccount" targetRef="Gateway_AccountReadyMerge"/>
    
    <!-- Activation request flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ActivationRequested" sourceRef="Task_RequestActivation" targetRef="Intermediate_Event_WaitResponse"/>

    <!-- Response received flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ResponseReceived" sourceRef="Intermediate_Event_WaitResponse" targetRef="Gateway_AccountReadyMerge"/>

    <!-- Login after account creation path -->
    <bpmn:sequenceFlow id="SequenceFlow_LoginAfterAccountCreation" name="Log into Account">
      <bpmn:name>Yes - Log In</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Existing login flow -->
    <bpmn:sequenceFlow id="SequenceFlow_AccountReadyForRegistration" sourceRef="Task_LoginExisting" targetRef="Gateway_TwitterTweet"/>

    <!-- Login new account flow -->
    <bpmn:sequenceFlow id="SequenceFlow_LoggedInToAccount" name="Logged In">
      <bpmn:name>Yes - Logged In</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Twitter tweet flows -->
    <bpmn:sequenceFlow id="SequenceFlow_ConnectTwitterPath" sourceRef="Gateway_TwitterTweet" targetRef="Task_TweetFriends">
      <bpmn:name>Connect to Twitter</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Tweet complete flow -->
    <bpmn:sequenceFlow id="SequenceFlow_TwitterComplete" sourceRef="Task_TweetFriends" targetRef="Gateway_RegistrationMerge"/>

    <!-- Registration merge flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CompleteRegistrationPath" name="Complete Registration">
      <bpmn:name>Yes - Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Final registration flow -->
    <bpmn:sequenceFlow id="SequenceFlow_RegistrationSubmitted" sourceRef="Task_CompleteRegistration" targetRef="End_Event_CourseTicket">
      <bpmn:name>Ticket Issued</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Data Objects -->
  <bpmn:dataObjectReference id="Data_CustomerInfo" name="Customer Information"/>
  <bpmn:dataObjectReference id="Data_CourseSelection" name="Course Selection Details"/>
  <bpmn:dataObjectReference id="Data_PaymentInformation" name="Payment Information"/>

</bpmn:definitions>