<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_WorkLiveAustria">
    <bpmn:participant id="Participant_Applicant" name="Applicant Process" processRef="Process_VisaAndResidence"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_VisaAndResidence" isExecutable="false">
    
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_CheckRequirements" name="Check Requirements for Work and Live in Austria">
      <bpmn:outgoing>SequenceFlow_StartToAuthority</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Determine Competence -->
    <bpmn:task id="Task_DetermineCompetence" name="Determine Competent Authority (Territorial Competence)">
      <bpmn:incoming>SequenceFlow_StartToAuthority</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckResidence</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for Residence Check -->
    <bpmn:exclusiveGateway id="Gateway_ResidenceCheck">
      <bpmn:incoming>SequenceFlow_CheckResidence</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AuthorityAbroad</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_AuthorityLocal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Authority Tasks -->
    <bpmn:task id="Task_SubmitToRepresentation" name="Submit to Representation Office (BMEIA)">
      <bpmn:incoming>SequenceFlow_AuthorityAbroad</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareDocs</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SubmitToPolice" name="Submit to State Police Headquarters">
      <bpmn:incoming>SequenceFlow_AuthorityLocal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareDocs</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Document Preparation -->
    <bpmn:parallelGateway id="Parallel_GatherDocuments">
      <bpmn:incoming>SequenceFlow_PrepareDocs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PassportCheck</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_InsuranceCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_Passport" name="Travel Document">
      <bpmn:textContent>Valid &gt; Visa Duration + 3 Months, Issued within last 10 years</bpmn:textContent>
    </bpmn:dataObjectReference>

    <bpmn:task id="Task_PassportCheck" name="Validate Passport">
      <bpmn:incoming>SequenceFlow_PassportCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PhotoCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:dataObjectReference id="Data_Insurance" name="Health Insurance Policy">
      <bpmn:textContent>Cover 30,000 Euro, Schengen Area Validity</bpmn:textContent>
    </bpmn:dataObjectReference>

    <bpmn:task id="Task_InsuranceCheck" name="Validate Health Insurance">
      <bpmn:incoming>SequenceFlow_InsuranceCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FundsCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:dataObjectReference id="Data_PassportPhoto" name="Passport Photo">
      <bpmn:textContent>Portrait 35 x 45 mm, Specified Criteria</bpmn:textContent>
    </bpmn:dataObjectReference>

    <bpmn:task id="Task_PhotoCheck" name="Validate Passport Photo (35x45mm)">
      <bpmn:incoming>SequenceFlow_PassportPhotoRef</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FundsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Funds Data Object -->
    <bpmn:dataObjectReference id="Data_Funds" name="Means of Subsistence">
      <bpmn:textContent>Sufficient for stay and return journey</bpmn:textContent>
    </bpmn:dataObjectReference>

    <!-- Decision Gateway for Documents -->
    <bpmn:exclusiveGateway id="Gateway_DocumentsValid">
      <bpmn:incoming>SequenceFlow_FundsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplyVisa</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedDocs</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Rejection -->
    <bpmn:endEvent id="End_Event_DocRejected" name="Application Rejected (Invalid Docs)">
      <bpmn:incoming>SequenceFlow_RejectedDocs</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Visa Submission Task -->
    <bpmn:task id="Task_VisaSubmission" name="Submit Visa Application Form">
      <bpmn:incoming>SequenceFlow_ApplyVisa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Decision Gateway for Visa -->
    <bpmn:exclusiveGateway id="Gateway_VisaDecision">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedVisa</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DeniedVisa</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for Denied Visa -->
    <bpmn:endEvent id="End_Event_VisaDenied" name="Visa Denied">
      <bpmn:incoming>SequenceFlow_DeniedVisa</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Parallel Gateway for Arrival Prep -->
    <bpmn:parallelGateway id="Parallel_ArrivalPrep">
      <bpmn:incoming>SequenceFlow_ApprovedVisa</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrganizeAccommodation</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OpenBankAccount</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Accommodation Task -->
    <bpmn:task id="Task_Accommodation" name="Organise Accommodation">
      <bpmn:incoming>SequenceFlow_OrganizeAccommodation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- Bank Account Task -->
    <bpmn:task id="Task_BankAccount" name="Negotiate Bank Account">
      <bpmn:incoming>SequenceFlow_OpenBankAccount</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConvergeEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Success -->
    <bpmn:endEvent id="End_Event_Success" name="Work and Live in Austria">
      <bpmn:incoming>SequenceFlow_ConvergeEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  
  <!-- Initial Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_StartToAuthority" name="" sourceRef="Start_Event_CheckRequirements" targetRef="Task_DetermineCompetence"/>
  <bpmn:sequenceFlow id="SequenceFlow_CheckResidence" name="" sourceRef="Task_DetermineCompetence" targetRef="Gateway_ResidenceCheck"/>

  <!-- Territorial Competence Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_AuthorityAbroad" name="Applicant Abroad / First Entry" sourceRef="Gateway_ResidenceCheck" targetRef="Task_SubmitToRepresentation">
    <bpmn:name>Apply at Representation Office (BMEIA)</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_AuthorityLocal" name="Residence in Austria / Extension" sourceRef="Gateway_ResidenceCheck" targetRef="Task_SubmitToPolice">
    <bpmn:name>Apply at State Police Headquarters</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Document Preparation Flow -->
  <bpmn:sequenceFlow id="SequenceFlow_PrepareDocs" name="" sourceRef="Task_SubmitToRepresentation" targetRef="Parallel_GatherDocuments"/>
  
  <!-- Split for Checks (Note: In a real model, all checks should originate from Parallel Gateway) -->
  <bpmn:sequenceFlow id="SequenceFlow_PassportCheck" name="" sourceRef="Parallel_GatherDocuments" targetRef="Task_PassportCheck"/>
  <bpmn:sequenceFlow id="SequenceFlow_InsuranceCheck" name="" sourceRef="Parallel_GatherDocuments" targetRef="Task_InsuranceCheck"/>

  <!-- Photo Check Logic -->
  <bpmn:task id="Task_PhotoPrep">
    <bpmn:name>Prepare Passport Photo (35x45mm)</bpmn:name>
  </bpmn:task>
  
  <bpmn:sequenceFlow id="SequenceFlow_PassportPhotoRef" name="" sourceRef="Parallel_GatherDocuments" targetRef="Task_PhotoPrep"/>

  <!-- Converging Checks -->
  <bpmn:sequenceFlow id="SequenceFlow_PhotoCheck" name="" sourceRef="Task_InsuranceCheck" targetRef="Gateway_DocumentsValid">
    <bpmn:name>Proof of Subsistence</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Correction for Photo Flow to converge -->
  <bpmn:sequenceFlow id="SequenceFlow_PhotoToFunds" name="" sourceRef="Task_PhotoPrep" targetRef="Gateway_DocumentsValid"/>

  <!-- Decision Logic -->
  <bpmn:sequenceFlow id="SequenceFlow_ApplyVisa" name="" sourceRef="Gateway_DocumentsValid" targetRef="Task_VisaSubmission"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_RejectedDocs" name="Invalid Documents" sourceRef="Gateway_DocumentsValid" targetRef="End_Event_DocRejected">
    <bpmn:name>Missing/Invalid Docs</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Visa Submission -->
  <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" name="" sourceRef="Task_VisaSubmission" targetRef="Gateway_VisaDecision"/>

  <!-- Final Decision -->
  <bpmn:sequenceFlow id="SequenceFlow_ApprovedVisa" name="Approved (Rot-Weiss-Rot Card)" sourceRef="Gateway_VisaDecision" targetRef="Parallel_ArrivalPrep">
    <bpmn:name>Visa Granted</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_DeniedVisa" name="" sourceRef="Gateway_VisaDecision" targetRef="End_Event_VisaDenied">
    <bpmn:name>Grounds for Refusal</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Post Visa Steps -->
  <bpmn:sequenceFlow id="SequenceFlow_OrganizeAccommodation" name="" sourceRef="Parallel_ArrivalPrep" targetRef="Task_Accommodation"/>
  
  <bpmn:sequenceFlow id="SequenceFlow_OpenBankAccount" name="" sourceRef="Parallel_ArrivalPrep" targetRef="Task_BankAccount">
    <bpmn:name>Negotiate Bank Account</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- End -->
  <bpmn:sequenceFlow id="SequenceFlow_ConvergeEnd" name="" sourceRef="Task_Accommodation" targetRef="End_Event_Success"/>

  <!-- Associations for Data Objects (Optional but good practice) -->
  <bpmn:association id="Assoc_Passport" sourceRef="Task_PassportCheck" targetRef="Data_Passport"/>
  <bpmn:association id="Assoc_Insurance" sourceRef="Task_InsuranceCheck" targetRef="Data_Insurance"/>
  <bpmn:association id="Assoc_Photo" sourceRef="Task_PhotoPrep" targetRef="Data_PassportPhoto"/>

</bpmn:definitions>