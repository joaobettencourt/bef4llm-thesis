<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_LANParty_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_LAN_Party">
    <bpmn:participant id="Participant_Organizer" name="LAN Party Organizer" processRef="Process_LAN_Planning"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_LAN_Planning" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Organizer_01" name="Organizer">
        <bpmn:flowNodeRef>StartEvent_SendInvites</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendInvitations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_GameMissing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadGames</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppointDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AttendanceCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BeerCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuyBeer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EnjoyParty</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SendInvites" name="Send Invitations">
      <bpmn:outgoing>SequenceFlow_StartToSplit</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Send Invitations -->
    <bpmn:task id="Task_SendInvitations" name="Send invitations to friends">
      <bpmn:incoming>SequenceFlow_StartToSplit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway Split -->
    <bpmn:parallelGateway id="Gateway_PrepSplit">
      <bpmn:incoming>SequenceFlow_SplitPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GamePath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_DatePath</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path 1: Games -->
    <bpmn:task id="Task_CollectGames" name="Find out which games they want">
      <bpmn:incoming>SequenceFlow_GamePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckInventory</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_CheckInventory" name="Check if you have all the games">
      <bpmn:incoming>SequenceFlow_CheckInventory</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GameDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Game Missing? -->
    <bpmn:exclusiveGateway id="Gateway_GameMissing">
      <bpmn:incoming>SequenceFlow_GameDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DownloadGames</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JoinGamePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 2: Download Games -->
    <bpmn:task id="Task_DownloadGames" name="Download missing games">
      <bpmn:incoming>SequenceFlow_DownloadGames</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinGamePath</bpmn:outgoing>
    </bpmn:task>

    <!-- Path 2: Date -->
    <bpmn:task id="Task_AppointDate" name="Appoint a date">
      <bpmn:incoming>SequenceFlow_DatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAttendance</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Attendance Check -->
    <bpmn:exclusiveGateway id="Gateway_AttendanceCheck">
      <bpmn:incoming>SequenceFlow_CheckAttendance</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ContinueDateLoop</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_JoinDatePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Join Gateway for Prep Phase -->
    <bpmn:parallelGateway id="Gateway_PrepJoin">
      <bpmn:incoming>SequenceFlow_JoinGamePath</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinDatePath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBeerCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 3: Beer Calculation -->
    <bpmn:task id="Task_CalculateBeer" name="Find out how much beer is required">
      <bpmn:incoming>SequenceFlow_StartBeerCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BeerDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Beer Check -->
    <bpmn:exclusiveGateway id="Gateway_BeerCheck">
      <bpmn:incoming>SequenceFlow_BeerDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BuyBeerTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task 4: Buy Beer -->
    <bpmn:task id="Task_BuyBeer" name="Buy what's missing">
      <bpmn:incoming>SequenceFlow_BuyBeerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_EnjoyParty" name="Enjoy LAN Party">
      <bpmn:incoming>SequenceFlow_ToEndEvent</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSplit" sourceRef="StartEvent_SendInvites" targetRef="Task_SendInvitations"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitPrep" name="" sourceRef="Task_SendInvitations" targetRef="Gateway_PrepSplit"/>

    <!-- Game Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GamePath" name="" sourceRef="Gateway_PrepSplit" targetRef="Task_CollectGames"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckInventory" name="" sourceRef="Task_CollectGames" targetRef="Task_CheckInventory"/>

    <bpmn:sequenceFlow id="SequenceFlow_GameDecision" name="" sourceRef="Task_CheckInventory" targetRef="Gateway_GameMissing"/>
    
    <!-- Game Decision Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_DownloadGames" name="If missing" sourceRef="Gateway_GameMissing" targetRef="Task_DownloadGames">
      <bpmn:name>Some are missing</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinGamePath" name="" sourceRef="Task_DownloadGames" targetRef="Gateway_PrepJoin"/>
    
    <!-- Game Decision No Missing -->
    <bpmn:sequenceFlow id="SequenceFlow_GameSkipDownload" name="" sourceRef="Gateway_GameMissing" targetRef="Gateway_PrepJoin">
      <bpmn:name>All games present</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Date Path -->
    <bpmn:sequenceFlow id="SequenceFlow_DatePath" name="" sourceRef="Gateway_PrepSplit" targetRef="Task_AppointDate"/>

    <bpmn:sequenceFlow id="SequenceFlow_CheckAttendance" name="" sourceRef="Task_AppointDate" targetRef="Gateway_AttendanceCheck">
      <bpmn:name>Appointed</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Attendance Decision Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_ContinueDateLoop" name="" sourceRef="Gateway_AttendanceCheck" targetRef="Task_AppointDate">
      <bpmn:name>&lt; 8 agree</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_JoinDatePath" name="" sourceRef="Gateway_AttendanceCheck" targetRef="Gateway_PrepJoin">
      <bpmn:name>&gt;= 8 agree</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Beer Path -->
    <bpmn:sequenceFlow id="SequenceFlow_StartBeerCheck" name="" sourceRef="Gateway_PrepJoin" targetRef="Task_CalculateBeer"/>

    <bpmn:sequenceFlow id="SequenceFlow_BeerDecision" name="" sourceRef="Task_CalculateBeer" targetRef="Gateway_BeerCheck">
      <bpmn:name>Calculated</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Beer Decision Outcomes -->
    <bpmn:sequenceFlow id="SequenceFlow_BuyBeerTask" name="" sourceRef="Gateway_BeerCheck" targetRef="Task_BuyBeer">
      <bpmn:name>If not enough</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ToEndEvent" name="" sourceRef="Task_BuyBeer" targetRef="EndEvent_EnjoyParty"/>
    
    <!-- Beer Decision Skip -->
    <bpmn:sequenceFlow id="SequenceFlow_SkipBuyBeer" name="" sourceRef="Gateway_BeerCheck" targetRef="EndEvent_EnjoyParty">
      <bpmn:name>Enough beer</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>