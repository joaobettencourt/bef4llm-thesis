<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_roboticBurgerSeller" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoboticBurger">
    <bpmn:participant id="Participant_BurgerRobot" name="Robotic Burger Seller - University of Vienna" processRef="Process_OrderFulfillment"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_OrderFulfillment" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="Start_Event_ReceiveOrder" name="Robot Receives Order">
      <bpmn:outgoing>SequenceFlow_StartToMenuDecision</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Menu or Burger Only Decision -->
    <bpmn:exclusiveGateway id="Gateway_MenuOrBurger" name="Order Type?">
      <bpmn:incoming>SequenceFlow_StartToMenuDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MenuPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_BurgerOnlyPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Menu Path - Prepare Drink -->
    <bpmn:task id="Task_PrepareDrink" name="Prepare Drink (Variable Time)">
      <bpmn:incoming>SequenceFlow_MenuPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkToSideChoice</bpmn:outgoing>
    </bpmn:task>

    <!-- Side Dish Choice -->
    <bpmn:exclusiveGateway id="Gateway_FriesOrWedges" name="Fries or Wedges?">
      <bpmn:incoming>SequenceFlow_DrinkToSideChoice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FriesPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WedgesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Fries Preparation -->
    <bpmn:task id="Task_PrepareFries" name="Prepare Fries (Variable Time)">
      <bpmn:incoming>SequenceFlow_FriesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideToBurgerPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Wedges Preparation -->
    <bpmn:task id="Task_PrepareWedges" name="Prepare Wedges (Variable Time)">
      <bpmn:incoming>SequenceFlow_WedgesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SideToBurgerPrep</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Burger and Status Updates -->
    <bpmn:parallelGateway id="Parallel_BurgerAndUpdates" name="Start Processing">
      <bpmn:incoming>SequenceFlow_SideToBurgerPrep</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartBurgerTask</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Burger Preparation Task -->
    <bpmn:task id="Task_PrepareBurger" name="Prepare Burger (Variable Time)">
      <bpmn:incoming>SequenceFlow_StartBurgerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BurgerToDeliveryCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Status Update Timer Loop -->
    <bpmn:intermediateCatchEvent id="Timer_StatusUpdate" name="Status Update (30s)">
      <bpmn:timerEventDefinition/>
      <bpmn:incoming>SequenceFlow_StartUpdates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateLoopBack</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Parallel Gateway for Status Updates -->
    <bpmn:parallelGateway id="Parallel_StatusUpdates" name="Status Update Loop">
      <bpmn:incoming>SequenceFlow_StartBurgerTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartUpdates</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Burger Only Path -->
    <bpmn:task id="Task_PrepareDrinkBurgerOnly" name="Prepare Drink (Optional)">
      <bpmn:incoming>SequenceFlow_BurgerOnlyPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DrinkToParallelStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Delivery Check -->
    <bpmn:exclusiveGateway id="Gateway_AllItemsReady" name="All Items Ready?">
      <bpmn:incoming>SequenceFlow_BurgerToDeliveryCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_OrderDelivered" name="Order Delivered via Conveyor Belt">
      <bpmn:incoming>SequenceFlow_DeliveryPath</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- Sequence Flows -->
  <bpmn:sequenceFlow id="SequenceFlow_StartToMenuDecision" sourceRef="Start_Event_ReceiveOrder" targetRef="Gateway_MenuOrBurger"/>

  <bpmn:sequenceFlow id="SequenceFlow_MenuPath" name="Yes - Menu Order">
    <bpmn:name>Is Menu?</bpmn:name>
    <bpmn:sourceRef>Gateway_MenuOrBurger</bpmn:sourceRef>
    <bpmn:targetRef>Task_PrepareDrink</bpmn:targetRef>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_BurgerOnlyPath" name="No - Burger Only">
    <bpmn:name>Burger Only</bpmn:name>
    <bpmn:sourceRef>Gateway_MenuOrBurger</bpmn:sourceRef>
    <bpmn:targetRef>Task_PrepareDrinkBurgerOnly</bpmn:targetRef>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_DrinkToSideChoice" sourceRef="Task_PrepareDrink" targetRef="Gateway_FriesOrWedges"/>

  <bpmn:sequenceFlow id="SequenceFlow_FriesPath" name="Fries">
    <bpmn:name>Choose Fries</bpmn:name>
    <bpmn:sourceRef>Gateway_FriesOrWedges</bpmn:sourceRef>
    <bpmn:targetRef>Task_PrepareFries</bpmn:targetRef>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_WedgesPath" name="Wedges">
    <bpmn:name>Choose Wedges</bpmn:name>
    <bpmn:sourceRef>Gateway_FriesOrWedges</bpmn:sourceRef>
    <bpmn:targetRef>Task_PrepareWedges</bpmn:targetRef>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_SideToBurgerPrep" sourceRef="Gateway_FriesOrWedges" targetRef="Parallel_BurgerAndUpdates"/>

  <bpmn:sequenceFlow id="SequenceFlow_DrinkToParallelStart" sourceRef="Task_PrepareDrinkBurgerOnly" targetRef="Parallel_StatusUpdates"/>

  <bpmn:sequenceFlow id="SequenceFlow_StartBurgerTask" name="" sourceRef="Parallel_BurgerAndUpdates" targetRef="Task_PrepareBurger"/>

  <bpmn:sequenceFlow id="SequenceFlow_StartUpdates" name="" sourceRef="Parallel_StatusUpdates" targetRef="Timer_StatusUpdate"/>

  <bpmn:sequenceFlow id="SequenceFlow_UpdateLoopBack" name="" sourceRef="Timer_StatusUpdate" targetRef="Task_PrepareBurger">
    <bpmn:name>Continue Updates</bpmn:name>
  </bpmn:sequenceFlow>

  <bpmn:sequenceFlow id="SequenceFlow_BurgerToDeliveryCheck" sourceRef="Task_PrepareBurger" targetRef="Gateway_AllItemsReady"/>

  <bpmn:sequenceFlow id="SequenceFlow_DeliveryPath" name="" sourceRef="Gateway_AllItemsReady" targetRef="End_Event_OrderDelivered">
    <bpmn:name>All Items Ready</bpmn:name>
  </bpmn:sequenceFlow>

  <!-- Data Objects -->
  <bpmn:dataObjectReference id="Data_CustomerPreferences"/>
  <bpmn:association sourceRef="Gateway_MenuOrBurger" targetRef="Data_CustomerPreferences"/>

  <bpmn:dataObjectReference id="Data_SideDishChoice"/>
  <bpmn:association sourceRef="Gateway_FriesOrWedges" targetRef="Data_SideDishChoice"/>

</bpmn:definitions>