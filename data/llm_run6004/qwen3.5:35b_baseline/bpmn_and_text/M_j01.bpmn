<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_ChainsawProduction">
    <bpmn:participant id="Participant_Manufacturing" name="Chainsaw Manufacturing Process" processRef="Process_ChainsawOrder"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_ChainsawOrder" isExecutable="false">
    
    <!-- Lane Set for Organizing Activities -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CustomerInteraction" name="Customer Interaction">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordSpecifications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CustomerApproval</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Procurement &amp; Logistics">
        <bpmn:flowNodeRef>ParallelGateway_OrderParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderGuideBar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderChain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OrderMotorComponents</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ParallelGateway_JoinParts</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_QualityControl" name="Quality Control">
        <bpmn:flowNodeRef>Task_InspectAllParts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartsAcceptable</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Assembly" name="Assembly">
        <bpmn:flowNodeRef>Task_AssembleChainsaw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_FirstSawComplete</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Communication" name="Communication">
        <bpmn:flowNodeRef>Task_SendProductionUpdates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FirstSawSent</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_FullOrder" name="Full Order Production">
        <bpmn:flowNodeRef>Task_ProduceRestOfOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OrderComplete</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Receive Customer Order">
      <bpmn:outgoing>SequenceFlow_StartToSpecs</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Record Specifications -->
    <bpmn:task id="Task_RecordSpecifications" name="Record Chain Saw Properties">
      <bpmn:incoming>SequenceFlow_StartToSpecs</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SpecsToOrderParts</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Ordering Parts -->
    <bpmn:parallelGateway id="ParallelGateway_OrderParts">
      <bpmn:incoming>SequenceFlow_SpecsToOrderParts</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OrderGuideBar</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderChain</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_OrderMotorComponents</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Order Guide Bar -->
    <bpmn:task id="Task_OrderGuideBar" name="Order Guide Bar">
      <bpmn:incoming>SequenceFlow_OrderGuideBar</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GuideBarArrives</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order Chain -->
    <bpmn:task id="Task_OrderChain" name="Order Chains">
      <bpmn:incoming>SequenceFlow_OrderChain</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ChainArrives</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Order Motor Components -->
    <bpmn:task id="Task_OrderMotorComponents" name="Order Electric/Motor Components">
      <bpmn:incoming>SequenceFlow_OrderMotorComponents</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MotorArrives</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway to Join Parts -->
    <bpmn:parallelGateway id="ParallelGateway_JoinParts">
      <bpmn:incoming>SequenceFlow_GuideBarArrives</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ChainArrives</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MotorArrives</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartsReadyForInspection</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Manual Inspection -->
    <bpmn:task id="Task_InspectAllParts" name="Manual Inspection of All Parts">
      <bpmn:incoming>SequenceFlow_PartsReadyForInspection</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckAcceptable</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Quality Check -->
    <bpmn:exclusiveGateway id="Gateway_PartsAcceptable">
      <bpmn:incoming>SequenceFlow_CheckAcceptable</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InspectionPassed</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReorderParts</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Assemble Chainsaw -->
    <bpmn:task id="Task_AssembleChainsaw" name="Assemble Parts into First Saw">
      <bpmn:incoming>SequenceFlow_InspectionPassed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirstSawReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Send Production Updates -->
    <bpmn:task id="Task_SendProductionUpdates" name="Send Regular Customer Updates">
      <bpmn:incoming>SequenceFlow_InspectionPassed</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UpdateSent</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for First Saw Approval -->
    <bpmn:exclusiveGateway id="Gateway_CustomerApproval">
      <bpmn:incoming>SequenceFlow_FirstSawReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApprovedContinue</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectedStop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event for First Saw Sent -->
    <bpmn:endEvent id="EndEvent_FirstSawSent" name="First Saw Delivered">
      <bpmn:incoming>SequenceFlow_SentToCustomer</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task: Produce Rest of Order -->
    <bpmn:task id="Task_ProduceRestOfOrder" name="Produce Remaining Orders">
      <bpmn:incoming>SequenceFlow_ApprovedContinue</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RestComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Order Complete -->
    <bpmn:endEvent id="EndEvent_OrderComplete" name="Order Completed">
      <bpmn:incoming>SequenceFlow_RestComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToSpecs" sourceRef="StartEvent_1" targetRef="Task_RecordSpecifications"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SpecsToOrderParts" name="Properties Recorded" sourceRef="Task_RecordSpecifications" targetRef="ParallelGateway_OrderParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_OrderGuideBar" sourceRef="ParallelGateway_OrderParts" targetRef="Task_OrderGuideBar"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_OrderChain" name="Order Parts in Parallel" sourceRef="ParallelGateway_OrderParts" targetRef="Task_OrderChain"/>

    <bpmn:sequenceFlow id="SequenceFlow_OrderMotorComponents" sourceRef="ParallelGateway_OrderParts" targetRef="Task_OrderMotorComponents"/>

    <bpmn:sequenceFlow id="SequenceFlow_GuideBarArrives" name="Guide Bar Arrived" sourceRef="Task_OrderGuideBar" targetRef="ParallelGateway_JoinParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_ChainArrives" name="Chain Arrived" sourceRef="Task_OrderChain" targetRef="ParallelGateway_JoinParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_MotorArrives" name="Motor Components Arrived" sourceRef="Task_OrderMotorComponents" targetRef="ParallelGateway_JoinParts"/>

    <bpmn:sequenceFlow id="SequenceFlow_PartsReadyForInspection" sourceRef="ParallelGateway_JoinParts" targetRef="Task_InspectAllParts"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckAcceptable" name="Quality Check Complete" sourceRef="Task_InspectAllParts" targetRef="Gateway_PartsAcceptable"/>

    <bpmn:sequenceFlow id="SequenceFlow_InspectionPassed" name="Parts Acceptable - Yes" sourceRef="Gateway_PartsAcceptable" targetRef="Task_AssembleChainsaw">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ReorderParts" name="Parts Not Acceptable - No" sourceRef="Gateway_PartsAcceptable" targetRef="ParallelGateway_OrderParts">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway for Updates -->
    <bpmn:parallelGateway id="ParallelGateway_SendUpdates"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_InspectionPassedToUpdate" sourceRef="Task_AssembleChainsaw" targetRef="ParallelGateway_SendUpdates">
      <bpmn:name>Start Updates</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway for Update Join -->
    <bpmn:parallelGateway id="ParallelGateway_UpdateJoin"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_UpdateSent" sourceRef="Task_SendProductionUpdates" targetRef="ParallelGateway_UpdateJoin">
      <bpmn:name>Update Sent</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Parallel Gateway for Assembly Continue -->
    <bpmn:parallelGateway id="ParallelGateway_AssemblyContinue"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FirstSawReady" name="First Saw Complete" sourceRef="Task_AssembleChainsaw" targetRef="Gateway_CustomerApproval">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Customer Approval Decision -->
    <bpmn:sequenceFlow id="SequenceFlow_ApprovedContinue" name="Customer Likes It - Yes" sourceRef="Gateway_CustomerApproval" targetRef="Task_ProduceRestOfOrder">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_RejectedStop" name="Customer Does Not Like - No" sourceRef="Gateway_CustomerApproval" targetRef="EndEvent_FirstSawSent">
      <bpmn:name>No</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Send to Customer -->
    <bpmn:task id="Task_SendToCustomer" name="Send First Saw to Customer">
      <bpmn:incoming>SequenceFlow_FirstSawReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SentToCustomer</bpmn:outgoing>
    </bpmn:task>

    <!-- Message for Updates -->
    <bpmn:message id="Message_CustomerUpdate" name="Production Update Notification"/>

    <bpmn:sequenceFlow id="SequenceFlow_SentToCustomer" sourceRef="Task_SendToCustomer" targetRef="EndEvent_FirstSawSent">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Produce Rest of Order -->
    <bpmn:sequenceFlow id="SequenceFlow_RestComplete" name="Rest Complete" sourceRef="Task_ProduceRestOfOrder" targetRef="EndEvent_OrderComplete">
      <bpmn:name>Yes</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>