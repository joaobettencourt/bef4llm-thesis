<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Internship_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Internship_1">
    <bpmn:participant id="Participant_EGovernment_System" name="Internship Management System" processRef="Process_Internship_Lifecycle"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_Internship_Lifecycle" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Candidate" name="Candidate (Intern)">
        <bpmn:flowNodeRef>StartEvent_SubmitProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EnterDetails</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecideOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_WaitingPhase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteStatusUpdate1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteStatusUpdate2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteStatusUpdate3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InternshipEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecommendCompany</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Company" name="Company (HR)">
        <bpmn:flowNodeRef>Gateway_InternshipStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteReview1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteReview2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteReview3</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SocialMedia" name="Twitter System">
        <bpmn:flowNodeRef>Gateway_SendTweets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriend1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TweetFriend2</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>IntermediateCatchEvent_OfferReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_OffersInvalidated</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_SubmitProfile" name="Submit Internship Profile">
      <bpmn:outgoing>SequenceFlow_ProfileToDetails</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Enter Details -->
    <bpmn:task id="Task_EnterDetails" name="Enter Topic, Money, Experience &amp; Hobbies">
      <bpmn:incoming>SequenceFlow_ProfileToDetails</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DetailsToWaitLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- SubProcess for Waiting Phase (Offers) -->
    <bpmn:subProcess id="SubProcess_WaitingPhase" name="Waiting for Offers">
      <bpmn:startEvent id="StartLoop_OfferWait"/>
      <bpmn:endEvent id="EndLoop_Accepted"/>

      <!-- Intermediate Catch Event (Receive Offer) -->
      <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_OfferReceived" name="Offer Arrives">
        <bpmn:messageEventDefinition/>
        <bpmn:incoming>SequenceFlow_WaitLoopStart</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ToDecisionGateway</bpmn:outgoing>
      </bpmn:intermediateCatchEvent>

      <!-- Gateway Decision -->
      <bpmn:exclusiveGateway id="Gateway_DecideOffer" name="Accept Offer?">
        <bpmn:incoming>SequenceFlow_ToDecisionGateway</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_DenyLoopBack</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_AcceptInternshipStart</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <!-- Loop Logic -->
      <bpmn:sequenceFlow id="SequenceFlow_WaitLoopStart" sourceRef="StartLoop_OfferWait" targetRef="IntermediateCatchEvent_OfferReceived"/>
      <bpmn:sequenceFlow id="SequenceFlow_ToDecisionGateway" sourceRef="IntermediateCatchEvent_OfferReceived" targetRef="Gateway_DecideOffer"/>

      <!-- Deny Path -->
      <bpmn:sequenceFlow id="SequenceFlow_DenyLoopBack" name="Deny">
        <bpmn:name>Not Accepted</bpmn:name>
        <bpmn:sourceRef>Gateway_DecideOffer</bpmn:sourceRef>
        <bpmn:targetRef>StartLoop_OfferWait</bpmn:targetRef>
      </bpmn:sequenceFlow>

      <!-- Accept Path -->
      <bpmn:sequenceFlow id="SequenceFlow_AcceptInternship" name="Accept">
        <bpmn:name>Accepted - Start Internship</bpmn:name>
        <bpmn:sourceRef>Gateway_DecideOffer</bpmn:sourceRef>
        <bpmn:targetRef>EndLoop_Accepted</bpmn:targetRef>
      </bpmn:sequenceFlow>

    </bpmn:subProcess>

    <!-- Internship Start Gateway -->
    <bpmn:startEvent id="StartEvent_Internship" name="Internship Started">
      <bpmn:outgoing>SequenceFlow_StartToParallel</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Split for Internship Tasks -->
    <bpmn:parallelGateway id="Gateway_InternshipStart" name="Internship Phase">
      <bpmn:incoming>SequenceFlow_AcceptInternship</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CandidateUpdates</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_CompanyReviews</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Candidate Updates (3 Status Updates) -->
    <bpmn:task id="Task_WriteStatusUpdate1" name="Write Update 1">
      <bpmn:incoming>SequenceFlow_CandidateUpdates</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Update2Path</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteStatusUpdate2" name="Write Update 2">
      <bpmn:incoming>SequenceFlow_Update2Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Update3Path</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteStatusUpdate3" name="Write Update 3">
      <bpmn:incoming>SequenceFlow_Update3Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Company Reviews (3 Status Updates) -->
    <bpmn:task id="Task_WriteReview1" name="Write Review 1">
      <bpmn:incoming>SequenceFlow_CompanyReviews</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Review2Path</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteReview2" name="Write Review 2">
      <bpmn:incoming>SequenceFlow_Review2Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Review3Path</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_WriteReview3" name="Write Review 3">
      <bpmn:incoming>SequenceFlow_Review3Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InternshipMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Internship Phase -->
    <bpmn:parallelGateway id="Gateway_InternshipEnd" name="Internship Finished">
      <bpmn:incoming>SequenceFlow_CandidateUpdates</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CompanyReviews</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRecommendation</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Recommendation Task -->
    <bpmn:task id="Task_RecommendCompany" name="Recommend Company to Friends">
      <bpmn:incoming>SequenceFlow_InternshipMerge2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToTweetSplit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Tweet Sending -->
    <bpmn:parallelGateway id="Gateway_SendTweets" name="Send Tweets">
      <bpmn:incoming>SequenceFlow_ToRecommendation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Tweet1Path</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Tweet2Path</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Tweet Tasks -->
    <bpmn:task id="Task_TweetFriend1" name="Tweet Friend 1">
      <bpmn:incoming>SequenceFlow_Tweet1Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeTweets_1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_TweetFriend2" name="Tweet Friend 2">
      <bpmn:incoming>SequenceFlow_Tweet2Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergeTweets_2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_ProcessFinished" name="Process Finished">
      <bpmn:incoming>SequenceFlow_ToTweetSplit</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows (Connecting Logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_ProfileToDetails" sourceRef="StartEvent_SubmitProfile" targetRef="Task_EnterDetails"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DetailsToWaitLoop" name="" sourceRef="Task_EnterDetails" targetRef="SubProcess_WaitingPhase">
      <!-- Note: In BPMN, connecting to Subprocess start is implicit via flow -->
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="Gateway_MergeTweets_Final">
      <bpmn:incoming>SequenceFlow_MergeTweets_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeTweets_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent_Final</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Sequence Flows (Connecting Logic) -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToParallel" sourceRef="StartEvent_Internship" targetRef="Gateway_InternshipStart"/> 
    <bpmn:sequenceFlow id="SequenceFlow_CandidateUpdates" sourceRef="Gateway_InternshipStart" targetRef="Task_WriteStatusUpdate1"/>
    <bpmn:sequenceFlow id="SequenceFlow_CompanyReviews" sourceRef="Gateway_InternshipStart" targetRef="Task_WriteReview1"/>

    <!-- Internship Updates -->
    <bpmn:sequenceFlow id="SequenceFlow_Update2Path" sourceRef="Task_WriteStatusUpdate1" targetRef="Task_WriteStatusUpdate2"/>
    <bpmn:sequenceFlow id="SequenceFlow_Update3Path" sourceRef="Task_WriteStatusUpdate2" targetRef="Task_WriteStatusUpdate3"/>

    <!-- Company Reviews -->
    <bpmn:sequenceFlow id="SequenceFlow_Review2Path" sourceRef="Task_WriteReview1" targetRef="Task_WriteReview2"/>
    <bpmn:sequenceFlow id="SequenceFlow_Review3Path" sourceRef="Task_WriteReview2" targetRef="Task_WriteReview3"/>

    <!-- Merge Internship -->
    <bpmn:parallelGateway id="Gateway_InternshipEnd_Merge">
      <bpmn:incoming>SequenceFlow_Update3Path</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_Review3Path</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToRecommendation_Final</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Recommendation Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_InternshipMerge" sourceRef="Task_WriteStatusUpdate3" targetRef="Gateway_InternshipEnd_Merge"/> 
    <bpmn:sequenceFlow id="SequenceFlow_InternshipMerge2" sourceRef="Task_WriteReview3" targetRef="Gateway_InternshipEnd_Merge"/>
    
    <!-- Tweet Split -->
    <bpmn:sequenceFlow id="SequenceFlow_ToRecommendation_Final" name="" sourceRef="Gateway_InternshipEnd_Merge" targetRef="Task_RecommendCompany"> 
      <bpmn:name>Internship Finished</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Tweet Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_ToTweetSplit_Corrected" name="" sourceRef="Task_RecommendCompany" targetRef="Gateway_SendTweets"> 
      <bpmn:name>Recommendation Complete</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Tweet Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_Tweet1Path" sourceRef="Gateway_SendTweets" targetRef="Task_TweetFriend1"/>
    <bpmn:sequenceFlow id="SequenceFlow_Tweet2Path" sourceRef="Gateway_SendTweets" targetRef="Task_TweetFriend2"/>

    <!-- Tweet Merge -->
    <bpmn:parallelGateway id="Gateway_MergeTweets_Final">
      <bpmn:incoming>SequenceFlow_MergeTweets_1</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergeTweets_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndEvent_Final</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_MergeTweets_1" sourceRef="Task_TweetFriend1" targetRef="Gateway_MergeTweets_Final"/> 
    <bpmn:sequenceFlow id="SequenceFlow_MergeTweets_2" sourceRef="Task_TweetFriend2" targetRef="Gateway_MergeTweets_Final"/>
    
    <!-- Final End -->
    <bpmn:endEvent id="EndEvent_ProcessFinished">
      <bpmn:incoming>SequenceFlow_ToTweetSplit</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

</bpmn:definitions>