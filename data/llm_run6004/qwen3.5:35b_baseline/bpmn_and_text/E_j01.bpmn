<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_FindJob_001" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_JobSeekerProcess">
    <bpmn:participant id="Participant_JobSeekerSystem" name="Find a Job Process" processRef="Proc_FindJob_001"/>
  </bpmn:collaboration>

  <bpmn:process id="Proc_FindJob_001" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_JobSeeker" name="Applicant (You)">
        <bpmn:flowNodeRef>StartEvent_ReportApps</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitApplications</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NegotiateInterview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HiredDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProbationPhase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EvaluationResult</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SystemCompanies" name="System / Companies">
        <bpmn:flowNodeRef>Task_SendOffers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmReceiptRateApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PermanentJob</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ReportApps" name="Regularly Report Applications">
      <bpmn:outgoing>SeqFlow_ApplicationsToOffers</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Submit Reports (Applicant) -->
    <bpmn:task id="Task_SubmitApplications" name="Report Job Applications">
      <bpmn:incoming>SeqFlow_ApplicationsToOffers</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ProcessApps</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: System Sends Offers (System) -->
    <bpmn:task id="Task_SendOffers" name="Send Potential Job Offers">
      <bpmn:incoming>SeqFlow_ProcessApps</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ConfirmReceipt</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Confirm Receipt & Rate App (System) -->
    <bpmn:task id="Task_ConfirmReceiptRateApp" name="Confirm Receipt &amp; Rate Application">
      <bpmn:incoming>SeqFlow_ConfirmReceipt</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_NegotiateInterview</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Negotiate Interview (Applicant) -->
    <bpmn:task id="Task_NegotiateInterview" name="Negotiate Job Interview">
      <bpmn:incoming>SeqFlow_NegotiateInterview</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_HiredDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Hired? -->
    <bpmn:exclusiveGateway id="Gateway_HiredDecision" name="Hired for Probation?">
      <bpmn:incoming>SeqFlow_HiredDecision</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_ProbationStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Enter Probation (Applicant) -->
    <bpmn:task id="Task_ProbationPhase" name="Enter Probation Phase">
      <bpmn:incoming>SeqFlow_ProbationStart</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_CompleteProbation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Rate Company (Applicant) -->
    <bpmn:task id="Task_RateCompany" name="Rate Company &amp; Receive Rating">
      <bpmn:incoming>SeqFlow_CompleteProbation</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_EvaluationResult</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Evaluation Result -->
    <bpmn:exclusiveGateway id="Gateway_EvaluationResult" name="Permanent Job or Rating C?">
      <bpmn:incoming>SeqFlow_EvaluationResult</bpmn:incoming>
      <bpmn:outgoing>SeqFlow_PermanentJob</bpmn:outgoing>
      <bpmn:outgoing>SeqFlow_ContinueOffers</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_PermanentJob" name="Process Ends (Permanent Job)">
      <bpmn:incoming>SeqFlow_PermanentJob</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SeqFlow_ApplicationsToOffers" sourceRef="StartEvent_ReportApps" targetRef="Task_SubmitApplications"/>
    
    <bpmn:sequenceFlow id="SeqFlow_ProcessApps" name="Based on Applications" sourceRef="Task_SubmitApplications" targetRef="Task_SendOffers"/>

    <bpmn:sequenceFlow id="SeqFlow_ConfirmReceipt" sourceRef="Task_SendOffers" targetRef="Task_ConfirmReceiptRateApp"/>
    
    <!-- Cross-lane flow -->
    <bpmn:sequenceFlow id="SeqFlow_NegotiateInterview" name="" sourceRef="Task_ConfirmReceiptRateApp" targetRef="Task_NegotiateInterview"/>

    <bpmn:sequenceFlow id="SeqFlow_HiredDecision" sourceRef="Task_NegotiateInterview" targetRef="Gateway_HiredDecision"/>
    
    <!-- Cross-lane flow -->
    <bpmn:sequenceFlow id="SeqFlow_ProbationStart" name="" sourceRef="Gateway_HiredDecision" targetRef="Task_ProbationPhase"/>

    <bpmn:sequenceFlow id="SeqFlow_CompleteProbation" sourceRef="Task_ProbationPhase" targetRef="Task_RateCompany"/>
    
    <!-- Cross-lane flow -->
    <bpmn:sequenceFlow id="SeqFlow_EvaluationResult" name="" sourceRef="Task_RateCompany" targetRef="Gateway_EvaluationResult"/>

    <!-- End Path -->
    <bpmn:sequenceFlow id="SeqFlow_PermanentJob" name="" sourceRef="Gateway_EvaluationResult" targetRef="EndEvent_PermanentJob"/>

    <!-- Loop Path -->
    <bpmn:sequenceFlow id="SeqFlow_ContinueOffers" name="" sourceRef="Gateway_EvaluationResult" targetRef="Task_SendOffers"/>

    <!-- Data Objects -->
    <bpmn:dataObjectReference id="Data_JobReview" name="Company Review">
      <bpmn:text>Reviews visible after 1 year</bpmn:text>
    </bpmn:dataObjectReference>
    
    <!-- Association for 1 Year Rule (Conceptual) -->
    <bpmn:association id="Assoc_ReviewVisibility" sourceRef="Task_RateCompany" targetRef="Data_JobReview"/>

  </bpmn:process>
</bpmn:definitions>