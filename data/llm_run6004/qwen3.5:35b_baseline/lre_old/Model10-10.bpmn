<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_FaultRepair">
    <bpmn:participant id="Participant_UserProcess" name="User Process" processRef="Process_FaultRepair"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_FaultRepair" isExecutable="true">
    
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Failure Reported/Suspected">
      <bpmn:outgoing>SequenceFlow_Examine</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Examine Failure -->
    <bpmn:task id="Task_ExamineFailure" name="Examine Failure">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Confirm vs Reject -->
    <bpmn:exclusiveGateway id="Gateway_ConfirmReject" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Confirm -->
    
    <!-- Task 2: Inform Initial (Customer & Manager) -->
    <bpmn:task id="Task_NotifyInitial" name="Inform Customer and Manager">
      <bpmn:incoming>SequenceFlow_YesPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixFault</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Fix Fault -->
    <bpmn:task id="Task_FixFault" name="Fix Fault at Measuring Device">
      <bpmn:incoming>SequenceFlow_FixFault</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ShareResults</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Share Results with Detector -->
    <bpmn:task id="Task_ShareResults" name="Share Repair Results with Fault Detector">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Parallel Split for Final Notifications -->
    <bpmn:parallelGateway id="Gateway_FinalSplit" name="Parallel Notify">
      <bpmn:incoming>SequenceFlow_SplitFinalNotify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveCustomer</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task 5: Inform Customer Resolution -->
    <bpmn:task id="Task_ResolveCustomer" name="Inform Customer of Resolution">
      <bpmn:incoming>SequenceFlow_ResolveCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 3: Parallel Join -->
    <bpmn:parallelGateway id="Gateway_FinalJoin" name="Parallel Notify">
      <bpmn:incoming>SequenceFlow_ResolveCustomer</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="End_Success" name="Resolution Complete">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Reject (Missing Info Filled) -->
    
    <!-- Task for Rejection Handling -->
    <bpmn:task id="Task_LogReject" name="Log Rejection">
      <bpmn:incoming>SequenceFlow_NoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndReject</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="End_Reject" name="Process Ended">
      <bpmn:incoming>SequenceFlow_EndReject</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_Examine" sourceRef="StartEvent_1" targetRef="Task_ExamineFailure"/>
    
    <bpmn:exclusiveGateway id="Gateway_ConfirmReject">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_DecisionPoint" sourceRef="Task_ExamineFailure" targetRef="Gateway_ConfirmReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Confirm Path -->
    
    <bpmn:exclusiveGateway id="Gateway_ConfirmReject" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_YesPath" sourceRef="Gateway_ConfirmReject" targetRef="Task_NotifyInitial">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[confirmed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Reject Path -->
    
    <bpmn:exclusiveGateway id="Gateway_ConfirmReject" name="Confirm Failure?">
      <bpmn:incoming>SequenceFlow_DecisionPoint</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_NoPath" sourceRef="Gateway_ConfirmReject" targetRef="Task_LogReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[rejected]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Flow Continuation -->
    
    <bpmn:task id="Task_ExamineFailure">
      <bpmn:incoming>SequenceFlow_Examine</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionPoint</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_FixFault" sourceRef="Task_NotifyInitial" targetRef="Task_FixFault"/>
    
    <bpmn:parallelGateway id="Gateway_FinalSplit">
      <bpmn:incoming>SequenceFlow_SplitFinalNotify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ResolveCustomer</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ResolveManager</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_SplitFinalNotify" sourceRef="Task_ShareResults" targetRef="Gateway_FinalSplit"/>

    <!-- Task 6: Inform Manager Resolution -->
    
    <bpmn:task id="Task_ResolveManager" name="Inform Manager of Resolution">
      <bpmn:incoming>SequenceFlow_ResolveManager</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JoinFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <!-- Join Gateway -->
    
    <bpmn:parallelGateway id="Gateway_FinalJoin">
      <bpmn:incoming>SequenceFlow_ResolveCustomer</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_JoinFinalNotify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Flow -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ResolveCustomer" sourceRef="Gateway_FinalSplit" targetRef="Task_ResolveCustomer"/>
    
    <bpmn:task id="Task_ShareResults">
      <bpmn:incoming>SequenceFlow_ShareResults</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitFinalNotify</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ResolveManager" sourceRef="Gateway_FinalSplit" targetRef="Task_ResolveManager"/>
    
    <bpmn:endEvent id="End_Success">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reject Flow -->
    
    <bpmn:task id="Task_LogReject" name="Log Rejection">
       <bpmn:incoming>SequenceFlow_NoPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndReject</bpmn:outgoing>
    </bpmn:task>

     <bpmn:endEvent id="End_Reject">
       <bpmn:incoming>SequenceFlow_EndReject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="Gateway_FinalJoin" targetRef="End_Success"/>
    
     <bpmn:exclusiveGateway id="Gateway_ConfirmReject">
      <bpmn:outgoing>SequenceFlow_NoPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_EndReject" sourceRef="Task_LogReject" targetRef="End_Reject"/>

  </bpmn:process>
  
  <!-- Data Objects (Optional) -->
</bpmn:definitions>