<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Dismissal Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_MPON" name="MPON">
        <bpmn:flowNodeRef>StartEvent_Dismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendDismissal</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_MPOO" name="MPOO">
        <bpmn:flowNodeRef>Task_ReviewDismissal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Opposed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Dismissal" name="Dismissal Initiated">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: MPON sends dismissal -->
    <bpmn:task id="Task_SendDismissal" name="Send Dismissal">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2: MPOO reviews dismissal -->
    <bpmn:task id="Task_ReviewDismissal" name="Review Dismissal">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Confirm or Oppose?">
      <bpmn:incoming>SequenceFlow_GatewayIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Opposes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Confirms</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Opposed" name="Dismissal Opposed">
      <bpmn:incoming>SequenceFlow_Opposes</bpmn:incoming>
    </bpmn:endEvent>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Confirmed" name="Dismissal Confirmed">
      <bpmn:incoming>SequenceFlow_Confirms</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Dismissal" targetRef="Task_SendDismissal"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" name="Send to MPOO" sourceRef="Task_SendDismissal" targetRef="Task_ReviewDismissal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_GatewayIn" sourceRef="Task_ReviewDismissal" targetRef="Gateway_Decision"/>

    <bpmn:sequenceFlow id="SequenceFlow_Opposes" name="Oppose Dismissal" sourceRef="Gateway_Decision" targetRef="EndEvent_Opposed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isOpposed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_Confirms" name="Confirm Dismissal" sourceRef="Gateway_Decision" targetRef="EndEvent_Confirmed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isConfirmed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>