<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RoomService">
    <bpmn:participant id="Participant_HotelRoomService" name="The Evanstonian Room Service Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_RoomService">
      <bpmn:lane id="Lane_Manager" name="Room-service Manager">
        <bpmn:flowNodeRef>StartEvent_GuestCall</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Kitchen" name="Kitchen Staff">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gateway_AlcoholCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_AlcoholCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadiesCart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverToRoom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BillingWait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_GuestCall" name="Guest calls room service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Take Order -->
    <bpmn:task id="Task_TakeOrder" name="Take down order ticket">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitKitchen</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for concurrent tasks -->
    <bpmn:parallelGateway id="Parallel_GenerateTasks" name="Submit order">
      <bpmn:incoming>SequenceFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToSommelierCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Submit to Kitchen -->
    <bpmn:task id="Task_SubmitKitchen" name="Submit order ticket to kitchen">
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFood</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Prepare Food -->
    <bpmn:task id="Task_PrepareFood" name="Prepare food">
      <bpmn:incoming>SequenceFlow_PrepareFood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Alcohol Check (80% include alcohol) -->
    <bpmn:exclusiveGateway id="Gateway_AlcoholCheck" name="Alcoholic beverage needed?">
      <bpmn:incoming>SequenceFlow_ToSommelierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Fetch Wine (if alcohol needed) -->
    <bpmn:task id="Task_FetchWine" name="Fetch wine and prepare beverages">
      <bpmn:incoming>SequenceFlow_SommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Assign Order to Waiter -->
    <bpmn:task id="Task_AssignOrder" name="Assign order to waiter">
      <bpmn:incoming>SequenceFlow_ToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadiesCart</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Waiter Readies Cart -->
    <bpmn:task id="Task_ReadiesCart" name="Ready cart (tablecloth, silverware)">
      <bpmn:incoming>SequenceFlow_ReadiesCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for Delivery Readiness -->
    <bpmn:parallelGateway id="Gateway_DeliveryReady" name="All ready?">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToRoom</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Deliver to Room -->
    <bpmn:task id="Task_DeliverToRoom" name="Deliver to guest's room">
      <bpmn:incoming>SequenceFlow_DeliverToRoom</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Return to Station -->
    <bpmn:task id="Task_ReturnStation" name="Return to room-service station">
      <bpmn:incoming>SequenceFlow_ReturnStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingWait</bpmn:outgoing>
    </bpmn:task>

    <!-- Exclusive Gateway for Billing Wait Decision -->
    <bpmn:exclusiveGateway id="Gateway_BillingWait" name="Another order?">
      <bpmn:incoming>SequenceFlow_BillingWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Debit Account -->
    <bpmn:task id="Task_DebitAccount" name="Debit guest's account">
      <bpmn:incoming>SequenceFlow_DebitAccountNow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Complete" name="Order complete">
      <bpmn:incoming>SequenceFlow_BillingComplete</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_GuestCall" targetRef="Task_TakeOrder"/>
    
    <bpmn:parallelGateway id="Parallel_GenerateTasks">
      <bpmn:incoming>SequenceFlow_SubmitKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToKitchen</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToSommelierCheck</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_SubmitKitchen" sourceRef="Task_TakeOrder" targetRef="Parallel_GenerateTasks"/>
    
    <bpmn:task id="Task_SubmitKitchen">
      <bpmn:incoming>SequenceFlow_ToKitchen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareFood</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToKitchen" sourceRef="Parallel_GenerateTasks" targetRef="Task_SubmitKitchen"/>
    
    <bpmn:task id="Task_PrepareFood">
      <bpmn:incoming>SequenceFlow_PrepareFood</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToSommelierCheck" sourceRef="Parallel_GenerateTasks" targetRef="Gateway_AlcoholCheck"/>
    
    <bpmn:exclusiveGateway id="Gateway_AlcoholCheck">
      <bpmn:incoming>SequenceFlow_ToSommelierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareFood" sourceRef="Task_SubmitKitchen" targetRef="Task_PrepareFood"/>
    
    <bpmn:task id="Task_FetchWine">
      <bpmn:incoming>SequenceFlow_SommelierYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_ToWaiter" sourceRef="Parallel_GenerateTasks" targetRef="Task_AssignOrder"/>
    
    <bpmn:exclusiveGateway id="Gateway_AlcoholCheck">
      <bpmn:incoming>SequenceFlow_ToSommelierCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierYes</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" sourceRef="Task_PrepareFood" targetRef="Gateway_DeliveryReady"/>
    
    <bpmn:task id="Task_AssignOrder">
      <bpmn:incoming>SequenceFlow_ToWaiter</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReadiesCart</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_SommelierYes" sourceRef="Gateway_AlcoholCheck" targetRef="Task_FetchWine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[needsAlcoholicBeverage]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:task id="Task_ReadiesCart">
      <bpmn:incoming>SequenceFlow_ReadiesCart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_WineReady" sourceRef="Task_FetchWine" targetRef="Gateway_DeliveryReady"/>
    
    <bpmn:parallelGateway id="Gateway_DeliveryReady">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliverToRoom</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ReadiesCart" sourceRef="Task_AssignOrder" targetRef="Task_ReadiesCart"/>
    
    <bpmn:task id="Task_DeliverToRoom">
      <bpmn:incoming>SequenceFlow_DeliverToRoom</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_CartReady" sourceRef="Task_ReadiesCart" targetRef="Gateway_DeliveryReady"/>
    
    <bpmn:exclusiveGateway id="Gateway_BillingWait">
      <bpmn:incoming>SequenceFlow_BillingWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ReturnStation" sourceRef="Task_DeliverToRoom" targetRef="Task_ReturnStation"/>
    
    <bpmn:task id="Task_DebitAccount">
      <bpmn:incoming>SequenceFlow_DebitAccountNow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingComplete</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Event_Complete">
      <bpmn:incoming>SequenceFlow_BillingComplete</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_DeliverToRoom" sourceRef="Gateway_DeliveryReady" targetRef="Task_DeliverToRoom"/>
    
    <bpmn:exclusiveGateway id="Gateway_BillingWait">
      <bpmn:incoming>SequenceFlow_BillingWait</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DebitAccountNow</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_BillingComplete" sourceRef="Task_DebitAccount" targetRef="End_Event_Complete"/>
    
  </bpmn:process>
  
  <!-- Data Objects -->
</bpmn:definitions>