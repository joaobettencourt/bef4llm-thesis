<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MasterDataChange" name="Master Data Change Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_EC" name="EC">
        <bpmn:flowNodeRef>StartEvent_Initiate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TellINQ</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_INQ" name="INQ">
        <bpmn:flowNodeRef>Task_NotifyIP</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_IP" name="IP">
        <bpmn:flowNodeRef>Task_CheckFeasibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Initiate" name="Change Request Initiated">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task EC -->
    <bpmn:task id="Task_TellINQ" name="Tell INQ about change of master data">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <!-- Task INQ -->
    <bpmn:task id="Task_NotifyIP" name="Notify IP of the change">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>

    <!-- Task IP Check -->
    <bpmn:task id="Task_CheckFeasibility" name="Check whether master data can be changed at desired time">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayIn</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway -->
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Can be changed?">
      <bpmn:incoming>SequenceFlow_GatewayIn</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task Confirm -->
    <bpmn:task id="Task_ConfirmChanges" name="Confirm changes of the INQ">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SuccessEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event Success -->
    <bpmn:endEvent id="EndEvent_Success" name="Changes Confirmed">
      <bpmn:incoming>SequenceFlow_SuccessEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task Reject -->
    <bpmn:task id="Task_RejectChanges" name="Reject changes of the INQ">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FailureEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event Failure -->
    <bpmn:endEvent id="EndEvent_Failure" name="Changes Rejected">
      <bpmn:incoming>SequenceFlow_FailureEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_Initiate" targetRef="Task_TellINQ"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_TellINQ" targetRef="Task_NotifyIP"/>

    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_NotifyIP" targetRef="Task_CheckFeasibility"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_GatewayIn" name="Check Result" sourceRef="Task_CheckFeasibility" targetRef="Gateway_Decision">
      <!-- Condition expression omitted for brevity, implied logic -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Yes (Can change)" sourceRef="Gateway_Decision" targetRef="Task_ConfirmChanges"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SuccessEnd" sourceRef="Task_ConfirmChanges" targetRef="EndEvent_Success"/>

    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="No (Cannot change)" sourceRef="Gateway_Decision" targetRef="Task_RejectChanges"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_FailureEnd" sourceRef="Task_RejectChanges" targetRef="EndEvent_Failure"/>

  </bpmn:process>
</bpmn:definitions>