<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Authority" name="Town Planning Authority" processRef="Process_Authority"/>
    <bpmn:participant id="Participant_Committee" name="Committee Members" processRef="Process_Committee"/>

    <!-- Message Flow 1: Send Schedule -->
    <bpmn:messageFlow id="MessageFlow_SendSchedule" sourceRef="Event_Throw_Schedule" targetRef="Start_Catch_Schedule"/>

    <!-- Message Flow 2: Advise Conflicts -->
    <bpmn:messageFlow id="MessageFlow_AdviseConflicts" sourceRef="Task_AdviseConflicts" targetRef="End_Event_Authority"/>

    <!-- Global Messages for reference -->
    <bpmn:message id="Msg_Schedule" name="Meeting Schedule"/>
    <bpmn:message id="Msg_ConflictAdvice" name="Conflict Advice"/>

  </bpmn:collaboration>

  <!-- Process A: Town Planning Authority -->
  <bpmn:process id="Process_Authority" isExecutable="true">
    
    <bpmn:laneSet>
      <bpmn:lane id="Lane_CoordUnit" name="Coordination Unit">
        <bpmn:flowNodeRef>Task_DraftSchedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Throw_Schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_SupportOfficer" name="Support Officer">
        <bpmn:flowNodeRef>Task_CheckSuggestDates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecheckConflicts</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="Start_Timer" name="November Schedule Draft">
       <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
       <bpmn:timerEventDefinition xsi:type="bpmn:tTimerExpression"/>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_DraftSchedule" name="Draft Schedule &amp; Add Dates">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToSupport</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 2 -->
    <bpmn:task id="Task_CheckSuggestDates" name="Check Dates &amp; Suggest Modifications">
      <bpmn:incoming>SequenceFlow_ToSupport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Recheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3 -->
    <bpmn:task id="Task_RecheckConflicts" name="Recheck Dates &amp; Look for Conflicts">
      <bpmn:incoming>SequenceFlow_Recheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SendSchedule</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Throw Event (Send Message) -->
    <bpmn:startEvent id="Event_Throw_Schedule" name="Send Schedule">
       <bpmn:incoming>SequenceFlow_SendSchedule</bpmn:incoming>
       <bpmn:messageEventDefinition xsi:type="bpmn:tMessageEventDefinition"/>
    </bpmn:startEvent>

    <!-- End Event -->
    <bpmn:endEvent id="End_Event_Authority" name="Process Complete">
      <bpmn:incoming>SequenceFlow_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="Start_Timer" targetRef="Task_DraftSchedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_ToSupport" sourceRef="Task_DraftSchedule" targetRef="Task_CheckSuggestDates"/>
    <bpmn:sequenceFlow id="SequenceFlow_Recheck" sourceRef="Task_CheckSuggestDates" targetRef="Task_RecheckConflicts"/>
    <bpmn:sequenceFlow id="SequenceFlow_SendSchedule" sourceRef="Task_RecheckConflicts" targetRef="Event_Throw_Schedule"/>
    <bpmn:sequenceFlow id="SequenceFlow_End" sourceRef="End_Event_Authority" targetRef="End_Event_Authority">
      <!-- Placeholder for advice flow completion -->
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Process B: Committee Members (External) -->
  <bpmn:process id="Process_Committee" isExecutable="true">
    
    <!-- Intermediate Catch Event for Schedule Start -->
    <bpmn:startEvent id="Start_Catch_Schedule" name="Receive Schedule">
      <bpmn:outgoing>SequenceFlow_CheckDiary</bpmn:outgoing>
       <bpmn:messageEventDefinition xsi:type="bpmn:tMessageEventDefinition"/>
    </bpmn:startEvent>

    <!-- Task 4 -->
    <bpmn:task id="Task_CheckDiary" name="Check Diaries">
      <bpmn:incoming>SequenceFlow_CheckDiary</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Advise</bpmn:outgoing>
    </bpmn:task>

     <!-- Task 5 -->
    <bpmn:endEvent id="End_Committee" name="Advise Conflicts">
       <bpmn:incoming>MessageFlow_AdviseConflicts</bpmn:incoming> 
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_CheckDiary" sourceRef="Start_Catch_Schedule" targetRef="Task_CheckDiary"/>
    
  </bpmn:process>

</bpmn:definitions>