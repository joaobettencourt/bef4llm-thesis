<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_RestaurantProcess">
    <bpmn:participant id="Participant_Guest" name="Guest" processRef="Process_Guest"/>
    <bpmn:participant id="Participant_Employee" name="Employee" processRef="Process_Employee"/>
    <bpmn:participant id="Participant_Chef" name="Chef" processRef="Process_Chef"/>

    <!-- Message Flows -->
    <bpmn:messageFlow id="MessageFlow_OrderToPOS" sourceRef="Task_GuestPlaceOrder" targetRef="Task_EmployeeEnterOrder"/>
    <bpmn:messageFlow id="MessageFlow_BuzzerInfo" sourceRef="Task_EmployeeSetBuzzer" targetRef="Event_GuestReceiveBuzzer"/>
    <bpmn:messageFlow id="MessageFlow_OrderToChef" sourceRef="Task_EmployeeInformChef" targetRef="Start_ChefOrderReceived"/>
    <bpmn:messageFlow id="MessageMealReady" sourceRef="End_ChefPlacedInHatch" targetRef="Event_EmployeeMealNotified"/>
  </bpmn:collaboration>

  <!-- Guest Process -->
  <bpmn:process id="Process_Guest">
    <bpmn:startEvent id="StartGuest_Hungry" name="Feeling Hungry">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_GuestChooseDish" name="Choose Dish from Menu">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_GuestWaitTurn" name="Waiting for Turn">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPlaceOrder" name="Place Order with Employee">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_GuestReceiveBuzzer" name="Receiving Buzzer">
      <bpmn:incoming>MessageFlow_BuzzerInfo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <bpmn:task id="Task_GuestPickUpMeal" name="Pick Up Meal">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndGuest_EatMeal" name="Eat Meal">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Timer for buzzer follow-up -->
    <bpmn:startEvent id="StartTimer_BuzzerTimeout" name="5 Minutes After Buzzer">
      <bpmn:timerDefinition xsi:type="bpmn:TimeDurationExpression"><![CDATA[PT5M]]></bpmn:timerDefinition>
      <bpmn:outgoing>SequenceFlow_Timer</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Timer Event for Guest -->
    <bpmn:endEvent id="EndGuest_NoReaction" name="No Reaction">
      <bpmn:incoming>SequenceFlow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartGuest_Hungry" targetRef="Task_GuestChooseDish"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_GuestChooseDish" targetRef="Event_GuestWaitTurn"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Event_GuestWaitTurn" targetRef="Task_GuestPlaceOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[turnHasCome]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_GuestPlaceOrder" targetRef="Event_GuestReceiveBuzzer"/>
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="Event_GuestReceiveBuzzer" targetRef="Task_GuestPickUpMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="Task_GuestPickUpMeal" targetRef="EndGuest_EatMeal"/>
  </bpmn:process>

  <!-- Employee Process -->
  <bpmn:process id="Process_Employee">
    <bpmn:startEvent id="StartEmployee_AwaitingOrder" name="Awaiting Guest Order">
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_EmployeeEnterOrder" name="Enter Order into POS System">
      <bpmn:incoming>MessageFlow_OrderToPOS</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeCollectMoney" name="Collect Money from Guest">
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeSetBuzzer" name="Setup Buzzer for Guest">
      <bpmn:incoming>SequenceFlow_12</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_EmployeeInformChef" name="Inform Chef of New Order">
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_14</bpmn:outgoing>
    </bpmn:task>

    <!-- Wait for meal ready notification -->
    <bpmn:intermediateCatchEvent id="Event_EmployeeMealNotified" name="Meal Ready Notification">
      <bpmn:incoming>MessageFlowMealReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_15</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>

    <!-- Timer for buzzer follow-up -->
    <bpmn:startEvent id="StartTimer_EmployeeCall" name="After 5 Minutes">
      <bpmn:timerDefinition xsi:type="bpmn:TimeDurationExpression"><![CDATA[PT5M]]></bpmn:timerDefinition>
      <bpmn:outgoing>SequenceFlow_TimerEmployee</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Gateway for buzzer call decision -->
    <bpmn:exclusiveGateway id="Gateway_CallGuest" name="Call Guest?">
      <bpmn:incoming>SequenceFlow_16</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Caller</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task for calling guest -->
    <bpmn:task id="Task_EmployeeCallGuest" name="Call Guest">
      <bpmn:incoming>SequenceFlow_Caller</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_17</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway for multiple calls -->
    <bpmn:exclusiveGateway id="Gateway_MoreCalls" name="More Calls Needed?">
      <bpmn:incoming>SequenceFlow_17</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CallerLoop</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="StartEmployee_AwaitingOrder" targetRef="Task_EmployeeEnterOrder"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="Task_EmployeeEnterOrder" targetRef="Task_EmployeeCollectMoney">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[orderEntered]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_12" sourceRef="Task_EmployeeCollectMoney" targetRef="Task_EmployeeSetBuzzer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[paymentReceived]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="Task_EmployeeSetBuzzer" targetRef="Task_EmployeeInformChef"/>
    <bpmn:sequenceFlow id="SequenceFlow_14" sourceRef="Task_EmployeeInformChef" targetRef="Event_EmployeeMealNotified">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[waitingForNotification]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Buzzer timeout path -->
    <bpmn:sequenceFlow id="SequenceFlow_16" sourceRef="StartTimer_EmployeeCall" targetRef="Gateway_CallGuest"/>
    <bpmn:sequenceFlow id="SequenceFlow_Caller" sourceRef="Gateway_CallGuest" targetRef="Task_EmployeeCallGuest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[guestNotResponding]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Loop for multiple calls -->
    <bpmn:sequenceFlow id="SequenceFlow_17" sourceRef="Task_EmployeeCallGuest" targetRef="Gateway_MoreCalls"/>
    <bpmn:sequenceFlow id="SequenceFlow_CallerLoop" name="Yes - More Calls Needed" sourceRef="Gateway_MoreCalls" targetRef="StartTimer_EmployeeCall">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[guestStillNotResponding]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

  </bpmn:process>

  <!-- Chef Process -->
  <bpmn:process id="Process_Chef">
    <bpmn:startEvent id="Start_ChefOrderReceived" name="New Order Received">
      <bpmn:incoming>MessageFlow_OrderToChef</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_20</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_ChefPrepareMeal" name="Prepare Meal">
      <bpmn:incoming>SequenceFlow_20</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_21</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ChefPlaceInHatch" name="Place Meal in Service Hatch">
      <bpmn:incoming>SequenceFlow_21</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_22</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event for Chef -->
    <bpmn:endEvent id="End_ChefPlacedInHatch" name="Meal Ready">
      <bpmn:incoming>SequenceFlow_22</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_20" sourceRef="Start_ChefOrderReceived" targetRef="Task_ChefPrepareMeal"/>
    <bpmn:sequenceFlow id="SequenceFlow_21" sourceRef="Task_ChefPrepareMeal" targetRef="Task_ChefPlaceInHatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[mealPrepared]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_22" sourceRef="Task_ChefPlaceInHatch" targetRef="End_ChefPlacedInHatch"/>

  </bpmn:process>

</bpmn:definitions>