<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_GO_Process">
    <bpmn:participant id="Participant_GO" name="GO (Government Office)" processRef="Process_GO"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_GO" isExecutable="true">
    
    <!-- Lane for the GO -->
    <bpmn:laneSet>
      <bpmn:lane id="Lane_GO_Operations" name="GO Operations">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejectDeregistration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmPreliminarily</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AssignGOAsMSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoMSPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoMPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InfoSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="MSPO Deregisters at GO">
      <bpmn:outgoing>SequenceFlow_Verify</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Verify -->
    <bpmn:task id="Task_VerifyDeregistration" name="Verify Deregistration">
      <bpmn:incoming>SequenceFlow_Verify</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DecisionCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Decision -->
    <bpmn:exclusiveGateway id="Gateway_DecisionOutcome" name="Verification Result?">
      <bpmn:incoming>SequenceFlow_DecisionCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RejectPath</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Path 1: Reject -->
    <bpmn:task id="Task_RejectDeregistration" name="Reject Deregistration">
      <bpmn:incoming>SequenceFlow_RejectPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndDenied</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 1 -->
    <bpmn:endEvent id="EndEvent_Denied" name="Deregistration Denied">
      <bpmn:incoming>SequenceFlow_EndDenied</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Path 2: Confirm & Assign -->
    <bpmn:task id="Task_ConfirmPreliminarily" name="Preliminarily Confirm Deregistration">
      <bpmn:incoming>SequenceFlow_ConfirmPath</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AssignMSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 3: Assign MSP -->
    <bpmn:task id="Task_AssignGOAsMSP" name="Assign GO as MSP">
      <bpmn:incoming>SequenceFlow_AssignMSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoMSPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 4: Inform MSPO -->
    <bpmn:task id="Task_InfoMSPO" name="Inform MSPO of Assignment Change">
      <bpmn:incoming>SequenceFlow_InfoMSPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoMPO</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 5: Inform MPO -->
    <bpmn:task id="Task_InfoMPO" name="Inform MPO of Assignment">
      <bpmn:incoming>SequenceFlow_InfoMPO</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoSP</bpmn:outgoing>
    </bpmn:task>

    <!-- Task 6: Inform SP -->
    <bpmn:task id="Task_InfoSP" name="Inform SP of Assignment">
      <bpmn:incoming>SequenceFlow_InfoSP</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 -->
    <bpmn:endEvent id="EndEvent_Success" name="GO Assigned as MSP">
      <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows with Conditions where applicable -->
    <bpmn:sequenceFlow id="SequenceFlow_Verify" sourceRef="StartEvent_1" targetRef="Task_VerifyDeregistration"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_DecisionCheck" sourceRef="Task_VerifyDeregistration" targetRef="Gateway_DecisionOutcome"/>
    
    <!-- Conditions for Gateway Outflows -->
    <bpmn:sequenceFlow id="SequenceFlow_RejectPath" name="Reject" sourceRef="Gateway_DecisionOutcome" targetRef="Task_RejectDeregistration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isRejected]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_ConfirmPath" name="Confirm" sourceRef="Gateway_DecisionOutcome" targetRef="Task_ConfirmPreliminarily">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isConfirmed]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Sequential Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_AssignMSP" sourceRef="Task_ConfirmPreliminarily" targetRef="Task_AssignGOAsMSP"/>
    
    <!-- Sequential Notifications -->
    <bpmn:sequenceFlow id="SequenceFlow_InfoMSPO" sourceRef="Task_AssignGOAsMSP" targetRef="Task_InfoMSPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_InfoMPO" sourceRef="Task_InfoMSPO" targetRef="Task_InfoMPO"/>
    <bpmn:sequenceFlow id="SequenceFlow_InfoSP" sourceRef="Task_InfoMPO" targetRef="Task_InfoSP"/>

    <!-- End Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_EndDenied" sourceRef="Task_RejectDeregistration" targetRef="EndEvent_Denied"/>
    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="Task_InfoSP" targetRef="EndEvent_Success"/>

  </bpmn:process>
</bpmn:definitions>