<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IPO_Process" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_1" name="IPO Process Modeler" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Set -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Company" name="Corporate Management">
        <bpmn:flowNodeRef>StartEvent_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectUnderwritersTask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Investment Bankers / Underwriters">
        <bpmn:flowNodeRef>FairnessCheckGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareRegistrationTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BlueSkyComplianceTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RoadShowTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FairnessCheckGateway2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FixIssuePriceTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoReasonsNotToProceedGateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FirmCommitmentTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OfferPubliclyTask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Decision" name="Decision to Go Public">
      <bpmn:outgoing>SequenceFlow_SelectUnderwriters</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1: Select Underwriters -->
    <bpmn:task id="SelectUnderwritersTask" name="Select Underwriters">
      <bpmn:incoming>SequenceFlow_SelectUnderwriters</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FairnessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1: Fairness Check -->
    <bpmn:exclusiveGateway id="FairnessCheckGateway" name="Facts Presented Fairly?">
      <bpmn:incoming>SequenceFlow_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToSEC</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Parallel Split for SEC Registration and Road Show -->
    <bpmn:parallelGateway id="ParallelSplit_1" name="Start Preparation">
      <bpmn:incoming>SequenceFlow_ProceedToSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareReg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Path A: SEC Registration -->
    <bpmn:task id="PrepareRegistrationTask" name="Prepare Registration Statement">
      <bpmn:incoming>SequenceFlow_PrepareReg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BlueSkyCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Path A Continued: Blue-Sky Laws -->
    <bpmn:task id="BlueSkyComplianceTask" name="Check Blue-Sky Laws Compliance">
      <bpmn:incoming>SequenceFlow_BlueSkyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitSEC</bpmn:outgoing>
    </bpmn:task>

    <!-- Path B: Road Show -->
    <bpmn:task id="RoadShowTask" name="Arrange Road Show & Firm Up Price">
      <bpmn:incoming>SequenceFlow_RoadShow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePricing</bpmn:outgoing>
    </bpmn:task>

    <!-- Intermediate Catch Event for SEC Clearance -->
    <bpmn:startEvent id="StartSecApproval" name="SEC Clearance Received">
      <bpmn:incoming/>
      <bpmn:outgoing>SequenceFlow_FixPrice</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Parallel Join Gateway -->
    <bpmn:parallelGateway id="ParallelJoin_1" name="Await All">
      <bpmn:incoming>SequenceFlow_SubmitSEC</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_MergePricing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Fix Issue Price -->
    <bpmn:task id="FixIssuePriceTask" name="Fix Issue Price">
      <bpmn:incoming>SequenceFlow_FixPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoReasonsCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2: Check for Reasons Not to Proceed -->
    <bpmn:exclusiveGateway id="NoReasonsNotToProceedGateway" name="Any Reason Not To?">
      <bpmn:incoming>SequenceFlow_NoReasonsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirmCommitment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Firm Commitment -->
    <bpmn:task id="FirmCommitmentTask" name="Enter Firm Commitment">
      <bpmn:incoming>SequenceFlow_FirmCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferPublicly</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Offer to Public -->
    <bpmn:task id="OfferPubliclyTask" name="Offer Stock to Public">
      <bpmn:incoming>SequenceFlow_OfferPublicly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Completed</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_Completed" name="IPO Completed">
      <bpmn:incoming>SequenceFlow_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_SelectUnderwriters" sourceRef="StartEvent_Decision" targetRef="SelectUnderwritersTask"/>
    
    <bpmn:exclusiveGateway id="FairnessCheckGateway">
      <bpmn:incoming>SequenceFlow_FairnessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProceedToSEC</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_FairnessCheck" sourceRef="SelectUnderwritersTask" targetRef="FairnessCheckGateway"/>
    
    <bpmn:parallelGateway id="ParallelSplit_1">
      <bpmn:incoming>SequenceFlow_ProceedToSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PrepareReg</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RoadShow</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_ProceedToSEC" sourceRef="FairnessCheckGateway" targetRef="ParallelSplit_1"/>
    
    <bpmn:task id="PrepareRegistrationTask">
      <bpmn:incoming>SequenceFlow_PrepareReg</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BlueSkyCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_PrepareReg" sourceRef="ParallelSplit_1" targetRef="PrepareRegistrationTask"/>
    
    <bpmn:task id="BlueSkyComplianceTask">
      <bpmn:incoming>SequenceFlow_BlueSkyCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SubmitSEC</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_BlueSkyCheck" sourceRef="PrepareRegistrationTask" targetRef="BlueSkyComplianceTask"/>
    
    <bpmn:parallelGateway id="ParallelJoin_1">
      <bpmn:incoming>SequenceFlow_SubmitSEC</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_SubmitSEC" sourceRef="BlueSkyComplianceTask" targetRef="ParallelJoin_1"/>
    
    <bpmn:startEvent id="StartSecApproval">
      <bpmn:outgoing>SequenceFlow_FixPrice</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="RoadShowTask">
      <bpmn:incoming>SequenceFlow_RoadShow</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MergePricing</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_RoadShow" sourceRef="ParallelSplit_1" targetRef="RoadShowTask"/>
    
    <bpmn:parallelGateway id="ParallelJoin_2">
      <bpmn:incoming>SequenceFlow_MergePricing</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FixPrice</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_MergePricing" sourceRef="RoadShowTask" targetRef="ParallelJoin_2"/>
    
    <bpmn:task id="FixIssuePriceTask">
      <bpmn:incoming>SequenceFlow_FixPrice</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoReasonsCheck</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_FixPrice" sourceRef="ParallelJoin_2" targetRef="FixIssuePriceTask"/>
    
    <bpmn:exclusiveGateway id="NoReasonsNotToProceedGateway">
      <bpmn:incoming>SequenceFlow_NoReasonsCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FirmCommitment</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="SequenceFlow_NoReasonsCheck" sourceRef="FixIssuePriceTask" targetRef="NoReasonsNotToProceedGateway"/>
    
    <bpmn:task id="FirmCommitmentTask">
      <bpmn:incoming>SequenceFlow_FirmCommitment</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_OfferPublicly</bpmn:outgoing>
    </bpmn:task>

    <bpmn:sequenceFlow id="SequenceFlow_FirmCommitment" sourceRef="NoReasonsNotToProceedGateway" targetRef="FirmCommitmentTask"/>
    
    <bpmn:task id="OfferPubliclyTask">
      <bpmn:incoming>SequenceFlow_OfferPublicly</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Completed</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Completed">
      <bpmn:incoming>SequenceFlow_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="SequenceFlow_OfferPublicly" sourceRef="FirmCommitmentTask" targetRef="OfferPubliclyTask"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_Completed" sourceRef="OfferPubliclyTask" targetRef="EndEvent_Completed"/>

  </bpmn:process>
</bpmn:definitions>