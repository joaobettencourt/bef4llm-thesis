<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Room Service Process" processRef="Process_1"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="true">
    
    <!-- Lane Definitions -->
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Manager" name="Room-Service Manager">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TakeOrder</bpmn:flowNodeRef>
      </bpmn:lane>
      
      <bpmn:lane id="Lane_Kitchen" name="Kitchen">
        <bpmn:flowNodeRef>Task_PrepareFood</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sommelier" name="Sommelier">
        <bpmn:flowNodeRef>Gateway_WineCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FetchWine</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Waiter" name="Waiter">
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareCartDrinks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DeliveryJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnStation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DebitAccount</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Guest Calls Room Service">
      <bpmn:outgoing>SequenceFlow_TakeOrder</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Manager Task -->
    <bpmn:task id="Task_TakeOrder" name="Take Down Order">
      <bpmn:incoming>SequenceFlow_TakeOrder</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SplitInit</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Split (Starts Kitchen, Waiter, and Wine Check paths) -->
    <bpmn:parallelGateway id="Gateway_ParallelSplit">
      <bpmn:incoming>SequenceFlow_SplitInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KitchenStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WaiterStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WineCheckInit</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Kitchen Task -->
    <bpmn:task id="Task_PrepareFood" name="Prepare Food">
      <bpmn:incoming>SequenceFlow_KitchenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FoodReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Waiter Task (Cart & Non-Alcoholic Drinks) -->
    <bpmn:task id="Task_PrepareCartDrinks" name="Ready Cart and Prepare Drinks">
      <bpmn:incoming>SequenceFlow_WaiterStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CartReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Wine Check Logic (Exclusive Gateway) -->
    <bpmn:exclusiveGateway id="Gateway_WineCheck" name="Alcohol Required?">
      <bpmn:incoming>SequenceFlow_WineCheckInit</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_SommelierTask</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoWinePath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Sommelier Task (Only if Alcohol Required) -->
    <bpmn:task id="Task_FetchWine" name="Fetch Wine and Alcoholic Beverages">
      <bpmn:incoming>SequenceFlow_SommelierTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_WineReady</bpmn:outgoing>
    </bpmn:task>

    <!-- Convergence Gateway (AND Join) -->
    <bpmn:parallelGateway id="Gateway_DeliveryJoin">
      <bpmn:incoming>SequenceFlow_FoodReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_CartReady</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_WineReady</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DeliveryStart</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Delivery Task -->
    <bpmn:task id="Task_DeliverOrder" name="Deliver to Guest Room">
      <bpmn:incoming>SequenceFlow_DeliveryStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReturnStation</bpmn:outgoing>
    </bpmn:task>

    <!-- Return Task -->
    <bpmn:task id="Task_ReturnStation" name="Return to Room-Service Station">
      <bpmn:incoming>SequenceFlow_ReturnStation</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BillingStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Billing Task -->
    <bpmn:task id="Task_DebitAccount" name="Debit Guest Account">
      <bpmn:incoming>SequenceFlow_BillingStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProcess</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event -->
    <bpmn:endEvent id="EndEvent_1" name="Order Completed">
      <bpmn:incoming>SequenceFlow_EndProcess</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <bpmn:sequenceFlow id="SequenceFlow_TakeOrder" sourceRef="StartEvent_1" targetRef="Task_TakeOrder"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_SplitInit" sourceRef="Task_TakeOrder" targetRef="Gateway_ParallelSplit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Parallel Paths -->
    <bpmn:sequenceFlow id="SequenceFlow_KitchenStart" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareFood"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_WaiterStart" sourceRef="Gateway_ParallelSplit" targetRef="Task_PrepareCartDrinks"/>
    
    <!-- Wine Check Path -->
    <bpmn:sequenceFlow id="SequenceFlow_WineCheckInit" sourceRef="Gateway_ParallelSplit" targetRef="Gateway_WineCheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Wine Decision Outcomes -->
    
    <bpmn:sequenceFlow id="SequenceFlow_SommelierTask" sourceRef="Gateway_WineCheck" targetRef="Task_FetchWine">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[isAlcoholic]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Bypass Path for No Wine (Ensures Join receives token) -->
    <bpmn:sequenceFlow id="SequenceFlow_NoWinePath" sourceRef="Gateway_WineCheck" targetRef="Gateway_DeliveryJoin">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[!isAlcoholic]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Join Inputs -->
    
    <bpmn:sequenceFlow id="SequenceFlow_FoodReady" sourceRef="Task_PrepareFood" targetRef="Gateway_DeliveryJoin"/>
    
    <bpmn:sequenceFlow id="SequenceFlow_CartReady" sourceRef="Task_PrepareCartDrinks" targetRef="Gateway_DeliveryJoin"/>

    <!-- Sommelier Task Output -->
    
    <bpmn:sequenceFlow id="SequenceFlow_WineReady" sourceRef="Task_FetchWine" targetRef="Gateway_DeliveryJoin"/>

    <!-- Delivery Flow -->
    
    <bpmn:sequenceFlow id="SequenceFlow_DeliveryStart" sourceRef="Gateway_DeliveryJoin" targetRef="Task_DeliverOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- Return Flow -->
    
    <bpmn:sequenceFlow id="SequenceFlow_ReturnStation" sourceRef="Task_DeliverOrder" targetRef="Task_ReturnStation"/>

    <!-- Billing Flow -->
    
    <bpmn:sequenceFlow id="SequenceFlow_BillingStart" sourceRef="Task_ReturnStation" targetRef="Task_DebitAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression"><![CDATA[true]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <!-- End Flow -->
    
    <bpmn:sequenceFlow id="SequenceFlow_EndProcess" sourceRef="Task_DebitAccount" targetRef="EndEvent_1"/>

  </bpmn:process>
</bpmn:definitions>