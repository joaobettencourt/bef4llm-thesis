<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Versicherung - Regressabteilung" processRef="Process_0geryc1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_0geryc1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Sachbearbeiter" name="Sachbearbeiter">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FallPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_RegressMoeglich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ZahlungsauflorderungSenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_StatusPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EingangVerbuchen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>XORGateway_Gerechtfertigt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_VorgangSchliessen3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InkassoAbgeben</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Meldung möglicher Regress">
      <bpmn:outgoing>SequenceFlow_StartToPruefen</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task 1 -->
    <bpmn:task id="Task_FallPruefen" name="Fall prüfen">
      <bpmn:incoming>SequenceFlow_StartToPruefen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PruefenZuGateway1</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 1 -->
    <bpmn:xorGateway id="XORGateway_RegressMoeglich">
      <bpmn:incoming>SequenceFlow_PruefenZuGateway1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoRegressToEnd1</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_YesRegressToSendDemand</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- End Event 1 (No Recourse) -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen1" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_NoRegressToEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 2 (Send Demand) -->
    <bpmn:task id="Task_ZahlungsauflorderungSenden" name="Zahlungsauflorderung senden &amp; Wiedervorlage setzen">
      <bpmn:incoming>SequenceFlow_YesRegressToSendDemand</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DemandToStatusCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway 2 (Status Check) -->
    <bpmn:xorGateway id="XORGateway_StatusPruefen">
      <bpmn:incoming>SequenceFlow_DemandToStatusCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PaymentReceivedToEnd3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ObjectionOrTimeoutToCollection2</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Task 3 (Book Receipt) -->
    <bpmn:task id="Task_EingangVerbuchen" name="Eingang verbuchen">
      <bpmn:incoming>SequenceFlow_PaymentReceivedToEnd3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_BookingToStatusCheck2</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 2 (Payment Received) -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen2" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_BookingToStatusCheck2</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Gateway 3 (Objection Check) -->
    <bpmn:xorGateway id="XORGateway_Gerechtfertigt">
      <bpmn:incoming>SequenceFlow_ObjectionOrTimeoutToCollection2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_JustifiedToEnd3</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NotJustifiedToInkasso</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- End Event 3 (Objection Justified) -->
    <bpmn:endEvent id="EndEvent_VorgangSchliessen3" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_JustifiedToEnd3</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Task 4 (Collection Agency) -->
    <bpmn:task id="Task_InkassoAbgeben" name="An Inkassodienstleister abgeben">
      <bpmn:incoming>SequenceFlow_NotJustifiedToInkasso</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CollectionToEnd4</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event 4 (Collection) -->
    <bpmn:endEvent id="EndEvent_ProzessBeendet" name="Vorgang schließen">
      <bpmn:incoming>SequenceFlow_CollectionToEnd4</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartToPruefen" sourceRef="StartEvent_1" targetRef="Task_FallPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_PruefenZuGateway1" sourceRef="Task_FallPruefen" targetRef="XORGateway_RegressMoeglich" />
    <bpmn:sequenceFlow id="SequenceFlow_NoRegressToEnd1" name="Nein" sourceRef="XORGateway_RegressMoeglich" targetRef="EndEvent_VorgangSchliessen1" />
    <bpmn:sequenceFlow id="SequenceFlow_YesRegressToSendDemand" name="Ja" sourceRef="XORGateway_RegressMoeglich" targetRef="Task_ZahlungsauflorderungSenden" />
    <bpmn:sequenceFlow id="SequenceFlow_DemandToStatusCheck" sourceRef="Task_ZahlungsauflorderungSenden" targetRef="XORGateway_StatusPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_PaymentReceivedToEnd3" name="Geld eingegangen" sourceRef="XORGateway_StatusPruefen" targetRef="Task_EingangVerbuchen" />
    <bpmn:sequenceFlow id="SequenceFlow_BookingToStatusCheck2" sourceRef="Task_EingangVerbuchen" targetRef="EndEvent_VorgangSchliessen2" />
    <bpmn:sequenceFlow id="SequenceFlow_ObjectionOrTimeoutToCollection2" name="Kein Geldeingang / Widerspruch" sourceRef="XORGateway_StatusPruefen" targetRef="XORGateway_Gerechtfertigt" />
    <bpmn:sequenceFlow id="SequenceFlow_JustifiedToEnd3" name="Gerechtfertigt" sourceRef="XORGateway_Gerechtfertigt" targetRef="EndEvent_VorgangSchliessen3" />
    <bpmn:sequenceFlow id="SequenceFlow_NotJustifiedToInkasso" name="Nicht gerechtfertigt" sourceRef="XORGateway_Gerechtfertigt" targetRef="Task_InkassoAbgeben" />
    <bpmn:sequenceFlow id="SequenceFlow_CollectionToEnd4" sourceRef="Task_InkassoAbgeben" targetRef="EndEvent_ProzessBeendet" />

  </bpmn:process>
</bpmn:definitions>