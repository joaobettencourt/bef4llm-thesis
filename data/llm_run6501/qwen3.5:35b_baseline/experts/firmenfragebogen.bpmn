<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Firmenregistrierung und Datenprüfung" processRef="Process_0geryc1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_0geryc1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_System" name="System / Automatisierung">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Erfassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PartnerSuche</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatenPruefungOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BetriebsnummernPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_U1InsolvenzPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GeberIdentifizieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MeldezeitraumPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VerfuegungszeitenVorhanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UmlageZeitenVerifizieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UmlageZeitenAnlegen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeUmlage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KontaktdatenPruefen</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manual" name="Sachbearbeiter / Mitarbeiter">
        <bpmn:flowNodeRef>Gateway_PartnerManuell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManuellePruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProblemEntscheidung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MitarbeiterBearbeitung</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_End" name="Ende">
         <bpmn:flowNodeRef>EndEvent_Erfolg</bpmn:flowNodeRef>
         <bpmn:flowNodeRef>EndEvent_ProblemAbgeschlossen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_1" name="Eingang Firmenfragebogen">
      <bpmn:outgoing>SequenceFlow_Start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Processing -->
    <bpmn:task id="Task_Erfassen" name="Erstellen im System verarbeiten">
      <bpmn:incoming>SequenceFlow_Start</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_PartnerSucheStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Partner Search Decision -->
    <bpmn:exclusiveGateway id="Gateway_PartnerSuche">
      <bpmn:incoming>SequenceFlow_PartnerSucheStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GatewayToDataCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Review Path -->
    <bpmn:exclusiveGateway id="Gateway_PartnerManuell">
       <bpmn:incoming>SequenceFlow_ManualTrigger</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ToDataCheckMerge</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Manual Task -->
    <bpmn:task id="Task_ManuellePruefung" name="Manuelle Prüfung durch Sachbearbeiter">
      <bpmn:incoming>SequenceFlow_PartnerNoMatch</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToDataCheckMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Data Verification Phase -->
    <bpmn:exclusiveGateway id="Gateway_DatenPruefungOK">
       <bpmn:incoming>SequenceFlow_GatewayToDataCheck</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_BetriebsnummernStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Check Operating Numbers -->
    <bpmn:task id="Task_BetriebsnummernPruefen" name="Betriebsnummer &amp; Betriebsstättennummer prüfen">
      <bpmn:incoming>SequenceFlow_BetriebsnummernStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_DataCheckOK_1</bpmn:outgoing>
    </bpmn:task>

    <!-- Check U1 & Insolvency -->
    <bpmn:task id="Task_U1InsolvenzPruefen" name="U1-Verfahren &amp; Insolvenzrücklage prüfen">
      <bpmn:incoming>SequenceFlow_DataCheckOK_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GeberIdentStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Identify Employer -->
    <bpmn:task id="Task_GeberIdentifizieren" name="Arbeitgeber eindeutig identifizieren">
      <bpmn:incoming>SequenceFlow_GeberIdentStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MeldezeitraumStart</bpmn:outgoing>
    </bpmn:task>

    <!-- Reporting Period Check -->
    <bpmn:task id="Task_MeldezeitraumPruefen" name="Meldezeitraum kontrollieren">
      <bpmn:incoming>SequenceFlow_MeldezeitraumStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_VerfuegungszeitenCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Contribution Times Decision -->
    <bpmn:exclusiveGateway id="Gateway_VerfuegungszeitenVorhanden">
      <bpmn:incoming>SequenceFlow_VerfuegungszeitenCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_UmlageVerifizierenStart</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_UmlageAnlegenStart</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Verify Existing -->
    <bpmn:task id="Task_UmlageZeitenVerifizieren" name="Umlageversicherungszeiten überprüfen">
      <bpmn:incoming>SequenceFlow_UmlageVerifizierenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KontaktdatenToMerge</bpmn:outgoing>
    </bpmn:task>

    <!-- Create New -->
    <bpmn:task id="Task_UmlageZeitenAnlegen" name="Umlageversicherungszeiten neu anlegen">
      <bpmn:incoming>SequenceFlow_UmlageAnlegenStart</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_KontaktdatenToMerge2</bpmn:outgoing>
    </bpmn:task>

    <!-- Merge Contribution Paths -->
    <bpmn:exclusiveGateway id="Gateway_MergeUmlage">
       <bpmn:incoming>SequenceFlow_UmlageVerifizierenStart</bpmn:incoming>
       <bpmn:incoming>SequenceFlow_KontaktdatenToMerge2</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_KontaktdatenTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Contact Data Check -->
    <bpmn:task id="Task_KontaktdatenPruefen" name="Kontaktdaten (Telefon, Fax, Adresse) prüfen">
      <bpmn:incoming>SequenceFlow_KontaktdatenToMerge</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndSuccess</bpmn:outgoing>
    </bpmn:task>

    <!-- Problem Handling Logic -->
    <bpmn:exclusiveGateway id="Gateway_ProblemEntscheidung">
       <bpmn:incoming>SequenceFlow_PartnerNoMatch</bpmn:incoming>
       <bpmn:outgoing>SequenceFlow_ProblemHandlingTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Problem Handling Task -->
    <bpmn:task id="Task_MitarbeiterBearbeitung" name="Vorgang an Mitarbeiter zur weiteren Bearbeitung übergeben">
      <bpmn:incoming>SequenceFlow_ProblemHandlingTask</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EndProblem</bpmn:outgoing>
    </bpmn:task>

    <!-- End Events -->
    <bpmn:endEvent id="EndEvent_Erfolg" name="Registrierung abgeschlossen">
       <bpmn:incoming>SequenceFlow_EndSuccess</bpmn:incoming> 
    </bpmn:endEvent>

     <bpmn:endEvent id="EndEvent_ProblemAbgeschlossen" name="Bearbeitung durch Mitarbeiter">
      <bpmn:incoming>SequenceFlow_EndProblem</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    
    <!-- Start to Process -->
    <bpmn:sequenceFlow id="SequenceFlow_Start" sourceRef="StartEvent_1" targetRef="Task_Erfassen">
      <bpmn:name>Eingang</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Partner Search Logic (Simplified for XML structure) -->
    <bpmn:sequenceFlow id="SequenceFlow_PartnerSucheStart" sourceRef="Task_Erfassen" targetRef="Gateway_PartnerSuche">
      <bpmn:name>Automatische Suche</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Partner Found Path -->
    <bpmn:sequenceFlow id="SequenceFlow_GatewayToDataCheck" sourceRef="Gateway_PartnerSuche" targetRef="Gateway_DatenPruefungOK">
      <bpmn:name>Partner gefunden</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Partner Not Found Path -->
    <bpmn:sequenceFlow id="SequenceFlow_PartnerNoMatch" sourceRef="Gateway_PartnerSuche" targetRef="Task_ManuellePruefung">
      <bpmn:name>Kein passender Partner / Mehrdeutig</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Manual Review to Merge -->
    <bpmn:sequenceFlow id="SequenceFlow_ToDataCheckMerge" sourceRef="Task_ManuellePruefung" targetRef="Gateway_DatenPruefungOK">
      <bpmn:name>Zur Datenprüfung</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Data Verification Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_BetriebsnummernStart" sourceRef="Gateway_DatenPruefungOK" targetRef="Task_BetriebsnummernPruefen">
      <bpmn:name>Daten prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check 1 to Check 2 -->
    <bpmn:sequenceFlow id="SequenceFlow_DataCheckOK_1" sourceRef="Task_BetriebsnummernPruefen" targetRef="Task_U1InsolvenzPruefen">
      <bpmn:name>Betreffend OK</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Check 2 to Identify -->
    <bpmn:sequenceFlow id="SequenceFlow_GeberIdentStart" sourceRef="Task_U1InsolvenzPruefen" targetRef="Task_GeberIdentifizieren">
      <bpmn:name>Zu Identifikation</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Identify to Period -->
    <bpmn:sequenceFlow id="SequenceFlow_MeldezeitraumStart" sourceRef="Task_GeberIdentifizieren" targetRef="Task_MeldezeitraumPruefen">
      <bpmn:name>Zu Meldezeitraum</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Period to Contribution Check -->
    <bpmn:sequenceFlow id="SequenceFlow_VerfuegungszeitenCheck" sourceRef="Task_MeldezeitraumPruefen" targetRef="Gateway_VerfuegungszeitenVorhanden">
      <bpmn:name>Zeiten prüfen</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Contribution Times Exists -->
    <bpmn:sequenceFlow id="SequenceFlow_UmlageVerifizierenStart" sourceRef="Gateway_VerfuegungszeitenVorhanden" targetRef="Task_UmlageZeitenVerifizieren">
      <bpmn:name>Vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

    <!-- Contribution Times New -->
    <bpmn:sequenceFlow id="SequenceFlow_UmlageAnlegenStart" sourceRef="Gateway_VerfuegungszeitenVorhanden" targetRef="Task_UmlageZeitenAnlegen">
      <bpmn:name>Nicht vorhanden</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- To Contact Data from Verify -->
    <bpmn:sequenceFlow id="SequenceFlow_KontaktdatenToMerge" sourceRef="Task_UmlageZeitenVerifizieren" targetRef="Gateway_MergeUmlage">
      <bpmn:name>Zu Kontakten</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- To Contact Data from New -->
    <bpmn:sequenceFlow id="SequenceFlow_KontaktdatenToMerge2" sourceRef="Task_UmlageZeitenAnlegen" targetRef="Gateway_MergeUmlage">
      <bpmn:name>Zu Kontakten</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- To Contact Data Task -->
    <bpmn:sequenceFlow id="SequenceFlow_KontaktdatenTask" sourceRef="Gateway_MergeUmlage" targetRef="Task_KontaktdatenPruefen">
      <bpmn:name>Kontakten</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- Problem Handling Flow -->
    <bpmn:sequenceFlow id="SequenceFlow_ProblemHandlingTask" sourceRef="Gateway_PartnerManuell" targetRef="Task_MitarbeiterBearbeitung">
      <bpmn:name>Klärungsbedarf</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- End Problem -->
    <bpmn:sequenceFlow id="SequenceFlow_EndProblem" sourceRef="Task_MitarbeiterBearbeitung" targetRef="EndEvent_ProblemAbgeschlossen">
      <bpmn:name>Bearbeitet</bpmn:name>
    </bpmn:sequenceFlow>

     <!-- End Success -->
    <bpmn:sequenceFlow id="SequenceFlow_EndSuccess" sourceRef="Task_KontaktdatenPruefen" targetRef="EndEvent_Erfolg">
      <bpmn:name>Erfolgreich</bpmn:name>
    </bpmn:sequenceFlow>

  </bpmn:process>
</bpmn:definitions>