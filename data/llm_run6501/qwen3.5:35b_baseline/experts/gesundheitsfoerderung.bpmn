<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Betriebliche Gesundheitsförderung" processRef="Process_0geryc1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_0geryc1" isExecutable="false">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_ProgrammBeginn" name="Programmstart">
      <bpmn:outgoing>SequenceFlow_StartCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Initial Health Check Phase (Parallel Activities) -->
    <bpmn:task id="Task_GesundheitsCheck" name="Gesundheit-Check durchführen">
      <bpmn:incoming>SequenceFlow_StartCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CheckToAppTraining</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for App and Wearable Training -->
    <bpmn:parallelGateway id="ParallelGateway_TrainingStart">
      <bpmn:incoming>SequenceFlow_CheckToAppTraining</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_AppInstruction</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_WearableInstruction</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- App Training Task -->
    <bpmn:task id="Task_AppEinweisung" name="App-Einweisung">
      <bpmn:incoming>SequenceFlow_AppInstruction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPlanCreation</bpmn:outgoing>
    </bpmn:task>

    <!-- Wearable Training Task -->
    <bpmn:task id="Task_WearableEinweisung" name="Wearables-Einweisung">
      <bpmn:incoming>SequenceFlow_WearableInstruction</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingPlanCreation2</bpmn:outgoing>
    </bpmn:task>

    <!-- Health Coach Task -->
    <bpmn:parallelGateway id="ParallelGateway_PlansCreation">
      <bpmn:incoming>SequenceFlow_AppInstruction</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_TrainingPlanCreation2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingsplanErstellen</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Health Coach Task -->
    <bpmn:task id="Task_TrainingsplanErstellen" name="Trainings- und Ernährungspläne erstellen">
      <bpmn:incoming>SequenceFlow_TrainingsplanErstellen</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_StartTrainingPhase</bpmn:outgoing>
    </bpmn:task>

    <!-- Training Phase (6 months) -->
    <bpmn:task id="Task_IndividuellesTraining" name="Trainingsphase durchführen">
      <bpmn:incoming>SequenceFlow_StartTrainingPhase</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MidtermCheckTrigger</bpmn:outgoing>
    </bpmn:task>

    <!-- Optional Nutrition Counseling (can happen anytime during training) -->
    <bpmn:exclusiveGateway id="Gateway_NutritionCounseling">
      <bpmn:incoming>SequenceFlow_MidtermCheckTrigger</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CounselingRequestYes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_TrainingContinueNoCounseling</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Nutrition Counseling Task -->
    <bpmn:task id="Task_Ernaehrungsberatung" name="Ernährungsberatung in Anspruch nehmen">
      <bpmn:incoming>SequenceFlow_CounselingRequestYes</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingContinueLoop</bpmn:outgoing>
    </bpmn:task>

    <!-- Mid-term Check after 6 months -->
    <bpmn:exclusiveGateway id="Gateway_MidtermCheck">
      <bpmn:incoming>SequenceFlow_CounselingRequestNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Group Split Decision -->
    <bpmn:xorGateway id="Gateway_GroupAssignment">
      <bpmn:incoming>SequenceFlow_GroupSplitDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupIndependent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GroupWithSupport</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Group A: Independent Training -->
    <bpmn:task id="Task_TrainingEigenstaendig" name="Trainingsphase eigenständig fortsetzen">
      <bpmn:incoming>SequenceFlow_GroupIndependent</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTriggerA</bpmn:outgoing>
    </bpmn:task>

    <!-- Group B: Training with App/Wearables Support -->
    <bpmn:task id="Task_TrainingMitUnterstuetzung" name="Trainingsphase mit App- und Wearable-Unterstützung fortsetzen">
      <bpmn:incoming>SequenceFlow_GroupWithSupport</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTriggerB</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Check -->
    <bpmn:endEvent id="EndEvent_ProgrammAbschluss" name="Programmabschluss">
      <bpmn:incoming>SequenceFlow_ProgrammAbschluss</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_StartCheck" sourceRef="StartEvent_ProgrammBeginn" targetRef="Task_GesundheitsCheck" />
    
    <bpmn:sequenceFlow id="SequenceFlow_CheckToAppTraining" name="Parallel starten" sourceRef="Task_GesundheitsCheck" targetRef="ParallelGateway_TrainingStart" />
    
    <bpmn:sequenceFlow id="SequenceFlow_AppInstruction" sourceRef="ParallelGateway_TrainingStart" targetRef="Task_AppEinweisung" />
    
    <bpmn:sequenceFlow id="SequenceFlow_WearableInstruction" sourceRef="ParallelGateway_TrainingStart" targetRef="Task_WearableEinweisung" />
    
    <bpmn:parallelGateway id="ParallelGateway_PlansCreation2">
      <bpmn:incoming>SequenceFlow_AppInstruction</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_TrainingPlanCreation2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_TrainingsplanErstellen</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:sequenceFlow id="SequenceFlow_AppInstruction" sourceRef="ParallelGateway_PlansCreation2" targetRef="Task_TrainingsplanErstellen">
      <!-- Condition: Both instructions completed -->
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="ParallelGateway_MidtermCheckTriggerMerge">
      <bpmn:incoming>SequenceFlow_CounselingRequestNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Nutrition Counseling Loop -->
    <bpmn:sequenceFlow id="SequenceFlow_MidtermCheckTrigger" sourceRef="Task_IndividuellesTraining" targetRef="Gateway_NutritionCounseling">
      <!-- Condition: Training phase ongoing, check for counseling need -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CounselingRequestYes" name="Beratung gewünscht?" sourceRef="Gateway_NutritionCounseling" targetRef="Task_Ernaehrungsberatung">
      <!-- Condition: Yes -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_CounselingRequestNo" name="Keine Beratung gewünscht?" sourceRef="Gateway_NutritionCounseling" targetRef="ParallelGateway_MidtermCheckTriggerMerge">
      <!-- Condition: No - continue to mid-term check -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TrainingContinueLoop" name="Weiter mit Training und erneutem Check" sourceRef="Task_Ernaehrungsberatung" targetRef="Gateway_NutritionCounseling">
      <!-- Loop back to check for more counseling -->
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="ParallelGateway_TrainingContinueMerge">
      <bpmn:incoming>SequenceFlow_CounselingRequestNo</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupSplitDecision</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Group Split -->
    <bpmn:sequenceFlow id="SequenceFlow_GroupSplitDecision" name="6 Monate Training abgeschlossen - Gruppenaufteilung" sourceRef="ParallelGateway_MidtermCheckTriggerMerge" targetRef="Gateway_GroupAssignment">
      <!-- Condition: 6 months completed, split into groups -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_TrainingContinueNoCounseling" name="Keine Beratung - weiter zum Midterm Check" sourceRef="ParallelGateway_MidtermCheckTriggerMerge" targetRef="Task_IndividuellesTraining">
      <!-- Condition: No counseling needed, continue training -->
    </bpmn:sequenceFlow>

    <bpmn:parallelGateway id="ParallelGroupSplitDecision2">
      <bpmn:incoming>SequenceFlow_TrainingContinueNoCounseling</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupIndependent</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GroupWithSupport</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Group Independent -->
    <bpmn:sequenceFlow id="SequenceFlow_TrainingContinueNoCounseling2" name="Weiter mit Training ohne Beratung" sourceRef="ParallelGroupSplitDecision2" targetRef="Task_IndividuellesTraining">
      <!-- Condition: Continue training without counseling -->
    </bpmn:sequenceFlow>

    <bpmn:xorGateway id="Gateway_GroupAssignmentFinal">
      <bpmn:incoming>SequenceFlow_TrainingContinueNoCounseling2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_GroupIndependentFinal</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_GroupWithSupportFinal</bpmn:outgoing>
    </bpmn:xorGateway>

    <!-- Group A Final -->
    <bpmn:task id="Task_TrainingEigenstaendig2" name="Trainingsphase eigenständig fortsetzen (Gruppe A)">
      <bpmn:incoming>SequenceFlow_GroupIndependentFinal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTriggerA</bpmn:outgoing>
    </bpmn:task>

    <!-- Group B Final -->
    <bpmn:task id="Task_TrainingMitUnterstuetzung2" name="Trainingsphase mit App- und Wearable-Unterstützung fortsetzen (Gruppe B)">
      <bpmn:incoming>SequenceFlow_GroupWithSupportFinal</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FinalCheckTriggerB</bpmn:outgoing>
    </bpmn:task>

    <!-- Final Check Merge -->
    <bpmn:parallelGateway id="ParallelGateway_FinalCheckMerge">
      <bpmn:incoming>SequenceFlow_FinalCheckTriggerA</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_FinalCheckTriggerB</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ProgrammAbschluss</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Final Check Trigger from both groups -->
    <bpmn:sequenceFlow id="SequenceFlow_FinalCheckTriggerA" sourceRef="Task_TrainingEigenstaendig2" targetRef="ParallelGateway_FinalCheckMerge">
      <!-- Condition: Group A completed 6 months -->
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="SequenceFlow_FinalCheckTriggerB" sourceRef="Task_TrainingMitUnterstuetzung2" targetRef="ParallelGateway_FinalCheckMerge">
      <!-- Condition: Group B completed 6 months with support -->
    </bpmn:sequenceFlow>

    <bpmn:endEvent id="EndEvent_ProgrammAbschlussFinal" name="Programmabschluss - Abschluss-Check durchgeführt">
      <bpmn:incoming>SequenceFlow_ProgrammAbschluss</bpmn:outgoing />
    </bpmn:endEvent>

  </bpmn:process>
</bpmn:definitions>