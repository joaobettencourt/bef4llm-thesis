<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Erfassen und verarbeiten des Fragebogens">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_3" name="Partnerunternehmen gefunden" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
      <conditionExpression xsi:type="tFormalExpression">partnerFound = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_4" name="Kein Partnerunternehmen gefunden" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>

    <task id="Task_2" name="Überprüfung relevanter Unternehmensdaten">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <task id="Task_3" name="Manuelle Prüfung durch Sachbearbeiter">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_4"/>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="Task_4"/>

    <task id="Task_4" name="Überprüfung von Unternehmensdaten">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow_8" name="Umlageversicherungszeiten vorhanden" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
      <conditionExpression xsi:type="tFormalExpression">umlageversicherungszeitenVorhanden = true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow_9" name="Umlageversicherungszeiten nicht vorhanden" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>

    <task id="Task_5" name="Überprüfung von Umlageversicherungszeiten">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <task id="Task_6" name="Anlegen von Umlageversicherungszeiten">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="Task_7"/>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>

    <task id="Task_7" name="Überprüfung von Kontaktdaten">
      <incoming>SequenceFlow_10</incoming>
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_12</incoming>
    </endEvent>

  </process>

</definitions>