<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Schadensabwicklung">
    <bpmn:participant id="Participant_Versicherung" name="Schadenbearbeitung Versicherung" processRef="Process_Schaden01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Schaden01" isExecutable="true">
    <!-- Start Event -->
    <bpmn:startEvent id="StartEvent_Schadensmeldung" name="Schadensmeldung einreichen">
      <bpmn:outgoing>SequenceFlow_InitialCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Task: Check validity -->
    <bpmn:task id="Task_GueltigkeitPruefen" name="Gültigkeit der Schadensmeldung überprüfen">
      <bpmn:incoming>SequenceFlow_InitialCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_EligibilityDecision</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Is damage valid? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Gueltigkeit" name="Schaden gültig?">
      <bpmn:incoming>SequenceFlow_EligibilityDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NotValid</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Inform customer about rejection -->
    <bpmn:task id="Task_KundeInformieren" name="Kunden über Ablehnung informieren">
      <bpmn:incoming>SequenceFlow_NotValid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToEndRejected</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Process ended -->
    <bpmn:endEvent id="EndEvent_Rejected" name="Schaden abgelehnt">
      <bpmn:text><![CDATA[Prozess abgeschlossen]]></bpmn:text>
      <bpmn:incoming>SequenceFlow_ToEndRejected</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task: Check documents for completeness -->
    <bpmn:task id="Task_UnterlagenPruefen" name="Eingereichte Unterlagen auf Vollständigkeit prüfen">
      <bpmn:incoming>SequenceFlow_Valid</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_CompletenessCheck</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Are documents complete? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Vollstaendigkeit" name="Unterlagen vollständig?">
      <bpmn:incoming>SequenceFlow_CompletenessCheck</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_YesComplete</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_NoIncomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Request additional information -->
    <bpmn:task id="Task_ZusaetzlicheInfoEinholen" name="Zusätzliche Informationen vom Kunden/Dritten einholen">
      <bpmn:incoming>SequenceFlow_NoIncomplete</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_InfoReceived</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for information gathering -->
    <bpmn:parallelGateway id="ParallelGateway_InformationGathered" name="">
        <bpmn:incoming>SequenceFlow_InfoReceived</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAcceptance</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Preliminary acceptance by customer center -->
    <bpmn:task id="Task_VorlaeufigeAnnahme" name="Vorläufige Annahme durch Kundenzentrum">
      <bpmn:incoming>SequenceFlow_YesComplete</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ToAcceptance</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Acceptance successful? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Accepted" name="Annahme erfolgreich?">
      <bpmn:incoming>SequenceFlow_ToAcceptance</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_ContinueProcessing</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- End Event: Processing failed -->
    <bpmn:endEvent id="EndEvent_ProcessFailed" name="Bearbeitung fehlgeschlagen">
      <bpmn:text><![CDATA[Prozess abgebrochen]]></bpmn:text>
        <bpmn:incoming>SequenceFlow_Failed</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Task: Record case in statistics -->
    <bpmn:task id="Task_StatisticsRecord" name="Fall in Schadensstatistik erfassen">
      <bpmn:incoming>SequenceFlow_StartStats</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_ToValidation</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Deep validation process -->
    <bpmn:task id="Task_TiefenValidierung" name="Vertiefter Validierungsprozess">
      <bpmn:incoming>SequenceFlow_ToValidation</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_CauseAnalysis</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Analyze cause of damage -->
    <bpmn:task id="Task_Schadensursache" name="Schadensursache untersuchen">
      <bpmn:incoming>SequenceFlow_CauseAnalysis</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_LegalAssessmentNeeded</bpmn:outgoing>
    </bpmn:task>

    <!-- Gateway: Legal assessment needed? -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_Legal" name="Rechtliche Einschätzung erforderlich?">
      <bpmn:incoming>SequenceFlow_LegalAssessmentNeeded</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_YesLegal</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_NoLegal</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Task: Obtain legal assessment from insurer -->
    <bpmn:task id="Task_RechtlicheEinschaetzung" name="Rechtliche Einschätzung durch Versicherer einholen">
      <bpmn:incoming>SequenceFlow_YesLegal</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_LegalComplete</bpmn:outgoing>
    </bpmn:task>

    <!-- Parallel Gateway for legal assessment -->
    <bpmn:parallelGateway id="ParallelGateway_LegalMerge" name="">
      <bpmn:incoming>SequenceFlow_NoLegal</bpmn:incoming>
        <bpmn:incoming>SequenceFlow_LegalComplete</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_StatisticsUpdate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Task: Update statistics -->
    <bpmn:task id="Task_StatisticsUpdate" name="Schadensstatistik aktualisieren">
      <bpmn:incoming>SequenceFlow_StatisticsUpdate</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_CustomerNotification</bpmn:outgoing>
    </bpmn:task>

    <!-- Task: Notify customer of current status -->
    <bpmn:task id="Task_KundeBenachrichtigen" name="Aktuellen Bearbeitungsstand dem Kunden mitteilen">
      <bpmn:incoming>SequenceFlow_CustomerNotification</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_ToFinalEnd</bpmn:outgoing>
    </bpmn:task>

    <!-- End Event: Process completed -->
    <bpmn:endEvent id="EndEvent_Completed" name="Prozess abgeschlossen">
      <bpmn:text><![CDATA[Entscheidung mitgeteilt]]></bpmn:text>
        <bpmn:incoming>SequenceFlow_ToFinalEnd</bpmn:outgoing>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_InitialCheck" sourceRef="StartEvent_Schadensmeldung" targetRef="Task_GueltigkeitPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_EligibilityDecision" sourceRef="Task_GueltigkeitPruefen" targetRef="ExclusiveGateway_Gueltigkeit" />
    <bpmn:sequenceFlow id="SequenceFlow_NotValid" name="nein" sourceRef="ExclusiveGateway_Gueltigkeit" targetRef="Task_KundeInformieren" />
    <bpmn:sequenceFlow id="SequenceFlow_Valid" name="ja" sourceRef="ExclusiveGateway_Gueltigkeit" targetRef="Task_UnterlagenPruefen" />
    <bpmn:sequenceFlow id="SequenceFlow_ToEndRejected" sourceRef="Task_KundeInformieren" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="SequenceFlow_CompletenessCheck" sourceRef="Task_UnterlagenPruefen" targetRef="ExclusiveGateway_Vollstaendigkeit" />
    <bpmn:sequenceFlow id="SequenceFlow_YesComplete" name="ja" sourceRef="ExclusiveGateway_Vollstaendigkeit" targetRef="Task_VorlaeufigeAnnahme" />
    <bpmn:sequenceFlow id="SequenceFlow_NoIncomplete" name="nein" sourceRef="ExclusiveGateway_Vollstaendigkeit" targetRef="Task_ZusaetzlicheInfoEinholen" />
    <bpmn:sequenceFlow id="SequenceFlow_InfoReceived" sourceRef="Task_ZusaetzlicheInfoEinholen" targetRef="ParallelGateway_InformationGathered" />
    <bpmn:sequenceFlow id="SequenceFlow_ToAcceptance" name="" sourceRef="ParallelGateway_InformationGathered" targetRef="ExclusiveGateway_Accepted" />
    <bpmn:sequenceFlow id="SequenceFlow_Failed" name="nein" sourceRef="ExclusiveGateway_Accepted" targetRef="EndEvent_ProcessFailed" />
    <bpmn:sequenceFlow id="SequenceFlow_ContinueProcessing" name="ja" sourceRef="ExclusiveGateway_Accepted" targetRef="Task_StatisticsRecord" />
    <bpmn:sequenceFlow id="SequenceFlow_StartStats" sourceRef="ParallelGateway_InformationGathered" targetRef="Task_StatisticsRecord" />
    <bpmn:sequenceFlow id="SequenceFlow_ToValidation" name="" sourceRef="Task_StatisticsRecord" targetRef="Task_TiefenValidierung" />
    <bpmn:sequenceFlow id="SequenceFlow_CauseAnalysis" sourceRef="Task_TiefenValidierung" targetRef="Task_Schadensursache" />
    <bpmn:sequenceFlow id="SequenceFlow_LegalAssessmentNeeded" name="" sourceRef="Task_Schadensursache" targetRef="ExclusiveGateway_Legal" />
    <bpmn:sequenceFlow id="SequenceFlow_YesLegal" name="ja" sourceRef="ExclusiveGateway_Legal" targetRef="Task_RechtlicheEinschaetzung" />
    <bpmn:sequenceFlow id="SequenceFlow_NoLegal" name="nein" sourceRef="ExclusiveGateway_Legal" targetRef="ParallelGateway_LegalMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_LegalComplete" sourceRef="Task_RechtlicheEinschaetzung" targetRef="ParallelGateway_LegalMerge" />
    <bpmn:sequenceFlow id="SequenceFlow_StatisticsUpdate" name="" sourceRef="ParallelGateway_LegalMerge" targetRef="Task_StatisticsUpdate" />
    <bpmn:sequenceFlow id="SequenceFlow_CustomerNotification" sourceRef="Task_StatisticsUpdate" targetRef="Task_KundeBenachrichtigen" />
    <bpmn:sequenceFlow id="SequenceFlow_ToFinalEnd" name="" sourceRef="Task_KundeBenachrichtigen" targetRef="EndEvent_Completed" />

  </bpmn:process>
</bpmn:definitions>