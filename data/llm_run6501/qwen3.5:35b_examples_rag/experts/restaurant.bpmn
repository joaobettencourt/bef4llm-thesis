<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RestaurantProcess" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_Restaurant">
    <bpmn:participant id="Participant_GuestsAndStaff" name="Restaurant Service Process" processRef="Process_Restaurant01" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Restaurant01" isExecutable="true">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_Guest" name="Gast (Guest)">
        <bpmn:flowNodeRef>StartEvent_0guest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1chooseDish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2waitOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_3eatMeal</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Staff" name="Angestellter (Server)">
        <bpmn:flowNodeRef>Task_2placeOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3cashRegister</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_4setPager</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>InclusiveGateway_5informCook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_6pagerTriggered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7callGuestAfterWait</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Cook" name="Koch (Cook)">
        <bpmn:flowNodeRef>InclusiveGateway_8cookMeal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9prepareFood</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_10foodReady</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <!-- Guest Lane -->
    <bpmn:startEvent id="StartEvent_0guest" name="Gast betritt Restaurant">
      <bpmn:outgoing>SequenceFlow_g1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1chooseDish" name="Gericht auswählen und warten">
      <bpmn:incoming>SequenceFlow_g1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_s2</bpmn:outgoing>
    </bpmn:task>

    <!-- Staff Lane -->
    <bpmn:exclusiveGateway id="ExclusiveGateway_6pagerTriggered" name="Pieper ausgelöst?">
      <bpmn:incoming>SequenceFlow_c10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_s7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Staff tasks -->
    <bpmn:task id="Task_2placeOrder" name="Bestellung aufnehmen">
      <bpmn:incoming>SequenceFlow_g3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_s4</bpmn:outgoing>
    </bpmn:task>

    <!-- Cook Lane -->
    <bpmn:startEvent id="StartEvent_8cook" name="Koch erhält Bestellung">
        <bpmn:text><![CDATA[Bestellung erhalten]]></bpmn:text>
      <bpmn:outgoing>SequenceFlow_c1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="SequenceFlow_g1" sourceRef="StartEvent_0guest" targetRef="Task_1chooseDish" />
    
    <bpmn:exclusiveGateway id="ExclusiveGateway_2waitOrder" name="Reihe?">
      <bpmn:incoming>SequenceFlow_s2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_g3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Staff tasks -->
    <bpmn:task id="Task_3cashRegister" name="Kasse bedienen">
      <bpmn:incoming>SequenceFlow_s5</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_c4</bpmn:outgoing>
    </bpmn:task>

    <!-- Cook tasks -->
    <bpmn:startEvent id="StartEvent_8cook" name="Koch erhält Bestellung">
        <bpmn:text><![CDATA[Bestellung erhalten]]></bpmn:text>
      <bpmn:outgoing>SequenceFlow_c1</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Sequence flows for staff -->
    <bpmn:sequenceFlow id="SequenceFlow_s2" sourceRef="Task_1chooseDish" targetRef="ExclusiveGateway_6pagerTriggered" />
    
    <bpmn:task id="Task_3cashRegister" name="Kasse bedienen">
      <bpmn:incoming>SequenceFlow_c4</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_s5</bpmn:outgoing>
    </bpmn:task>

  </bpmn:process>
</bpmn:definitions>