<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Check Hunger">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Select Dish">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="IntermediateCatchEvent_1"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="Wait in Line">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_4" sourceRef="IntermediateCatchEvent_1" targetRef="Task_3"/>
    <task id="Task_3" name="Place Order">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="Task_4"/>
    <task id="Task_4" name="Pay and Receive Pager">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_4" targetRef="IntermediateCatchEvent_2"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_2" name="Wait for Food">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_7" sourceRef="IntermediateCatchEvent_2" targetRef="Task_5"/>
    <task id="Task_5" name="Pick Up Food">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_8" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
    </endEvent>

  </process>
  <process id="Process_2" isExecutable="true">
    <startEvent id="StartEvent_2">
      <outgoing>SequenceFlow_9</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <sequenceFlow id="SequenceFlow_9" sourceRef="StartEvent_2" targetRef="Task_6"/>
    <task id="Task_6" name="Enter Order into System">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_6" targetRef="Task_7"/>
    <task id="Task_7" name="Collect Payment">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_7" targetRef="Task_8"/>
    <task id="Task_8" name="Set Pager">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_8" targetRef="Task_9"/>
    <task id="Task_9" name="Inform Cook">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_9" targetRef="IntermediateCatchEvent_3"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_3" name="Wait for Food to be Ready">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_14" sourceRef="IntermediateCatchEvent_3" targetRef="Task_10"/>
    <task id="Task_10" name="Trigger Pager">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_10" targetRef="EventBasedGateway_1"/>
    <eventBasedGateway id="EventBasedGateway_1">
      <incoming>SequenceFlow_15</incoming>
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="IntermediateCatchEvent_4" name="Customer Appears">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_19</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_17" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_4"/>
    <task id="Task_11" name="Hand Over Food">
      <incoming>SequenceFlow_19</incoming>
      <outgoing>SequenceFlow_20</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_19" sourceRef="IntermediateCatchEvent_4" targetRef="Task_11"/>
    <sequenceFlow id="SequenceFlow_20" sourceRef="Task_11" targetRef="EndEvent_2"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_20</incoming>
    </endEvent>

  </process>
  <process id="Process_3" isExecutable="true">
    <startEvent id="StartEvent_3">
      <outgoing>SequenceFlow_21</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <sequenceFlow id="SequenceFlow_21" sourceRef="StartEvent_3" targetRef="Task_12"/>
    <task id="Task_12" name="Prepare Food">
      <incoming>SequenceFlow_21</incoming>
      <outgoing>SequenceFlow_22</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_22" sourceRef="Task_12" targetRef="Task_13"/>
    <task id="Task_13" name="Place Food in Service Line">
      <incoming>SequenceFlow_22</incoming>
      <outgoing>SequenceFlow_23</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_23" sourceRef="Task_13" targetRef="Task_14"/>
    <task id="Task_14" name="Inform Staff">
      <incoming>SequenceFlow_23</incoming>
      <outgoing>SequenceFlow_24</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_24" sourceRef="Task_14" targetRef="EndEvent_3"/>
    <endEvent id="EndEvent_3">
      <incoming>SequenceFlow_24</incoming>
    </endEvent>

  </process>
</definitions>