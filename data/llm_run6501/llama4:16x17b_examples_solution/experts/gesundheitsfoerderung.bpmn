<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_HealthCheck"/>
     <task id="Task_HealthCheck" name="Gesundheits-Check durchführen">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_HealthCheck" targetRef="ExclusiveGateway_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_Trainingsplan">
       <conditionExpression xsi:type="tFormalExpression">${trainingsplan}</conditionExpression>
     </sequenceFlow>
     <task id="Task_Trainingsplan" name="Trainings- und Ernährungspläne erstellen">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_Trainingsplan" targetRef="IntermediateCatchEvent_SixMonths"/>
     <intermediateCatchEvent id="IntermediateCatchEvent_SixMonths">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_SixMonths" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_2" targetRef="Task_SelfTraining">
       <conditionExpression xsi:type="tFormalExpression">${self_training}</conditionExpression>
     </sequenceFlow>
     <task id="Task_SelfTraining" name="Eigenständiges Training ohne Wearables">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_AppAndWearablesTraining">
       <conditionExpression xsi:type="tFormalExpression">${app_and_wearables_training}</conditionExpression>
     </sequenceFlow>
     <task id="Task_AppAndWearablesTraining" name="Training mit App und Wearables">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_SelfTraining" targetRef="EndEvent_FinalHealthCheck"/>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_AppAndWearablesTraining" targetRef="EndEvent_FinalHealthCheck"/>
     <endEvent id="EndEvent_FinalHealthCheck">
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_10</incoming>
     </endEvent>
   </process>
 </definitions>