<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="damageClaimProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Check damage claim validity">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow5</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">isValid == true</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow3" sourceRef="task1" targetRef="exclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">isValid == false</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2"/>

    <task id="task2" name="Notify customer about invalid claim">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="parallelGateway1"/>

    <parallelGateway id="parallelGateway1">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
      <outgoing>sequenceFlow8</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="task3"/>

    <task id="task3" name="Check submitted documents for completeness">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway1" targetRef="serviceTask1"/>

    <serviceTask id="serviceTask1" name="Capture damage claim in statistics">
      <incoming>sequenceFlow8</incoming>
      <!-- No outgoing sequence flow, assuming it's an independent task -->
    </serviceTask>

    <sequenceFlow id="sequenceFlow9" sourceRef="task3" targetRef="userTask1"/>

    <userTask id="userTask1" name="Perform detailed validation">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow10" sourceRef="userTask1" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow11</outgoing>
      <outgoing>sequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway2" targetRef="task4"/>

    <task id="task4" name="Get legal assessment from insurer">
      <incoming>sequenceFlow11</incoming>
      <!-- No outgoing sequence flow, assuming it's a task that completes -->
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway2" targetRef="parallelGateway2"/>

    <parallelGateway id="parallelGateway2">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
      <outgoing>sequenceFlow14</outgoing>
    </parallelGateway>

    <sequenceFlow id="sequenceFlow13" sourceRef="parallelGateway2" targetRef="serviceTask2"/>

    <serviceTask id="serviceTask2" name="Update damage claim statistics">
      <incoming>sequenceFlow13</incoming>
      <!-- No outgoing sequence flow, assuming it's an independent task -->
    </serviceTask>

    <sequenceFlow id="sequenceFlow14" sourceRef="parallelGateway2" targetRef="task5"/>

    <task id="task5" name="Notify customer about current processing status">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow15</incoming>
    </endEvent>

  </process>
</definitions>