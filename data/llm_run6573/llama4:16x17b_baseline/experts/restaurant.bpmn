<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="restaurantProcess" isExecutable="true">
    <startEvent id="guestArrives">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="guestArrives" targetRef="task1"/>

    <task id="task1" name="Guest selects a dish from the menu and waits for their turn">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="serviceTask1"/>

    <serviceTask id="serviceTask1" name="Employee takes the order and enters it into the cash system">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow3" sourceRef="serviceTask1" targetRef="task2"/>

    <task id="task2" name="Employee receives payment from the guest">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="task2" targetRef="serviceTask2"/>

    <serviceTask id="serviceTask2" name="Employee sets a pager for the guest and hands it over">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow5" sourceRef="serviceTask2" targetRef="task3"/>

    <task id="task3" name="Employee informs the cook about the ordered meal">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow6" sourceRef="task3" targetRef="serviceTask3"/>

    <serviceTask id="serviceTask3" name="Cook prepares the meal and places it in the pass-through">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow7" sourceRef="serviceTask3" targetRef="task4"/>

    <task id="task4" name="Cook informs the employee that the meal is ready">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task4" targetRef="serviceTask4"/>

    <serviceTask id="serviceTask4" name="Employee triggers the guest's pager">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow9" sourceRef="serviceTask4" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow10</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway1" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">guest reacts to the pager</conditionExpression>
    </sequenceFlow>

    <task id="task5" name="Guest picks up their meal and consumes it">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="exclusiveGateway1" targetRef="serviceTask5">
      <conditionExpression xsi:type="tFormalExpression">guest does not react to the pager</conditionExpression>
    </sequenceFlow>

    <serviceTask id="serviceTask5" name="Employee calls out the guest after 5 minutes">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="endEvent"/>

    <sequenceFlow id="sequenceFlow13" sourceRef="serviceTask5" targetRef="exclusiveGateway1"/>

    <endEvent id="endEvent">
      <incoming>sequenceFlow12</incoming>
    </endEvent>

  </process>

</definitions>