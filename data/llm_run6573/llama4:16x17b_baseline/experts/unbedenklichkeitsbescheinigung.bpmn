<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="unbedenklichkeitsbescheinigungProcess" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="task1"/>

    <task id="task1" name="Sicherstellung der Nachvollziehbarkeit und Prozessidentifikation">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="exclusiveGateway1"/>

    <exclusiveGateway id="exclusiveGateway1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="task2">
      <conditionExpression xsi:type="tFormalExpression">personImSystemVorhanden == true</conditionExpression>
    </sequenceFlow>

    <task id="task2" name="Überprüfung von Informationen und Ermittlung des Versicherungszeitraums">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="task2" targetRef="exclusiveGateway2"/>

    <exclusiveGateway id="exclusiveGateway2">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow6</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="task3">
      <conditionExpression xsi:type="tFormalExpression">arbeitgeberrolleVorhanden == true</conditionExpression>
    </sequenceFlow>

    <task id="task3" name="Überprüfung der Versicherungszeiten und Beitragsnachweise">
      <incoming>sequenceFlow6</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow8" sourceRef="task3" targetRef="exclusiveGateway3"/>

    <exclusiveGateway id="exclusiveGateway3">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway3" targetRef="task4">
      <conditionExpression xsi:type="tFormalExpression">unbedenklichkeitVorhanden == true</conditionExpression>
    </sequenceFlow>

    <task id="task4" name="Ausstellung der Unbedenklichkeitsbescheinigung">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="task4" targetRef="endEvent1"/>

    <sequenceFlow id="sequenceFlow10" sourceRef="exclusiveGateway3" targetRef="task5">
      <conditionExpression xsi:type="tFormalExpression">unbedenklichkeitVorhanden == false</conditionExpression>
    </sequenceFlow>

    <task id="task5" name="Erstellung einer Bescheinigung mit Hinweis auf nicht vollständige Unbedenklichkeit">
      <incoming>sequenceFlow10</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow12" sourceRef="task5" targetRef="endEvent2"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow11</incoming>
    </endEvent>

    <endEvent id="endEvent2">
      <incoming>sequenceFlow12</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task6">
      <conditionExpression xsi:type="tFormalExpression">personImSystemVorhanden == false</conditionExpression>
    </sequenceFlow>

    <task id="task6" name="Erstellung eines Anschreibens zur Einholung weiterer Informationen">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow13" sourceRef="task6" targetRef="exclusiveGateway4"/>

    <exclusiveGateway id="exclusiveGateway4">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow14" sourceRef="exclusiveGateway4" targetRef="task7"/>

    <task id="task7" name="Übergabe an einen Sachbearbeiter zur weiteren Bearbeitung">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow15" sourceRef="task7" targetRef="endEvent3"/>

    <endEvent id="endEvent3">
      <incoming>sequenceFlow15</incoming>
    </endEvent>
  </process>
</definitions>