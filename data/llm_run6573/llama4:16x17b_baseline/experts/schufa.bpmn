<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="schufaScoringProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="serviceTask1"/>

     <serviceTask id="serviceTask1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="serviceTask1" targetRef="intermediateEvent1"/>

     <intermediateEvent id="intermediateEvent1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </intermediateEvent>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="intermediateEvent1" targetRef="exclusiveGateway1"/>

     <intermediateEvent id="intermediateEvent2">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow4" sourceRef="intermediateEvent1" targetRef="intermediateEvent2"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="intermediateEvent2" targetRef="exclusiveGateway1"/>

     <serviceTask id="serviceTask2">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway1" targetRef="serviceTask2"/>

     <endEvent id="endEvent1">
       <incoming>sequenceFlow7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="serviceTask2" targetRef="endEvent1"/>
   </process>
</definitions>