<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Reward and Training Process">
  <process id="rewardAndTrainingProcess" isExecutable="true">
    <startEvent id="startEvent1">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="checkPerformance1" name="Check Employee Performance">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="checkPerformance1"/>

    <exclusiveGateway id="performanceResult1">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow4</outgoing>
      <outgoing>sequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow2" sourceRef="checkPerformance1" targetRef="performanceResult1">
      <conditionExpression xsi:type="tFormalExpression">${performance <= 20}</conditionExpression>
    </sequenceFlow>

    <task id="suggestDismissal1" name="Suggest Dismissal to HR">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="performanceResult1" targetRef="suggestDismissal1">
      <conditionExpression xsi:type="tFormalExpression">${performance <= 20}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="dismissEmployee1" name="HR Dismisses Employee">
      <incoming>sequenceFlow5</incoming>
    </serviceTask>

    <sequenceFlow id="sequenceFlow5" sourceRef="suggestDismissal1" targetRef="dismissEmployee1"/>

    <task id="suggestTraining1" name="Suggest Training to HR">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="performanceResult1" targetRef="suggestTraining1">
      <conditionExpression xsi:type="tFormalExpression">${performance > 20 and performance <= 50}</conditionExpression>
    </sequenceFlow>

    <serviceTask id="provideTraining1" name="HR Provides Training">
      <incoming>sequenceFlow6</incoming>
    </serviceTask>

    <sequenceFlow id="sequenceFlow6" sourceRef="suggestTraining1" targetRef="provideTraining1"/>

    <task id="suggestReward1" name="Suggest Reward to Management">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow7" sourceRef="performanceResult1" targetRef="suggestReward1">
      <conditionExpression xsi:type="tFormalExpression">${performance > 75}</conditionExpression>
    </sequenceFlow>

    <exclusiveGateway id="rewardType1">
      <incoming>sequenceFlow8</incoming>
      <outgoing>sequenceFlow9</outgoing>
      <outgoing>sequenceFlow11</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow8" sourceRef="suggestReward1" targetRef="rewardType1"/>

    <task id="financialReward1" name="Financial Reward by Finance">
      <incoming>sequenceFlow9</incoming>
    </task>

    <sequenceFlow id="sequenceFlow9" sourceRef="rewardType1" targetRef="financialReward1"/>

    <task id="otherBenefit1" name="Choose Other Benefit">
      <incoming>sequenceFlow11</incoming>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="rewardType1" targetRef="otherBenefit1"/>

    <task id="announceEmployeeOfTheMonth1" name="Announce Employee of the Month">
      <incoming>sequenceFlow10</incoming>
    </task>

    <sequenceFlow id="sequenceFlow10" sourceRef="suggestReward1" targetRef="announceEmployeeOfTheMonth1"/>

    <endEvent id="endEvent1">
      <incoming>sequenceFlow6</incoming>
      <incoming>sequenceFlow5</incoming>
      <incoming>sequenceFlow9</incoming>
      <incoming>sequenceFlow11</incoming>
      <incoming>sequenceFlow10</incoming>
    </endEvent>

  </process>
</definitions>