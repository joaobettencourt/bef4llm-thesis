<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="Bag Collection Process" targetNamespace="http://example.com/bpmn">
   <process id="bagCollectionProcess" isExecutable="true">
     <startEvent id="notCollectedBagIdentified1" name="Not Collected Bag Identified">
       <outgoing>sequenceFlow11</outgoing>
     </startEvent>

     <task id="checkResolutionRetries1" name="Check Resolution Retries">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="notCollectedBagIdentified1" targetRef="checkResolutionRetries1"/>

     <exclusiveGateway id="retryCountCheck1" name="Retry Count Check">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow13</outgoing>
       <outgoing>sequenceFlow14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow12" sourceRef="checkResolutionRetries1" targetRef="retryCountCheck1"/>

     <task id="returnToProductionArea1" name="Return to Production Area for Disassemble">
       <incoming>sequenceFlow13</incoming>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="retryCountCheck1" targetRef="returnToProductionArea1"/>

     <task id="contactCustomer1" name="Contact Customer by Phone">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
       <outgoing>sequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="retryCountCheck1" targetRef="contactCustomer1"/>

     <exclusiveGateway id="contactResult1" name="Contact Result">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow17</outgoing>
       <outgoing>sequenceFlow18</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow15" sourceRef="contactCustomer1" targetRef="contactResult1"/>

     <task id="increaseRetryCount1" name="Increase Retry Count on Bag Label">
       <incoming>sequenceFlow17</incoming>
     </task>

     <sequenceFlow id="sequenceFlow17" sourceRef="contactResult1" targetRef="increaseRetryCount1"/>

     <exclusiveGateway id="customerResponse1" name="Customer Response">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow19</outgoing>
       <outgoing>sequenceFlow20</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow16" sourceRef="contactCustomer1" targetRef="customerResponse1"/>

     <task id="disassembleBag1" name="Disassemble Bag">
       <incoming>sequenceFlow19</incoming>
     </task>

     <sequenceFlow id="sequenceFlow19" sourceRef="customerResponse1" targetRef="disassembleBag1"/>

     <task id="increaseRetryCountUnsuccessful1" name="Increase Retry Count on Bag Label Unsuccessful">
       <incoming>sequenceFlow20</incoming>
     </task>

     <sequenceFlow id="sequenceFlow20" sourceRef="customerResponse1" targetRef="increaseRetryCountUnsuccessful1"/>

     <endEvent id="processEnd1" name="Process End">
       <incoming>sequenceFlow18</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow18" sourceRef="contactResult1" targetRef="processEnd1"/>
   </process>
 </definitions>