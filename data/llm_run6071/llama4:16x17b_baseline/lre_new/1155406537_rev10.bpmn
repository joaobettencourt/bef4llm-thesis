<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Paypal Account Creation Process" targetNamespace="http://example.com/paypal">

   <process id="paypalAccountCreationProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="accountTypeGateway1">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="accountTypeGateway1"/>

     <task id="selectPersonalAccount1" name="Select Personal Account">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="accountTypeGateway1" targetRef="selectPersonalAccount1"/>

     <task id="selectPremiumAccount1" name="Select Premium Account">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4_1</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="accountTypeGateway1" targetRef="selectPremiumAccount1"/>

     <parallelGateway id="enterDetailsGateway1">
       <incoming>sequenceFlow4</incoming>
       <incoming>sequenceFlow4_1</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="selectPersonalAccount1" targetRef="enterDetailsGateway1"/>
     <sequenceFlow id="sequenceFlow4_1" sourceRef="selectPremiumAccount1" targetRef="enterDetailsGateway1"/>

     <task id="enterLoginDetails1" name="Enter Login Details">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="enterDetailsGateway1" targetRef="enterLoginDetails1"/>

     <task id="enterPersonalDetails1" name="Enter Personal Details">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="enterLoginDetails1" targetRef="enterPersonalDetails1"/>

     <task id="enterContactInformation1" name="Enter Contact Information">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow7" sourceRef="enterPersonalDetails1" targetRef="enterContactInformation1"/>

     <task id="declarePoliticallyExposedPerson1" name="Declare Politically Exposed Person">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="enterContactInformation1" targetRef="declarePoliticallyExposedPerson1"/>

     <serviceTask id="createAccount1" name="Create Account">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="declarePoliticallyExposedPerson1" targetRef="createAccount1"/>

     <exclusiveGateway id="validationResultGateway1">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow12</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow10" sourceRef="createAccount1" targetRef="validationResultGateway1"/>

     <task id="notifyClientOfInvalidFields1" name="Notify Client of Invalid Fields">
       <incoming>sequenceFlow12</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow12" sourceRef="validationResultGateway1" targetRef="notifyClientOfInvalidFields1"/>

     <task id="generateWelcomeEmail1" name="Generate Welcome Email">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="validationResultGateway1" targetRef="generateWelcomeEmail1"/>

     <endEvent id="accountCreated1" name="Account Created">
       <incoming>sequenceFlow15</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="generateWelcomeEmail1" targetRef="accountCreated1"/>
   </process>
 </definitions>