<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Order Fulfillment Process" targetNamespace="http://example.com/bpmn">

   <process id="orderFulfillmentProcess" isExecutable="true">
     <startEvent id="reviewOrder">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkAvailability">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="reviewOrder" targetRef="checkAvailability"/>

     <exclusiveGateway id="availabilityResult">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkAvailability" targetRef="availabilityResult"/>

     <task id="informCustomerDelay">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow5" sourceRef="availabilityResult" targetRef="informCustomerDelay"/>

     <task id="orderMissingProducts">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow6" sourceRef="informCustomerDelay" targetRef="orderMissingProducts"/>

     <intermediateEvent id="waitForDelivery">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="orderMissingProducts" targetRef="waitForDelivery"/>

     <task id="recheckAvailability">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow8" sourceRef="waitForDelivery" targetRef="recheckAvailability"/>

     <exclusiveGateway id="availabilityResult2">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow9" sourceRef="recheckAvailability" targetRef="availabilityResult2"/>

     <task id="informCustomerDiscontinued">
       <incoming>sequenceFlow11</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow11" sourceRef="availabilityResult2" targetRef="informCustomerDiscontinued"/>

     <task id="collectProducts">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="availabilityResult2" targetRef="collectProducts"/>

     <task id="preparePackage">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow13" sourceRef="collectProducts" targetRef="preparePackage"/>

     <task id="informCourier">
       <incoming>sequenceFlow14</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="preparePackage" targetRef="informCourier"/>

     <intermediateEvent id="courierInformsClient2">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow15" sourceRef="informCourier" targetRef="courierInformsClient2"/>

     <task id="pickupPackage">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow16" sourceRef="courierInformsClient2" targetRef="pickupPackage"/>

     <intermediateEvent id="routeOptimization">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow18</outgoing>
     </intermediateEvent>

     <sequenceFlow id="sequenceFlow17" sourceRef="pickupPackage" targetRef="routeOptimization"/>

     <task id="deliverPackage">
       <incoming>sequenceFlow18</incoming>
       <outgoing>sequenceFlow19</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow18" sourceRef="routeOptimization" targetRef="deliverPackage"/>

     <endEvent id="orderDelivered">
       <incoming>sequenceFlow19</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow19" sourceRef="deliverPackage" targetRef="orderDelivered"/>
   </process>
 </definitions>