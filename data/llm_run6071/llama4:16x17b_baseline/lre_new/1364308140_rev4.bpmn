<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="SO: Angebot/Auftrag Process"
             targetNamespace="http://example.com/bpmn">

   <process id="soAngebotAuftragProcess" isExecutable="true">
     <startEvent id="subsidaryOrderReceived" name="Subsidary Order Received">
       <outgoing>prepareGoodsFlow</outgoing>
       <outgoing>prepareInvoicingFlow</outgoing>
       <outgoing>shipGoodsFlow</outgoing>
     </startEvent>

     <task id="prepareGoodsTask" name="Prepare Goods for Shipment">
       <incoming>prepareGoodsFlow</incoming>
       <outgoing>goodsPreparedFlow</outgoing>
     </task>

     <sequenceFlow id="prepareGoodsFlow" sourceRef="subsidaryOrderReceived" targetRef="prepareGoodsTask"/>
     <sequenceFlow id="goodsPreparedFlow" sourceRef="prepareGoodsTask" targetRef="shipGoodsTask"/>

     <task id="shipGoodsTask" name="Ship Goods">
       <incoming>goodsPreparedFlow</incoming>
       <outgoing>goodsShippedFlow</outgoing>
     </task>

     <sequenceFlow id="shipGoodsFlow" sourceRef="subsidaryOrderReceived" targetRef="shipGoodsTask"/>
     <sequenceFlow id="goodsShippedFlow" sourceRef="shipGoodsTask"/>

     <task id="prepareInvoicingTask" name="Prepare Invoicing">
       <incoming>prepareInvoicingFlow</incoming>
       <outgoing>invoicingPreparedFlow</outgoing>
     </task>

     <sequenceFlow id="prepareInvoicingFlow" sourceRef="subsidaryOrderReceived" targetRef="prepareInvoicingTask"/>
     <sequenceFlow id="invoicingPreparedFlow" sourceRef="prepareInvoicingTask" targetRef="isSubsidiaryGateway"/>

     <exclusiveGateway id="isSubsidiaryGateway" name="Is Customer Subsidiary?">
       <incoming>invoicingPreparedFlow</incoming>
       <outgoing>addParentCompanyFlow</outgoing>
       <outgoing>createInvoiceDirectlyFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="addParentCompanyFlow" sourceRef="isSubsidiaryGateway" targetRef="addParentCompanyTask">
       <conditionExpression xsi:type="tFormalExpression">${customer.isSubsidiary()}</conditionExpression>
     </sequenceFlow>

     <task id="addParentCompanyTask" name="Add Parent Company as Invoicing Address">
       <incoming>addParentCompanyFlow</incoming>
       <outgoing>parentCompanyAddedFlow</outgoing>
     </task>

     <sequenceFlow id="parentCompanyAddedFlow" sourceRef="addParentCompanyTask" targetRef="createInvoiceTask"/>

     <sequenceFlow id="createInvoiceDirectlyFlow" sourceRef="isSubsidiaryGateway" targetRef="createInvoiceTask">
       <conditionExpression xsi:type="tFormalExpression">${!customer.isSubsidiary()}</conditionExpression>
     </sequenceFlow>

     <task id="createInvoiceTask" name="Create Invoice">
       <incoming>parentCompanyAddedFlow</incoming>
       <incoming>createInvoiceDirectlyFlow</incoming>
       <outgoing>invoiceCreatedFlow</outgoing>
     </task>

     <sequenceFlow id="invoiceCreatedFlow" sourceRef="createInvoiceTask" targetRef="sendInvoiceTask"/>

     <task id="sendInvoiceTask" name="Send Invoice">
       <incoming>invoiceCreatedFlow</incoming>
       <outgoing>invoiceSentFlow</outgoing>
     </task>

     <endEvent id="invoiceSentEnd" name="Invoice Sent">
       <incoming>invoiceSentFlow</incoming>
     </endEvent>

     <sequenceFlow id="invoiceSentFlow" sourceRef="sendInvoiceTask" targetRef="invoiceSentEnd"/>
   </process>
 </definitions>