<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="Payment Process" targetNamespace="http://example.com/paymentProcess">

   <process id="paymentProcess" isExecutable="true">
     <startEvent id="weeklyPaymentReport" name="End of Week">
       <outgoing>generate-report</outgoing>
     </startEvent>

     <task id="generate-payment-report" name="Generate Payment Report">
       <incoming>generate-report</incoming>
       <outgoing>pay-vendor</outgoing>
     </task>

     <sequenceFlow id="generate-report" sourceRef="weeklyPaymentReport" targetRef="generate-payment-report"/>

     <task id="pay-vendor" name="Pay Vendor">
       <incoming>pay-vendor</incoming>
       <outgoing>send-to-clients</outgoing>
     </task>

     <sequenceFlow id="pay-vendor-flow" sourceRef="generate-payment-report" targetRef="pay-vendor"/>

     <task id="send-to-clients" name="Automatic Send Reports to Clients">
       <incoming>pay-vendor-flow</incoming>
       <outgoing>send-to-registry-office</outgoing>
     </task>

     <sequenceFlow id="send-to-clients-flow" sourceRef="pay-vendor" targetRef="send-to-clients"/>

     <task id="send-to-registry-office-task" name="Send Payment Report to Registry Office">
       <incoming>send-to-clients-flow</incoming>
       <outgoing>send-to-accounts-receivable</outgoing>
     </task>

     <sequenceFlow id="send-to-registry-office-flow" sourceRef="send-to-clients" targetRef="send-to-registry-office-task"/>

     <task id="send-to-accounts-receivable-task" name="Send Payment Report to Accounts Receivable Department">
       <incoming>send-to-registry-office-flow</incoming>
       <outgoing>generate-monthly-invoice</outgoing>
     </task>

     <sequenceFlow id="send-to-accounts-receivable-flow" sourceRef="send-to-registry-office-task" targetRef="send-to-accounts-receivable-task"/>

     <task id="generate-monthly-invoice-task" name="Generate Monthly Invoice">
       <incoming>send-to-accounts-receivable-flow</incoming>
       <outgoing>charge-client</outgoing>
     </task>

     <sequenceFlow id="generate-monthly-invoice-flow" sourceRef="send-to-accounts-receivable-task" targetRef="generate-monthly-invoice-task"/>

     <task id="charge-client-task" name="Charge Client $35 per Invoice">
       <incoming>generate-monthly-invoice-flow</incoming>
       <outgoing>notify-client</outgoing>
     </task>

     <sequenceFlow id="charge-client-flow" sourceRef="generate-monthly-invoice-task" targetRef="charge-client-task"/>

     <task id="notify-client-task" name="Notify Client">
       <incoming>charge-client-flow</incoming>
     </task>

     <sequenceFlow id="notify-client-flow" sourceRef="charge-client-task" targetRef="notify-client-task"/>

     <task id="select-invoices-to-archive-task" name="Select Paid Invoices for Archive">
       <incoming>send-to-registry-office-flow</incoming>
       <outgoing>archive-invoices</outgoing>
     </task>

     <sequenceFlow id="select-invoices-to-archive-flow" sourceRef="send-to-registry-office-task" targetRef="select-invoices-to-archive-task"/>

     <task id="archive-invoices-task" name="Archive Invoices per Vendor and Payment Date">
       <incoming>select-invoices-to-archive-flow</incoming>
     </task>

     <sequenceFlow id="archive-invoices-flow" sourceRef="select-invoices-to-archive-task" targetRef="archive-invoices-task"/>

     <task id="track-payment-task" name="Track Down Payment">
       <incoming>send-to-registry-office-flow</incoming>
     </task>

     <sequenceFlow id="track-payment-flow" sourceRef="send-to-registry-office-task" targetRef="track-payment-task"/>
   </process>
 </definitions>