<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="restaurantProcess" isExecutable="true">
    <startEvent id="guestEntersRestaurant">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="sequenceFlow1" sourceRef="guestEntersRestaurant" targetRef="chooseDishTask"/>

    <task id="chooseDishTask" name="Choose a dish from the changing meal range">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow2" sourceRef="chooseDishTask" targetRef="waitForTurnTask"/>

    <task id="waitForTurnTask" name="Wait until it is his turn">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow3" sourceRef="waitForTurnTask" targetRef="placeOrderTask"/>

    <task id="placeOrderTask" name="Place order with the employee">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow4" sourceRef="placeOrderTask" targetRef="employeeEnterOrderTask"/>

    <task id="employeeEnterOrderTask" name="Employee enters the order into the POS system and collects money">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow5" sourceRef="employeeEnterOrderTask" targetRef="passOnBuzzerTask"/>

    <task id="passOnBuzzerTask" name="Employee sets up a buzzer and passes it on to the guest">
      <incoming>sequenceFlow5</incoming>
        <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>

    </task>

     <sequenceFlow id="sequenceFlow9" sourceRef="passOnBuzzerTask" targetRef="informChefTask"/>

    <task id="informChefTask" name="Employee informs the chef of the new meal order">
      <incoming>sequenceFlow9</incoming>
      <outgoing>sequenceFlow11</outgoing>

    </task>

     <sequenceFlow id="sequenceFlow10" sourceRef="passOnBuzzerTask" targetRef="prepareMealTask"/>

    <task id="prepareMealTask" name="Chef prepares the meal and places it in the service hatch">
      <incoming>sequenceFlow10</incoming>
        <outgoing>sequenceFlow12</outgoing>

    </task>
     <sequenceFlow id="sequenceFlow11" sourceRef="informChefTask" targetRef="chefInformsEmployeeTask"/>

  <task id="chefInformsEmployeeTask" name="Chef informs the employee that he has placed the finished meal in the service hatch">
      <incoming>sequenceFlow11</incoming>
        <outgoing>sequenceFlow13</outgoing>

    </task>


     <sequenceFlow id="sequenceFlow12" sourceRef="prepareMealTask" targetRef="chefInformsEmployeeTask"/>

       <sequenceFlow id="sequenceFlow13" sourceRef="chefInformsEmployeeTask" targetRef="employeeSetsOffBuzzerTask"/>


  <task id="employeeSetsOffBuzzerTask" name="Employee sets off the guest's buzzer">
      <incoming>sequenceFlow13</incoming>
        <outgoing>sequenceFlow14</outgoing>

    </task>

     <sequenceFlow id="sequenceFlow14" sourceRef="employeeSetsOffBuzzerTask" targetRef="guestPicksUpMealTask"/>

  <task id="guestPicksUpMealTask" name="Guest picks up his meal">
      <incoming>sequenceFlow14</incoming>
        <outgoing>sequenceFlow15</outgoing>

    </task>

     <sequenceFlow id="sequenceFlow15" sourceRef="guestPicksUpMealTask" targetRef="endEvent"/>

  <endEvent id="endEvent" name="End of process">
      <incoming>sequenceFlow15</incoming>
 
    </endEvent>


  </process>
</definitions>