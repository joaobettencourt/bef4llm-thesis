<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="IPOProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Select Underwriters">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

    <task id="Task2" name="Prepare Registration Statement">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="Task3"/>

    <task id="Task3" name="Register with SEC and Comply with Blue-Sky Laws">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="Task3" targetRef="Gateway1"/>

    <parallelGateway id="Gateway1">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow5</outgoing>
      <outgoing>SequenceFlow6</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow5" sourceRef="Gateway1" targetRef="Task4"/>

    <task id="Task4" name="Firm Up Issue Price and Arrange Road Show">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="Gateway1" targetRef="Task5"/>

    <task id="Task5" name="Receive Clearance from SEC">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task4" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
      <outgoing>SequenceFlow10</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task5" targetRef="ExclusiveGateway1"/>

    <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway1" targetRef="Task6">
      <conditionExpression xsi:type="tFormalExpression">${clearanceGranted}</conditionExpression>
    </sequenceFlow>

    <task id="Task6" name="Fix Issue Price and Enter into Firm Commitment">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${clearanceNotGranted}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task6" targetRef="Task7"/>

    <task id="Task7" name="Offer Stock to Public">
      <incoming>SequenceFlow11</incoming>
    </task>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow10</incoming>
    </endEvent>
  </process>
</definitions>