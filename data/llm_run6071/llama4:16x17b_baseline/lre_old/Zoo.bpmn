<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="ZooClubMembershipProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
       <outgoing>SequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow2" sourceRef="ExclusiveGateway1" targetRef="Task1">
       <conditionExpression xsi:type="tFormalExpression">${membershipType == 'individual'}</conditionExpression>
     </sequenceFlow>

     <task id="Task1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="Task1" targetRef="Task3"/>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
       <conditionExpression xsi:type="tFormalExpression">${membershipType == 'family'}</conditionExpression>
     </sequenceFlow>

     <task id="Task2">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="Task3"/>

     <task id="Task3">
       <incoming>SequenceFlow4</incoming>
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="UserTask1"/>

     <userTask id="UserTask1">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow7" sourceRef="UserTask1" targetRef="UserTask2"/>

     <userTask id="UserTask2">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow8" sourceRef="UserTask2" targetRef="ParallelGateway1"/>

     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
       <outgoing>SequenceFlow10</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow9" sourceRef="ParallelGateway1" targetRef="UserTask3"/>

     <userTask id="UserTask3">
       <incoming>SequenceFlow9</incoming>
     </userTask>

     <sequenceFlow id="SequenceFlow10" sourceRef="ParallelGateway1" targetRef="BankTasks"/>

     <subProcess id="BankTasks">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
       <userTask id="UserTask4">
         <incoming></incoming>
         <outgoing>SequenceFlow12</outgoing>
       </userTask>

       <sequenceFlow id="SequenceFlow12" sourceRef="UserTask4" targetRef="EndEvent1"/>

       <endEvent id="EndEvent1">
         <incoming>SequenceFlow12</incoming>
       </endEvent>
     </subProcess>

     <sequenceFlow id="SequenceFlow11" sourceRef="BankTasks" targetRef="ZooClubDepartmentPrintCard"/>

     <userTask id="ZooClubDepartmentPrintCard">
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </userTask>

     <sequenceFlow id="SequenceFlow13" sourceRef="ZooClubDepartmentPrintCard" targetRef="EndEvent2"/>

     <endEvent id="EndEvent2">
       <incoming>SequenceFlow13</incoming>
     </endEvent>

   </process>
</definitions>