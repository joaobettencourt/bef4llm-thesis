<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="MeetingScheduleProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1" name="Draft Schedule of Meetings">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

     <task id="Task2" name="Check Dates and Suggest Modifications">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="Task3"/>

     <task id="Task3" name="Recheck Dates and Look for Conflicts">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="Task3" targetRef="Task4"/>

     <task id="Task4" name="Send Schedule to Committee Members">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task4" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow5</incoming>
     </endEvent>

     <startEvent id="TimerStartEvent">
       <timerEventDefinition>
         <timeCycle>P1Y11M</timeCycle>
       </timerEventDefinition>
       <outgoing>SequenceFlow6</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow6" sourceRef="TimerStartEvent" targetRef="Task1"/>

   </process>
</definitions>