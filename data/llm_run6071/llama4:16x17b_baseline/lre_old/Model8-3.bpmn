<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="JobDescriptionProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Report Vacancy to Personnel Department">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

    <task id="Task2" name="Wait for Job Description and Review">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="ExclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">${requiresCorrections}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow4" sourceRef="Task2" targetRef="Task5"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
      <outgoing>SequenceFlow6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${needsClarification}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Request Corrections">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow7</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="Task3" targetRef="Task2"/>

    <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway1" targetRef="Task5"/>

    <task id="Task5" name="Approve Job Description">
      <incoming>SequenceFlow4</incoming>
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task5" targetRef="EndEvent1"/>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow8</incoming>
    </endEvent>

    <task id="Task4" name="Provide Clarifications for Job Description">
      <incoming>SequenceFlow6</incoming>
    </task>
  </process>
</definitions>