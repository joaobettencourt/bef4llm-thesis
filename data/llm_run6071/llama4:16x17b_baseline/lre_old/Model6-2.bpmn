<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="orderProcess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow1</outgoing>
       <timerEventDefinition>
         <timeCycle>P0M1D</timeCycle>
       </timerEventDefinition>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="sendOrderTask"/>

     <serviceTask id="sendOrderTask">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="sendOrderTask" targetRef="processOrderTask"/>

     <userTask id="processOrderTask">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="processOrderTask" targetRef="sendInvoiceTask"/>

     <serviceTask id="sendInvoiceTask">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="sendInvoiceTask" targetRef="endEvent"/>

     <endEvent id="endEvent">
       <incoming>sequenceFlow4</incoming>
     </endEvent>
   </process>
</definitions>