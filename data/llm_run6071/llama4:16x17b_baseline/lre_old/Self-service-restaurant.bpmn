<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="RestaurantProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1" name="Guest Enters Restaurant and Chooses Dish">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="IntermediateCatchEvent1"/>

     <intermediateCatchEvent id="IntermediateCatchEvent1">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow3" sourceRef="IntermediateCatchEvent1" targetRef="Task2"/>

     <task id="Task2" name="Guest Places Order with Employee">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="Task2" targetRef="Task3"/>

     <task id="Task3" name="Employee Enters Order and Collects Money">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task3" targetRef="Task4"/>

     <task id="Task4" name="Employee Gives Guest Buzzer and Informs Chef">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow6" sourceRef="Task4" targetRef="Task5"/>

     <task id="Task5" name="Chef Prepares Meal and Informs Employee">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow7" sourceRef="Task5" targetRef="Task6"/>

     <task id="Task6" name="Employee Sets Off Buzzer When Meal is Ready">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
       <outgoing>SequenceFlow10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task6" targetRef="IntermediateCatchEvent2"/>

     <intermediateCatchEvent id="IntermediateCatchEvent2">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow9" sourceRef="IntermediateCatchEvent2" targetRef="Task7"/>

     <task id="Task7" name="Guest Collects Meal">
       <incoming>SequenceFlow9</incoming>
     </task>

     <sequenceFlow id="SequenceFlow10" sourceRef="Task6" targetRef="Task8"/>

     <task id="Task8" name="Employee Calls for Guest After 5 Minutes">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow11" sourceRef="Task8" targetRef="IntermediateCatchEvent2"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow9</incoming>
     </endEvent>
   </process>
</definitions>