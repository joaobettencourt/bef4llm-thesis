<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

  <process id="DeregistrationProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Deregister at GO">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${deregistrationRejected == true}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow3</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${deregistrationPreliminarilyConfirmed == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Prepare readmission of measuring point">
      <incoming>SequenceFlow4</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
      <outgoing>SequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway2" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${continueOperations == false}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Perform equipment acquisition and/or changes">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway2" targetRef="Task4">
      <conditionExpression xsi:type="tFormalExpression">${continueOperations == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task4" name="Oblige MPOO to continue operations">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="Task3" targetRef="Task5"/>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="Task6"/>

    <task id="Task5" name="Assign GO as MPO">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow10</outgoing>
    </task>

    <task id="Task6" name="Confirm continuation to MPOO">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow10" sourceRef="Task5" targetRef="Task7"/>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task6" targetRef="Task7"/>

    <task id="Task7" name="Inform MPOO, MSPO and SP about assignment of GO">
      <incoming>SequenceFlow10</incoming>
      <incoming>SequenceFlow11</incoming>
      <outgoing>SequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow12" sourceRef="Task7" targetRef="EndEvent2"/>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow12</incoming>
    </endEvent>
  </process>
</definitions>