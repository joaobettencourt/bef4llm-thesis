<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="WarrantPossessionRequestProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

     <task id="Task2">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="Task2" targetRef="Task3"/>

     <task id="Task3">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="Task3" targetRef="Task4"/>

     <task id="Task4">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task4" targetRef="IntermediateEvent2"/>

     <intermediateCatchEvent id="IntermediateEvent2">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow6" sourceRef="IntermediateEvent2" targetRef="Task5"/>

     <task id="Task5">
       <incoming>SequenceFlow6</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow7" sourceRef="Task5" targetRef="Task6"/>

     <task id="Task6">
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="Task6" targetRef="EndEvent1"/>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow8</incoming>
     </endEvent>
   </process>
 </definitions>