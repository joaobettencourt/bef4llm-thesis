<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="DismissalProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="MSPN sends dismissal to MSPO">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ReviewDismissal"/>

    <userTask id="ReviewDismissal" name="MSPO reviews dismissal">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </userTask>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
      <outgoing>SequenceFlow6</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ReviewDismissal" targetRef="ExclusiveGateway1"/>

    <sequenceFlow id="SequenceFlow4" sourceRef="ReviewDismissal" targetRef="ExclusiveGateway1">
      <conditionExpression xsi:type="tFormalExpression">${dismissalStatus == 'confirmed'}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="MSPO confirms dismissal of MSPN">
      <incoming>SequenceFlow5</incoming>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="ExclusiveGateway1" targetRef="Task2"/>

    <task id="Task3" name="MSPO rejects dismissal of MSPN">
      <incoming>SequenceFlow6</incoming>
    </task>

    <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${dismissalStatus == 'rejected'}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow5</incoming>
      <incoming>SequenceFlow6</incoming>
    </endEvent>
  </process>
</definitions>