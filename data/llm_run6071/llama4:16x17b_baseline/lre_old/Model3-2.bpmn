<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

  <process id="FilePreparationProcess" isExecutable="true">
    <startEvent id="StartEvent">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="Task1"/>

    <task id="Task1" name="Check Files for Court Hearing">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${filesMissing == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Initiate File Search">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="Task3"/>

    <task id="Task3" name="Physically Track Files to Intended Location">
      <incoming>SequenceFlow4</incoming>
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${filesMissing == false}</conditionExpression>
    </sequenceFlow>

    <sequenceFlow id="SequenceFlow6" sourceRef="Task3" targetRef="ParallelGateway1"/>

    <parallelGateway id="ParallelGateway1">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow7</outgoing>
      <outgoing>SequenceFlow8</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow7" sourceRef="ParallelGateway1" targetRef="Task4"/>

    <task id="Task4" name="Hand Files to Associate">
      <incoming>SequenceFlow7</incoming>
    </task>

    <sequenceFlow id="SequenceFlow8" sourceRef="ParallelGateway1" targetRef="Task5"/>

    <task id="Task5" name="Distribute Judges Lawlist">
      <incoming>SequenceFlow8</incoming>
    </task>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task4" targetRef="Task6"/>
    <sequenceFlow id="SequenceFlow10" sourceRef="Task5" targetRef="Task6"/>

    <task id="Task6" name="Conduct Directions Hearings">
      <incoming>SequenceFlow9</incoming>
      <incoming>SequenceFlow10</incoming>
    </task>

    <endEvent id="EndEvent">
      <incoming>SequenceFlow11</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow11" sourceRef="Task6" targetRef="EndEvent"/>
  </process>
</definitions>