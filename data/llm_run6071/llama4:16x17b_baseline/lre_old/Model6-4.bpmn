<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="Definitions" targetNamespace="http://www.example.com">

   <process id="CustomerAcquisitionProcess" isExecutable="true">
     <startEvent id="StartEvent">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent" targetRef="ExclusiveGateway1"/>

     <exclusiveGateway id="ExclusiveGateway1">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
       <outgoing>SequenceFlow3</outgoing>
       <outgoing>SequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow2" sourceRef="ExclusiveGateway1" targetRef="Task1">
       <conditionExpression xsi:type="tFormalExpression">${acquisitionMethod  ==  'buy_details'}</conditionExpression>
     </sequenceFlow>

     <task id="Task1" name="Buy Contact Details">
       <incoming>SequenceFlow2</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
       <conditionExpression xsi:type="tFormalExpression">${acquisitionMethod  ==  'marketing_exhibition'}</conditionExpression>
     </sequenceFlow>

     <task id="Task2" name="Participate in Exhibition">
       <incoming>SequenceFlow3</incoming>
       <outgoing>SequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="Task3">
       <conditionExpression xsi:type="tFormalExpression">${acquisitionMethod  ==  'personal_connection'}</conditionExpression>
     </sequenceFlow>

     <task id="Task3" name="Leverage Personal Connection">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="Task1" targetRef="CallCenterTask"/>
     <sequenceFlow id="SequenceFlow6" sourceRef="Task2" targetRef="CallCenterTask"/>
     <sequenceFlow id="SequenceFlow7" sourceRef="Task3" targetRef="CallCenterTask"/>

     <task id="CallCenterTask" name="Call Customer">
       <incoming>SequenceFlow5</incoming>
       <incoming>SequenceFlow6</incoming>
       <incoming>SequenceFlow7</incoming>
       <outgoing>SequenceFlow8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow8" sourceRef="CallCenterTask" targetRef="ExclusiveGateway2"/>

     <exclusiveGateway id="ExclusiveGateway2">
       <incoming>SequenceFlow8</incoming>
       <outgoing>SequenceFlow9</outgoing>
       <outgoing>SequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow9" sourceRef="ExclusiveGateway2" targetRef="Task4">
       <conditionExpression xsi:type="tFormalExpression">${customerInterested  == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task4" name="Online Presentation">
       <incoming>SequenceFlow9</incoming>
       <outgoing>SequenceFlow11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow10" sourceRef="ExclusiveGateway2" targetRef="HeadOfDevelopmentTask">
       <conditionExpression xsi:type="tFormalExpression">${customerInterested  == false and budget  > 1000000}</conditionExpression>
     </sequenceFlow>

     <task id="HeadOfDevelopmentTask" name="Personal Acquisition by Head of Development">
       <incoming>SequenceFlow10</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow11" sourceRef="Task4" targetRef="WaitForResponseTask"/>
     <sequenceFlow id="SequenceFlow12" sourceRef="HeadOfDevelopmentTask" targetRef="WaitForResponseTask"/>

     <task id="WaitForResponseTask" name="Wait for Customer Response">
       <incoming>SequenceFlow11</incoming>
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow13" sourceRef="WaitForResponseTask" targetRef="ExclusiveGateway3">
       <conditionExpression xsi:type="tFormalExpression">${timePassed  > 2 weeks}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway3">
       <incoming>SequenceFlow13</incoming>
       <outgoing>SequenceFlow14</outgoing>
       <outgoing>SequenceFlow15</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow14" sourceRef="ExclusiveGateway3" targetRef="SalesRepresentativeTask">
       <conditionExpression xsi:type="tFormalExpression">${followUpNeeded  == true}</conditionExpression>
     </sequenceFlow>

     <task id="SalesRepresentativeTask" name="Follow-up Call by Sales Representative">
       <incoming>SequenceFlow14</incoming>
       <outgoing>SequenceFlow16</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow15" sourceRef="ExclusiveGateway3" targetRef="QuotationTask"/>
     <sequenceFlow id="SequenceFlow16" sourceRef="SalesRepresentativeTask" targetRef="QuotationTask"/>

     <task id="QuotationTask" name="Create Quotation">
       <incoming>SequenceFlow15</incoming>
       <incoming>SequenceFlow16</incoming>
       <outgoing>SequenceFlow17</outgoing>
     </task>

     <endEvent id="EndEvent">
       <incoming>SequenceFlow17</incoming>
     </endEvent>
   </process>
</definitions>