<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">

   <process id="RoomServiceProcess" isExecutable="true">
     <startEvent id="StartEvent1">
       <outgoing>SequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

     <task id="Task1" name="Take Down Order">
       <incoming>SequenceFlow1</incoming>
       <outgoing>SequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="Task2"/>

     <task id="Task2" name="Submit Order to Kitchen">
       <incoming>SequenceFlow2</incoming>
     </task>

     <sequenceFlow id="SequenceFlow3" sourceRef="Task1" targetRef="Task3"/>

     <task id="Task3" name="Fetch Wine and Prepare Alcoholic Beverages">
       <incoming>SequenceFlow3</incoming>
     </task>

     <sequenceFlow id="SequenceFlow4" sourceRef="Task1" targetRef="AssignOrderToWaiter"/>

     <task id="AssignOrderToWaiter" name="Assign Order to Waiter">
       <incoming>SequenceFlow4</incoming>
       <outgoing>SequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow5" sourceRef="AssignOrderToWaiter" targetRef="ParallelGateway1"/>

     <parallelGateway id="ParallelGateway1">
       <incoming>SequenceFlow5</incoming>
       <outgoing>SequenceFlow6</outgoing>
       <outgoing>SequenceFlow7</outgoing>
       <outgoing>SequenceFlow8</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow6" sourceRef="ParallelGateway1" targetRef="Task2"/>

     <sequenceFlow id="SequenceFlow7" sourceRef="ParallelGateway1" targetRef="Task3"/>

     <sequenceFlow id="SequenceFlow8" sourceRef="ParallelGateway1" targetRef="ReadyCart"/>

     <task id="ReadyCart" name="Ready Cart and Prepare Non-Alcoholic Drinks">
       <incoming>SequenceFlow8</incoming>
     </task>

     <parallelGateway id="MergeGateway2">
       <incoming>SequenceFlow9</incoming>
       <incoming>SequenceFlow10</incoming>
       <incoming>SequenceFlow11</incoming>
       <outgoing>SequenceFlow12</outgoing>
     </parallelGateway>

     <sequenceFlow id="SequenceFlow9" sourceRef="Task2" targetRef="MergeGateway2"/>
     <sequenceFlow id="SequenceFlow10" sourceRef="Task3" targetRef="MergeGateway2"/>
     <sequenceFlow id="SequenceFlow11" sourceRef="ReadyCart" targetRef="MergeGateway2"/>

     <sequenceFlow id="SequenceFlow12" sourceRef="MergeGateway2" targetRef="DeliverOrder"/>

     <task id="DeliverOrder" name="Deliver Order to Guest Room">
       <incoming>SequenceFlow12</incoming>
       <outgoing>SequenceFlow13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow13" sourceRef="DeliverOrder" targetRef="DebitGuestAccount"/>

     <task id="DebitGuestAccount" name="Debit Guest's Account">
       <incoming>SequenceFlow13</incoming>
     </task>

     <endEvent id="EndEvent1">
       <incoming>SequenceFlow14</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow14" sourceRef="DebitGuestAccount" targetRef="EndEvent1"/>
   </process>
</definitions>