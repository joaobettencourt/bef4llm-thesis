<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com">
  <process id="SubrogationProcess" isExecutable="true">
    <startEvent id="StartEvent1">
      <outgoing>SequenceFlow1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow1" sourceRef="StartEvent1" targetRef="Task1"/>

    <task id="Task1" name="Get Information about Possible Subrogation">
      <incoming>SequenceFlow1</incoming>
      <outgoing>SequenceFlow2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow2" sourceRef="Task1" targetRef="ExclusiveGateway1"/>

    <exclusiveGateway id="ExclusiveGateway1">
      <incoming>SequenceFlow2</incoming>
      <outgoing>SequenceFlow3</outgoing>
      <outgoing>SequenceFlow4</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow3" sourceRef="ExclusiveGateway1" targetRef="Task2">
      <conditionExpression xsi:type="tFormalExpression">${subrogationPossible  == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task2" name="Check Subrogation Case">
      <incoming>SequenceFlow3</incoming>
      <outgoing>SequenceFlow5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow4" sourceRef="ExclusiveGateway1" targetRef="EndEvent1">
      <conditionExpression xsi:type="tFormalExpression">${subrogationPossible  == false}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent1">
      <incoming>SequenceFlow4</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow5" sourceRef="Task2" targetRef="ExclusiveGateway2"/>

    <exclusiveGateway id="ExclusiveGateway2">
      <incoming>SequenceFlow5</incoming>
      <outgoing>SequenceFlow6</outgoing>
      <outgoing>SequenceFlow7</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow6" sourceRef="ExclusiveGateway2" targetRef="Task3">
      <conditionExpression xsi:type="tFormalExpression">${insurantAgrees  == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task3" name="Send Request for Payment and Create Reminder">
      <incoming>SequenceFlow6</incoming>
      <outgoing>SequenceFlow8</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow7" sourceRef="ExclusiveGateway2" targetRef="Task5">
      <conditionExpression xsi:type="tFormalExpression">${insurantDisagrees  == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task5" name="Check Insurant's Reasoning">
      <incoming>SequenceFlow7</incoming>
      <outgoing>SequenceFlow9</outgoing>
      <outgoing>SequenceFlow10</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway3">
      <incoming>SequenceFlow9</incoming>
      <outgoing>SequenceFlow11</outgoing>
      <outgoing>SequenceFlow12</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="SequenceFlow9" sourceRef="Task5" targetRef="ExclusiveGateway3">
      <conditionExpression xsi:type="tFormalExpression">${insurantRight  == true}</conditionExpression>
    </sequenceFlow>

    <task id="Task6" name="Forward to Collection Agency">
      <incoming>SequenceFlow10</incoming>
      <incoming>SequenceFlow12</incoming>
    </task>

    <sequenceFlow id="SequenceFlow10" sourceRef="Task5" targetRef="Task6">
      <conditionExpression xsi:type="tFormalExpression">${insurantWrong  == true}</conditionExpression>
    </sequenceFlow>

    <endEvent id="EndEvent2">
      <incoming>SequenceFlow11</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow11" sourceRef="ExclusiveGateway3" targetRef="EndEvent2"/>

    <sequenceFlow id="SequenceFlow12" sourceRef="ExclusiveGateway3" targetRef="Task6"/>

    <task id="Task4" name="Make Booking and Close Case">
      <incoming>SequenceFlow8</incoming>
      <outgoing>SequenceFlow13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow13" sourceRef="Task4" targetRef="EndEvent3"/>

    <endEvent id="EndEvent3">
      <incoming>SequenceFlow13</incoming>
    </endEvent>

    <intermediateCatchEvent id="IntermediateCatchEvent1">
      <timerEventDefinition/>
      <outgoing>SequenceFlow14</outgoing>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow14" sourceRef="IntermediateCatchEvent1" targetRef="Task6"/>
  </process>
</definitions>