<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="workAndLiveInAustriaProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="taskOrganizeAccommodationAndBankAccount"/>

     <userTask id="taskOrganizeAccommodationAndBankAccount" name="Organize Accommodation and Bank Account">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="taskOrganizeAccommodationAndBankAccount" targetRef="exclusiveGatewayVisaRequirements"/>

     <exclusiveGateway id="exclusiveGatewayVisaRequirements">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGatewayVisaRequirements" targetRef="taskVisaApplication">
       <conditionExpression xsi:type="tFormalExpression">${visaRequired == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="taskVisaApplication1" name="Apply for Visa (Rot-Weiss-Rot Card)">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGatewayVisaRequirements" targetRef="endEventNoVisaNeeded">
       <conditionExpression xsi:type="tFormalExpression">${visaRequired == false}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEventNoVisaNeeded1" name="No Visa Needed">
       <incoming>sequenceFlow4</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="taskVisaApplication1" targetRef="exclusiveGatewayVisaIssuance"/>

     <exclusiveGateway id="exclusiveGatewayVisaIssuance1">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGatewayVisaIssuance1" targetRef="endEventVisaIssued">
       <conditionExpression xsi:type="tFormalExpression">${visaIssued == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEventVisaIssued1" name="Visa Issued">
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow7" sourceRef="exclusiveGatewayVisaIssuance1" targetRef="taskCollectDocuments">
       <conditionExpression xsi:type="tFormalExpression">${visaIssued == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="taskCollectDocuments1" name="Collect Required Documents (e.g. travel document, passport photo, health insurance)">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="taskCollectDocuments1" targetRef="serviceTaskSubmitVisaApplication"/>

     <serviceTask id="serviceTaskSubmitVisaApplication1" name="Submit Visa Application to Austrian Representation">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="serviceTaskSubmitVisaApplication1" targetRef="endEventProcessComplete"/>

     <endEvent id="endEventProcessComplete1" name="Process Complete">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

   </process>

</definitions>