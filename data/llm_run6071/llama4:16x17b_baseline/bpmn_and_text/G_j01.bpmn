<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="farmingBotProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <userTask id="task1" name="Select Resources">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="parallelGateway1"/>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
       <!-- Add more outgoing flows -->
     </parallelGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="parallelGateway1" targetRef="task2"/>
     <serviceTask id="task2" name="Collect Resource 1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="parallelGateway1" targetRef="task3"/>
     <serviceTask id="task3" name="Collect Resource 2">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow12</outgoing>
     </serviceTask>

     <!-- Add more tasks for resources 3-10 -->

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow12</incoming>
       <!-- Add more incoming flows -->
       <outgoing>sequenceFlow13</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow11" sourceRef="task2" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="task3" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow13" sourceRef="exclusiveGateway1" targetRef="task4"/>

     <userTask id="task4" name="Create Tools">
       <incoming>sequenceFlow13</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow14" sourceRef="task4" targetRef="parallelGateway2"/>

     <parallelGateway id="parallelGateway2">
       <incoming>sequenceFlow14</incoming>
       <!-- Simulate farming with random natural disasters -->
       <outgoing>sequenceFlow15</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow15" sourceRef="parallelGateway2" targetRef="task5"/>
     <serviceTask id="task5" name="Farm Resources">
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </serviceTask>

     <intermediateCatchEvent id="intermediateCatchEvent1">
       <incoming>sequenceFlow16</incoming>
       <!-- Simulate random natural disasters -->
       <outgoing>sequenceFlow17</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="sequenceFlow16" sourceRef="task5" targetRef="intermediateCatchEvent1"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow17</incoming>
       <outgoing>sequenceFlow19</outgoing>
       <outgoing>sequenceFlow20</outgoing>
     </exclusiveGateway>

     <!-- Notify user of milestones reached -->
     <sequenceFlow id="sequenceFlow19" sourceRef="exclusiveGateway2" targetRef="task6">
     </sequenceFlow>

     <userTask id="task6" name="Notify User">
       <incoming>sequenceFlow19</incoming>
       <outgoing>sequenceFlow21</outgoing>
     </userTask>

     <!-- Update list of resources to farm -->
     <sequenceFlow id="sequenceFlow20" sourceRef="exclusiveGateway2" targetRef="task7"/>
     <userTask id="task7" name="Update Resources">
       <incoming>sequenceFlow20</incoming>
       <outgoing>sequenceFlow22</outgoing>
     </userTask>

     <!-- Brag to friends and/or send materials -->
     <endEvent id="endEvent1">
       <incoming>sequenceFlow21</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow21" sourceRef="task6" targetRef="endEvent1"/>

     <endEvent id="endEvent2">
       <incoming>sequenceFlow22</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow22" sourceRef="task7" targetRef="endEvent2"/>
   </process>
 </definitions>