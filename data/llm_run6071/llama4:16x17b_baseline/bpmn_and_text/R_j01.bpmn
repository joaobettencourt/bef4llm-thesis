<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" name="OEE Process">

   <process id="oeeProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="task1"/>

     <serviceTask id="task1" name="Collect Machine Data">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow2" sourceRef="task1" targetRef="calculateOee"/>

     <serviceTask id="calculateOee" name="Calculate OEE">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow3" sourceRef="calculateOee" targetRef="exclusiveGateway1"/>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="exclusiveGateway1" targetRef="task2">
       <conditionExpression xsi:type="tFormalExpression">${oeeValue >= threshold}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="task2" name="Continue Measuring">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow6" sourceRef="task2" targetRef="exclusiveGateway1"/>

     <sequenceFlow id="sequenceFlow5" sourceRef="exclusiveGateway1" targetRef="task3">
       <conditionExpression xsi:type="tFormalExpression">${oeeValue < threshold}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="task3" name="Stop Machine and Send Email">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="task3" targetRef="exclusiveGateway2"/>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
       <outgoing>sequenceFlow9</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="exclusiveGateway2" targetRef="task4">
       <conditionExpression xsi:type="tFormalExpression">${machineRestarted}</conditionExpression>
     </sequenceFlow>

     <serviceTask id="task4" name="Restart Machine">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="task4" targetRef="calculateOee"/>

     <sequenceFlow id="sequenceFlow9" sourceRef="exclusiveGateway2" targetRef="endEvent1">
       <conditionExpression xsi:type="tFormalExpression">${machineDisconnected}</conditionExpression>
     </sequenceFlow>

     <endEvent id="endEvent1" name="Machine Disconnected">
       <incoming>sequenceFlow9</incoming>
     </endEvent>

   </process>

</definitions>