<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="orderingProcess" isExecutable="true">
     <startEvent id="startEvent1">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="loginTask"/>

     <serviceTask id="loginTask" name="Login">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow13</outgoing>
     </serviceTask>

     <exclusiveGateway id="exclusiveGateway1">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="loginTask" targetRef="exclusiveGateway1"/>
     <sequenceFlow id="sequenceFlow12" sourceRef="exclusiveGateway1" targetRef="endEvent5"/>

     <sequenceFlow id="sequenceFlow3" sourceRef="exclusiveGateway1" targetRef="selectProductTask">
       <conditionExpression xsi:type="tFormalExpression">${loginSuccess  == true}</conditionExpression>
     </sequenceFlow>

     <userTask id="selectProductTask" name="Select Product">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow4" sourceRef="selectProductTask" targetRef="addToCartTask"/>

     <userTask id="addToCartTask" name="Add to Cart">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </userTask>

     <exclusiveGateway id="exclusiveGateway2">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
       <outgoing>sequenceFlow11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow5" sourceRef="addToCartTask" targetRef="exclusiveGateway2">
       <conditionExpression xsi:type="tFormalExpression">${allProductsSelected  == true}</conditionExpression>
     </sequenceFlow>

     <parallelGateway id="parallelGateway1">
       <incoming>sequenceFlow6</incoming>
       <outgoing>sequenceFlow7</outgoing>
       <outgoing>sequenceFlow8</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequenceFlow6" sourceRef="exclusiveGateway2" targetRef="parallelGateway1"/>

     <serviceTask id="preparePaymentTask" name="Prepare Payment">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow9</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="parallelGateway1" targetRef="preparePaymentTask"/>

     <userTask id="enterPaymentDataTask" name="Enter Payment Data">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow10</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="preparePaymentTask" targetRef="enterPaymentDataTask"/>

     <serviceTask id="waitForPaymentConfirmationTask" name="Wait for Payment Confirmation">
       <incoming>sequenceFlow10</incoming>
       <outgoing>sequenceFlow14</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow10" sourceRef="enterPaymentDataTask" targetRef="waitForPaymentConfirmationTask"/>

     <userTask id="enterShippingAddressTask" name="Enter Shipping Address">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow15</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow8" sourceRef="parallelGateway1" targetRef="enterShippingAddressTask"/>

     <exclusiveGateway id="exclusiveGateway3">
       <incoming>sequenceFlow14</incoming>
       <incoming>sequenceFlow15</incoming>
       <outgoing>sequenceFlow16</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow14" sourceRef="waitForPaymentConfirmationTask" targetRef="exclusiveGateway3"/>
     <sequenceFlow id="sequenceFlow15" sourceRef="enterShippingAddressTask" targetRef="exclusiveGateway3"/>

     <serviceTask id="finishOrderTask" name="Finish Order">
       <incoming>sequenceFlow16</incoming>
       <outgoing>sequenceFlow17</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow16" sourceRef="exclusiveGateway3" targetRef="finishOrderTask"/>

     <endEvent id="endEvent1" name="Order Finished">
       <incoming>sequenceFlow17</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow17" sourceRef="finishOrderTask" targetRef="endEvent1"/>

     <endEvent id="endEvent5" name="Login Failed">
       <incoming>sequenceFlow13</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow13" sourceRef="loginTask" targetRef="endEvent5"/>
   </process>

</definitions>