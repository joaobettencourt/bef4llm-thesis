<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" 
             targetNamespace="http://example.com/invoice/process">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailCentre" name="Mail Centre">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CategorizeInvoice</flowNodeRef>
         <flowNodeRef>Task_ForwardInvoiceToAdminDept</flowNodeRef>
         <flowNodeRef>CatchEvent_EveryHour</flowNodeRef>
       </lane>
       <lane id="Lane_AdminDepartment" name="Administration Department">
         <flowNodeRef>SubProcess_ProcessInvoice</flowNodeRef>
         <flowNodeRef>Task_PutInCollectionBox</flowNodeRef>
       </lane>
       <lane id="Lane_DataEntry" name="Data Entry">
         <flowNodeRef>CatchEvent_At10AM</flowNodeRef>
         <flowNodeRef>SubProcess_EnterDataInSAP</flowNodeRef>
       </lane>
       <lane id="Lane_ValidationOffice" name="Validation Office">
         <flowNodeRef>Task_ValidateInvoice</flowNodeRef>
       </lane>
       <lane id="Lane_PaymentOffice" name="Payment office">
         <flowNodeRef>CatchEvent_BeginningOfWeek</flowNodeRef>
         <flowNodeRef>SubProcess_ProcessPayment</flowNodeRef>
       </lane>
       <lane id="Lane_RegistryOffice" name="Registry office">
         <flowNodeRef>Task_ArchiveInvoice</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_Start_To_CategorizeInvoice</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <sequenceFlow id="SequenceFlow_Start_To_CategorizeInvoice" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>
     <task id="Task_CategorizeInvoice" name="Categorize invoice by staff member">
       <incoming>SequenceFlow_Start_To_CategorizeInvoice</incoming>
       <outgoing>SequenceFlow_CategorizeInvoice_To_ForwardInvoiceToAdminDept</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_CategorizeInvoice_To_ForwardInvoiceToAdminDept" sourceRef="Task_CategorizeInvoice" targetRef="Task_ForwardInvoiceToAdminDept"/>
     <task id="Task_ForwardInvoiceToAdminDept" name="Forward invoice to Admin Department">
       <incoming>SequenceFlow_CategorizeInvoice_To_ForwardInvoiceToAdminDept</incoming>
       <outgoing>SequenceFlow_ForwardInvoiceToAdminDept_To_ProcessInvoice</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ForwardInvoiceToAdminDept_To_ProcessInvoice" sourceRef="Task_ForwardInvoiceToAdminDept" targetRef="SubProcess_ProcessInvoice"/>
     <subProcess id="SubProcess_ProcessInvoice" name="Process invoice">
       <incoming>SequenceFlow_ForwardInvoiceToAdminDept_To_ProcessInvoice</incoming>
       <outgoing>SequenceFlow_ProcessInvoice_To_PutInCollectionBox</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_ProcessInvoice_To_PutInCollectionBox" sourceRef="SubProcess_ProcessInvoice" targetRef="Task_PutInCollectionBox"/>
     <task id="Task_PutInCollectionBox" name="Put invoices in collection box">
       <incoming>SequenceFlow_ProcessInvoice_To_PutInCollectionBox</incoming>
       <outgoing>SequenceFlow_PutInCollectionBox_To_CatchEvent_At10AM</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_PutInCollectionBox_To_CatchEvent_At10AM" sourceRef="Task_PutInCollectionBox" targetRef="CatchEvent_At10AM"/>
     <intermediateCatchEvent id="CatchEvent_At10AM" name="At 10. AM workday">
       <incoming>SequenceFlow_PutInCollectionBox_To_CatchEvent_At10AM</incoming>
       <outgoing>SequenceFlow_CatchEvent_At10AM_To_EnterDataInSAP</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_CatchEvent_At10AM_To_EnterDataInSAP" sourceRef="CatchEvent_At10AM" targetRef="SubProcess_EnterDataInSAP"/>
     <subProcess id="SubProcess_EnterDataInSAP" name="Enter Data in SAP">
       <incoming>SequenceFlow_CatchEvent_At10AM_To_EnterDataInSAP</incoming>
       <outgoing>SequenceFlow_EnterDataInSAP_To_CatchEvent_EveryHour</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_EnterDataInSAP_To_CatchEvent_EveryHour" sourceRef="SubProcess_EnterDataInSAP" targetRef="CatchEvent_EveryHour"/>
     <intermediateCatchEvent id="CatchEvent_EveryHour" name="Every 1 hour">
       <incoming>SequenceFlow_EnterDataInSAP_To_CatchEvent_EveryHour</incoming>
       <outgoing>SequenceFlow_CatchEvent_EveryHour_To_ForwardInvoiceForValidation</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_CatchEvent_EveryHour_To_ForwardInvoiceForValidation" sourceRef="CatchEvent_EveryHour" targetRef="Task_ForwardInvoiceForValidation"/>
     <task id="Task_ForwardInvoiceForValidation" name="Forward invoice for Validation">
       <incoming>SequenceFlow_CatchEvent_EveryHour_To_ForwardInvoiceForValidation</incoming>
       <outgoing>SequenceFlow_ForwardInvoiceForValidation_To_ValidateInvoice</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ForwardInvoiceForValidation_To_ValidateInvoice" sourceRef="Task_ForwardInvoiceForValidation" targetRef="Task_ValidateInvoice"/>
     <subProcess id="Task_ValidateInvoice" name="Validate Invoice">
       <incoming>SequenceFlow_ForwardInvoiceForValidation_To_ValidateInvoice</incoming>
       <outgoing>SequenceFlow_ValidateInvoice_To_CatchEvent_BeginningOfWeek</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_ValidateInvoice_To_CatchEvent_BeginningOfWeek" sourceRef="Task_ValidateInvoice" targetRef="CatchEvent_BeginningOfWeek"/>
     <intermediateCatchEvent id="CatchEvent_BeginningOfWeek" name="Beginning of every Week">
       <incoming>SequenceFlow_ValidateInvoice_To_CatchEvent_BeginningOfWeek</incoming>
       <outgoing>SequenceFlow_CatchEvent_BeginningOfWeek_To_ProcessPayment</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="SequenceFlow_CatchEvent_BeginningOfWeek_To_ProcessPayment" sourceRef="CatchEvent_BeginningOfWeek" targetRef="SubProcess_ProcessPayment"/>
     <subProcess id="SubProcess_ProcessPayment" name="Process Payment">
       <incoming>SequenceFlow_CatchEvent_BeginningOfWeek_To_ProcessPayment</incoming>
       <outgoing>SequenceFlow_ProcessPayment_To_ArchiveInvoice</outgoing>
     </subProcess>
     <sequenceFlow id="SequenceFlow_ProcessPayment_To_ArchiveInvoice" sourceRef="SubProcess_ProcessPayment" targetRef="Task_ArchiveInvoice"/>
     <task id="Task_ArchiveInvoice" name="Archive Invoice">
       <incoming>SequenceFlow_ProcessPayment_To_ArchiveInvoice</incoming>
       <outgoing>SequenceFlow_ArchiveInvoice_To_EndEvent_1</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_ArchiveInvoice_To_EndEvent_1" sourceRef="Task_ArchiveInvoice" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_ArchiveInvoice_To_EndEvent_1</incoming>
     </endEvent>
   </process>
</definitions>