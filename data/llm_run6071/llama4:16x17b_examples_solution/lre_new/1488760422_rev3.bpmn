<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" processRef="Process_1"/>
    <participant id="Participant_2" name="Client"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
      <messageEventDefinition/>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Receive the invoice">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>
    <task id="Task_2" name="Sort the invoice per client">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="Task_3"/>
    <task id="Task_3" name="Sort the invoice per vendor">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_4</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_4" sourceRef="Task_3" targetRef="Task_4"/>
    <task id="Task_4" name="Attach invoice entry form to invoice">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_4" targetRef="SubProcess_1"/>
    <subProcess id="SubProcess_1" name="Enter required info on the invoice entry form">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </subProcess>
    <sequenceFlow id="SequenceFlow_6" sourceRef="SubProcess_1" targetRef="Task_5"/>
    <task id="Task_5" name="Check the completeness of the invoice">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </task>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
      <outgoing>SequenceFlow_10</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_5" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="SequenceFlow_8" name="Not complete" sourceRef="Task_5" targetRef="EndEvent_1"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_8</incoming>
      <messageEventDefinition/>
    </endEvent>
    <task id="Task_6" name="Enter the info for the SLA">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_1" targetRef="Task_6"/>
    <task id="Task_7" name="Check the priority">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_6" targetRef="Task_7"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
      <outgoing>SequenceFlow_14</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_7" targetRef="ExclusiveGateway_2"/>
    <task id="Task_8" name="Apply the red stamp on entry invoice">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" name="High priority" sourceRef="ExclusiveGateway_2" targetRef="Task_8"/>
    <task id="Task_9" name="Check invoice compliance">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_16</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_15" sourceRef="Task_8" targetRef="Task_9"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_17</outgoing>
      <outgoing>SequenceFlow_18</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_16" sourceRef="Task_9" targetRef="ExclusiveGateway_3"/>
    <task id="Task_10" name="Allocate invoice to DEO">
      <incoming>SequenceFlow_17</incoming>
      <outgoing>SequenceFlow_19</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_17" sourceRef="ExclusiveGateway_3" targetRef="Task_10"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_19</incoming>
    </endEvent>
    <exclusiveGateway id="ExclusiveGateway_4">
      <incoming>SequenceFlow_18</incoming>
      <outgoing>SequenceFlow_20</outgoing>
      <outgoing>SequenceFlow_21</outgoing>
      <outgoing>SequenceFlow_22</outgoing>
    </exclusiveGateway>
    <task id="Task_11" name="Send to experience staff">
      <incoming>SequenceFlow_20</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_20" sourceRef="ExclusiveGateway_4" targetRef="Task_11"/>
    <task id="Task_12" name="Call the client">
      <incoming>SequenceFlow_21</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_21" sourceRef="ExclusiveGateway_4" targetRef="Task_12"/>
    <task id="Task_13" name="Send a postal mail requesting the information complete">
      <incoming>SequenceFlow_22</incoming>
    </task>
    <sequenceFlow id="SequenceFlow_22" sourceRef="ExclusiveGateway_4" targetRef="Task_13"/>
  </process>
</definitions>