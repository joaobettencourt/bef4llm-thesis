<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Dispatch of goods" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_1" processRef="Process_1"/>
    <participant id="Participant_2" name="Courier Company" processRef="Process_2"/>
    <messageFlow id="MessageFlow_1" sourceRef="EndEvent_1" targetRef="StartEvent_2"/>
  </collaboration>
  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <task id="Task_1" name="Review order">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_3" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
    <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="IntermediateThrowEvent_1">
      <conditionExpression xsi:type="tFormalExpression">productDiscontinued</conditionExpression>
    </sequenceFlow>
    <task id="Task_3" name="Inform customer about unavailable products and order replacement">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_3" targetRef="IntermediateThrowEvent_2"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_1">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateThrowEvent_1" targetRef="Task_2"/>
    <task id="Task_2" name="Wait for delivery and check stock">
      <incoming>SequenceFlow_5</incoming>
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_7" sourceRef="Task_2" targetRef="ExclusiveGateway_2"/>
    <exclusiveGateway id="ExclusiveGateway_2">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_8</outgoing>
      <outgoing>SequenceFlow_9</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_8" sourceRef="ExclusiveGateway_2" targetRef="Task_4"/>
    <sequenceFlow id="SequenceFlow_9" sourceRef="ExclusiveGateway_2" targetRef="IntermediateThrowEvent_3">
      <conditionExpression xsi:type="tFormalExpression">not enough stock</conditionExpression>
    </sequenceFlow>
    <task id="Task_4" name="Prepare package and inform courier">
      <incoming>SequenceFlow_8</incoming>
      <outgoing>SequenceFlow_10</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_10" sourceRef="Task_4" targetRef="EndEvent_1"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_2">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_11" sourceRef="IntermediateThrowEvent_2" targetRef="Task_2"/>
    <intermediateThrowEvent id="IntermediateThrowEvent_3">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </intermediateThrowEvent>
    <sequenceFlow id="SequenceFlow_12" sourceRef="IntermediateThrowEvent_3" targetRef="Task_2"/>
    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_10</incoming>
    </endEvent>
  </process>
  <process id="Process_2" isExecutable="true">
    <startEvent id="StartEvent_2">
      <incoming>MessageFlow_1</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </startEvent>
    <sequenceFlow id="SequenceFlow_13" sourceRef="StartEvent_2" targetRef="Task_5"/>
    <task id="Task_5" name="Ensure enough human resources">
      <incoming>SequenceFlow_13</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>
    <exclusiveGateway id="ExclusiveGateway_3">
      <incoming>SequenceFlow_14</incoming>
      <outgoing>SequenceFlow_15</outgoing>
      <outgoing>SequenceFlow_16</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="SequenceFlow_15" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
    <sequenceFlow id="SequenceFlow_16" sourceRef="ExclusiveGateway_3" targetRef="IntermediateCatchEvent_1">
      <conditionExpression xsi:type="tFormalExpression">not enough human resources</conditionExpression>
    </sequenceFlow>
    <task id="Task_6" name="Pick up package and deliver to customer">
      <incoming>SequenceFlow_15</incoming>
      <outgoing>SequenceFlow_17</outgoing>
    </task>
    <sequenceFlow id="SequenceFlow_17" sourceRef="Task_6" targetRef="EndEvent_2"/>
    <intermediateCatchEvent id="IntermediateCatchEvent_1">
      <incoming>SequenceFlow_16</incoming>
      <outgoing>SequenceFlow_18</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="SequenceFlow_18" sourceRef="IntermediateCatchEvent_1" targetRef="Task_5"/>
    <endEvent id="EndEvent_2">
      <incoming>SequenceFlow_17</incoming>
    </endEvent>
  </process>
</definitions>