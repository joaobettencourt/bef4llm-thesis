<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Dispatch of goods" targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="SO:Angebot/Auftrag">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>IntermediateThrowEvent_1</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
       <messageEventDefinition/>
     </startEvent>
     <task id="Task_1" name="Prepare goods for shipment">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <task id="Task_2" name="Prepare Invoicing">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" sourceRef="StartEvent_1" targetRef="Task_2"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
       <outgoing>SequenceFlow_6</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>
     <task id="Task_3" name="Ship goods">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>
     <userTask id="Task_4" name="Add parent company as invoicing address">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </userTask>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_5"/>
     <task id="Task_5" name="Create Invoice">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_1" targetRef="Task_5"/>
     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="IntermediateThrowEvent_1"/>
     <intermediateThrowEvent id="IntermediateThrowEvent_1">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_8</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>
     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="IntermediateThrowEvent_1"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateThrowEvent_1" targetRef="EndEvent_1"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
</definitions>