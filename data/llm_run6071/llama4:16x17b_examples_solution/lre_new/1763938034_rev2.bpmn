<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Rewards and Training Process">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_Management" name="Management">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_Check_Performance</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>Task_Suggest_Training</flowNodeRef>
         <flowNodeRef>Task_Suggest_Reward</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
         <flowNodeRef>Task_Announce_Employee_of_the_Month</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
       <lane id="Lane_HR" name="HR">
         <flowNodeRef>Task_Dismiss_Employee</flowNodeRef>
         <flowNodeRef>Task_Provide_Training</flowNodeRef>
       </lane>
       <lane id="Lane_Finance" name="Finance">
         <flowNodeRef>Task_Calculate_and_Pay_Reward</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_Check_Performance"/>
     <task id="Task_Check_Performance" name="Check employee performance">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_Check_Performance" targetRef="ExclusiveGateway_1"/>
     <task id="Task_Suggest_Dismissal" name="Suggest employee dismissal">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_3" name="performance < 20%" sourceRef="ExclusiveGateway_1" targetRef="Task_Suggest_Dismissal"/>
     <task id="Task_Dismiss_Employee" name="Dismiss employee">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_Suggest_Dismissal" targetRef="Task_Dismiss_Employee"/>
     <endEvent id="EndEvent_Dismissed">
       <incoming>SequenceFlow_7</incoming>
     </endEvent>
     <task id="Task_Suggest_Training" name="Suggest training">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_4" name="20% < performance < 50%" sourceRef="ExclusiveGateway_1" targetRef="Task_Suggest_Training"/>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_Suggest_Training" targetRef="Task_Provide_Training"/>
     <task id="Task_Provide_Training" name="Provide training">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_Provide_Training" targetRef="EndEvent_Trained"/>
     <endEvent id="EndEvent_Trained">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>
     <task id="Task_Suggest_Reward" name="Suggest for reward">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" name="performance > 75%" sourceRef="ExclusiveGateway_1" targetRef="Task_Suggest_Reward"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_Suggest_Reward" targetRef="ExclusiveGateway_2"/>
     <task id="Task_Calculate_and_Pay_Reward" name="Calculate and pay reward">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_11" name="financial reward" sourceRef="ExclusiveGateway_2" targetRef="Task_Calculate_and_Pay_Reward"/>
     <task id="Task_Announce_Employee_of_the_Month" name="Announce employee of the month">
       <incoming>SequenceFlow_13</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" name="other benefit" sourceRef="ExclusiveGateway_2" targetRef="Task_Announce_Employee_of_the_Month"/>
     <endEvent id="EndEvent_Rewarded">
       <incoming>SequenceFlow_14</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_Calculate_and_Pay_Reward" targetRef="Task_Announce_Employee_of_the_Month"/>
     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_Announce_Employee_of_the_Month" targetRef="EndEvent_Rewarded"/>
   </process>
</definitions>