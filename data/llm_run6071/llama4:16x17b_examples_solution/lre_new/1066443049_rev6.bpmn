<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <collaboration id="Collaboration_1">
     <participant id="Participant_1" processRef="Process_1"/>
   </collaboration>
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_1" name="Web design team">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_1</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
         <flowNodeRef>Task_2</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>ParallelGateway_1</flowNodeRef>
         <flowNodeRef>ExclusiveGateway_2</flowNodeRef>
         <flowNodeRef>EndEvent_2</flowNodeRef>
       </lane>
       <lane id="Lane_2" name="Marketing team">
         <flowNodeRef>Task_4</flowNodeRef>
       </lane>
     </laneSet>
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>
     <task id="Task_1" name="Informational meeting">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>
     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>
     <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>
     <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_1" targetRef="EndEvent_1"/>
     <task id="Task_2" name="Create storyboard">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="ParallelGateway_1"/>
     <parallelGateway id="ParallelGateway_1">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </parallelGateway>
     <task id="Task_3" name="Design and development">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_6" sourceRef="ParallelGateway_1" targetRef="Task_3"/>
     <task id="Task_5" name="Prepare initial draft of content">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_1" targetRef="Task_5"/>
     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>
     <task id="Task_6" name="Create final version of content">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_6"/>
     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_4</incoming>
     </endEvent>
     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_13</outgoing>
       <outgoing>SequenceFlow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>
     <task id="Task_4" name="Review initial draft">
       <incoming>SequenceFlow_14</incoming>
       <outgoing>SequenceFlow_15</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_14" name="yes" sourceRef="ExclusiveGateway_3" targetRef="Task_4"/>
     <sequenceFlow id="SequenceFlow_13" name="no" sourceRef="ExclusiveGateway_3" targetRef="Task_6"/>
     <sequenceFlow id="SequenceFlow_15" sourceRef="Task_4" targetRef="Task_6"/>
     <task id="Task_7" name="Build and review website">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_16</outgoing>
     </task>
     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="Task_7"/>
     <exclusiveGateway id="ExclusiveGateway_4">
       <incoming>SequenceFlow_16</incoming>
       <outgoing>SequenceFlow_17</outgoing>
       <outgoing>SequenceFlow_18</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="SequenceFlow_16" sourceRef="Task_7" targetRef="ExclusiveGateway_4"/>
     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_18</incoming>
     </endEvent>
     <sequenceFlow id="SequenceFlow_17" name="no" sourceRef="ExclusiveGateway_4" targetRef="Task_7"/>
     <sequenceFlow id="SequenceFlow_18" name="yes" sourceRef="ExclusiveGateway_4" targetRef="EndEvent_2"/>
   </process>
</definitions>