<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" id="definition" name="Chainsaw Process">
   <process id="chainsaw_process" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <serviceTask id="request_properties_1" name="Request properties">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="request_properties_1"/>
     <receiveTask id="receive_properties_1" name="Receive properties">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
     </receiveTask>
     <sequenceFlow id="sequence_flow_2" sourceRef="request_properties_1" targetRef="receive_properties_1"/>
     <parallelGateway id="parallel_gateway_1">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_4</outgoing>
       <outgoing>sequence_flow_5</outgoing>
       <outgoing>sequence_flow_6</outgoing>
       <outgoing>sequence_flow_7</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_3" sourceRef="receive_properties_1" targetRef="parallel_gateway_1"/>
     <serviceTask id="order_guide_bar_1" name="Order guide bar">
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_4" sourceRef="parallel_gateway_1" targetRef="order_guide_bar_1"/>
     <serviceTask id="order_chain_1" name="Order chain">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_9</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_5" sourceRef="parallel_gateway_1" targetRef="order_chain_1"/>
     <serviceTask id="order_color_1" name="Order color">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_10</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="parallel_gateway_1" targetRef="order_color_1"/>
     <serviceTask id="order_protective_shield_1" name="Order protective shield">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_11</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_7" sourceRef="parallel_gateway_1" targetRef="order_protective_shield_1"/>
     <manualTask id="manual_inspection_1" name="Inspect parts">
       <incoming>sequence_flow_8</incoming>
       <incoming>sequence_flow_9</incoming>
       <incoming>sequence_flow_10</incoming>
       <incoming>sequence_flow_11</incoming>
       <outgoing>sequence_flow_12</outgoing>
     </manualTask>
     <parallelGateway id="parts_assembled_gateway_1">
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_13</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_12" sourceRef="manual_inspection_1" targetRef="parts_assembled_gateway_1"/>
     <manualTask id="assemble_parts_1" name="Assemble parts">
       <incoming>sequence_flow_13</incoming>
       <outgoing>sequence_flow_14</outgoing>
     </manualTask>
     <sequenceFlow id="sequence_flow_13" sourceRef="parts_assembled_gateway_1" targetRef="assemble_parts_1"/>
     <intermediateCatchEvent id="send_update_to_customer_1">
      <incoming>sequence_flow_14</incoming>
       <outgoing>sequence_flow_15</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>
     <sequenceFlow id="sequence_flow_14" sourceRef="assemble_parts_1" targetRef="send_update_to_customer_1"/>
     <receiveTask id="receive_feedback_from_customer_1" name="Receive feedback from customer">
       <incoming>sequence_flow_15</incoming>
       <outgoing>sequence_flow_16</outgoing>
     </receiveTask>
     <sequenceFlow id="sequence_flow_15" sourceRef="send_update_to_customer_1" targetRef="receive_feedback_from_customer_1"/>
     <exclusiveGateway id="customer_likes_chainsaw_1">
       <incoming>sequence_flow_16</incoming>
       <outgoing>sequence_flow_17</outgoing>
       <outgoing>sequence_flow_18</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_16" sourceRef="receive_feedback_from_customer_1" targetRef="customer_likes_chainsaw_1"/>
     <sendTask id="send_chainsaw_to_customer_2" name="Send chainsaw to customer">
       <incoming>sequence_flow_17</incoming>
     </sendTask>
     <sequenceFlow id="sequence_flow_17" sourceRef="customer_likes_chainsaw_1" targetRef="send_chainsaw_to_customer_2"/>
     <serviceTask id="request_number_of_chainsaws_needed_2" name="Request number of chainsaws needed">
       <incoming>sequence_flow_18</incoming>
       <outgoing>sequence_flow_19</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_18" sourceRef="customer_likes_chainsaw_1" targetRef="request_number_of_chainsaws_needed_2"/>
     <receiveTask id="receive_number_of_chainsaws_needed_2" name="Receive number of chainsaws needed">
       <incoming>sequence_flow_19</incoming>
       <outgoing>sequence_flow_20</outgoing>
     </receiveTask>
     <sequenceFlow id="sequence_flow_19" sourceRef="request_number_of_chainsaws_needed_2" targetRef="receive_number_of_chainsaws_needed_2"/>
     <task id="produce_additional_chainsaws_1" name="Produce additional chainsaws">
       <incoming>sequence_flow_20</incoming>
     </task>
     <endEvent id="chainsaw_order_completed_1">
     </endEvent>
     <sequenceFlow id="sequence_flow_20" sourceRef="receive_number_of_chainsaws_needed_2" targetRef="produce_additional_chainsaws_1"/>
     <sequenceFlow id="sequence_flow_21" sourceRef="produce_additional_chainsaws_1" targetRef="chainsaw_order_completed_1"/>
   </process>
 </definitions>