<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd" 
             id="definition" name="New Application for Registering for an USI course">

   <process id="new_application_process" isExecutable="true">
     <startEvent id="wish_to_enroll_in_course">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>

     <userTask id="select_course" name="Select course">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_1" sourceRef="wish_to_enroll_in_course" targetRef="select_course"/>

     <exclusiveGateway id="free_spots_gateway">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence_flow_2" sourceRef="select_course" targetRef="free_spots_gateway"/>

     <serviceTask id="system_shows_courses_and_dates" name="System shows parallel courses and dates">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_5</outgoing>
     </serviceTask>

     <sequenceFlow id="sequence_flow_3" sourceRef="free_spots_gateway" targetRef="system_shows_courses_and_dates"/>

     <userTask id="select_specific_course" name="Select specific course">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_6</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_5" sourceRef="system_shows_courses_and_dates" targetRef="select_specific_course"/>

     <exclusiveGateway id="already_registered_gateway">
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_7</outgoing>
       <outgoing>sequence_flow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence_flow_6" sourceRef="select_specific_course" targetRef="already_registered_gateway"/>

     <userTask id="log_into_account" name="Log into account">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_9</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_7" sourceRef="already_registered_gateway" targetRef="log_into_account"/>

     <exclusiveGateway id="eligible_university_gateway">
       <incoming>sequence_flow_8</incoming>
       <outgoing>sequence_flow_10</outgoing>
       <outgoing>sequence_flow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence_flow_8" sourceRef="already_registered_gateway" targetRef="eligible_university_gateway"/>

     <userTask id="check_if_registered_at_eligible_university" name="Check if registered at eligible university">
       <incoming>sequence_flow_10</incoming>
       <outgoing>sequence_flow_12</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_10" sourceRef="eligible_university_gateway" targetRef="check_if_registered_at_eligible_university"/>

     <exclusiveGateway id="university_check_result">
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_13</outgoing>
       <outgoing>sequence_flow_14</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequence_flow_12" sourceRef="check_if_registered_at_eligible_university" targetRef="university_check_result"/>

     <userTask id="register_account" name="Register account">
       <incoming>sequence_flow_13</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_13" sourceRef="university_check_result" targetRef="register_account"/>

     <userTask id="request_activation" name="Request activation">
       <incoming>sequence_flow_14</incoming>
       <outgoing>sequence_flow_16</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_14" sourceRef="university_check_result" targetRef="request_activation"/>

     <parallelGateway id="account_created_or_logged_in">
       <incoming>sequence_flow_15</incoming>
       <incoming>sequence_flow_16</incoming>
       <outgoing>sequence_flow_17</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequence_flow_15" sourceRef="register_account" targetRef="account_created_or_logged_in"/>
     <sequenceFlow id="sequence_flow_16" sourceRef="request_activation" targetRef="account_created_or_logged_in"/>

     <userTask id="log_into_account_2" name="Log into account">
       <incoming>sequence_flow_17</incoming>
       <outgoing>sequence_flow_18</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_17" sourceRef="account_created_or_logged_in" targetRef="log_into_account_2"/>

     <parallelGateway id="twitter_and_payment">
       <incoming>sequence_flow_18</incoming>
       <outgoing>sequence_flow_19</outgoing>
       <outgoing>sequence_flow_20</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequence_flow_18" sourceRef="log_into_account_2" targetRef="twitter_and_payment"/>

     <userTask id="connect_to_twitter" name="Connect to twitter">
       <incoming>sequence_flow_19</incoming>
       <outgoing>sequence_flow_21</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_19" sourceRef="twitter_and_payment" targetRef="connect_to_twitter"/>

     <userTask id="invite_friends" name="Invite friends">
       <incoming>sequence_flow_21</incoming>
     </userTask>

     <sequenceFlow id="sequence_flow_21" sourceRef="connect_to_twitter" targetRef="invite_friends"/>

     <userTask id="provide_payment_info" name="Provide payment info">
       <incoming>sequence_flow_20</incoming>
       <outgoing>sequence_flow_22</outgoing>
     </userTask>

     <sequenceFlow id="sequence_flow_20" sourceRef="twitter_and_payment" targetRef="provide_payment_info"/>

     <parallelGateway id="registration_and_payment_done">
       <incoming>sequence_flow_21</incoming>
       <incoming>sequence_flow_22</incoming>
       <outgoing>sequence_flow_23</outgoing>
     </parallelGateway>

     <sequenceFlow id="sequence_flow_22" sourceRef="provide_payment_info" targetRef="registration_and_payment_done"/>
     <sequenceFlow id="sequence_flow_21" sourceRef="invite_friends" targetRef="registration_and_payment_done"/>

     <serviceTask id="system_issues_course_tickets" name="System issues course tickets">
       <incoming>sequence_flow_23</incoming>
       <outgoing>sequence_flow_24</outgoing>
     </serviceTask>

     <sequenceFlow id="sequence_flow_23" sourceRef="registration_and_payment_done" targetRef="system_issues_course_tickets"/>

     <endEvent id="course_ticket_received">
       <incoming>sequence_flow_24</incoming>
     </endEvent>

     <sequenceFlow id="sequence_flow_24" sourceRef="system_issues_course_tickets" targetRef="course_ticket_received"/>
   </process>
 </definitions>