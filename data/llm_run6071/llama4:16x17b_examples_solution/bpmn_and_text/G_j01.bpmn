<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd" 
             id="definition" name="Farming Bot Process" targetNamespace="http://example.com/bpmn">
   <process id="farming_bot_process" isExecutable="true">
     <startEvent id="start_game">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_game" targetRef="determine_resources"/>
     <userTask id="determine_resources" name="Determine Resources">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_2" sourceRef="determine_resources" targetRef="create_farming_list"/>
     <scriptTask id="create_farming_list" name="Create Farming List">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
     </scriptTask>
     <sequenceFlow id="sequence_flow_3" sourceRef="create_farming_list" targetRef="parallel_gateway"/>
     <parallelGateway id="parallel_gateway">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_4</outgoing>
       <outgoing>sequence_flow_5</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_4" sourceRef="parallel_gateway" targetRef="collect_materials"/>
     <scriptTask id="collect_materials" name="Collect Materials">
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_6</outgoing>
     </scriptTask>
     <sequenceFlow id="sequence_flow_5" sourceRef="parallel_gateway" targetRef="create_tools"/>
     <scriptTask id="create_tools" name="Create Tools">
       <incoming>sequence_flow_5</incoming>
       <outgoing>sequence_flow_7</outgoing>
     </scriptTask>
     <sequenceFlow id="sequence_flow_6" sourceRef="collect_materials" targetRef="check_milestone"/>
     <sequenceFlow id="sequence_flow_7" sourceRef="create_tools" targetRef="check_tool_list"/>
     <scriptTask id="check_tool_list" name="Check Tool List">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </scriptTask>
     <sequenceFlow id="sequence_flow_8" sourceRef="check_tool_list" targetRef="adjust_farming_list"/>
     <userTask id="adjust_farming_list" name="Adjust Farming List">
       <incoming>sequence_flow_8</incoming>
       <outgoing>sequence_flow_9</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_9" sourceRef="adjust_farming_list" targetRef="check_milestone"/>
     <exclusiveGateway id="check_milestone">
       <incoming>sequence_flow_6</incoming>
       <incoming>sequence_flow_9</incoming>
       <outgoing>sequence_flow_10</outgoing>
       <outgoing>sequence_flow_11</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_10" sourceRef="check_milestone" targetRef="notify_player">
       <conditionExpression xsi:type="tFormalExpression">milestone reached</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequence_flow_11" sourceRef="check_milestone" targetRef="farming_bot_continue"/>
     <serviceTask id="notify_player" name="Notify Player">
       <incoming>sequence_flow_10</incoming>
       <outgoing>sequence_flow_12</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_12" sourceRef="notify_player" targetRef="brag_and_send_materials"/>
     <exclusiveGateway id="brag_and_send_materials">
       <incoming>sequence_flow_12</incoming>
       <outgoing>sequence_flow_13</outgoing>
       <outgoing>sequence_flow_14</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_13" sourceRef="brag_and_send_materials" targetRef="end_event">
       <conditionExpression xsi:type="tFormalExpression">brag and send materials</conditionExpression>
     </sequenceFlow>
     <sequenceFlow id="sequence_flow_14" sourceRef="brag_and_send_materials" targetRef="end_event">
       <conditionExpression xsi:type="tFormalExpression">only brag</conditionExpression>
     </sequenceFlow>
     <userTask id="farming_bot_continue" name="Farming Bot Continue">
       <incoming>sequence_flow_11</incoming>
       <outgoing>sequence_flow_15</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_15" sourceRef="farming_bot_continue" targetRef="end_event"/>
     <endEvent id="end_event">
       <incoming>sequence_flow_13</incoming>
       <incoming>sequence_flow_14</incoming>
       <incoming>sequence_flow_15</incoming>
     </endEvent>
     <intermediateCatchEvent id="natural_disaster" name="Natural Disaster">
       <incoming>collect_materials</incoming>
       <outgoing>sequence_flow_16</outgoing>
     </intermediateCatchEvent>
     <sequenceFlow id="sequence_flow_16" sourceRef="natural_disaster" targetRef="collect_materials"/>
   </process>
 </definitions>