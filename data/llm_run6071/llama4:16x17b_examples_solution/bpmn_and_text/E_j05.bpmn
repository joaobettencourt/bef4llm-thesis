<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="Work and Live in Austria" targetNamespace="http://example.com/work_and_live_in_austria">
   <process id="work_and_live_in_austria_process" isExecutable="true">
     <startEvent id="start_event_1">
       <outgoing>sequence_flow_1</outgoing>
     </startEvent>
     <serviceTask id="check_requirements_task">
       <incoming>sequence_flow_1</incoming>
       <outgoing>sequence_flow_2</outgoing>
     </serviceTask>
     <sequenceFlow id="sequence_flow_1" sourceRef="start_event_1" targetRef="check_requirements_task"/>
     <parallelGateway id="parallel_gateway_1">
       <incoming>sequence_flow_2</incoming>
       <outgoing>sequence_flow_3</outgoing>
       <outgoing>sequence_flow_4</outgoing>
     </parallelGateway>
     <sequenceFlow id="sequence_flow_2" sourceRef="check_requirements_task" targetRef="parallel_gateway_1"/>
     <userTask id="organize_accommodation_and_bank_account_task">
       <incoming>sequence_flow_3</incoming>
       <outgoing>sequence_flow_5</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_3" sourceRef="parallel_gateway_1" targetRef="organize_accommodation_and_bank_account_task"/>
     <task id="apply_for_rot_weiss_rot_card_task">
       <incoming>sequence_flow_4</incoming>
       <outgoing>sequence_flow_6</outgoing>
     </task>
     <sequenceFlow id="sequence_flow_4" sourceRef="parallel_gateway_1" targetRef="apply_for_rot_weiss_rot_card_task"/>
     <exclusiveGateway id="exclusive_gateway_1">
       <incoming>sequence_flow_5</incoming>
       <incoming>sequence_flow_6</incoming>
       <outgoing>sequence_flow_7</outgoing>
     </exclusiveGateway>
     <sequenceFlow id="sequence_flow_5" sourceRef="organize_accommodation_and_bank_account_task" targetRef="exclusive_gateway_1"/>
     <sequenceFlow id="sequence_flow_6" sourceRef="apply_for_rot_weiss_rot_card_task" targetRef="exclusive_gateway_1"/>
     <userTask id="prepare_travel_documents_task">
       <incoming>sequence_flow_7</incoming>
       <outgoing>sequence_flow_8</outgoing>
     </userTask>
     <sequenceFlow id="sequence_flow_7" sourceRef="exclusive_gateway_1" targetRef="prepare_travel_documents_task"/>
     <endEvent id="end_event_1">
       <incoming>sequence_flow_8</incoming>
     </endEvent>
     <sequenceFlow id="sequence_flow_8" sourceRef="prepare_travel_documents_task" targetRef="end_event_1"/>
   </process>
 </definitions>