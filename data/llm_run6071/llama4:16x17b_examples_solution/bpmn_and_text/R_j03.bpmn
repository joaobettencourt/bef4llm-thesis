<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/BPMN20.xsd"
             id="definition" name="Service for Your Fridge" targetNamespace="http://example.com/bpmn">
  <process id="service_for_your_fridge" isExecutable="true">
    <startEvent id="start_event">
      <outgoing>sequence_flow_1</outgoing>
    </startEvent>
    <userTask id="describe_symptoms" name="Describe the symptoms">
      <incoming>sequence_flow_1</incoming>
      <outgoing>sequence_flow_2</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_1" sourceRef="start_event" targetRef="describe_symptoms"/>
    <userTask id="send_report" name="Send a report to the fridge service center">
      <incoming>sequence_flow_2</incoming>
      <outgoing>sequence_flow_3</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_2" sourceRef="describe_symptoms" targetRef="send_report"/>
    <serviceTask id="schedule_appointment" name="Schedule an appointment for fridge repair">
      <incoming>sequence_flow_3</incoming>
      <outgoing>sequence_flow_4</outgoing>
    </serviceTask>
    <sequenceFlow id="sequence_flow_3" sourceRef="send_report" targetRef="schedule_appointment"/>
    <intermediateCatchEvent id="wait_for_service_facility">
      <incoming>sequence_flow_4</incoming>
      <outgoing>sequence_flow_5</outgoing>
      <timerEventDefinition/>
    </intermediateCatchEvent>
    <sequenceFlow id="sequence_flow_4" sourceRef="schedule_appointment" targetRef="wait_for_service_facility"/>
    <manualTask id="repair_fridge" name="Repair the fridge">
      <incoming>sequence_flow_5</incoming>
      <outgoing>sequence_flow_6</outgoing>
    </manualTask>
    <sequenceFlow id="sequence_flow_5" sourceRef="wait_for_service_facility" targetRef="repair_fridge"/>
    <exclusiveGateway id="additional_parts_needed">
      <incoming>sequence_flow_6</incoming>
      <outgoing>sequence_flow_7</outgoing>
      <outgoing>sequence_flow_8</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="sequence_flow_6" sourceRef="repair_fridge" targetRef="additional_parts_needed"/>
    <serviceTask id="order_additional_parts" name="Service orders additional parts">
      <incoming>sequence_flow_7</incoming>
      <outgoing>sequence_flow_9</outgoing>
    </serviceTask>
    <sequenceFlow id="sequence_flow_7" sourceRef="additional_parts_needed" targetRef="order_additional_parts"/>
    <intermediateCatchEvent id="wait_for_additional_parts">
      <incoming>sequence_flow_9</incoming>
      <outgoing>sequence_flow_10</outgoing>
      <conditionalEventDefinition>
        <condition xsi:type="tFormalExpression">/* condition expression */</condition>
      </conditionalEventDefinition>
    </intermediateCatchEvent>
    <sequenceFlow id="sequence_flow_9" sourceRef="order_additional_parts" targetRef="wait_for_additional_parts"/>
    <manualTask id="confirm_repair" name="Confirm that fridge is okay">
      <incoming>sequence_flow_10</incoming>
      <outgoing>sequence_flow_11</outgoing>
    </manualTask>
    <sequenceFlow id="sequence_flow_10" sourceRef="wait_for_additional_parts" targetRef="confirm_repair"/>
    <userTask id="rate_service_facility" name="Rate Service Facility">
      <incoming>sequence_flow_11</incoming>
      <outgoing>sequence_flow_12</outgoing>
    </userTask>
    <sequenceFlow id="sequence_flow_11" sourceRef="confirm_repair" targetRef="rate_service_facility"/>
    <endEvent id="end_event">
      <incoming>sequence_flow_12</incoming>
    </endEvent>
    <sequenceFlow id="sequence_flow_12" sourceRef="rate_service_facility" targetRef="end_event"/>
  </process>
</definitions>