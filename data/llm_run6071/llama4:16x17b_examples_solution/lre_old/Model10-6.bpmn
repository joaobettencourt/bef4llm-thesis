<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="MSPN" processRef="Pool_0"/>
     <participant id="Participant_1" name="MSPO" processRef="Pool_1"/>
   </collaboration>

   <process id="Pool_0" isExecutable="false">
     <startEvent id="StartNoneEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <task id="Task_0" name="Send dismissal">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="IntermediateMessageEventCatching_0"/>

     <endEvent id="EndNoneEvent_0">
       <incoming>SequenceFlow_2</incoming>
     </endEvent>

   </process>

   <process id="Pool_1" isExecutable="false">

     <startEvent id="StartMessageEvent_0">
       <outgoing>SequenceFlow_4</outgoing>
     </startEvent>

     <task id="Task_1" name="Review dismissal">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="StartMessageEvent_0" targetRef="Task_1"/>
     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>

     <exclusiveGateway id="ExclusiveGateway_0">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" sourceRef="ExclusiveGateway_0" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Reject dismissal">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="ExclusiveGateway_0" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Confirm dismissal">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <endEvent id="EndNoneEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>

     <endEvent id="EndNoneEvent_2">
       <incoming>SequenceFlow_9</incoming>
     </endEvent>

   </process>

</definitions>