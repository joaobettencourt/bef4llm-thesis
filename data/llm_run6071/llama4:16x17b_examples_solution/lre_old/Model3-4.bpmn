<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <process id="ClaimHandlingProcess" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_SendQuestionnaire"/>

     <task id="Task_SendQuestionnaire" name="Send questionnaire to claimant">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_SendQuestionnaire" targetRef="EventBasedGateway_1"/>

     <eventBasedGateway id="EventBasedGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </eventBasedGateway>

     <intermediateCatchEvent id="IntermediateCatchEvent_QuestionnaireReceived" name="Filled questionnaire received">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_3" sourceRef="EventBasedGateway_1" targetRef="IntermediateCatchEvent_QuestionnaireReceived"/>

     <intermediateTimerEvent id="IntermediateTimerEvent_Reminder">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <timerEventDefinition>
         <timeCycle>P5D</timeCycle>
       </timerEventDefinition>
     </intermediateTimerEvent>

     <sequenceFlow id="SequenceFlow_4" sourceRef="EventBasedGateway_1" targetRef="IntermediateTimerEvent_Reminder"/>

     <task id="Task_SendReminder" name="Send reminder to claimant">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateTimerEvent_Reminder" targetRef="Task_SendReminder"/>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_SendReminder" targetRef="EventBasedGateway_1"/>

     <endEvent id="EndEvent_1" name="Claim handling completed">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>

   </process>
</definitions>