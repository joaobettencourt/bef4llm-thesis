<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="Customer Service" processRef="Process_0"/>
     <participant id="Participant_1" name="Customer" processRef="Process_1"/>
     <participant id="Participant_2" name="Service Management" processRef="Process_2"/>
     <participant id="Participant_3" name="Resource Provisioning" processRef="Process_3"/>
   </collaboration>

   <process id="Process_0" isExecutable="true">
     <laneSet>
       <lane id="Lane_1">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Send list of problem parameters to Customer Service department">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="Task_2"/>

     <task id="Task_2" name="Enter problem report into system T">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_2" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_3"/>
     <task id="Task_3" name="Determine significance of the customer">
       <incoming>SequenceFlow_4</incoming>
       <!-- outgoing sequence flow -->
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="ExclusiveGateway_1" targetRef="Task_4"/>

     <task id="Task_4" name="Create detailed problem report">
       <incoming>SequenceFlow_5</incoming>
       <!-- outgoing sequence flow -->
     </task>
   </process>

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_Customer">
       <outgoing>SequenceFlow_Customer</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Customer" sourceRef="StartEvent_Customer" targetRef="Task_Customer"/>

     <task id="Task_Customer" name="Receive report about service performance and problem resolution">
       <!-- Incoming/Outgoing sequence flows -->
     </task>
   </process>

   <process id="Process_2" isExecutable="true">
     <!-- Tasks, gateways and SequenceFlows for Service Management -->

     <startEvent id="StartEvent_Service_Management">
       <incoming>SequenceFlow_From_Customer_Service</incoming>
     </startEvent>

     <!-- Exclusive Gateway to determine next steps -->
     <exclusiveGateway id="ExclusiveGateway_2">
       <!-- Incoming/Outgoing sequence flows -->
     </exclusiveGateway>

     <!-- Tasks for corrective actions, problem resolution report creation and sending -->
   </process>

   <process id="Process_3" isExecutable="true">
     <!-- Resource Provisioning process activities -->

     <startEvent id="StartEvent_Resource_Provisoning">
       <incoming>SequenceFlow_From_Service_Management</incoming>
     </startEvent>

     <!-- Tasks for error tracking, corrective actions and trouble-shooting report creation -->
   </process>

</definitions>