<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

   <collaboration id="Collaboration_1">
     <participant id="Participant_0" name="Supplier" processRef="Pool_0"/>
     <participant id="Participant_1" name="Assembler AG" processRef="Pool_1"/>
     <messageFlow id="MessageFlow_0" sourceRef="Task_2" targetRef="Task_0"/>
     <messageFlow id="MessageFlow_1" sourceRef="Task_1" targetRef="Task_3"/>
   </collaboration>

   <process id="Pool_0" isExecutable="false">
     <laneSet>
       <lane id="Lane_0" name="Accounts Department">
         <flowNodeRef>Task_0</flowNodeRef>
         <flowNodeRef>StartEvent_0</flowNodeRef>
         <flowNodeRef>Task_1</flowNodeRef>
         <flowNodeRef>EndEvent_0</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_0">
       <outgoing>SequenceFlow_0</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_0" sourceRef="StartEvent_0" targetRef="Task_2"/>

     <task id="Task_2" name="Send order">
       <incoming>SequenceFlow_0</incoming>
       <outgoing>SequenceFlow_1</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_1" sourceRef="Task_2" targetRef="Task_0"/>

     <task id="Task_0" name="Process order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_4</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_4" sourceRef="Task_0" targetRef="Task_1"/>

     <task id="Task_1" name="Send invoice">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_1" targetRef="EndEvent_0"/>

     <endEvent id="EndEvent_0">
       <incoming>SequenceFlow_5</incoming>
     </endEvent>
   </process>

   <process id="Pool_1" isExecutable="false">
     <laneSet>
       <lane id="Lane_1" name="Production">
         <flowNodeRef>StartTimerEvent_1</flowNodeRef>
         <flowNodeRef>Task_3</flowNodeRef>
         <flowNodeRef>EndEvent_1</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartTimerEvent_1">
       <outgoing>SequenceFlow_6</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_6" sourceRef="StartTimerEvent_1" targetRef="Task_3"/>

     <task id="Task_3" name="Create order">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="Task_4"/>

     <task id="Task_4" name="Receive invoice">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_8</incoming>
     </endEvent>
   </process>
</definitions>