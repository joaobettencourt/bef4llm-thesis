<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" targetNamespace="http://www.example.com">

  <process id="Process_1" isExecutable="true">
    <startEvent id="StartEvent_1">
      <outgoing>SequenceFlow_1</outgoing>
    </startEvent>

    <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

    <task id="Task_1" name="Select Underwriters">
      <incoming>SequenceFlow_1</incoming>
      <outgoing>SequenceFlow_2</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ParallelGateway_1"/>

    <parallelGateway id="ParallelGateway_1">
      <incoming>SequenceFlow_2</incoming>
      <outgoing>SequenceFlow_3</outgoing>
      <outgoing>SequenceFlow_4</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_3" sourceRef="ParallelGateway_1" targetRef="Task_2"/>

    <task id="Task_2" name="Provide Procedural and Financial Advice">
      <incoming>SequenceFlow_3</incoming>
      <outgoing>SequenceFlow_5</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="Task_3"/>

    <task id="Task_3" name="Prepare Registration Statement for Approval of SEC">
      <incoming>SequenceFlow_5</incoming>
      <outgoing>SequenceFlow_6</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ParallelGateway_2"/>

    <parallelGateway id="ParallelGateway_2">
      <incoming>SequenceFlow_6</incoming>
      <outgoing>SequenceFlow_7</outgoing>
      <outgoing>SequenceFlow_8</outgoing>
    </parallelGateway>

    <sequenceFlow id="SequenceFlow_7" sourceRef="ParallelGateway_2" targetRef="Task_4"/>

    <task id="Task_4" name="Check Compliance with Laws">
      <incoming>SequenceFlow_7</incoming>
      <outgoing>SequenceFlow_9</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="IntermediateCatchEvent_1"/>

    <intermediateCatchEvent id="IntermediateCatchEvent_1" name="SEC Approval">
      <incoming>SequenceFlow_9</incoming>
      <outgoing>SequenceFlow_10</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateCatchEvent_1" targetRef="Task_5"/>

    <task id="Task_5" name="Fix Issue Price">
      <incoming>SequenceFlow_10</incoming>
      <outgoing>SequenceFlow_11</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_11" sourceRef="Task_5" targetRef="Task_6"/>

    <task id="Task_6" name="Buy Stock">
      <incoming>SequenceFlow_11</incoming>
      <outgoing>SequenceFlow_12</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_12" sourceRef="Task_6" targetRef="Task_7"/>

    <task id="Task_7" name="Offer to Public">
      <incoming>SequenceFlow_12</incoming>
      <outgoing>SequenceFlow_13</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_13" sourceRef="Task_7" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1">
      <incoming>SequenceFlow_13</incoming>
    </endEvent>

    <sequenceFlow id="SequenceFlow_4" sourceRef="ParallelGateway_1" targetRef="Task_8"/>

    <task id="Task_8" name="Arrange Road Show">
      <incoming>SequenceFlow_4</incoming>
      <outgoing>SequenceFlow_14</outgoing>
    </task>

    <sequenceFlow id="SequenceFlow_14" sourceRef="Task_8" targetRef="IntermediateCatchEvent_1"/>
  </process>
</definitions>