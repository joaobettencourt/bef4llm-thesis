<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <collaboration id="Collaboration_1">
    <participant id="Participant_0" name="Recourse Process" processRef="Process_0"/>
  </collaboration>
  <process id="Process_0" isExecutable="false">
    <laneSet>
      <lane id="Lane_0" name="Clerk">
        <flowNodeRef>StartEvent_0</flowNodeRef>
        <flowNodeRef>Task_GetInformation</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_CheckPossibility</flowNodeRef>
        <flowNodeRef>Task_SendRequest</flowNodeRef>
        <flowNodeRef>Task_CreateReminder</flowNodeRef>
        <flowNodeRef>Task_CloseCase</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_CheckDisagreement</flowNodeRef>
        <flowNodeRef>Task_CheckReasoning</flowNodeRef>
        <flowNodeRef>ExclusiveGateway_ForwardToCollectionAgency</flowNodeRef>
        <flowNodeRef>EndEvent_CaseClosed</flowNodeRef>
      </lane>
    </laneSet>

    <!-- Sequence Flows  -->
    <sequenceFlow id="SequenceFlow_GetInformation" sourceRef="StartEvent_0" targetRef="Task_GetInformation"/>
    <sequenceFlow id="SequenceFlow_CheckPossibility" sourceRef="Task_GetInformation" targetRef="ExclusiveGateway_CheckPossibility"/>
    <sequenceFlow id="SequenceFlow_SendRequestYes" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_SendRequest"/>
    <sequenceFlow id="SequenceFlow_CloseCaseNo" sourceRef="ExclusiveGateway_CheckPossibility" targetRef="Task_CloseCase"/>
    <sequenceFlow id="SequenceFlow_CreateReminder" sourceRef="Task_SendRequest" targetRef="Task_CreateReminder"/>
    <sequenceFlow id="SequenceFlow_MakeBooking" sourceRef="Task_CreateReminder" targetRef="Task_MakeBooking"/>
    <sequenceFlow id="SequenceFlow_CheckDisagreement" sourceRef="Task_MakeBooking" targetRef="ExclusiveGateway_CheckDisagreement"/>
    <sequenceFlow id="SequenceFlow_ForwardToCollectionAgencyYes" sourceRef="ExclusiveGateway_CheckDisagreement" targetRef="ExclusiveGateway_ForwardToCollectionAgency"/>
    <sequenceFlow id="SequenceFlow_CheckReasoningNo" sourceRef="ExclusiveGateway_CheckDisagreement" targetRef="Task_CheckReasoning"/>
    <sequenceFlow id="SequenceFlow_CloseCaseAfterCheckReasoning" sourceRef="Task_CheckReasoning" targetRef="Task_CloseCase"/>

    <!-- Tasks  -->
    <startEvent id="StartEvent_0">
      <outgoing>SequenceFlow_GetInformation</outgoing>
    </startEvent>

    <task id="Task_GetInformation" name="Get information about possible subrogation">
      <incoming>SequenceFlow_GetInformation</incoming>
      <outgoing>SequenceFlow_CheckPossibility</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_CheckPossibility" name="Is recourse possible?">
      <incoming>SequenceFlow_CheckPossibility</incoming>
      <outgoing>SequenceFlow_SendRequestYes</outgoing>
      <outgoing>SequenceFlow_CloseCaseNo</outgoing>
    </exclusiveGateway>

    <task id="Task_SendRequest" name="Send request for payment">
      <incoming>SequenceFlow_SendRequestYes</incoming>
      <outgoing>SequenceFlow_CreateReminder</outgoing>
    </task>

    <task id="Task_CreateReminder" name="Create reminder">
      <incoming>SequenceFlow_CreateReminder</incoming>
      <outgoing>SequenceFlow_MakeBooking</outgoing>
    </task>

    <task id="Task_MakeBooking" name="Make booking when receiving money">
      <incoming>SequenceFlow_MakeBooking</incoming>
      <outgoing>SequenceFlow_CheckDisagreement</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_CheckDisagreement" name="Is there a disagreement?">
      <incoming>SequenceFlow_CheckDisagreement</incoming>
      <outgoing>SequenceFlow_ForwardToCollectionAgencyYes</outgoing>
      <outgoing>SequenceFlow_CheckReasoningNo</outgoing>
    </exclusiveGateway>

    <task id="Task_CheckReasoning" name="Check reasoning of disagreement">
      <incoming>SequenceFlow_CheckReasoningNo</incoming>
      <outgoing>SequenceFlow_CloseCaseAfterCheckReasoning</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_ForwardToCollectionAgency" name="Forward to collection agency">
      <incoming>SequenceFlow_ForwardToCollectionAgencyYes</incoming>
    </exclusiveGateway>

    <task id="Task_CloseCase" name="Close case">
      <incoming>SequenceFlow_CloseCaseNo</incoming>
      <incoming>SequenceFlow_CloseCaseAfterCheckReasoning</incoming>
    </task>

    <endEvent id="EndEvent_CaseClosed" name="Case closed">
      <incoming>SequenceFlow_ForwardToCollectionAgencyYes</incoming>
    </endEvent>
  </process>
</definitions>