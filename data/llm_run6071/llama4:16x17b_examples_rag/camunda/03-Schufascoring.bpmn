<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="definitions" 
             targetNamespace="http://example.com/bpmn">

   <process id="schufaScoringProzess" isExecutable="true">
     <startEvent id="startEvent">
       <outgoing>sequenceFlow_1</outgoing>
     </startEvent>

     <serviceTask id="scoringAnfrage">
       <incoming>sequenceFlow_1</incoming>
       <outgoing>sequenceFlow_2</outgoing>
     </serviceTask>

     <exclusiveGateway id="verzogerungGateway">
       <incoming>sequenceFlow_3</incoming>
       <outgoing>sequenceFlow_4</outgoing>
       <outgoing>sequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow_1" sourceRef="startEvent" targetRef="scoringAnfrage"/>
     <sequenceFlow id="sequenceFlow_2" sourceRef="scoringAnfrage" targetRef="verzogerungGateway"/>

     <sequenceFlow id="sequenceFlow_3" sourceRef="scoringAnfrage" targetRef="verzogerungGateway">
       <!--<conditionExpression xsi:type="tFormalExpression">${verzögerung==true}</conditionExpression>-->
     </sequenceFlow>

     <task id="level1Scoring">
       <incoming>sequenceFlow_2</incoming>
       <outgoing>sequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow_4" sourceRef="verzogerungGateway" targetRef="level1Scoring"/>

     <serviceTask id="scoringergebnisLeiten">
       <incoming>sequenceFlow_6</incoming>
       <outgoing>sequenceFlow_7</outgoing>
     </serviceTask>

     <endEvent id="prozessBeendet">
       <incoming>sequenceFlow_7</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow_5" sourceRef="verzogerungGateway"> 
       <!--<conditionExpression xsi:type="tFormalExpression">${verzögerung==false}</conditionExpression>-->
     </sequenceFlow>

     <serviceTask id="level2Scoring">
       <incoming>sequenceFlow_5</incoming>
       <outgoing>sequenceFlow_8</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow_6" sourceRef="level1Scoring" targetRef="scoringergebnisLeiten"/>
     <sequenceFlow id="sequenceFlow_7" sourceRef="scoringergebnisLeiten" targetRef="prozessBeendet"/>
     <sequenceFlow id="sequenceFlow_8" sourceRef="level2Scoring" targetRef="scoringergebnisLeiten"/>

   </process>
</definitions>