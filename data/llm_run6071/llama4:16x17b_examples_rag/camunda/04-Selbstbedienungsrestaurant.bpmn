<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Restaurant Process" targetNamespace="http://example.com/bpmn">

    <process id="restaurantProcess" isExecutable="true">
        <laneSet>
            <lane id="guestLane" name="Gast">
                <flowNodeRef>StartEvent_1</flowNodeRef>
                <flowNodeRef>Task_GetFood</flowNodeRef>
                <flowNodeRef>EndEvent_Finished</flowNodeRef>
            </lane>
            <lane id="staffLane" name="Angestellter">
                <flowNodeRef>Task_TakeOrder_1</flowNodeRef>
                <flowNodeRef>Task_PayAndGetPieper_1</flowNodeRef>
                <flowNodeRef>Task_InformCook_1</flowNodeRef>
                <flowNodeRef>Task_GiveFood_1</flowNodeRef>
            </lane>
            <lane id="cookLane" name="Koch">
                <flowNodeRef>Task_PrepareFood_1</flowNodeRef>
            </lane>
        </laneSet>

        <startEvent id="StartEvent_1" name="Gast betritt Restaurant">
            <outgoing>SequenceFlow_1</outgoing>
        </startEvent>

        <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_TakeOrder_1"/>

        <task id="Task_TakeOrder_1" name="Bestellung aufnehmen">
            <incoming>SequenceFlow_1</incoming>
            <outgoing>SequenceFlow_2</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_2" sourceRef="Task_TakeOrder_1" targetRef="Task_PayAndGetPieper_1"/>

        <task id="Task_PayAndGetPieper_1" name="Bezahlung und Pieper aushändigen">
            <incoming>SequenceFlow_2</incoming>
            <outgoing>SequenceFlow_3</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_3" sourceRef="Task_PayAndGetPieper_1" targetRef="Task_InformCook_1"/>

        <task id="Task_InformCook_1" name="Koch informieren">
            <incoming>SequenceFlow_3</incoming>
            <outgoing>SequenceFlow_4</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_4" sourceRef="Task_InformCook_1" targetRef="Task_PrepareFood_1"/>

        <task id="Task_PrepareFood_1" name="Essen zubereiten">
            <incoming>SequenceFlow_4</incoming>
            <outgoing>SequenceFlow_5</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_5" sourceRef="Task_PrepareFood_1" targetRef="Task_GiveFood_1"/>

        <task id="Task_GiveFood_1" name="Essen aushändigen">
            <incoming>SequenceFlow_5</incoming>
            <outgoing>SequenceFlow_6</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_6" sourceRef="Task_GiveFood_1" targetRef="EndEvent_Finished"/>

        <endEvent id="EndEvent_Finished" name="Gast verlässt Restaurant">
            <incoming>SequenceFlow_6</incoming>
        </endEvent>

        <task id="Task_GetFood" name="Essen abholen">
            <outgoing>SequenceFlow_7</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_7" sourceRef="Task_GetFood" targetRef="Task_GiveFood_1"/>

    </process>
</definitions>