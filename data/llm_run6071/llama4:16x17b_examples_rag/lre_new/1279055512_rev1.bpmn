<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" 
             targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="Process_1" isExecutable="true">
     <laneSet>
       <lane id="Lane_MailCentreOffice" name="Mail Centre office">
         <flowNodeRef>StartEvent_1</flowNodeRef>
         <flowNodeRef>Task_CategorizeInvoice</flowNodeRef>
         <flowNodeRef>IntermediateCatchEvent_DataEntry</flowNodeRef>
       </lane>
       <lane id="Lane_AdministrationDepartment" name="Administration Department">
         <flowNodeRef>Task_ProcessInvoice</flowNodeRef>
       </lane>
       <lane id="Lane_DataEntryOffice" name="Data Entry office">
         <flowNodeRef>Task_EnterDataIntoSAPSystem</flowNodeRef>
       </lane>
       <lane id="Lane_ValidationOffice" name="Validation office">
         <flowNodeRef>Task_ValidateInvoices</flowNodeRef>
       </lane>
       <lane id="Lane_PaymentOffice" name="Payment office">
         <flowNodeRef>Task_ExecutePayment</flowNodeRef>
       </lane>
       <lane id="Lane_RegistryOffice" name="Registry office">
         <flowNodeRef>Task_ArchiveInvoices</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_Start_To_CategorizeInvoice</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_Start_To_CategorizeInvoice" sourceRef="StartEvent_1" targetRef="Task_CategorizeInvoice"/>

     <task id="Task_CategorizeInvoice" name="Categorize invoice by staff member and forward to Administration Department">
       <incoming>SequenceFlow_Start_To_CategorizeInvoice</incoming>
       <outgoing>SequenceFlow_CategorizeInvoice_To_ProcessInvoice</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_CategorizeInvoice_To_ProcessInvoice" sourceRef="Task_CategorizeInvoice" targetRef="Task_ProcessInvoice"/>

     <task id="Task_ProcessInvoice" name="Process invoice">
       <incoming>SequenceFlow_CategorizeInvoice_To_ProcessInvoice</incoming>
       <outgoing>SequenceFlow_ProcessInvoice_To_DataEntry</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ProcessInvoice_To_DataEntry" sourceRef="Task_ProcessInvoice" targetRef="IntermediateCatchEvent_DataEntry"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_DataEntry">
       <incoming>SequenceFlow_ProcessInvoice_To_DataEntry</incoming>
       <outgoing>SequenceFlow_DataEntry_To_SAPSystem</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_DataEntry_To_SAPSystem" sourceRef="IntermediateCatchEvent_DataEntry" targetRef="Task_EnterDataIntoSAPSystem"/>

     <task id="Task_EnterDataIntoSAPSystem" name="Enter data into SAP system">
       <incoming>SequenceFlow_DataEntry_To_SAPSystem</incoming>
       <outgoing>SequenceFlow_SAPSystem_To_Validation</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_SAPSystem_To_Validation" sourceRef="Task_EnterDataIntoSAPSystem" targetRef="IntermediateCatchEvent_Validation"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_Validation">
       <incoming>SequenceFlow_SAPSystem_To_Validation</incoming>
       <outgoing>SequenceFlow_Validation_To_Payment</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_Validation_To_Payment" sourceRef="IntermediateCatchEvent_Validation" targetRef="Task_ValidateInvoices"/>

     <task id="Task_ValidateInvoices" name="Validate invoices">
       <incoming>SequenceFlow_Validation_To_Payment</incoming>
       <outgoing>SequenceFlow_ValidateInvoices_To_Payment</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_ValidateInvoices_To_Payment" sourceRef="Task_ValidateInvoices" targetRef="IntermediateCatchEvent_Payment"/>

     <intermediateCatchEvent id="IntermediateCatchEvent_Payment">
       <incoming>SequenceFlow_ValidateInvoices_To_Payment</incoming>
       <outgoing>SequenceFlow_Payment_To_Archive</outgoing>
       <timerEventDefinition/>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_Payment_To_Archive" sourceRef="IntermediateCatchEvent_Payment" targetRef="Task_ExecutePayment"/>

     <task id="Task_ExecutePayment" name="Execute payment of validated invoices">
       <incoming>SequenceFlow_Payment_To_Archive</incoming>
       <outgoing>SequenceFlow_Payment_To_ArchiveInvoices</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_Payment_To_ArchiveInvoices" sourceRef="Task_ExecutePayment" targetRef="Task_ArchiveInvoices"/>

     <task id="Task_ArchiveInvoices" name="Archive invoices">
       <incoming>SequenceFlow_Payment_To_ArchiveInvoices</incoming>
     </task>

   </process>
</definitions>