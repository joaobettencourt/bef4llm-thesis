<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Identify Not Collected Bag">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1"/>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
       <outgoing>SequenceFlow_4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_3" name="yes" sourceRef="ExclusiveGateway_1" targetRef="Task_2">
       <conditionExpression xsi:type="tFormalExpression">${bag.needSpecialHandling   == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_2" name="Return to Production Area for Disassemble">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_2" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_4" name="no" sourceRef="ExclusiveGateway_1" targetRef="Task_3">
       <conditionExpression xsi:type="tFormalExpression">${bag.needSpecialHandling   == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_3" name="Check Number of Resolution Retries">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_3" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
       <outgoing>SequenceFlow_8</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_7" name="retry count exceeded" sourceRef="ExclusiveGateway_2" targetRef="Task_4">
       <conditionExpression xsi:type="tFormalExpression">${bag.retryCount  > maxRetries}</conditionExpression>
     </sequenceFlow>

     <task id="Task_4" name="Return to Production Area for Disassemble">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_8" name="retry count not exceeded" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${bag.retryCount  <= maxRetries}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Try to Contact Customer by Phone">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_10</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_10" sourceRef="Task_5" targetRef="ExclusiveGateway_3"/>

     <exclusiveGateway id="ExclusiveGateway_3">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
       <outgoing>SequenceFlow_12</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_11" name="successful contact, customer withdraws order" sourceRef="ExclusiveGateway_3" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${contactResult   ==  'withdrawn'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Return to Production Area for Disassemble">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="EndEvent_1"/>

     <sequenceFlow id="SequenceFlow_12" name="successful contact, customer promises to pick up bag or unsuccessful" sourceRef="ExclusiveGateway_3" targetRef="Task_7">
       <conditionExpression xsi:type="tFormalExpression">${contactResult   ==  'promises' || contactResult == 'unsuccessful'}</conditionExpression>
     </sequenceFlow>

     <task id="Task_7" name="Increase Retry Count on Bag Label">
       <incoming>SequenceFlow_12</incoming>
       <outgoing>SequenceFlow_14</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_14" sourceRef="Task_7" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_5</incoming>
       <incoming>SequenceFlow_9</incoming>
       <incoming>SequenceFlow_13</incoming>
       <incoming>SequenceFlow_14</incoming>
     </endEvent>

   </process>
</definitions>