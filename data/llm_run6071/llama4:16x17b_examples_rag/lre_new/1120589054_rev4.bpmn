<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/06-02-01.xsd"
             id="definition" name="BPMN Process Model">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_ReceiveOrder"/>

     <task id="Task_ReceiveOrder" name="Receive Order">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_ReceiveOrder" targetRef="Task_ProcessOrder"/>

     <task id="Task_ProcessOrder" name="Process Order">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_ProcessOrder" targetRef="Gateway_SendToWarehouse"/>

     <exclusiveGateway id="Gateway_SendToWarehouse">
       <incoming>SequenceFlow_3</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_21</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" name="yes" sourceRef="Gateway_SendToWarehouse" targetRef="Task_warehouseDetermineParts">
     </sequenceFlow>

     <task id="Task_warehouseDetermineParts" name="Determine parts required">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_5" sourceRef="Task_warehouseDetermineParts" targetRef="Gateway_PartsAvailability"/>

     <exclusiveGateway id="Gateway_PartsAvailability">
       <incoming>SequenceFlow_5</incoming>
       <outgoing>SequenceFlow_6</outgoing>
       <outgoing>SequenceFlow_7</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_6" name="Sufficient parts available" sourceRef="Gateway_PartsAvailability" targetRef="Task_StartProduction">
     </sequenceFlow>

     <task id="Task_StartProduction" name="Start production">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_8" sourceRef="Task_StartProduction" targetRef="Task_PerformQualityChecks"/>

     <task id="Task_PerformQualityChecks" name="Perform quality checks">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_PerformQualityChecks" targetRef="Gateway_FinishProduction"/>

     <exclusiveGateway id="Gateway_FinishProduction">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_20</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" name="Quality check passed" sourceRef="Gateway_FinishProduction" targetRef="Task_PackageAndLabelProduct">
     </sequenceFlow>

     <task id="Task_PackageAndLabelProduct" name="Package and label product">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_11</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_11" sourceRef="Task_PackageAndLabelProduct" targetRef="EndEvent_InformedSales"/>

     <endEvent id="EndEvent_InformedSales">
       <incoming>SequenceFlow_11</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_20" name="Quality check failed" sourceRef="Gateway_FinishProduction" targetRef="Task_PackageAndLabelProductWarehouse">
     </sequenceFlow>

     <task id="Task_PackageAndLabelProductWarehouse" name="Package and label product warehouse">
       <incoming>SequenceFlow_20</incoming>
       <outgoing>SequenceFlow_21</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_21" sourceRef="Task_PackageAndLabelProductWarehouse" targetRef="Gateway_SendToWarehouse"/>

     <sequenceFlow id="SequenceFlow_7" name="Parts not available" sourceRef="Gateway_PartsAvailability" targetRef="Task_OrderParts">
     </sequenceFlow>

     <task id="Task_OrderParts" name="Order parts">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_5</outgoing>
     </task>

   </process>
</definitions>