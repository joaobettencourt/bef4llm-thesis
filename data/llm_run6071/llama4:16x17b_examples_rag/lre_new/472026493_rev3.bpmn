<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://example.com/bpmn">

   <process id="Process_1" isExecutable="true">
     <startEvent id="StartEvent_1">
       <outgoing>SequenceFlow_1</outgoing>
     </startEvent>

     <sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="Task_1"/>

     <task id="Task_1" name="Analyse Request">
       <incoming>SequenceFlow_1</incoming>
       <outgoing>SequenceFlow_2</outgoing>
       <outgoing>SequenceFlow_3</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_2" sourceRef="Task_1" targetRef="ExclusiveGateway_1">
       <conditionExpression xsi:type="tFormalExpression">${request.approved == true}</conditionExpression>
     </sequenceFlow>

     <sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="EndEvent_2">
       <conditionExpression xsi:type="tFormalExpression">${request.approved == false}</conditionExpression>
     </sequenceFlow>

     <exclusiveGateway id="ExclusiveGateway_1">
       <incoming>SequenceFlow_2</incoming>
       <outgoing>SequenceFlow_4</outgoing>
       <outgoing>SequenceFlow_5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_4" sourceRef="ExclusiveGateway_1" targetRef="Task_2"/>

     <task id="Task_2" name="Edit and Complete Request">
       <incoming>SequenceFlow_4</incoming>
       <outgoing>SequenceFlow_6</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_6" sourceRef="Task_2" targetRef="Task_3"/>

     <task id="Task_3" name="Send Email to Supplier">
       <incoming>SequenceFlow_6</incoming>
       <outgoing>SequenceFlow_7</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_7" sourceRef="Task_3" targetRef="IntermediateEvent_1"/>

     <intermediateCatchEvent id="IntermediateEvent_1">
       <incoming>SequenceFlow_7</incoming>
       <outgoing>SequenceFlow_8</outgoing>
     </intermediateCatchEvent>

     <sequenceFlow id="SequenceFlow_8" sourceRef="IntermediateEvent_1" targetRef="Task_4"/>

     <task id="Task_4" name="Fill in Form and Send to Management">
       <incoming>SequenceFlow_8</incoming>
       <outgoing>SequenceFlow_9</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_9" sourceRef="Task_4" targetRef="ExclusiveGateway_2"/>

     <exclusiveGateway id="ExclusiveGateway_2">
       <incoming>SequenceFlow_9</incoming>
       <outgoing>SequenceFlow_10</outgoing>
       <outgoing>SequenceFlow_11</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="SequenceFlow_10" sourceRef="ExclusiveGateway_2" targetRef="Task_5">
       <conditionExpression xsi:type="tFormalExpression">${management.approved == true}</conditionExpression>
     </sequenceFlow>

     <task id="Task_5" name="Forward to Financial Department and IT Department">
       <incoming>SequenceFlow_10</incoming>
       <outgoing>SequenceFlow_12</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_12" sourceRef="Task_5" targetRef="EndEvent_1"/>

     <endEvent id="EndEvent_1">
       <incoming>SequenceFlow_12</incoming>
     </endEvent>

     <sequenceFlow id="SequenceFlow_11" sourceRef="ExclusiveGateway_2" targetRef="Task_6">
       <conditionExpression xsi:type="tFormalExpression">${management.approved == false}</conditionExpression>
     </sequenceFlow>

     <task id="Task_6" name="Rework Request">
       <incoming>SequenceFlow_11</incoming>
       <outgoing>SequenceFlow_13</outgoing>
     </task>

     <sequenceFlow id="SequenceFlow_13" sourceRef="Task_6" targetRef="ExclusiveGateway_1"/>

     <endEvent id="EndEvent_2">
       <incoming>SequenceFlow_3</incoming>
     </endEvent>
   </process>
 </definitions>