<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dcterms="http://purl.org/dc/terms/"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/DD/20100524/DC http://www.omg.org/spec/DD/2.0/20100501/dc.xsd
                                  http://www.omg.org/spec/DD/20100524/DI http://www.omg.org/spec/DD/2.0/20100501/di.xsd"
             id="definition" name="BPMN Process Model">
    <process id="createAndPrintModel" isExecutable="true">

        <!-- Start Event  -->
        <startEvent id="startCreateModel" name="Crave Custom 3D Model">
            <outgoing>sequenceFlow1</outgoing>
        </startEvent>

        <!-- Task: Instruct Artist  -->
        <userTask id="instructArtist" name="Instruct an artist to create a project">
            <incoming>sequenceFlow1</incoming>
            <outgoing>sequenceFlow2</outgoing>
        </userTask>

        <!-- Sequence Flow: Start to Instruct Artist  -->
        <sequenceFlow id="sequenceFlow1" sourceRef="startCreateModel" targetRef="instructArtist"/>

        <!-- Task: Send Sketches and Changes  -->
        <userTask id="sendSketchesAndChanges" name="Send sketches, tell changes until satisfied">
            <incoming>sequenceFlow2</incoming>
            <outgoing>sequenceFlow3</outgoing>
        </userTask>

        <!-- Sequence Flow: Instruct Artist to Send Sketches and Changes  -->
        <sequenceFlow id="sequenceFlow2" sourceRef="instructArtist" targetRef="sendSketchesAndChanges"/>

        <!-- Task: Choose Color  -->
        <userTask id="chooseColor" name="Choose plastic color">
            <incoming>sequenceFlow3</incoming>
            <outgoing>sequenceFlow4</outgoing>
            <outgoing>sequenceFlow5</outgoing>
        </userTask>

        <!-- Sequence Flow: Send Sketches and Changes to Choose Color  -->
        <sequenceFlow id="sequenceFlow3" sourceRef="sendSketchesAndChanges" targetRef="chooseColor"/>

        <!-- Exclusive Gateway: Check Color Stock  -->
        <exclusiveGateway id="checkColorStock" name="Check color stock">
            <incoming>sequenceFlow4</incoming>
            <outgoing>sequenceFlow6</outgoing>
            <outgoing>sequenceFlow7</outgoing>
        </exclusiveGateway>

        <!-- Sequence Flow: Choose Color to Check Color Stock  -->
        <sequenceFlow id="sequenceFlow4" sourceRef="chooseColor" targetRef="checkColorStock">
            <conditionExpression xsi:type="tFormalExpression">${colorInStock == true}</conditionExpression>
        </sequenceFlow>

        <!-- Task: Check Color Quantity  -->
        <userTask id="checkColorQuantity" name="Check color quantity">
            <incoming>sequenceFlow6</incoming>
            <outgoing>sequenceFlow8</outgoing>
        </userTask>

        <!-- Sequence Flow: Check Color Stock to Check Color Quantity  -->
        <sequenceFlow id="sequenceFlow6" sourceRef="checkColorStock" targetRef="checkColorQuantity"/>

        <!-- Task: Add to Shopping List  -->
        <userTask id="addToShoppingList" name="Add color to shopping list">
            <incoming>sequenceFlow8</incoming>
            <outgoing>sequenceFlow9</outgoing>
        </userTask>

        <!-- Sequence Flow: Check Color Quantity to Add to Shopping List  -->
        <sequenceFlow id="sequenceFlow8" sourceRef="checkColorQuantity" targetRef="addToShoppingList">
            <conditionExpression xsi:type="tFormalExpression">${colorQuantity < 100}</conditionExpression>
        </sequenceFlow>

        <!-- Task: Order Color  -->
        <userTask id="orderColor" name="Order color">
            <incoming>sequenceFlow7</incoming>
            <outgoing>sequenceFlow10</outgoing>
        </userTask>

        <!-- Sequence Flow: Check Color Stock to Order Color  -->
        <sequenceFlow id="sequenceFlow7" sourceRef="checkColorStock" targetRef="orderColor">
            <conditionExpression xsi:type="tFormalExpression">${colorInStock == false}</conditionExpression>
        </sequenceFlow>

        <!-- Task: Prepare 3D Printing  -->
        <userTask id="prepare3DPrinting" name="Prepare for 3D printing">
            <incoming>sequenceFlow9</incoming>
            <incoming>sequenceFlow10</incoming>
            <outgoing>sequenceFlow11</outgoing>
        </userTask>

        <!-- Sequence Flow: Add to Shopping List or Order Color to Prepare 3D Printing  -->
        <sequenceFlow id="sequenceFlow9" sourceRef="addToShoppingList" targetRef="prepare3DPrinting"/>
        <sequenceFlow id="sequenceFlow10" sourceRef="orderColor" targetRef="prepare3DPrinting"/>

        <!-- Task: Generate Gcode and Print  -->
        <userTask id="generateGcodeAndPrint" name="Generate gcode file, turn on printer and print">
            <incoming>sequenceFlow11</incoming>
        </userTask>

        <!-- Sequence Flow: Prepare 3D Printing to Generate Gcode and Print  -->
        <sequenceFlow id="sequenceFlow11" sourceRef="prepare3DPrinting" targetRef="generateGcodeAndPrint"/>

        <!-- End Event  -->
        <endEvent id="endCreateModel" name="3D Model Printed">
            <incoming>sequenceFlow12</incoming>
        </endEvent>

        <!-- Sequence Flow: Generate Gcode and Print to End Event  -->
        <sequenceFlow id="sequenceFlow12" sourceRef="generateGcodeAndPrint" targetRef="endCreateModel"/>

    </process>
</definitions>