<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model">
   <process id="orderProcess" isExecutable="true">
     <startEvent id="startOrder" name="Start Order Process">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="receiveOrder" name="Receive Order">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="startOrder" targetRef="receiveOrder"/>

     <exclusiveGateway id="checkInventory" name="Check Inventory">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
       <outgoing>sequenceFlow4</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow2" sourceRef="receiveOrder" targetRef="checkInventory"/>

     <task id="processOrder" name="Process Order">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow5</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow3" sourceRef="checkInventory" targetRef="processOrder">
       <conditionExpression xsi:type="tFormalExpression">${orderQuantity  <= availableStock}</conditionExpression>
     </sequenceFlow>

     <task id="notifyCustomer" name="Notify Customer">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="checkInventory" targetRef="notifyCustomer">
       <conditionExpression xsi:type="http://www.w3.org/2001/XMLSchema-instance>string">${orderQuantity  > availableStock}</conditionExpression>
     </sequenceFlow>

     <endEvent id="orderCompleted" name="Order Completed">
       <incoming>sequenceFlow5</incoming>
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow5" sourceRef="processOrder" targetRef="orderCompleted"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="notifyCustomer" targetRef="orderCompleted"/>
   </process>
</definitions>