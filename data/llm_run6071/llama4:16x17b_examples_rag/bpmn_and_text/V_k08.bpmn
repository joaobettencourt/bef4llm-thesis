<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="BPMN Process Model">
   <process id="onlineShopProcess" isExecutable="true">

     <startEvent id="startEvent1" name="Login to E-Shop">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <exclusiveGateway id="loginCheck1" name="Login Successful?">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow1" sourceRef="startEvent1" targetRef="loginCheck1"/>

     <task id="selectProducts1" name="Select Products">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="loginCheck1" targetRef="selectProducts1"/>

     <exclusiveGateway id="productSelectionCheck1" name="All Products Selected?">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow5</outgoing>
       <outgoing>sequenceFlow6</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow4" sourceRef="selectProducts1" targetRef="productSelectionCheck1"/>

     <serviceTask id="preparePaymentAndShipment1" name="Prepare Payment and Shipment">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="productSelectionCheck1" targetRef="preparePaymentAndShipment1"/>

     <userTask id="enterPaymentData1" name="Enter Payment Data">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow7" sourceRef="preparePaymentAndShipment1" targetRef="enterPaymentData1"/>

     <exclusiveGateway id="paymentConfirmationCheck1" name="Payment Confirmed?">
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow8" sourceRef="enterPaymentData1" targetRef="paymentConfirmationCheck1"/>

     <userTask id="enterShippingAddress1" name="Enter Shipping Address">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow9" sourceRef="paymentConfirmationCheck1" targetRef="enterShippingAddress1"/>

     <endEvent id="orderFinished1" name="Order Finished">
       <incoming>sequenceFlow11</incoming>
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow11" sourceRef="enterShippingAddress1" targetRef="orderFinished1"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="paymentConfirmationCheck1" targetRef="orderFinished1"/>

   </process>
</definitions>