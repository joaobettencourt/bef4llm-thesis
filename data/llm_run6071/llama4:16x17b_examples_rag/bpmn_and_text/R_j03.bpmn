<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd" 
             id="definition" name="BPMN Process Model">
  <process id="fridgeServiceProcess" isExecutable="true">

    <startEvent id="startFridgeService1" name="Start Fridge Service">
      <outgoing>sequenceFlow11</outgoing>
    </startEvent>

    <task id="describeSymptoms1" name="Describe Symptoms and Send to Central Fridge Service Center">
      <incoming>sequenceFlow11</incoming>
      <outgoing>sequenceFlow12</outgoing>
    </task>

    <sequenceFlow id="sequenceFlow11" sourceRef="startFridgeService1" targetRef="describeSymptoms1"/>

    <serviceTask id="selectLocalServiceFacility1" name="Select Local Service Facility">
      <incoming>sequenceFlow12</incoming>
      <outgoing>sequenceFlow13</outgoing>
    </serviceTask>

    <sequenceFlow id="sequenceFlow12" sourceRef="describeSymptoms1" targetRef="selectLocalServiceFacility1"/>

    <userTask id="makeAppointment1" name="Make Appointment">
      <incoming>sequenceFlow13</incoming>
      <outgoing>sequenceFlow14</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow13" sourceRef="selectLocalServiceFacility1" targetRef="makeAppointment1"/>

    <exclusiveGateway id="checkRepairStatus1" name="Check Repair Status">
      <incoming>sequenceFlow14</incoming>
      <outgoing>sequenceFlow15</outgoing>
      <outgoing>sequenceFlow16</outgoing>
    </exclusiveGateway>

    <sequenceFlow id="sequenceFlow14" sourceRef="makeAppointment1" targetRef="checkRepairStatus1"/>

    <userTask id="confirmRepair1" name="Confirm Repair">
      <incoming>sequenceFlow15</incoming>
      <outgoing>sequenceFlow17</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow15" sourceRef="checkRepairStatus1" targetRef="confirmRepair1"/>

    <userTask id="rateServiceFacility1" name="Rate Service Facility">
      <incoming>sequenceFlow17</incoming>
      <outgoing>sequenceFlow18</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow17" sourceRef="confirmRepair1" targetRef="rateServiceFacility1"/>

    <endEvent id="endFridgeService1" name="End Fridge Service">
      <incoming>sequenceFlow18</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow18" sourceRef="rateServiceFacility1" targetRef="endFridgeService1"/>

    <userTask id="notifyCustomerNoParts1" name="Notify Customer No Parts Available">
      <incoming>sequenceFlow16</incoming>
      <outgoing>sequenceFlow19</outgoing>
    </userTask>

    <sequenceFlow id="sequenceFlow16" sourceRef="checkRepairStatus1" targetRef="notifyCustomerNoParts1"/>

    <endEvent id="endFridgeServiceNoParts1" name="End Fridge Service No Parts">
      <incoming>sequenceFlow19</incoming>
    </endEvent>

    <sequenceFlow id="sequenceFlow19" sourceRef="notifyCustomerNoParts1" targetRef="endFridgeServiceNoParts1"/>

  </process>
</definitions>