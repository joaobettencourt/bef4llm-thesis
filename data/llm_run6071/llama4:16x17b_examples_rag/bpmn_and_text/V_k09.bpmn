<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/2.0/20100501/ BPMN20.xsd"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
             id="definitions" name="Storage Management Process" targetNamespace="http://example.com/storage-management">

   <process id="storageManagementProcess" isExecutable="true">
     <startEvent id="readOrder" name="Read Order from Automatic Order Management System">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <task id="checkProductAvailability" name="Check if Product is in Stock">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow1" sourceRef="readOrder" targetRef="checkProductAvailability"/>

     <exclusiveGateway id="productAvailabilityGateway" name="Is Product in Stock?">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <task id="withdrawProductFromWarehouse" name="Withdraw Product from Warehouse">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </task>

     <serviceTask id="reorderProduct" name="Reorder Product from Wholesaler">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </serviceTask>

     <task id="registerProductInStockManagementSystem" name="Register Product in Stock Management System">
       <incoming>sequenceFlow7</incoming>
       <outgoing>sequenceFlow8</outgoing>
     </task>

     <exclusiveGateway id="orderReadinessGateway2" name="Is Order Ready for Shipment?">
       <incoming>sequenceFlow6</incoming>
       <incoming>sequenceFlow8</incoming>
       <outgoing>sequenceFlow9</outgoing>
       <outgoing>sequenceFlow10</outgoing>
     </exclusiveGateway>

     <task id="requestCourierAndPackProducts" name="Request Courier and Pack Products Simultaneously">
       <incoming>sequenceFlow9</incoming>
       <outgoing>sequenceFlow11</outgoing>
     </task>

     <endEvent id="shipmentCompleted" name="Shipment Completed">
       <incoming>sequenceFlow10</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow2" sourceRef="checkProductAvailability" targetRef="productAvailabilityGateway"/>
     <sequenceFlow id="sequenceFlow3" sourceRef="checkProductAvailability" targetRef="productAvailabilityGateway"/>
     <sequenceFlow id="sequenceFlow4" sourceRef="productAvailabilityGateway" targetRef="withdrawProductFromWarehouse"/>
     <sequenceFlow id="sequenceFlow5" sourceRef="productAvailabilityGateway" targetRef="reorderProduct"/>
     <sequenceFlow id="sequenceFlow6" sourceRef="withdrawProductFromWarehouse" targetRef="orderReadinessGateway2"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="reorderProduct" targetRef="registerProductInStockManagementSystem"/>
     <sequenceFlow id="sequenceFlow8" sourceRef="registerProductInStockManagementSystem" targetRef="orderReadinessGateway2"/>
     <sequenceFlow id="sequenceFlow9" sourceRef="orderReadinessGateway2" targetRef="requestCourierAndPackProducts"/>
     <sequenceFlow id="sequenceFlow10" sourceRef="orderReadinessGateway2" targetRef="shipmentCompleted"/>
     <sequenceFlow id="sequenceFlow11" sourceRef="requestCourierAndPackProducts" targetRef="shipmentCompleted"/>

   </process>
</definitions>