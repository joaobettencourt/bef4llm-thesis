<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd"
             id="definition" name="BPMN Process Model" targetNamespace="http://bpmn.io/schema/bpmn">
   <process id="inspectionProcess" isExecutable="true">
     <startEvent id="startInspection" name="Start Inspection">
       <outgoing>sequenceFlow1</outgoing>
     </startEvent>

     <userTask id="enterMachineType" name="Enter Machine Type and Serial Number">
       <incoming>sequenceFlow1</incoming>
       <outgoing>sequenceFlow2</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow1" sourceRef="startInspection" targetRef="enterMachineType"/>

     <task id="inspectionQuestions" name="Answer Inspection Questions">
       <incoming>sequenceFlow2</incoming>
       <outgoing>sequenceFlow3</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow2" sourceRef="enterMachineType" targetRef="inspectionQuestions"/>

     <exclusiveGateway id="checkResults" name="Check Results">
       <incoming>sequenceFlow3</incoming>
       <outgoing>sequenceFlow4</outgoing>
       <outgoing>sequenceFlow5</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="sequenceFlow3" sourceRef="inspectionQuestions" targetRef="checkResults"/>

     <task id="automaticallyCollectedValues" name="Automatically Collect Values from Machine">
       <incoming>sequenceFlow4</incoming>
       <outgoing>sequenceFlow7</outgoing>
     </task>

     <sequenceFlow id="sequenceFlow4" sourceRef="checkResults" targetRef="automaticallyCollectedValues">

       <conditionExpression xsi:type="tFormalExpression">${results.requireManualInput  == false}</conditionExpression>
     </sequenceFlow>

     <userTask id="additionalQuestions" name="Answer Additional Questions">
       <incoming>sequenceFlow5</incoming>
       <outgoing>sequenceFlow6</outgoing>
     </userTask>

     <sequenceFlow id="sequenceFlow5" sourceRef="checkResults" targetRef="additionalQuestions">

       <conditionExpression xsi:type="tFormalExpression">${results.requireManualInput  == true}</conditionExpression>
     </sequenceFlow>

     <endEvent id="inspectionCompleted" name="Inspection Completed">
       <incoming>sequenceFlow7</incoming>
       <incoming>sequenceFlow6</incoming>
     </endEvent>

     <sequenceFlow id="sequenceFlow6" sourceRef="additionalQuestions" targetRef="inspectionCompleted"/>
     <sequenceFlow id="sequenceFlow7" sourceRef="automaticallyCollectedValues" targetRef="inspectionCompleted"/>

   </process>
</definitions>