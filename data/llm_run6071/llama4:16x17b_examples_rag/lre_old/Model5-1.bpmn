<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_1"
             targetNamespace="http://bpmn.io/schema/bpmn">
    <collaboration id="Collaboration_0bxs64x">
        <participant id="Participant_18pu9vn" name="Loan company&#10;" processRef="Process_1"/>
        <participant id="Participant_1qxes44" name="Customer"/>
        <messageFlow id="MessageFlow_12roltb" sourceRef="Participant_1qxes44" targetRef="StartEvent_1"/>
        <messageFlow id="MessageFlow_0l58mwt" sourceRef="EndEvent_loanapproved" targetRef="Participant_1qxes44"/>
    </collaboration>
    <process id="Process_1" isExecutable="false">
        <startEvent id="StartEvent_1">
            <outgoing>SequenceFlow_09yq5q7</outgoing>
            <messageEventDefinition/>
        </startEvent>

        <task id="Task_14h3p2c" name="Receive customer request for loan amount&#10;">
            <incoming>SequenceFlow_09yq5q7</incoming>
            <outgoing>SequenceFlow_1elzcle</outgoing>
        </task>

        <sequenceFlow id="SequenceFlow_09yq5q7" sourceRef="StartEvent_1" targetRef="Task_14h3p2c"/>

        <serviceTask id="Task_0cu9d4k" name="Invoke risk assessment Web service&#10;">
            <incoming>SequenceFlow_1elzcle</incoming>
            <outgoing>SequenceFlow_16093oy</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_1elzcle" sourceRef="Task_14h3p2c" targetRef="Task_0cu9d4k"/>

        <exclusiveGateway id="ExclusiveGateway_1">
            <incoming>SequenceFlow_16093oy</incoming>
            <outgoing>SequenceFlow_lowrisk_smalloan</outgoing>
            <outgoing>SequenceFlow_highrisk</outgoing>
            <outgoing>SequenceFlow_furtherrevieworlargeamount</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_16093oy" sourceRef="Task_0cu9d4k" targetRef="ExclusiveGateway_1"/>

        <exclusiveGateway id="ExclusiveGateway_lowrisk_smalloan">
            <incoming>SequenceFlow_lowrisk_smalloan</in>
            <outgoing>SequenceFlow_loanapproved</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_lowrisk_smalloan" name="Loan is small and customer is low risk&#10;" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_lowrisk_smalloan"/>

        <endEvent id="EndEvent_loanapproved">
            <incoming>SequenceFlow_loanapproved</incoming>
            <messageEventDefinition/>
        </endEvent>

        <sequenceFlow id="SequenceFlow_loanapproved" sourceRef="ExclusiveGateway_lowrisk_smalloan" targetRef="EndEvent_loanapproved"/>

        <exclusiveGateway id="ExclusiveGateway_highrisk">
            <incoming>SequenceFlow_highrisk</incoming>
            <outgoing>SequenceFlow_loandenied</outgoing>
        </exclusiveGateway>

        <sequenceFlow id="SequenceFlow_highrisk" name="Customer is high risk&#10;" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_highrisk"/>

        <endEvent id="EndEvent_loandenied">
            <incoming>SequenceFlow_loandenied</incoming>
            <messageEventDefinition/>
        </endEvent>

        <sequenceFlow id="SequenceFlow_loandenied" sourceRef="ExclusiveGateway_highrisk" targetRef="EndEvent_loandenied"/>

        <serviceTask id="Task_approverwebservice" name="Invoke approver Web service&#10;">
            <incoming>SequenceFlow_furtherrevieworlargeamount</incoming>
            <outgoing>SequenceFlow_customerfeedback</outgoing>
        </serviceTask>

        <sequenceFlow id="SequenceFlow_furtherrevieworlargeamount" name="Customer needs further review or loan amount is  $10,000 or more&#10;" sourceRef="ExclusiveGateway_1" targetRef="Task_approverwebservice"/>

        <endEvent id="EndEvent_customerfeedback">
            <incoming>SequenceFlow_customerfeedback</incoming>
            <messageEventDefinition/>
        </endEvent>

        <sequenceFlow id="SequenceFlow_customerfeedback" sourceRef="Task_approverwebservice" targetRef="EndEvent_customerfeedback"/>
    </process>
</definitions>