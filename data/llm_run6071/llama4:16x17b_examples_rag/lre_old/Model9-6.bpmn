<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

   <process id="design_process" isExecutable="true">
     <startEvent id="start_event">
       <outgoing>locate_and_distribute_SequenceFlow</outgoing>
     </startEvent>

     <task id="locate_and_distribute_designs">
       <incoming>locate_and_distribute_SequenceFlow</incoming>
       <outgoing>design_electrical_SequenceFlow</outgoing>
       <outgoing>design_physical_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="locate_and_distribute_SequenceFlow" sourceRef="start_event" targetRef="locate_and_distribute_designs"/>

     <parallelGateway id="electrical_parallel_gateway">
       <incoming>design_electrical_SequenceFlow</incoming>
       <outgoing>get_existing_electrical_Design_SequenceFlow</outgoing>
       <outgoing>update_electrical_Design_SequenceFlow</outgoing>
     </parallelGateway>

     <sequenceFlow id="design_electrical_SequenceFlow" sourceRef="locate_and_distribute_designs" targetRef="electrical_parallel_gateway"/>

     <task id="exclusive_gateway_electrical">
       <incoming>get_existing_electrical_Design_SequenceFlow</incoming>
       <outgoing>review_and_update_plan_electrical_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="get_existing_electrical_Design_SequenceFlow" sourceRef="electrical_parallel_gateway" targetRef="exclusive_gateway_electrical"/>

     <task id="update_plan_electrical">
       <incoming>review_and_update_plan_electrical_SequenceFlow</incoming>
       <outgoing>create_revised_design_electrical_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="review_and_update_plan_electrical_SequenceFlow" sourceRef="exclusive_gateway_electrical" targetRef="update_plan_electrical"/>

     <task id="test_design_electrical">
       <incoming>create_revised_design_electrical_SequenceFlow</incoming>
       <outgoing>electrical_test_passed_SequenceFlow</outgoing>
       <outgoing>electrical_test_failed_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="create_revised_design_electrical_SequenceFlow" sourceRef="update_plan_electrical" targetRef="test_design_electrical"/>

     <exclusiveGateway id="electrical_test_gateway">
       <incoming>electrical_test_failed_SequenceFlow</incoming>
       <incoming>electrical_test_passed_SequenceFlow</incoming>
       <outgoing>notify_physical_restart_SequenceFlow</outgoing>
       <outgoing>review_and_update_plan_electrical_again_SequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="electrical_test_passed_SequenceFlow" sourceRef="test_design_electrical" targetRef="electrical_test_gateway"/>
     <sequenceFlow id="electrical_test_failed_SequenceFlow" sourceRef="test_design_electrical" targetRef="electrical_test_gateway"/>

     <parallelGateway id="physical_parallel_gateway">
       <incoming>design_physical_SequenceFlow</incoming>
       <outgoing>get_existing_physical_Design_SequenceFlow</outgoing>
       <outgoing>update_physical_Design_SequenceFlow</outgoing>
     </parallelGateway>

     <sequenceFlow id="design_physical_SequenceFlow" sourceRef="locate_and_distribute_designs" targetRef="physical_parallel_gateway"/>

     <task id="exclusive_gateway_physical">
       <incoming>get_existing_physical_Design_SequenceFlow</incoming>
       <outgoing>review_and_update_plan_physical_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="get_existing_physical_Design_SequenceFlow" sourceRef="physical_parallel_gateway" targetRef="exclusive_gateway_physical"/>

     <task id="update_plan_physical">
       <incoming>review_and_update_plan_physical_SequenceFlow</incoming>
       <outgoing>create_revised_design_physical_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="review_and_update_plan_physical_SequenceFlow" sourceRef="exclusive_gateway_physical" targetRef="update_plan_physical"/>

     <task id="test_design_physical">
       <incoming>create_revised_design_physical_SequenceFlow</incoming>
       <outgoing>physical_test_passed_SequenceFlow</outgoing>
       <outgoing>physical_test_failed_SequenceFlow</outgoing>
     </task>

     <sequenceFlow id="create_revised_design_physical_SequenceFlow" sourceRef="update_plan_physical" targetRef="test_design_physical"/>

     <exclusiveGateway id="physical_test_gateway">
       <incoming>physical_test_failed_SequenceFlow</incoming>
       <incoming>physical_test_passed_SequenceFlow</incoming>
       <outgoing>notify_electrical_restart_SequenceFlow</outgoing>
       <outgoing>review_and_update_plan_physical_again_SequenceFlow</outgoing>
     </exclusiveGateway>

     <sequenceFlow id="physical_test_passed_SequenceFlow" sourceRef="test_design_physical" targetRef="physical_test_gateway"/>
     <sequenceFlow id="physical_test_failed_SequenceFlow" sourceRef="test_design_physical" targetRef="physical_test_gateway"/>

     <endEvent id="design_complete">
       <incoming>combined_test_passed_SequenceFlow</incoming>
     </endEvent>

   </process>
</definitions>