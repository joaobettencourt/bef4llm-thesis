<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definitions" targetNamespace="http://www.example.com/bpmn">

  <process id="process" isExecutable="true">
    <startEvent id="startEvent">
      <outgoing>sequenceFlow1</outgoing>
    </startEvent>

    <task id="backupDatabase" name="Backup Database">
      <incoming>sequenceFlow1</incoming>
      <outgoing>sequenceFlow2</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_0">
      <incoming>sequenceFlow2</incoming>
      <outgoing>sequenceFlow3</outgoing>
      <outgoing>sequenceFlow10</outgoing>
    </exclusiveGateway>

    <task id="checkDefaulters" name="Check for new defaulters">
      <incoming>sequenceFlow3</incoming>
      <outgoing>sequenceFlow4</outgoing>
    </task>

    <exclusiveGateway id="ExclusiveGateway_1">
      <incoming>sequenceFlow4</incoming>
      <outgoing>sequenceFlow5</outgoing>
      <outgoing>sequenceFlow6</outgoing>
    </exclusiveGateway>

    <task id="registerDefaulters" name="Register defaulting accounts and customers">
      <incoming>sequenceFlow5</incoming>
      <outgoing>sequenceFlow7</outgoing>
    </task>

    <intermediateCatchEvent id="catchEvent_2:30PM" name="2:30 PM">
      <incoming>sequenceFlow7</incoming>
      <outgoing>sequenceFlow8</outgoing>
    </intermediateCatchEvent>

    <endEvent id="endEvent">
      <incoming>sequenceFlow8</incoming>
    </endEvent>

    <!-- Sequence Flows -->
    <sequenceFlow id="sequenceFlow1" sourceRef="startEvent" targetRef="backupDatabase"/>
    <sequenceFlow id="sequenceFlow2" sourceRef="backupDatabase" targetRef="ExclusiveGateway_0"/>
    <sequenceFlow id="sequenceFlow3" sourceRef="ExclusiveGateway_0" targetRef="checkDefaulters"/>
    <sequenceFlow id="sequenceFlow4" sourceRef="checkDefaulters" targetRef="ExclusiveGateway_1"/>
    <sequenceFlow id="sequenceFlow5" sourceRef="ExclusiveGateway_1" targetRef="registerDefaulters"/>
    <sequenceFlow id="sequenceFlow7" sourceRef="registerDefaulters" targetRef="catchEvent_2:30PM"/>
    <sequenceFlow id="sequenceFlow8" sourceRef="catchEvent_2:30PM" targetRef="endEvent"/>

  </process>
</definitions>