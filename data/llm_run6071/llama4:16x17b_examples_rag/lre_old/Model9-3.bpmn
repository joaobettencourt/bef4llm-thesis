<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/06-02-01.xsd"
             id="definition" name="Town Planning Authority Process" targetNamespace="http://example.com/bpmn">

   <process id="town_planning_process" isExecutable="true">
     <laneSet>
       <lane id="coordination_unit_lane" name="Coordination Unit">
         <flowNodeRef>draft_schedule_task</flowNodeRef>
         <flowNodeRef>check_dates_task</flowNodeRef>
         <flowNodeRef>finalize_schedule_task</flowNodeRef>
         <flowNodeRef>send_schedule_event</flowNodeRef>
       </lane>

       <lane id="support_officer_lane" name="Support Officer">
         <flowNodeRef>suggest_modifications_task</flowNodeRef>
         <flowNodeRef>update_calendars_task</flowNodeRef>
       </lane>

       <lane id="committee_members_lane" name="Committee Members">
         <flowNodeRef>check_diaries_task</flowNodeRef>
       </lane>
     </laneSet>

     <startEvent id="start_event_1" name="Start of Scheduling Process">
       <outgoing>draft_schedule_sequence_flow</outgoing>
       <timerEventDefinition/>
     </startEvent>

     <sequenceFlow id="draft_schedule_sequence_flow" sourceRef="start_event_1" targetRef="draft_schedule_task"/>

     <task id="draft_schedule_task" name="Draft Schedule of Meetings">
       <incoming>draft_schedule_sequence_flow</incoming>
       <outgoing>suggest_modifications_sequence_flow</outgoing>
     </task>

     <sequenceFlow id="suggest_modifications_sequence_flow_1" sourceRef="draft_schedule_task" targetRef="suggest_modifications_task"/>

     <task id="suggest_modifications_task" name="Suggest Modifications to Dates">
       <incoming>suggest_modifications_sequence_flow_1</incoming>
       <outgoing>check_dates_sequence_flow</outgoing>
     </task>

     <sequenceFlow id="check_dates_sequence_flow_1" sourceRef="suggest_modifications_task" targetRef="check_dates_task"/>

     <task id="check_dates_task" name="Check Dates for Potential Conflicts">
       <incoming>check_dates_sequence_flow_1</incoming>
       <outgoing>finalize_schedule_sequence_flow</outgoing>
     </task>

     <sequenceFlow id="finalize_schedule_sequence_flow_1" sourceRef="check_dates_task" targetRef="finalize_schedule_task"/>

     <task id="finalize_schedule_task" name="Finalize Schedule of Meetings">
       <incoming>finalize_schedule_sequence_flow_1</incoming>
       <outgoing>send_schedule_sequence_flow</outgoing>
     </task>

     <sequenceFlow id="send_schedule_sequence_flow_1" sourceRef="finalize_schedule_task" targetRef="send_schedule_event"/>

     <intermediateThrowEvent id="send_schedule_event_1" name="Send Schedule to Committee Members">
       <incoming>send_schedule_sequence_flow_1</incoming>
       <outgoing>check_diaries_sequence_flow</outgoing>
       <messageEventDefinition/>
     </intermediateThrowEvent>

     <sequenceFlow id="check_diaries_sequence_flow_1" sourceRef="send_schedule_event_1" targetRef="check_diaries_task"/>

     <task id="check_diaries_task" name="Check Diaries for Conflicts">
       <incoming>check_diaries_sequence_flow_1</incoming>
     </task>

     <task id="update_calendars_task" name="Update Calendars">
       <!-- Add incoming and outgoing sequence flows as necessary -->
     </task>

   </process>
</definitions>