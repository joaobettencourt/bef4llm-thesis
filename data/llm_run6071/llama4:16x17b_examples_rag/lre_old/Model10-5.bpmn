<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_MPNO" name="MPON" processRef="Process_MPNO"/>
    <bpmn:participant id="Participant_MPOO" name="MPOO" processRef="Process_MPOO"/>
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="StartEvent_MPNO" targetRef="IntermediateCatchEvent_MP00"/>
    <bpmn:messageFlow id="MessageFlow_2" sourceRef="Task_MP00_SendTender" targetRef="IntermediateCatchEvent_MPNO_Order"/>
    <bpmn:messageFlow id="MessageFlow_3" sourceRef="Task_MPNO_PlaceOrder" targetRef="IntermediateCatchEventConfirmOrder_MP00"/>
    <bpmn:messageFlow id="MessageFlow_4" sourceRef="Task_MP00_ConfirmOrder" targetRef="EndEvent_MPNO"/>
  </bpmn:collaboration>
  
  <bpmn:process id="Process_MPNO" isExecutable="false">
    <bpmn:startEvent id="StartEvent_MPNO" name="Request device takeover bid">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_MPNO" targetRef="Task_MPNO_PlaceOrder"/>
    
    <bpmn:task id="Task_MPNO_PlaceOrder" name="Place an order">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="Task_MPNO_PlaceOrder" targetRef="EndEvent_MPNO"/>
    
    <bpmn:endEvent id="EndEvent_MPNO" name="Order confirmed">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  
  <bpmn:process id="Process_MP00" isExecutable="false">
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MP00" name="Receive request for device takeover bid">
      <bpmn:incoming>MessageFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="IntermediateCatchEvent_MP00" targetRef="Task_MP00_SendTender"/>
    
    <bpmn:task id="Task_MP00_SendTender" name="Send tender for equipment takeover">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:sequenceFlow id="SequenceFlow_4" sourceRef="Task_MP00_SendTender" targetRef="IntermediateCatchEvent_MPNO_ConfirmOrder"/>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPNO_Order" name="Receive order">
      <bpmn:incoming>MessageFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_5" sourceRef="IntermediateCatchEvent_MPNO_Order" targetRef="Task_MP00_ConfirmOrder"/>
    
    <bpmn:task id="Task_MP00_ConfirmOrder" name="Confirm order and send master data">
      <bpmn:incoming>SequenceFlow_5</bpmn:incoming>
      <bpmn:outgoing>MessageFlow_4</bpmn:outgoing>
    </bpmn:task>
    
    <bpmn:intermediateCatchEvent id="IntermediateCatchEvent_MPNO_ConfirmOrder" name="Receive order confirmation">
      <bpmn:incoming>MessageFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:intermediateCatchEvent>
    
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="IntermediateCatchEvent_MPNO_ConfirmOrder" targetRef="Task_MP00_SendMasterData"/>
    
    <bpmn:task id="Task_MP00_SendMasterData" name="Send master data">
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
    </bpmn:task>
  </bpmn:process>
</bpmn:definitions>