<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_0" name="MPON" processRef="Pool_0"/>
    <bpmn:participant id="Participant_1" name="MPOO" processRef="Pool_1"/>
    <bpmn:messageFlow id="MessageFlow_0" sourceRef="Task_1" targetRef="StartEvent_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Pool_0" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_0" name="">
        <bpmn:flowNodeRef>StartNoneEvent_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_0</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartNoneEvent_0">
      <bpmn:outgoing>SequenceFlow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_0" sourceRef="StartNoneEvent_0" targetRef="Task_0"/>
    <bpmn:task id="Task_0" name="Send dismissal">
      <bpmn:incoming>SequenceFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="Task_0" targetRef="EndNoneEvent_0"/>
    <bpmn:endEvent id="EndNoneEvent_0">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Pool_1" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="Lane_1" name="">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNoneEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:incoming>MessageFlow_0</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="StartEvent_1" targetRef="Task_1"/>
    <bpmn:task id="Task_1" name="Review dismissal">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="Task_1" targetRef="ExclusiveGateway_0"/>
    <bpmn:exclusiveGateway id="ExclusiveGateway_0">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_4</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="SequenceFlow_4" name="Oppose dismissal" sourceRef="ExclusiveGateway_0" targetRef="EndNoneEvent_1"/>
    <bpmn:endEvent id="EndNoneEvent_1">
      <bpmn:incoming>SequenceFlow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SequenceFlow_5" name="Confirm dismissal" sourceRef="ExclusiveGateway_0" targetRef="EndNoneEvent_1"/>
  </bpmn:process>
</bpmn:definitions>