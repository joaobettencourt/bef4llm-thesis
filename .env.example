# ----------------------------------------
# Ollama server configuration
# ----------------------------------------

# URL of the Ollama server
# Examples:
# - Local Docker: http://host.docker.internal:11434
# - Another VM:  http://<ip>:11434
# OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://<OLLAMA_HOST_IP>:<PORT>

# ----------------------------------------
# List of LLMs to use in experiments
# ----------------------------------------

# Comma-separated list of models available in your Ollama instance.
# Use `ollama list` to see which models are installed.
# Example:
# LLMS=llama3.1:latest,phi3:latest
# LLMS=llama3.1:latest_baseline,llama3.1:latest_examples_solution,llama3.1:latest_examples_rag
# LLMS=qwen3.5:35b_baseline,qwen3.5:35b_examples_solution,qwen3.5:35b_examples_rag
# LLMS=llama4:16x17b_baseline,llama4:16x17b_examples_solution,llama4:16x17b_examples_rag
LLMS=llama3.1:latest,phi3:latest

# ----------------------------------------
# Timeout configuration
# ----------------------------------------

# Timeout for initial model loading/warm-up (seconds)
# This is used only once per LLM when it's first loaded into memory
# Default: 1800 (30 minutes)
LOAD_TIMEOUT=1800

# Timeout for regular generation requests (seconds)
# Applied to each chat/generation call after the model is loaded
# Default: 300 (5 minutes)
GENERATE_TIMEOUT=300

# ----------------------------------------
# Dataset configuration
# ----------------------------------------

# Mode:
# - general → use selected datasets below
# - experts → use only expert dataset
DATASET_MODE=general

# Used only if DATASET_MODE=general
# Options: camunda, bpmn_and_text, lre_new, lre_old
DATASETS=camunda,bpmn_and_text,lre_new,lre_old

# ----------------------------------------
# Statistical tests configuration
# ----------------------------------------

# List of runs used in statistical analysis
# These should correspond to existing llm_runX folders
# Example:
# STATISTICAL_RUNS=1,2,3,4,5
STATISTICAL_RUNS=1,2,3,4,5

# Original runs
# STATISTICAL_RUNS=6001,6002,6003,6004,6005
# STATISTICAL_RUNS=6501,6502,6503,6504,6505

# llama3.1
# STATISTICAL_RUNS=6051,6052,6053,6054,6055
# STATISTICAL_RUNS=6551,6552,6553,6554,6555

# qwen3.5
# STATISTICAL_RUNS=6061,6062,6063,6064,6065
# STATISTICAL_RUNS=6561,6562,6563,6564,6565

# llama4
# STATISTICAL_RUNS=6071,6072,6073,6074,6075
# STATISTICAL_RUNS=6571,6572,6573,6574,6575

# ----------------------------------------
# Retrieval-Augmented Generation (RAG)
# ----------------------------------------

# Enable or disable RAG
# Options:
# - true  → retrieve contextual information before prompting the LLM
# - false → use standard prompting only
RAG_ENABLED=true

# Path to the documentation file used as retrieval source
# Suggested to check expected directory organization
#
# Example:
# RAG_DIR=dataset
RAG_DIR=all_examples

# Number of retrieved chunks injected into the prompt
# Higher values provide more context but increase prompt size
#
# Example:
# RAG_TOP_K=3
RAG_TOP_K=3

# Chunk size used during document splitting
# Measured approximately in characters/tokens depending on implementation
#
# Example:
# RAG_CHUNK_SIZE=500
RAG_CHUNK_SIZE=500

# Overlap between chunks
# Helps preserve context across chunk boundaries
#
# Example:
# RAG_CHUNK_OVERLAP=100
RAG_CHUNK_OVERLAP=100